<view class="vehicle-edit-page vehicle-form-page">
  <view class="page-glow"></view>

  <view class="hero-card">
    <view class="hero-top">
      <view>
        <view class="page-kicker">FLEET EDITOR</view>
        <view class="hero-title">编辑车辆</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" />
    </view>
    <view class="hero-desc">维护车辆基础资料、租赁信息与展示素材</view>
  </view>

  <view class="loading-card" wx:if="{{loading}}">
    <view class="vehicle-form-skeleton-heading">
      <view>
        <view class="vehicle-form-skeleton-kicker vehicle-form-skeleton-pulse"></view>
        <view class="vehicle-form-skeleton-title vehicle-form-skeleton-pulse"></view>
      </view>
      <view class="vehicle-form-skeleton-index vehicle-form-skeleton-pulse"></view>
    </view>
    <view class="vehicle-form-skeleton-divider"></view>
    <view class="vehicle-form-skeleton-row">
      <view class="vehicle-form-skeleton-field">
        <view class="vehicle-form-skeleton-label vehicle-form-skeleton-pulse"></view>
        <view class="vehicle-form-skeleton-input vehicle-form-skeleton-pulse"></view>
      </view>
      <view class="vehicle-form-skeleton-field">
        <view class="vehicle-form-skeleton-label vehicle-form-skeleton-pulse"></view>
        <view class="vehicle-form-skeleton-input vehicle-form-skeleton-pulse"></view>
      </view>
    </view>
    <view class="vehicle-form-skeleton-field vehicle-form-skeleton-field-full">
      <view class="vehicle-form-skeleton-label vehicle-form-skeleton-pulse"></view>
      <view class="vehicle-form-skeleton-input vehicle-form-skeleton-pulse"></view>
    </view>
  </view>

  <view class="vehicle-form-state" wx:elif="{{loadFailed}}">
    <image class="vehicle-form-state-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" />
    <view class="vehicle-form-state-kicker">FLEET EDITOR</view>
    <view class="vehicle-form-state-title">车辆档案不可用</view>
    <view class="vehicle-form-state-desc">{{loadErrorText}}</view>
    <button wx:if="{{id}}" class="vehicle-form-state-button vehicle-form-state-button-primary" bindtap="handleRetryLoad">重新加载</button>
    <button class="vehicle-form-state-button vehicle-form-state-button-secondary" bindtap="handleBackList">返回车辆列表</button>
  </view>

  <view wx:else>
    <view class="form-card">
      <view class="section-heading">
        <view>
          <view class="section-kicker">IDENTITY</view>
          <view class="section-title">车辆身份</view>
        </view>
        <view class="section-index">01</view>
      </view>
      <view class="form-divider"></view>

      <view class="form-row">
        <view class="field-group field-group-half">
          <view class="field-label field-label-row"><text>车牌号</text><text class="field-required">必填</text></view>
          <input
            class="field-input"
            placeholder="例如 京A12345"
            placeholder-class="input-placeholder"
            value="{{form.plateNumber}}"
            maxlength="8"
            bindinput="handlePlateInput"
          />
        </view>

        <view class="field-group field-group-half">
          <view class="field-label field-label-row"><text>车辆类型</text><text class="field-required">必填</text></view>
          <picker range="{{vehicleTypeLabels}}" value="{{vehicleTypeIndex}}" bindchange="handleVehicleTypeChange">
            <view class="picker-field {{form.vehicleType ? '' : 'picker-field-placeholder'}}">
              <text>{{vehicleTypeLabel || "选择类型"}}</text>
              <text class="picker-arrow">⌄</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="field-group">
        <view class="field-label field-label-row"><text>品牌型号</text><text class="field-required">必填</text></view>
        <input
          class="field-input"
          placeholder="例如 BMW 740Li"
          placeholder-class="input-placeholder"
          value="{{form.brandModel}}"
          maxlength="50"
          data-field="brandModel"
          bindinput="handleTextInput"
        />
      </view>

      <view class="form-row">
        <view class="field-group field-group-half">
          <view class="field-label field-label-row"><text>注册日期</text><text class="field-required">必填</text></view>
          <picker mode="date" end="{{today}}" value="{{form.registerDate}}" bindchange="handleDateChange">
            <view class="picker-field {{form.registerDate ? '' : 'picker-field-placeholder'}}">
              <text>{{form.registerDate || "选择日期"}}</text>
              <text class="picker-arrow">⌄</text>
            </view>
          </picker>
        </view>

        <view class="field-group field-group-half">
          <view class="field-label field-label-row"><text>使用状态</text><text class="field-required">必填</text></view>
          <picker range="{{statusLabels}}" value="{{statusIndex}}" bindchange="handleStatusChange">
            <view class="picker-field {{form.status ? '' : 'picker-field-placeholder'}}">
              <text>{{statusLabel || "选择状态"}}</text>
              <text class="picker-arrow">⌄</text>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view class="form-card">
      <view class="section-heading">
        <view>
          <view class="section-kicker">RENTAL PROFILE</view>
          <view class="section-title">展示与租赁</view>
        </view>
        <view class="section-index">02</view>
      </view>
      <view class="form-divider"></view>
      <view class="section-helper">选填信息 · 完善后将用于车库前台展示</view>

      <view class="form-row">
        <view class="field-group field-group-half">
          <view class="field-label">取车城市</view>
          <input class="field-input" placeholder="例如 杭州" placeholder-class="input-placeholder" value="{{form.location}}" maxlength="20" data-field="location" bindinput="handleTextInput" />
        </view>
        <view class="field-group field-group-half">
          <view class="field-label">日租金</view>
          <input class="field-input" type="number" placeholder="例如 699" placeholder-class="input-placeholder" value="{{form.priceDay}}" maxlength="5" data-field="priceDay" bindinput="handleTextInput" />
        </view>
      </view>

      <view class="form-row">
        <view class="field-group field-group-half">
          <view class="field-label">变速箱</view>
          <picker range="{{transmissionLabels}}" value="{{transmissionIndex}}" bindchange="handleTransmissionChange">
            <view class="picker-field {{form.transmission ? '' : 'picker-field-placeholder'}}">
              <text>{{transmissionLabel || "选择类型"}}</text>
              <text class="picker-arrow">⌄</text>
            </view>
          </picker>
        </view>
        <view class="field-group field-group-half">
          <view class="field-label">燃油类型</view>
          <picker range="{{fuelTypeLabels}}" value="{{fuelTypeIndex}}" bindchange="handleFuelTypeChange">
            <view class="picker-field {{form.fuelType ? '' : 'picker-field-placeholder'}}">
              <text>{{fuelTypeLabel || "选择类型"}}</text>
              <text class="picker-arrow">⌄</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="field-group">
        <view class="field-label">座位数</view>
        <input class="field-input" type="number" placeholder="例如 5" placeholder-class="input-placeholder" value="{{form.seats}}" maxlength="1" data-field="seats" bindinput="handleTextInput" />
      </view>

      <view class="field-group">
        <view class="field-label field-label-row"><text>公开说明</text><text class="field-counter">{{publicDescriptionLength}} / 200</text></view>
        <textarea
          class="field-textarea"
          placeholder="填写车辆亮点、租赁提示等公开内容"
          placeholder-class="input-placeholder"
          value="{{form.publicDescription}}"
          maxlength="200"
          data-field="publicDescription"
          bindinput="handleTextInput"
        />
        <view class="section-helper">此内容会显示在首页和车辆详情，请勿填写内部档案信息。</view>
      </view>
    </view>

    <view class="form-card">
      <view class="section-heading">
        <view>
          <view class="section-kicker">ARCHIVE</view>
          <view class="section-title">档案与备注</view>
        </view>
        <view class="section-index">03</view>
      </view>
      <view class="form-divider"></view>
      <view class="section-helper">选填信息 · 仅用于内部档案，不会在前台展示</view>

      <view class="field-group">
        <view class="field-label">VIN</view>
        <input class="field-input" placeholder="选填，最多 32 位" placeholder-class="input-placeholder" value="{{form.vin}}" maxlength="32" data-field="vin" bindinput="handleTextInput" />
      </view>

      <view class="field-group">
        <view class="field-label">发动机号</view>
        <input class="field-input" placeholder="选填，最多 32 位" placeholder-class="input-placeholder" value="{{form.engineNumber}}" maxlength="32" data-field="engineNumber" bindinput="handleTextInput" />
      </view>

      <view class="field-group">
        <view class="field-label field-label-row"><text>内部备注</text><text class="field-counter">{{noteLength}} / 200</text></view>
        <textarea
          class="field-textarea"
          placeholder="填写维修提醒、档案说明等内部内容"
          placeholder-class="input-placeholder"
          value="{{form.note}}"
          maxlength="200"
          data-field="note"
          bindinput="handleTextInput"
        />
      </view>
    </view>

    <view class="action-row">
      <button class="secondary-button" bindtap="handleManageImages" disabled="{{loading || isSubmitting}}" hover-class="vehicle-form-button-pressed">
        管理车辆图片
      </button>
      <button class="submit-button" bindtap="handleSubmit" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" hover-class="vehicle-form-button-pressed">
        {{isSubmitting ? "正在保存" : "保存车辆资料"}}
      </button>
    </view>
  </view>
</view>
