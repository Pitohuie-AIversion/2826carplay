.privacy-request-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
  background: #101010;
  color: #ffffff;
}

.hero,
.form-card,
.record-card,
.loading-card,
.empty-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-color: rgba(255, 255, 255, 0.075);
  border-radius: 26rpx;
}

.hero-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-desc,
.type-desc,
.form-tip,
.empty-desc {
  margin-top: 10rpx;
  color: #8793a3;
  font-size: 22rpx;
  line-height: 1.7;
}

.page-kicker,
.section-kicker {
  color: #6e9fea;
  font-size: 16rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.section-title {
  margin-top: 7rpx;
  color: #f2f5f9;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.4;
}

.form-card {
  background: #15181d;
}

.type-list {
  margin-top: 20rpx;
}

.type-item {
  margin-bottom: 14rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.02);
}

.type-item-active {
  border-color: rgba(82, 143, 255, 0.55);
  background: rgba(82, 143, 255, 0.09);
}

.type-head {
  display: flex;
  align-items: center;
}

.type-radio {
  width: 22rpx;
  height: 22rpx;
  margin-right: 14rpx;
  border: 2rpx solid #657183;
  border-radius: 50%;
  box-sizing: border-box;
}

.type-item-active .type-radio {
  border: 6rpx solid #528fff;
}

.type-label {
  color: #edf1f6;
  font-size: 24rpx;
  font-weight: 600;
}

.field-label {
  margin-top: 26rpx;
  color: #dce3ec;
  font-size: 23rpx;
}

.description-input {
  width: 100%;
  height: 220rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #101318;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 1.65;
}

.word-count {
  margin-top: 8rpx;
  color: #687485;
  font-size: 20rpx;
  text-align: right;
}

.submit-btn,
.retry-btn,
.load-more-btn {
  height: 82rpx;
  border-radius: 18rpx;
  line-height: 82rpx;
}

.submit-btn {
  margin-top: 20rpx;
}

.record-section {
  margin-top: 34rpx;
}

.record-list,
.loading-card,
.empty-card {
  margin-top: 20rpx;
}

.record-card {
  background: linear-gradient(145deg, #181d24, #14171c 74%);
}

.record-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.record-type {
  color: #edf2f8;
  font-size: 26rpx;
  font-weight: 650;
}

.record-time {
  margin-top: 8rpx;
  color: #6e7988;
  font-size: 20rpx;
}

.status-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.status-pending {
  background: rgba(246, 181, 58, 0.13);
  color: #efbe61;
}

.status-processing {
  background: rgba(82, 143, 255, 0.13);
  color: #83b0fb;
}

.status-completed {
  background: rgba(54, 190, 128, 0.13);
  color: #62d59d;
}

.status-rejected {
  background: rgba(225, 87, 87, 0.13);
  color: #ef8686;
}

.status-cancelled {
  background: rgba(132, 143, 158, 0.13);
  color: #9aa5b4;
}

.record-label {
  margin-top: 22rpx;
  color: #6f7c8e;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.record-content {
  margin-top: 8rpx;
  color: #aeb8c5;
  font-size: 22rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.resolution-box {
  margin-top: 20rpx;
  padding: 2rpx 18rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(82, 143, 255, 0.06);
}

.empty-card,
.loading-card {
  color: #8793a3;
  text-align: center;
}

.empty-title {
  color: #eef2f7;
  font-size: 26rpx;
  font-weight: 600;
}

.retry-btn,
.load-more-btn {
  margin-top: 20rpx;
}

.cancel-request-btn {
  width: 100%;
  height: 76rpx;
  margin-top: 22rpx;
  border-radius: 17rpx;
  font-size: 22rpx;
  line-height: 76rpx;
}

.list-end {
  padding: 18rpx 0;
  color: #687485;
  font-size: 21rpx;
  text-align: center;
}
