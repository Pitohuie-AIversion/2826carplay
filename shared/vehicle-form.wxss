.vehicle-form-page {
  position: relative;
  min-height: 100vh;
  padding: 38rpx 24rpx 70rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #141a25 0%, #0b0d10 600rpx);
  box-sizing: border-box;
}

.vehicle-form-page .page-glow {
  position: absolute;
  top: -220rpx;
  right: -190rpx;
  width: 540rpx;
  height: 540rpx;
  border-radius: 50%;
  background: rgba(47, 104, 198, 0.12);
  filter: blur(90rpx);
}

.vehicle-form-page .hero-card,
.vehicle-form-page .tip-card,
.vehicle-form-page .form-card,
.vehicle-form-page .loading-card,
.vehicle-form-page .action-row,
.vehicle-form-page .submit-button {
  position: relative;
  z-index: 1;
}

.vehicle-form-page .card,
.vehicle-form-page .hero-card,
.vehicle-form-page .tip-card,
.vehicle-form-page .form-card,
.vehicle-form-page .loading-card {
  margin-bottom: 22rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.075);
  border-radius: 26rpx;
  background: #15181d;
  box-shadow: 0 20rpx 46rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

.vehicle-form-page .hero-card {
  overflow: hidden;
  border-color: rgba(94, 145, 226, 0.18);
  background: linear-gradient(145deg, #1b2330, #14181e 70%);
}

.vehicle-form-page .hero-card::after {
  position: absolute;
  right: -70rpx;
  bottom: -125rpx;
  width: 270rpx;
  height: 270rpx;
  border: 1rpx solid rgba(98, 148, 227, 0.08);
  border-radius: 50%;
  content: "";
}

.vehicle-form-page .hero-top,
.vehicle-form-page .section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vehicle-form-page .page-kicker,
.vehicle-form-page .section-kicker {
  color: #657997;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 3rpx;
}

.vehicle-form-page .page-title,
.vehicle-form-page .hero-title {
  margin-top: 8rpx;
  color: #f7f9fc;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.vehicle-form-page .page-desc,
.vehicle-form-page .hero-desc,
.vehicle-form-page .tip-desc,
.vehicle-form-page .loading-text {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: #8993a1;
  font-size: 22rpx;
  line-height: 1.7;
}

.vehicle-form-page .hero-emblem {
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
  margin-left: 20rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.25);
  border-radius: 50%;
}

.vehicle-form-page .tip-card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 26rpx;
  border-color: rgba(78, 137, 232, 0.12);
  background: rgba(38, 59, 90, 0.16);
}

.vehicle-form-page .tip-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(86, 145, 240, 0.28);
  border-radius: 50%;
  color: #75a8ff;
  font-size: 20rpx;
}

.vehicle-form-page .tip-title,
.vehicle-form-page .section-title {
  color: #edf1f5;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.45;
}

.vehicle-form-page .tip-desc {
  margin-top: 5rpx;
  font-size: 20rpx;
}

.vehicle-form-page .section-index {
  color: #52637b;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.4;
}

.vehicle-form-page .form-divider {
  margin: 22rpx 0 2rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.065);
}

.vehicle-form-page .form-item,
.vehicle-form-page .field-group {
  margin-top: 24rpx;
  margin-bottom: 0;
}

.vehicle-form-page .form-row {
  display: flex;
  justify-content: space-between;
}

.vehicle-form-page .form-item-half,
.vehicle-form-page .field-group-half {
  width: 48.5%;
}

.vehicle-form-page .form-label,
.vehicle-form-page .field-label {
  margin-bottom: 10rpx;
  color: #c8cdd5;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.vehicle-form-page .field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vehicle-form-page .field-required {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 5rpx 9rpx;
  border: 1rpx solid rgba(84, 143, 255, 0.2);
  border-radius: 999rpx;
  background: rgba(84, 143, 255, 0.07);
  color: #7faaf1;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1;
}

.vehicle-form-page .field-counter {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #596473;
  font-size: 17rpx;
  font-weight: 400;
  line-height: 1.2;
}

.vehicle-form-page .section-helper {
  margin-top: 14rpx;
  color: #667283;
  font-size: 18rpx;
  line-height: 1.5;
}

.vehicle-form-page .form-input,
.vehicle-form-page .form-picker,
.vehicle-form-page .form-textarea,
.vehicle-form-page .field-input,
.vehicle-form-page .picker-field,
.vehicle-form-page .field-textarea {
  width: 100%;
  min-height: 82rpx;
  padding: 21rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 18rpx;
  background: #101318;
  color: #edf0f4;
  font-size: 23rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.vehicle-form-page .form-picker,
.vehicle-form-page .picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #626c79;
}

.vehicle-form-page .form-picker-filled,
.vehicle-form-page .picker-field:not(.picker-field-placeholder) {
  color: #edf0f4;
}

.vehicle-form-page .picker-field-placeholder {
  color: #626c79;
}

.vehicle-form-page .picker-arrow {
  margin-left: 8rpx;
  color: #5c6674;
  font-size: 22rpx;
}

.vehicle-form-page .form-textarea,
.vehicle-form-page .field-textarea {
  min-height: 176rpx;
}

.vehicle-form-page .input-placeholder {
  color: #515a66;
}

.vehicle-form-page .action-row {
  display: flex;
  margin-top: 8rpx;
}

.vehicle-form-page .submit-button,
.vehicle-form-page .secondary-button {
  flex: 1;
  height: 92rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 21rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 92rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: transform 120ms ease, opacity 120ms ease;
}

.vehicle-form-page .submit-button {
  background: linear-gradient(135deg, #4f93ff, #2d6add);
  box-shadow: 0 16rpx 36rpx rgba(41, 103, 213, 0.22);
}

.vehicle-form-page .secondary-button {
  margin-right: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
}

.vehicle-form-page .submit-button-disabled {
  background: #252b34;
  color: #68717d;
  box-shadow: none;
}

.vehicle-form-page .secondary-button::after,
.vehicle-form-page .submit-button::after {
  border: 0;
}

.vehicle-form-page .vehicle-form-button-pressed {
  opacity: 0.78;
  transform: scale(0.985);
}

.vehicle-form-page .vehicle-form-state {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 58rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.075);
  border-radius: 26rpx;
  background: linear-gradient(145deg, #1a2029, #14171c 72%);
  text-align: center;
  box-sizing: border-box;
}

.vehicle-form-page .vehicle-form-state-emblem {
  width: 98rpx;
  height: 98rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.22);
  border-radius: 50%;
  opacity: 0.8;
}

.vehicle-form-page .vehicle-form-state-kicker {
  margin-top: 20rpx;
  color: #60738f;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.vehicle-form-page .vehicle-form-state-title {
  margin-top: 9rpx;
  color: #f3f5f8;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.4;
}

.vehicle-form-page .vehicle-form-state-desc {
  margin-top: 12rpx;
  color: #818b99;
  font-size: 22rpx;
  line-height: 1.65;
}

.vehicle-form-page .vehicle-form-state-button {
  width: 100%;
  height: 84rpx;
  margin: 16rpx 0 0;
  border-radius: 19rpx;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 84rpx;
}

.vehicle-form-page .vehicle-form-state-button-primary {
  margin-top: 26rpx;
  background: linear-gradient(135deg, #4f93ff, #2d6add);
}

.vehicle-form-page .vehicle-form-state-button-secondary {
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
}

.vehicle-form-page .vehicle-form-state-button::after {
  border: 0;
}

.vehicle-form-skeleton-heading,
.vehicle-form-skeleton-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vehicle-form-skeleton-heading {
  align-items: flex-end;
}

.vehicle-form-skeleton-kicker {
  width: 168rpx;
  height: 16rpx;
  border-radius: 8rpx;
}

.vehicle-form-skeleton-title {
  width: 146rpx;
  height: 31rpx;
  margin-top: 13rpx;
  border-radius: 9rpx;
}

.vehicle-form-skeleton-index {
  width: 32rpx;
  height: 20rpx;
  margin-bottom: 4rpx;
  border-radius: 8rpx;
}

.vehicle-form-skeleton-divider {
  height: 1rpx;
  margin: 24rpx 0 4rpx;
  background: rgba(255, 255, 255, 0.065);
}

.vehicle-form-skeleton-row {
  margin-top: 24rpx;
}

.vehicle-form-skeleton-field {
  width: 48.5%;
}

.vehicle-form-skeleton-field-full {
  width: 100%;
  margin-top: 24rpx;
}

.vehicle-form-skeleton-label {
  width: 96rpx;
  height: 19rpx;
  margin-bottom: 12rpx;
  border-radius: 8rpx;
}

.vehicle-form-skeleton-input {
  width: 100%;
  height: 82rpx;
  border-radius: 18rpx;
}

.vehicle-form-skeleton-pulse {
  background: linear-gradient(105deg, #181c22 12%, #29313c 34%, #181c22 56%);
  background-size: 220% 100%;
  animation: vehicleFormSkeletonPulse 1.6s ease-in-out infinite;
}

@keyframes vehicleFormSkeletonPulse {
  0% {
    background-position: 160% 0;
  }

  100% {
    background-position: -70% 0;
  }
}
