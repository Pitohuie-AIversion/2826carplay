@import "../../shared/management-shell.wxss";

.workbench-page {
  min-height: 100vh;
  padding: 24rpx calc(24rpx + env(safe-area-inset-right)) calc(70rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  box-sizing: border-box;
  color: #eef2f7;
  background: linear-gradient(180deg, #17202d 0%, #0b0d10 560rpx);
}

.hero-card,
.state-card,
.stage-card,
.queue-card {
  position: relative;
  z-index: 1;
  margin-bottom: 22rpx;
  padding: 28rpx;
}

.hero-top,
.hero-foot,
.state-card,
.section-heading,
.queue-top,
.queue-actions,
.badge-row {
  display: flex;
  align-items: center;
}

.hero-top,
.section-heading,
.queue-top {
  justify-content: space-between;
}

.page-kicker,
.section-eyebrow {
  color: #7185a2;
  font-size: 15rpx;
  font-weight: 650;
  letter-spacing: 2.5rpx;
}

.hero-title {
  margin-top: 7rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-desc {
  margin-top: 10rpx;
  color: #8d98a7;
  font-size: 21rpx;
}

.hero-emblem {
  width: 82rpx;
  height: 82rpx;
  border: 1rpx solid rgba(113, 163, 246, 0.28);
  border-radius: 50%;
}

.hero-foot {
  margin-top: 24rpx;
  padding-top: 19rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.live-dot {
  width: 11rpx;
  height: 11rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #57d39b;
}

.hero-foot-text {
  color: #738093;
  font-size: 17rpx;
}

.hero-foot-copy {
  flex: 1;
  min-width: 0;
}

.sync-time {
  margin-top: 5rpx;
  color: #556376;
  font-size: 14rpx;
}

.refresh-control {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  margin-left: 16rpx;
  padding: 11rpx 15rpx;
  border: 1rpx solid rgba(101, 154, 232, 0.16);
  border-radius: 999rpx;
  background: rgba(63, 117, 198, 0.07);
  color: #78a3df;
  font-size: 16rpx;
  box-sizing: border-box;
  transition: opacity 120ms ease, transform 120ms ease;
}

.workbench-inline-pressed {
  opacity: 0.7;
  transform: scale(0.975);
}

.refresh-icon {
  width: 15rpx;
  height: 15rpx;
  margin-right: 8rpx;
  border: 2rpx solid rgba(115, 160, 224, 0.34);
  border-top-color: #7fa9e5;
  border-radius: 50%;
  box-sizing: border-box;
}

.refresh-control-loading {
  opacity: 0.62;
}

.refresh-control-loading .refresh-icon {
  animation: workbench-spin 0.8s linear infinite;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  position: relative;
  z-index: 1;
  margin-bottom: 10rpx;
}

.summary-card {
  width: calc(50% - 7rpx);
  margin-bottom: 14rpx;
  padding: 22rpx 18rpx;
  text-align: center;
  box-sizing: border-box;
  transition: border-color 140ms ease, background 140ms ease, opacity 120ms ease, transform 120ms ease;
}

.summary-native-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin: 0 auto 9rpx;
  color: #7ca7e8;
  box-sizing: border-box;
}

.summary-native-icon-todo {
  border: 2rpx solid currentColor;
  border-radius: 6rpx;
}

.summary-todo-line {
  position: absolute;
  top: 19rpx;
  left: 8rpx;
  width: 14rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.summary-todo-line-top {
  top: 10rpx;
}

.summary-native-icon-priority {
  border: 2rpx solid rgba(230, 164, 95, 0.76);
  border-radius: 50%;
  color: #e6a45f;
}

.summary-priority-mark,
.state-error-mark,
.scope-alert-mark {
  position: relative;
  width: 4rpx;
  height: 12rpx;
  margin-bottom: 6rpx;
  border-radius: 3rpx;
  background: currentColor;
}

.summary-priority-mark::after,
.state-error-mark::after,
.scope-alert-mark::after {
  position: absolute;
  bottom: -7rpx;
  left: 0;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.summary-native-icon-overdue {
  border: 2rpx solid rgba(226, 122, 103, 0.76);
  border-radius: 50%;
  color: #e27a67;
}

.summary-clock-hand {
  width: 7rpx;
  height: 8rpx;
  margin: -2rpx 0 0 3rpx;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  transform: rotate(-8deg);
  transform-origin: left bottom;
}

.summary-native-icon-standby {
  border: 2rpx solid rgba(157, 167, 179, 0.56);
  border-radius: 50%;
  color: #9da7b3;
}

.summary-pause-line {
  width: 3rpx;
  height: 13rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 7rpx 0 0 currentColor;
  transform: translateX(-3rpx);
}

.summary-card-active-primary {
  border-color: rgba(91, 148, 239, 0.2);
  background: rgba(70, 124, 209, 0.08);
}

.summary-card-active-warning {
  border-color: rgba(230, 164, 95, 0.23);
  background: rgba(190, 123, 54, 0.075);
}

.summary-card-active-danger {
  border-color: rgba(226, 122, 103, 0.22);
  background: rgba(190, 83, 69, 0.07);
}

.summary-card-active-muted {
  border-color: rgba(157, 167, 179, 0.18);
  background: rgba(125, 137, 153, 0.065);
}

.summary-card-pressed,
.stage-item-pressed,
.filter-chip-pressed,
.sort-chip-pressed {
  opacity: 0.7;
  transform: scale(0.975);
}

.summary-value {
  color: #86b1f5;
  font-size: 36rpx;
  font-weight: 700;
}

.summary-warning { color: #e6a45f; }
.summary-danger { color: #e27a67; }
.summary-muted { color: #9da7b3; }

.summary-label {
  margin-top: 7rpx;
  color: #758193;
  font-size: 17rpx;
}

.stage-card {
  position: relative;
  z-index: 1;
  margin-bottom: 22rpx;
  padding: 25rpx 26rpx 24rpx;
}

.stage-heading,
.stage-row,
.stage-connector {
  display: flex;
  align-items: center;
}

.stage-heading {
  justify-content: space-between;
}

.stage-title {
  margin-top: 5rpx;
  color: #e9edf3;
  font-size: 24rpx;
  font-weight: 650;
}

.stage-hint {
  color: #5e6c7e;
  font-size: 15rpx;
}

.stage-row {
  margin-top: 22rpx;
}

.stage-item {
  width: 128rpx;
  padding: 15rpx 6rpx 14rpx;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  text-align: center;
  box-sizing: border-box;
  transition: border-color 140ms ease, background 140ms ease, opacity 120ms ease, transform 120ms ease;
}

.stage-item-active {
  border-color: rgba(107, 157, 232, 0.22);
  background: rgba(72, 126, 210, 0.1);
}

.stage-item-progress {
  border-color: rgba(81, 151, 229, 0.22);
  background: rgba(52, 117, 198, 0.11);
}

.stage-item-finished {
  opacity: 0.82;
}

.stage-value {
  color: #d9aa6f;
  font-size: 29rpx;
  font-weight: 700;
}

.stage-value-progress {
  color: #7eadf1;
}

.stage-value-finished {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 39rpx;
  color: #67c99a;
}

.stage-finished-check-icon {
  width: 11rpx;
  height: 20rpx;
  margin-top: -6rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.stage-label {
  margin-top: 4rpx;
  color: #78879a;
  font-size: 16rpx;
}

.stage-connector {
  flex: 1;
  min-width: 28rpx;
  margin: 0 2rpx;
}

.stage-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(104, 132, 169, 0.08), rgba(104, 132, 169, 0.28));
}

.stage-arrow {
  width: 8rpx;
  height: 8rpx;
  margin-left: -8rpx;
  border-top: 1rpx solid rgba(117, 151, 196, 0.4);
  border-right: 1rpx solid rgba(117, 151, 196, 0.4);
  transform: rotate(45deg);
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-bottom: 12rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(111, 151, 211, 0.14);
  border-radius: 18rpx;
  background: rgba(8, 14, 22, 0.48);
  box-sizing: border-box;
}

.search-symbol {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  margin-right: 17rpx;
  border: 2rpx solid #657892;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-symbol::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #657892;
  content: "";
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  height: 76rpx;
  color: #dce4ef;
  font-size: 19rpx;
  line-height: 76rpx;
}

.search-placeholder {
  color: #596778;
}

.search-clear {
  position: relative;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-left: 14rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(100, 143, 207, 0.08);
  color: #78a4e6;
  line-height: 56rpx;
}

.search-clear::after {
  border: 0;
}

.search-clear-icon::before,
.search-clear-icon::after {
  position: absolute;
  top: 23rpx;
  left: 15rpx;
  width: 18rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}

.search-clear-icon::before {
  transform: rotate(45deg);
}

.search-clear-icon::after {
  transform: rotate(-45deg);
}

.search-clear-pressed {
  opacity: 0.68;
  transform: scale(0.9);
}

.search-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  color: #748399;
  font-size: 15rpx;
}

.search-privacy {
  color: #5f8d7a;
}

.section-title {
  margin-top: 5rpx;
  font-size: 27rpx;
  font-weight: 650;
}

.section-count {
  color: #738196;
  font-size: 18rpx;
}

.section-meta {
  flex-shrink: 0;
  margin-left: 18rpx;
  text-align: right;
}

.reset-view {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 56rpx;
  margin-top: 7rpx;
  color: #729fe0;
  font-size: 15rpx;
  box-sizing: border-box;
  transition: opacity 120ms ease, transform 120ms ease;
}

.reset-view-pressed {
  opacity: 0.72;
  transform: scale(0.97);
}

.reset-view-native-icon {
  position: relative;
  width: 16rpx;
  height: 16rpx;
  margin-right: 6rpx;
  border: 2rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.reset-view-native-icon::after {
  position: absolute;
  top: -4rpx;
  right: -3rpx;
  width: 0;
  height: 0;
  border-top: 3rpx solid transparent;
  border-bottom: 3rpx solid transparent;
  border-left: 5rpx solid currentColor;
  content: "";
  transform: rotate(18deg);
}

.filter-scroll-shell {
  width: 100%;
  margin-top: 20rpx;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  padding-right: 62rpx;
}

.filter-chip {
  margin-right: 11rpx;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.025);
  color: #758296;
  font-size: 17rpx;
}

.filter-chip-active {
  border-color: rgba(91, 148, 239, 0.25);
  background: rgba(75, 132, 222, 0.11);
  color: #88b2f4;
}

.sort-toolbar {
  margin-top: 18rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.055);
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.018);
}

.sort-heading {
  display: flex;
  align-items: center;
}

.sort-label {
  color: #9ba8b8;
  font-size: 17rpx;
  font-weight: 600;
}

.sort-hint {
  flex: 1;
  margin-left: 13rpx;
  overflow: hidden;
  color: #596779;
  font-size: 14rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sort-options {
  display: flex;
  margin-top: 13rpx;
}

.sort-chip {
  flex: 1;
  height: 54rpx;
  margin-left: 8rpx;
  border: 1rpx solid rgba(102, 132, 173, 0.1);
  border-radius: 13rpx;
  background: rgba(60, 79, 105, 0.05);
  color: #69788b;
  font-size: 16rpx;
  line-height: 54rpx;
  text-align: center;
}

.sort-chip:first-child {
  margin-left: 0;
}

.sort-chip-active {
  border-color: rgba(83, 142, 230, 0.22);
  background: rgba(61, 120, 207, 0.11);
  color: #83ace9;
}

.queue-list {
  margin-top: 14rpx;
}

.queue-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.queue-item:last-child {
  border-bottom: 0;
}

.queue-vehicle {
  flex: 1;
  min-width: 0;
  color: #eff2f6;
  font-size: 23rpx;
  font-weight: 650;
}

.queue-vehicle-row {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.queue-vehicle-icon {
  position: relative;
  flex-shrink: 0;
  width: 32rpx;
  height: 22rpx;
  margin-right: 11rpx;
  border: 2rpx solid #7098d2;
  border-radius: 6rpx;
  color: #7098d2;
  box-sizing: border-box;
}

.queue-vehicle-window {
  position: absolute;
  top: 4rpx;
  left: 6rpx;
  width: 15rpx;
  height: 5rpx;
  border-top: 2rpx solid currentColor;
}

.queue-vehicle-wheel {
  position: absolute;
  bottom: -5rpx;
  width: 6rpx;
  height: 6rpx;
  border: 2rpx solid #151a21;
  border-radius: 50%;
  background: currentColor;
  box-sizing: border-box;
}

.queue-vehicle-wheel-left {
  left: 4rpx;
}

.queue-vehicle-wheel-right {
  right: 4rpx;
}

.status-pill,
.queue-badge {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 14rpx;
}

.status-pill {
  display: inline-flex;
  align-items: center;
}

.status-pill-dot {
  flex-shrink: 0;
  width: 7rpx;
  height: 7rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 9rpx currentColor;
}

.status-pending {
  background: rgba(229, 159, 84, 0.1);
  color: #dfa25f;
}

.status-contacted {
  background: rgba(77, 139, 232, 0.1);
  color: #7da9eb;
}

.status-pill-actionable {
  border: 1rpx solid rgba(224, 153, 78, 0.16);
  box-shadow: inset 0 0 0 1rpx rgba(223, 162, 95, 0.03);
  transition: filter 120ms ease, transform 120ms ease;
}

.status-pill-pressed {
  filter: brightness(0.88);
  transform: scale(0.96);
}

.status-action-chevron {
  width: 7rpx;
  height: 7rpx;
  margin-left: 7rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  box-sizing: border-box;
  transform: rotate(-45deg);
}

.queue-contact,
.queue-date {
  margin-top: 8rpx;
  color: #788596;
  font-size: 17rpx;
}

.queue-contact-row {
  display: flex;
  align-items: center;
  margin-top: 9rpx;
}

.queue-contact-row .queue-contact {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  margin-top: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 19rpx;
  height: 19rpx;
  margin-right: 8rpx;
}

.contact-native-icon::before {
  position: absolute;
  top: 0;
  left: 6rpx;
  width: 7rpx;
  height: 7rpx;
  border: 2rpx solid #657a98;
  border-radius: 50%;
  box-sizing: border-box;
  content: "";
}

.contact-native-icon::after {
  position: absolute;
  right: 1rpx;
  bottom: 0;
  left: 1rpx;
  height: 8rpx;
  border: 2rpx solid #657a98;
  border-bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
  box-sizing: border-box;
  content: "";
}

.phone-chip {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  margin-left: 12rpx;
  padding: 7rpx 10rpx;
  border: 1rpx solid rgba(99, 151, 229, 0.14);
  border-radius: 999rpx;
  background: rgba(64, 116, 194, 0.07);
  color: #86a8d8;
  font-size: 14rpx;
  transition: opacity 120ms ease, transform 120ms ease;
}

.phone-copy-label {
  margin-left: 8rpx;
  color: #628fd0;
  font-size: 15rpx;
}

.phone-copy-native-icon {
  position: relative;
  width: 14rpx;
  height: 14rpx;
  margin-right: 7rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.phone-copy-native-icon::after {
  position: absolute;
  top: -5rpx;
  left: 3rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  border-radius: 0 3rpx 0 0;
  content: "";
}

.phone-chip-invalid {
  border-color: rgba(221, 105, 82, 0.16);
  background: rgba(171, 68, 49, 0.07);
  color: #c47a69;
}

.phone-chip-invalid .phone-copy-label {
  color: #b86454;
}

.queue-date {
  display: flex;
  align-items: center;
  color: #9ca7b4;
}

.date-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 18rpx;
  height: 17rpx;
  margin-right: 8rpx;
  border: 2rpx solid #657a98;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.date-native-icon::before {
  position: absolute;
  top: 4rpx;
  right: 0;
  left: 0;
  height: 2rpx;
  background: #657a98;
  content: "";
}

.date-route {
  display: flex;
  align-items: center;
  width: 34rpx;
  margin: 0 8rpx;
}

.date-route-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, #5b83bd, rgba(91, 131, 189, 0.18));
}

.date-route-chevron {
  width: 6rpx;
  height: 6rpx;
  border-right: 2rpx solid #637fa7;
  border-bottom: 2rpx solid #637fa7;
  box-sizing: border-box;
  transform: rotate(-45deg);
}

.badge-row {
  flex-wrap: wrap;
  margin-top: 13rpx;
}

.queue-badge {
  margin: 0 8rpx 7rpx 0;
  background: rgba(118, 132, 151, 0.1);
  color: #929dab;
}

.badge-danger {
  background: rgba(221, 91, 70, 0.12);
  color: #e17b69;
}

.badge-warning {
  background: rgba(222, 143, 57, 0.12);
  color: #e4a05a;
}

.badge-primary {
  background: rgba(76, 135, 224, 0.12);
  color: #7faaf0;
}

.waiting-text {
  margin: 1rpx 0 7rpx auto;
  color: #647185;
  font-size: 15rpx;
}

.remark-preview,
.remark-add {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 15rpx 17rpx;
  border: 1rpx solid rgba(101, 131, 170, 0.1);
  border-radius: 14rpx;
  background: rgba(49, 67, 91, 0.055);
  transition: opacity 120ms ease, transform 120ms ease;
}

.remark-preview-label {
  flex-shrink: 0;
  color: #7f91a9;
  font-size: 15rpx;
  font-weight: 600;
}

.remark-preview-text {
  flex: 1;
  min-width: 0;
  margin-left: 13rpx;
  overflow: hidden;
  color: #a1acba;
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remark-edit {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 13rpx;
  color: #78a6e9;
  font-size: 15rpx;
}

.remark-preview-native-icon,
.remark-save-native-icon,
.manage-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 20rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.remark-preview-native-icon {
