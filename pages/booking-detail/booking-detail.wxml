<view class="detail-page" wx:if="{{booking.id}}">
  <view class="page-glow"></view>

  <view class="receipt-card ui-card">
    <view class="receipt-top">
      <view class="receipt-brand">
        <image class="brand-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
        <view>
          <view class="brand-kicker">EXTREME GARAGE</view>
          <view class="brand-title">预约确认单</view>
        </view>
      </view>
      <view class="booking-status ui-status ui-status-lg {{statusClass}}"><view class="booking-status-dot"></view><text>{{statusText}}</text></view>
    </view>

    <view class="receipt-divider">
      <view class="receipt-notch receipt-notch-left"></view>
      <view class="dashed-line"></view>
      <view class="receipt-notch receipt-notch-right"></view>
    </view>

    <view class="vehicle-label">RESERVED VEHICLE</view>
    <view class="booking-name">{{booking.vehicleName || "—"}}</view>
    <view wx:if="{{booking.vehicleReference}}" class="booking-vehicle-reference">{{booking.vehicleReference}}</view>

    <view class="journey-panel">
      <view class="journey-date">
        <view class="journey-label">取车日期</view>
        <view class="journey-value">{{booking.startDate || "—"}}</view>
      </view>
      <view class="journey-route">
        <view class="route-track">
          <view class="route-dot"></view>
          <view class="route-line"></view>
          <view class="route-arrow" aria-hidden="true">
            <view class="route-chevron"></view>
          </view>
        </view>
        <view class="route-span">{{journeySpanText}}</view>
      </view>
      <view class="journey-date journey-date-end">
        <view class="journey-label">还车日期</view>
        <view class="journey-value">{{booking.endDate || "—"}}</view>
      </view>
    </view>

    <view class="receipt-footer">
      <view>
        <view class="footer-label">取车城市</view>
        <view class="footer-value">{{booking.city || "—"}}</view>
      </view>
      <view class="receipt-code">
        <view class="code-label">BOOKING ID</view>
        <view class="code-row">
          <view class="code-value">{{bookingReference}}</view>
          <button class="copy-code-btn action-with-icon" bindtap="handleCopyBookingId" hover-class="copy-code-btn-pressed" aria-label="复制预约编号 {{bookingReference}}"><view class="copy-native-icon" aria-hidden="true"></view><text>复制</text></button>
        </view>
      </view>
    </view>
  </view>

  <view class="info-card ui-card">
    <view class="section-heading">
      <view>
        <view class="section-kicker">CONTACT</view>
        <view class="section-title">联系人信息</view>
      </view>
      <view class="section-side">
        <button
          wx:if="{{canEdit && !editing}}"
          class="edit-contact-btn ui-btn ui-btn-ghost"
          disabled="{{loading || saving || subscriptionRequesting || cancelling}}"
          bindtap="handleStartEdit"
        >
          <view class="edit-native-icon" aria-hidden="true"></view><text>修改</text>
        </button>
        <view class="section-index">01</view>
      </view>
    </view>
    <view wx:if="{{!editing}}" class="info-grid">
      <view class="info-item">
        <view class="info-label">联系人</view>
        <view class="info-value">{{booking.userName || "—"}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">手机号</view>
        <view class="info-value">{{booking.phone || "—"}}</view>
      </view>
    </view>
    <view wx:else class="edit-form">
      <view class="edit-field">
        <view class="edit-label">联系人</view>
        <input
          class="edit-input"
          maxlength="20"
          value="{{editForm.userName}}"
          placeholder="请输入联系人姓名"
          aria-label="联系人姓名"
          data-field="userName"
          disabled="{{loading || saving || subscriptionRequesting || cancelling}}"
          bindinput="handleEditInput"
          confirm-type="done"
        />
      </view>
      <view class="edit-field">
        <view class="edit-label">手机号</view>
        <input
          class="edit-input"
          type="number"
          maxlength="11"
          value="{{editForm.phone}}"
          placeholder="请输入 11 位手机号"
          aria-label="联系人手机号"
          data-field="phone"
          disabled="{{loading || saving || subscriptionRequesting || cancelling}}"
          bindinput="handleEditInput"
          confirm-type="done"
        />
      </view>
      <view class="edit-field">
        <view class="edit-label">取车城市</view>
        <input
          class="edit-input"
          maxlength="20"
          value="{{editForm.city}}"
          placeholder="请输入取车城市"
          aria-label="取车城市"
          data-field="city"
          disabled="{{loading || saving || subscriptionRequesting || cancelling}}"
          bindinput="handleEditInput"
          confirm-type="done"
        />
      </view>
      <view class="edit-field">
        <view class="edit-label">需求备注</view>
        <textarea
          class="edit-textarea"
          maxlength="200"
          value="{{editForm.note}}"
          placeholder="可留空，最多 200 字"
          aria-label="需求备注"
          data-field="note"
          disabled="{{loading || saving || subscriptionRequesting || cancelling}}"
          bindinput="handleEditInput"
        />
        <view class="edit-count">{{editForm.note.length || 0}} / 200</view>
      </view>
      <view class="edit-actions">
        <button class="edit-save-btn ui-btn ui-btn-primary action-with-icon" loading="{{saving}}" disabled="{{loading || saving || subscriptionRequesting || cancelling}}" bindtap="handleSaveEdit"><view wx:if="{{!saving}}" class="save-native-icon" aria-hidden="true"><view class="save-native-line"></view></view><text>{{saving ? '正在保存' : '保存修改'}}</text></button>
        <button class="edit-cancel-btn ui-btn ui-btn-ghost action-with-icon" disabled="{{loading || saving || subscriptionRequesting || cancelling}}" bindtap="handleCancelEdit"><view class="cancel-edit-native-icon" aria-hidden="true"></view><text>取消</text></button>
      </view>
      <view class="edit-tip tip-with-icon"><view class="tip-info-native-icon" aria-hidden="true"><view class="tip-info-mark"></view></view><view>只修改本次预约的联系信息，不会更改行程日期或车辆。</view></view>
    </view>
  </view>

  <view class="info-card ui-card">
    <view class="section-heading">
      <view>
        <view class="section-kicker">TIMELINE</view>
        <view class="section-title">预约进度</view>
      </view>
      <view class="section-index">02</view>
    </view>
    <view class="progress-track" aria-role="group" aria-label="预约进度，{{statusGuidance.title}}">
      <view class="progress-step {{item.stateClass}} {{item.isLast ? 'progress-step-last' : ''}}" wx:for="{{progressSteps}}" wx:key="key">
        <view class="progress-visual" aria-hidden="true">
          <view class="progress-node"><view wx:if="{{item.showCheck}}" class="progress-node-check" aria-hidden="true"></view><view wx:elif="{{item.showCancelledMark}}" class="progress-node-cancel" aria-hidden="true"></view><text wx:else>{{item.marker}}</text></view>
          <view wx:if="{{!item.isLast}}" class="progress-connector"></view>
        </view>
        <view class="progress-label">{{item.label}}</view>
      </view>
    </view>
    <view class="status-guidance status-guidance-{{statusGuidance.tone}}">
      <view class="status-guidance-native-icon" aria-hidden="true"><view class="status-guidance-icon-mark"></view></view>
      <view>
        <view class="status-guidance-title">{{statusGuidance.title}}</view>
        <view class="status-guidance-desc">{{statusGuidance.desc}}</view>
      </view>
    </view>
    <view class="timeline-meta">
      <view class="timeline-meta-item">
        <view class="timeline-meta-label">提交时间</view>
        <view class="timeline-meta-value">{{createdAtText || "—"}}</view>
      </view>
      <view class="timeline-meta-divider"></view>
      <view class="timeline-meta-item timeline-meta-item-end">
        <view class="timeline-meta-label">最近更新</view>
        <view class="timeline-meta-value">{{updatedAtText || '等待顾问更新'}}</view>
      </view>
    </view>
    <view wx:if="{{subscriptionEnabled && canEdit}}" class="subscription-panel">
      <view class="subscription-native-icon" aria-hidden="true"><view class="subscription-bell-clapper"></view></view>
      <view class="subscription-copy">
        <view class="subscription-title">接收下一次状态提醒</view>
        <view class="subscription-desc">一次授权通常对应一次通知，收到提醒后可再次订阅。</view>
      </view>
      <button
        class="subscription-btn ui-btn ui-btn-ghost"
        loading="{{subscriptionRequesting}}"
        disabled="{{loading || editing || saving || subscriptionRequesting || cancelling}}"
        bindtap="handleRequestStatusSubscription"
      >
        <view wx:if="{{!subscriptionRequesting}}" class="subscription-action-native-icon" aria-hidden="true"></view><text>{{subscriptionRequesting ? '正在订阅' : '立即订阅'}}</text>
      </button>
    </view>
  </view>

  <view wx:if="{{latestQuote.id}}" class="customer-quote-card ui-card">
    <view class="section-heading">
      <view>
        <view class="section-kicker">QUOTE v{{latestQuote.version}}</view>
        <view class="section-title">费用报价</view>
      </view>
      <view class="quote-valid">有效至 {{latestQuote.validUntil || '—'}}</view>
    </view>
    <view class="quote-rental-meta">{{latestQuote.rentalDays}} 个计费日 · {{booking.startDate}} 至 {{booking.endDate}}</view>
    <view class="quote-breakdown">
      <view class="quote-row"><text>基础租金</text><text>￥{{latestQuote.baseRentalText}}</text></view>
      <view class="quote-row"><text>保障 / 保险</text><text>￥{{latestQuote.protectionText}}</text></view>
      <view class="quote-row"><text>服务费</text><text>￥{{latestQuote.serviceFeeText}}</text></view>
      <view class="quote-row"><text>取送车费</text><text>￥{{latestQuote.deliveryFeeText}}</text></view>
      <view class="quote-row"><text>其他费用</text><text>￥{{latestQuote.otherFeeText}}</text></view>
      <view class="quote-total"><text>应付预估总额</text><text>￥{{latestQuote.totalText}}</text></view>
    </view>
    <view class="quote-rule"><view class="quote-rule-label">押金说明</view><view>{{latestQuote.depositText || '以顾问最终说明为准'}}</view></view>
    <view wx:if="{{latestQuote.customerNote}}" class="quote-rule"><view class="quote-rule-label">报价备注</view><view>{{latestQuote.customerNote}}</view></view>
    <view wx:if="{{latestQuote.adjustmentNote}}" class="quote-adjustment-summary"><view class="quote-rule-label">我的调整说明</view><view>{{latestQuote.adjustmentNote}}</view></view>
    <view class="quote-boundary">确认报价仅表示认可当前费用方案，不代表已经付款、签署合同或锁定车辆。</view>

    <view wx:if="{{booking.status === 'quoted' && latestQuote.status === 'sent'}}" class="quote-response">
      <button class="quote-confirm-btn ui-btn ui-btn-primary" loading="{{quoteResponding}}" disabled="{{loading || quoteResponding}}" bindtap="handleConfirmQuote">确认报价（尚未付款）</button>
      <view class="quote-adjustment-form">
        <view class="quote-rule-label">需要调整？</view>
        <textarea class="quote-adjustment-input" maxlength="200" value="{{adjustmentNote}}" disabled="{{loading || quoteResponding}}" bindinput="handleAdjustmentInput" placeholder="请说明需要调整的费用或安排" aria-label="报价调整说明" />
        <view class="quote-adjustment-count">{{adjustmentNote.length || 0}} / 200</view>
        <button class="quote-adjust-btn ui-btn ui-btn-ghost" loading="{{quoteResponding}}" disabled="{{loading || quoteResponding || !adjustmentNote}}" bindtap="handleRequestQuoteAdjustment">申请调整报价</button>
      </view>
    </view>
    <view wx:elif="{{booking.status === 'confirmed'}}" class="quote-response-state quote-response-confirmed">当前报价已确认，尚未付款。</view>
    <view wx:elif="{{booking.status === 'adjustment_requested'}}" class="quote-response-state quote-response-adjustment">调整申请已提交，请等待顾问重新报价。</view>
    <view wx:elif="{{latestQuote.status === 'expired'}}" class="quote-response-state">当前报价已失效，请联系顾问重新报价。</view>
  </view>

  <view wx:if="{{handovers.pickup.id || handovers.return.id}}" class="customer-handover-card ui-card">
    <view class="section-heading">
      <view><view class="section-kicker">VEHICLE HANDOVER</view><view class="section-title">车辆交接记录</view></view>
      <view class="section-index">核对现状</view>
    </view>
    <view class="handover-boundary">确认仅表示你核对了页面展示的车辆现状，不是电子签章、合同签署、自动定损、扣款或维修报价。</view>
    <view class="customer-handover-record" wx:for="{{handoverList}}" wx:key="id">
      <view class="handover-record-head"><text>{{item.stageText}}记录 v{{item.version}}</text><text class="handover-status handover-status-{{item.status}}">{{item.statusText}}</text></view>
      <view class="handover-record-meta">{{item.mileageKm}} km · {{item.energyText}} · {{item.submittedAtText || '—'}}</view>
      <view class="handover-record-note"><text>已知损伤</text><view>{{item.damageNote || '—'}}</view></view>
      <view wx:if="{{item.additionalNote}}" class="handover-record-note"><text>补充说明</text><view>{{item.additionalNote}}</view></view>
      <view wx:if="{{item.photos.length}}" class="customer-handover-photos">
        <image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="angle" src="{{photo.url}}" mode="aspectFill" lazy-load="{{true}}" fade-in="{{true}}" binderror="handleHandoverImageError" data-stage="{{item.stage}}" data-url="{{photo.url}}" bindtap="handlePreviewHandoverPhoto" hover-class="detail-action-pressed" aria-role="button" />
      </view>
      <button wx:if="{{item.status === 'submitted'}}" class="ui-btn ui-btn-primary handover-confirm-btn" loading="{{handoverResponding}}" disabled="{{loading || handoverResponding}}" data-stage="{{item.stage}}" bindtap="handleConfirmHandover">我已核对{{item.stageText}}记录</button>
      <view wx:if="{{item.confirmedAtText}}" class="handover-confirmed-time">已于 {{item.confirmedAtText}} 完成内容核对</view>
    </view>
    <button class="ui-btn ui-btn-danger-ghost emergency-call-btn" bindtap="handleEmergencyCall">一键拨打救援 / 紧急联系电话</button>
    <view class="emergency-boundary">电话将接通人工服务渠道；本页面不提供实时调度、定位跟踪或到达时间承诺。紧急人身危险请直接拨打 110 / 119 / 120。</view>
  </view>

  <view wx:if="{{booking.note && !editing}}" class="note-card ui-card">
    <view class="section-heading">
      <view>
        <view class="section-kicker">REQUEST</view>
        <view class="section-title section-title-with-icon"><view class="note-native-icon" aria-hidden="true"><view class="note-native-line"></view></view><text>需求备注</text></view>
      </view>
      <view class="section-index">03</view>
    </view>
    <view class="note-content">{{booking.note}}</view>
  </view>

  <view class="detail-actions-card ui-card">
    <view class="section-heading">
      <view>
        <view class="section-kicker">QUICK ACTIONS</view>
        <view class="section-title">继续操作</view>
      </view>
      <view class="section-index">{{booking.status === 'cancelled' ? '已结束' : '快捷入口'}}</view>
    </view>
    <view class="detail-action-buttons">
      <button
        wx:if="{{booking.vehicleId}}"
        class="detail-action-btn ui-btn ui-btn-ghost"
        bindtap="handleViewVehicle"
      ><view class="vehicle-native-icon" aria-hidden="true"><view class="vehicle-native-window"></view><view class="vehicle-native-wheel vehicle-native-wheel-left"></view><view class="vehicle-native-wheel vehicle-native-wheel-right"></view></view><text>查看车辆</text></button>
      <button class="detail-action-btn detail-action-btn-last ui-btn ui-btn-primary action-with-icon" bindtap="handleBackBookings"><view class="booking-list-native-icon" aria-hidden="true"><view class="booking-list-native-line booking-list-native-line-top"></view><view class="booking-list-native-line"></view></view><text>全部预约</text></button>
    </view>
    <view class="detail-action-note tip-with-icon"><view class="tip-info-native-icon" aria-hidden="true"><view class="tip-info-mark"></view></view><view>预约信息仅供本次服务核对，最终安排以顾问确认为准。</view></view>
  </view>

  <view wx:if="{{canCancel}}" class="actions">
    <view class="action-note tip-with-icon"><view class="tip-info-native-icon tip-info-native-icon-danger" aria-hidden="true"><view class="tip-info-mark"></view></view><view>如行程发生变化，可在顾问确认前取消预约</view></view>
    <button class="cancel-btn ui-btn ui-btn-danger-ghost action-with-icon" loading="{{cancelling}}" disabled="{{loading || editing || saving || subscriptionRequesting || cancelling}}" bindtap="handleCancel"><view wx:if="{{!cancelling}}" class="cancel-booking-native-icon" aria-hidden="true"></view><text>{{cancelling ? '正在取消' : '取消本次预约'}}</text></button>
  </view>
</view>

<view wx:elif="{{initialLoading || loading}}" class="detail-page detail-skeleton-page" aria-hidden="true">
  <view class="detail-skeleton-card ui-card">
    <view class="detail-skeleton-top">
      <view class="detail-skeleton-brand">
        <view class="detail-skeleton-emblem skeleton-pulse"></view>
        <view>
          <view class="detail-skeleton-kicker skeleton-pulse"></view>
          <view class="detail-skeleton-brand-title skeleton-pulse"></view>
        </view>
      </view>
      <view class="detail-skeleton-status skeleton-pulse"></view>
    </view>
    <view class="detail-skeleton-divider"></view>
    <view class="detail-skeleton-label skeleton-pulse"></view>
    <view class="detail-skeleton-title skeleton-pulse"></view>
    <view class="detail-skeleton-journey">
      <view class="detail-skeleton-date skeleton-pulse"></view>
      <view class="detail-skeleton-route skeleton-pulse"></view>
      <view class="detail-skeleton-date skeleton-pulse"></view>
    </view>
    <view class="detail-skeleton-footer">
      <view class="detail-skeleton-footer-item skeleton-pulse"></view>
      <view class="detail-skeleton-footer-item skeleton-pulse"></view>
    </view>
  </view>
  <view class="detail-skeleton-info ui-card">
    <view class="detail-skeleton-section-title skeleton-pulse"></view>
    <view class="detail-skeleton-info-grid">
      <view class="detail-skeleton-info-item skeleton-pulse"></view>
      <view class="detail-skeleton-info-item skeleton-pulse"></view>
    </view>
  </view>
</view>

<view wx:else class="detail-page state-page">
  <view class="state-card ui-card">
    <image class="state-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    <view class="state-title">预约详情</view>
    <view class="state-desc">{{loadFailed ? loadErrorText : '未找到该预约记录'}}</view>
    <button wx:if="{{loadFailed}}" class="retry-btn ui-btn ui-btn-primary action-with-icon" bindtap="handleRetryLoad"><view class="retry-native-icon" aria-hidden="true"></view><text>重新加载</text></button>
    <button class="back-btn ui-btn ui-btn-ghost action-with-icon" bindtap="handleBackBookings"><view class="back-native-icon" aria-hidden="true"></view><text>返回预约列表</text></button>
  </view>
</view>
