.coordination-native-mark::after {
  position: absolute;
  top: -3rpx;
  right: -1rpx;
  width: 6rpx;
  height: 6rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
