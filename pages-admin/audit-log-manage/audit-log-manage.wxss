@import "../../shared/management-shell.wxss";
.audit-page { padding: 24rpx calc(24rpx + env(safe-area-inset-right)) calc(60rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left)); box-sizing: border-box; color: #ffffff; min-height: 100vh; background: #101010; }
.header { margin-bottom: 18rpx; }
.title { font-size: 30rpx; font-weight: 600; line-height: 1.35; }
.desc { font-size: 22rpx; color: rgba(255, 255, 255, 0.7); margin-top: 8rpx; line-height: 1.6; word-break: break-word; }
.filter-card { margin-bottom: 18rpx; }
.keyword-input { width: 100%; height: 78rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 16rpx; }
.action-scroll-shell { margin-top: 18rpx; }
.action-scroll { white-space: nowrap; }
.action-list { display: flex; align-items: center; padding-right: 62rpx; }
.action-chip { margin-right: 16rpx; padding: 14rpx 24rpx; max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.actions { display: flex; gap: 14rpx; margin-top: 14rpx; }
.action-btn { flex: 1; min-width: 0; }
.export-actions { margin-top: 18rpx; padding: 18rpx; border: 1rpx solid rgba(82, 143, 255, 0.14); border-radius: 16rpx; background: rgba(82, 143, 255, 0.05); }
.export-tip { overflow: hidden; color: #8290a3; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.export-buttons { display: flex; gap: 12rpx; margin-top: 14rpx; }
.export-button { flex: 1; min-width: 0; height: 68rpx; border-radius: 15rpx; font-size: 19rpx; line-height: 68rpx; }
.result-count { margin-top: 16rpx; font-size: 22rpx; line-height: 1.5; color: rgba(255, 255, 255, 0.72); }
.loading { padding: 40rpx 0; text-align: center; color: rgba(255, 255, 255, 0.72); }
.log-item { margin-bottom: 16rpx; }
.log-head { display: flex; justify-content: space-between; align-items: flex-start; }
.log-action { font-size: 24rpx; font-weight: 600; line-height: 1.4; }
.log-time { font-size: 22rpx; color: rgba(255, 255, 255, 0.6); line-height: 1.4; margin-left: 16rpx; max-width: 45%; text-align: right; word-break: break-word; }
.log-openid { margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; color: rgba(255, 255, 255, 0.76); word-break: break-word; }
.log-summary { margin-top: 12rpx; font-size: 22rpx; line-height: 1.7; color: rgba(255, 255, 255, 0.68); white-space: pre-wrap; word-break: break-word; }
.load-more { padding: 10rpx 0 0; text-align: center; }
.load-more-btn { width: 100%; margin: 0; }
.load-more-end { display: flex; align-items: center; justify-content: center; padding: 20rpx 0 10rpx; font-size: 22rpx; line-height: 1.5; color: rgba(255, 255, 255, 0.6); }
.log-action-content { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; line-height: 1; }
.load-more-native-icon { width: 13rpx; height: 13rpx; margin-top: -6rpx; margin-right: 10rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; box-sizing: border-box; transform: rotate(45deg); }
.load-complete-native-icon { position: relative; width: 20rpx; height: 20rpx; margin-right: 8rpx; border: 2rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.load-complete-native-icon::after { position: absolute; top: 3rpx; left: 6rpx; width: 4rpx; height: 8rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; content: ""; transform: rotate(45deg); }
.empty { padding: 70rpx 24rpx; text-align: center; }
.empty-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; color: #ffffff; line-height: 1.35; }
.empty-desc { font-size: 24rpx; line-height: 1.6; word-break: break-word; color: rgba(255, 255, 255, 0.72); }
.audit-page.management-page .header,
.audit-page.management-page .filter-card,
.audit-page.management-page .log-item,
.audit-page.management-page .empty { margin-bottom: 20rpx; border-color: rgba(255, 255, 255, 0.075); border-radius: 26rpx; }
.audit-page.management-page .filter-card { padding: 28rpx; background: #15181d; }
.audit-page.management-page .keyword-input { height: 82rpx; }
.audit-page.management-page .action-chip { min-height: 60rpx; padding: 13rpx 21rpx; }
.audit-page.management-page .action-btn { height: 82rpx; border-radius: 18rpx; line-height: 82rpx; }
.audit-page.management-page .log-item { position: relative; padding: 26rpx; overflow: hidden; background: linear-gradient(145deg, #181d24, #14171c 74%); }
.audit-page.management-page .log-item::before { position: absolute; top: 26rpx; left: 0; width: 5rpx; height: 50rpx; border-radius: 0 999rpx 999rpx 0; background: #528fff; content: ""; }
.audit-page.management-page .log-action { display: -webkit-box; min-width: 0; overflow: hidden; line-height: 1.35; color: #eaf0f8; font-size: 28rpx; text-overflow: ellipsis; word-break: break-word; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.audit-page.management-page .log-summary { color: #9aa4b1; font-size: 21rpx; }
.audit-page.management-page .actions { margin-top: 18rpx; }
.audit-page.management-page .action-btn,
.audit-page.management-page .export-button,
.audit-page.management-page .empty-reset-btn { display: flex; align-items: center; justify-content: center; }
.button-native-icon,
.export-action-icon,
.reset-native-icon { position: relative; flex-shrink: 0; width: 25rpx; height: 25rpx; margin-right: 11rpx; color: currentColor; box-sizing: border-box; }
.query-native-icon { width: 22rpx; height: 22rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.query-native-icon::after { position: absolute; right: -7rpx; bottom: -4rpx; width: 9rpx; height: 2rpx; border-radius: 2rpx; background: currentColor; content: ""; transform: rotate(45deg); transform-origin: left center; }
.export-native-icon::before { position: absolute; top: 1rpx; left: 11rpx; width: 3rpx; height: 15rpx; border-radius: 3rpx; background: currentColor; content: ""; }
.export-native-icon::after { position: absolute; top: 7rpx; left: 6rpx; width: 11rpx; height: 11rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; content: ""; transform: rotate(45deg); }
.audit-page.management-page .export-actions { padding: 20rpx; border-color: rgba(82, 143, 255, 0.18); background: linear-gradient(135deg, rgba(82, 143, 255, 0.08), rgba(82, 143, 255, 0.025)); }
.audit-page.management-page .export-tip { display: flex; align-items: center; overflow: visible; text-overflow: clip; white-space: normal; }
.file-native-icon { position: relative; flex-shrink: 0; width: 38rpx; height: 46rpx; margin-right: 16rpx; border: 2rpx solid #72a5f2; border-radius: 7rpx; box-sizing: border-box; }
.file-native-icon::before { position: absolute; top: -2rpx; right: -2rpx; width: 13rpx; height: 13rpx; border-bottom: 2rpx solid #72a5f2; border-left: 2rpx solid #72a5f2; background: #171d25; content: ""; }
.file-native-icon::after { position: absolute; bottom: 10rpx; left: 8rpx; width: 18rpx; height: 2rpx; border-radius: 2rpx; background: #72a5f2; box-shadow: 0 -8rpx 0 #72a5f2; content: ""; }
.export-tip-copy { flex: 1; min-width: 0; }
.export-tip-label { color: #a6c2eb; font-size: 21rpx; font-weight: 600; line-height: 1.4; }
.export-tip-name { margin-top: 4rpx; overflow: hidden; color: #718098; font-family: monospace; font-size: 17rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.audit-page.management-page .export-button-danger { border-color: rgba(202, 88, 101, 0.18); color: #bd7b84; }
.share-native-icon::before,
.share-native-icon::after { position: absolute; width: 8rpx; height: 8rpx; border: 2rpx solid currentColor; border-radius: 50%; content: ""; }
.share-native-icon::before { top: 1rpx; right: 1rpx; box-shadow: -14rpx 16rpx 0 -2rpx #151a21; }
.share-native-icon::after { right: 1rpx; bottom: 1rpx; }
.share-native-icon { border-bottom: 2rpx solid currentColor; transform: rotate(-30deg) scale(0.86); }
.open-native-icon { margin-top: 3rpx; border: 2rpx solid currentColor; border-radius: 4rpx; }
.open-native-icon::before { position: absolute; top: -7rpx; left: 2rpx; width: 10rpx; height: 7rpx; border: 2rpx solid currentColor; border-bottom: 0; border-radius: 4rpx 4rpx 0 0; content: ""; }
.delete-native-icon::before { position: absolute; top: 7rpx; left: 5rpx; width: 15rpx; height: 16rpx; border: 2rpx solid currentColor; border-top: 0; border-radius: 0 0 4rpx 4rpx; content: ""; }
.delete-native-icon::after { position: absolute; top: 3rpx; left: 3rpx; width: 19rpx; height: 2rpx; border-radius: 2rpx; background: currentColor; box-shadow: 6rpx -4rpx 0 -1rpx currentColor; content: ""; }
.filter-result-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; padding: 16rpx 18rpx; border: 1rpx solid rgba(255, 255, 255, 0.055); border-radius: 15rpx; background: rgba(8, 11, 15, 0.32); }
.filter-result-state { display: flex; align-items: center; color: #69768a; font-size: 18rpx; }
.filter-result-dot { width: 8rpx; height: 8rpx; margin-right: 9rpx; border-radius: 50%; background: #528fff; box-shadow: 0 0 12rpx rgba(82, 143, 255, 0.5); }
.filter-result-value { min-width: 0; margin-left: 16rpx; overflow: hidden; color: #a5b3c7; font-size: 19rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.result-warning { display: flex; align-items: flex-start; margin-top: 13rpx; padding: 14rpx 16rpx; border: 1rpx solid rgba(214, 164, 83, 0.15); border-radius: 14rpx; background: rgba(214, 164, 83, 0.05); color: #aa9169; font-size: 18rpx; line-height: 1.55; }
.warning-native-icon { position: relative; flex-shrink: 0; width: 22rpx; height: 22rpx; margin: 2rpx 11rpx 0 0; border: 2rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.warning-native-icon::before,
.warning-native-icon::after { position: absolute; left: 8rpx; width: 2rpx; border-radius: 2rpx; background: currentColor; content: ""; }
.warning-native-icon::before { top: 4rpx; height: 7rpx; }
.warning-native-icon::after { bottom: 3rpx; height: 2rpx; }
.audit-timeline { position: relative; }
.timeline-item { display: flex; align-items: stretch; }
.timeline-rail { position: relative; flex: 0 0 58rpx; }
.timeline-marker { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-top: 20rpx; border: 1rpx solid rgba(82, 143, 255, 0.26); border-radius: 14rpx; background: #172131; color: #72a5f2; box-shadow: 0 0 0 7rpx #0e1116; box-sizing: border-box; }
.timeline-line { position: absolute; top: 64rpx; bottom: -20rpx; left: 21rpx; width: 2rpx; background: linear-gradient(180deg, rgba(82, 143, 255, 0.25), rgba(82, 143, 255, 0.04)); }
.audit-page.management-page .timeline-item .log-item { flex: 1; min-width: 0; margin-bottom: 18rpx; }
.audit-page.management-page .timeline-item .log-item::before { display: none; }
.audit-page.management-page .log-head { align-items: flex-start; }
.log-title-copy { flex: 1; min-width: 0; }
.audit-page.management-page .log-kind { display: inline-flex; margin: 0 0 10rpx; }
.audit-page.management-page .log-kind-dot { background: currentColor; box-shadow: 0 0 10rpx currentColor; }

.log-action-code { margin-top: 4rpx; overflow: hidden; color: #536177; font-family: monospace; font-size: 16rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.audit-page.management-page .log-time { display: flex; align-items: center; flex-shrink: 0; margin-top: 3rpx; color: #69768a; font-size: 19rpx; line-height: 1.35; }
.time-native-icon { position: relative; flex-shrink: 0; width: 20rpx; height: 20rpx; margin-right: 7rpx; border: 2rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.time-native-icon::before,
.time-native-icon::after { position: absolute; top: 4rpx; left: 8rpx; width: 2rpx; border-radius: 2rpx; background: currentColor; content: ""; transform-origin: 1rpx 5rpx; }
.time-native-icon::before { height: 6rpx; }
.time-native-icon::after { height: 5rpx; transform: rotate(125deg); }
.audit-page.management-page .log-openid { display: flex; align-items: center; margin-top: 20rpx; padding: 15rpx 17rpx; border-radius: 14rpx; background: rgba(255, 255, 255, 0.025); color: #8290a3; font-family: monospace; font-size: 19rpx; }
.operator-native-icon { position: relative; flex-shrink: 0; width: 34rpx; height: 34rpx; margin-right: 14rpx; border: 1rpx solid rgba(112, 154, 222, 0.22); border-radius: 50%; background: rgba(82, 143, 255, 0.07); box-sizing: border-box; }
.operator-native-icon::before { position: absolute; top: 6rpx; left: 11rpx; width: 10rpx; height: 10rpx; border: 2rpx solid #718fbb; border-radius: 50%; box-sizing: border-box; content: ""; }
.operator-native-icon::after { position: absolute; bottom: 5rpx; left: 7rpx; width: 18rpx; height: 9rpx; border: 2rpx solid #718fbb; border-bottom: 0; border-radius: 12rpx 12rpx 0 0; box-sizing: border-box; content: ""; }
.log-openid-copy { min-width: 0; }
.log-meta-label,
.log-detail-label { color: #5f6c80; font-family: sans-serif; font-size: 16rpx; font-weight: 600; line-height: 1.4; letter-spacing: 1rpx; }
.log-openid-value { margin-top: 3rpx; overflow: hidden; color: #8d9bb0; font-family: monospace; font-size: 18rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.log-detail-grid { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 13rpx; }
.log-detail-item { flex: 1 1 42%; min-width: 0; padding: 14rpx 16rpx; border: 1rpx solid rgba(255, 255, 255, 0.045); border-radius: 14rpx; background: rgba(255, 255, 255, 0.018); box-sizing: border-box; }
.log-detail-value { margin-top: 5rpx; color: #aab4c2; font-size: 19rpx; line-height: 1.5; word-break: break-word; }
.audit-event-access .timeline-marker { border-color: rgba(150, 112, 221, 0.3); background: #211b2d; color: #aa8ddd; }
.audit-event-vehicle .timeline-marker { border-color: rgba(72, 161, 207, 0.28); background: #14242d; color: #67aed3; }
.audit-event-booking .timeline-marker { border-color: rgba(82, 143, 255, 0.3); background: #172131; color: #72a5f2; }
.audit-event-privacy .timeline-marker { border-color: rgba(72, 174, 145, 0.28); background: #142721; color: #69b99f; }
.audit-event-operation .timeline-marker { border-color: rgba(204, 157, 77, 0.27); background: #292318; color: #c9a15e; }
.audit-event-access .log-kind { border-color: rgba(150, 112, 221, 0.24); background: rgba(150, 112, 221, 0.08); color: #aa8ddd; }
.audit-event-vehicle .log-kind { border-color: rgba(72, 161, 207, 0.23); background: rgba(72, 161, 207, 0.07); color: #67aed3; }
.audit-event-booking .log-kind { color: #7eaaf1; }
.audit-event-privacy .log-kind { border-color: rgba(72, 174, 145, 0.23); background: rgba(72, 174, 145, 0.07); color: #69b99f; }
.audit-event-operation .log-kind { border-color: rgba(204, 157, 77, 0.22); background: rgba(204, 157, 77, 0.07); color: #c9a15e; }
.audit-event-icon-access { width: 17rpx; height: 20rpx; border: 2rpx solid currentColor; border-radius: 6rpx 6rpx 9rpx 9rpx; box-sizing: border-box; }
.audit-event-icon-access::after { position: absolute; bottom: 4rpx; left: 5rpx; width: 4rpx; height: 4rpx; border-radius: 50%; background: currentColor; content: ""; }
.audit-event-icon-vehicle { width: 24rpx; height: 12rpx; margin-top: 5rpx; border: 2rpx solid currentColor; border-radius: 5rpx; box-sizing: border-box; }
.audit-event-icon-vehicle::before { position: absolute; top: -7rpx; left: 4rpx; width: 13rpx; height: 8rpx; border: 2rpx solid currentColor; border-bottom: 0; border-radius: 6rpx 6rpx 0 0; box-sizing: border-box; content: ""; }
.audit-event-icon-vehicle::after { position: absolute; bottom: -5rpx; left: 3rpx; width: 4rpx; height: 4rpx; border-radius: 50%; background: currentColor; box-shadow: 12rpx 0 0 currentColor; content: ""; }
.audit-event-icon-booking { width: 22rpx; height: 20rpx; margin-top: 2rpx; border: 2rpx solid currentColor; border-radius: 4rpx; box-sizing: border-box; }
.audit-event-icon-booking::before { position: absolute; top: 4rpx; left: 0; width: 18rpx; height: 2rpx; background: currentColor; content: ""; }
.audit-event-icon-booking::after { position: absolute; top: -4rpx; left: 4rpx; width: 2rpx; height: 6rpx; border-radius: 2rpx; background: currentColor; box-shadow: 8rpx 0 0 currentColor; content: ""; }
.audit-event-icon-privacy { width: 20rpx; height: 15rpx; margin-top: 7rpx; border: 2rpx solid currentColor; border-radius: 4rpx; box-sizing: border-box; }
.audit-event-icon-privacy::before { position: absolute; top: -10rpx; left: 4rpx; width: 8rpx; height: 10rpx; border: 2rpx solid currentColor; border-bottom: 0; border-radius: 8rpx 8rpx 0 0; box-sizing: border-box; content: ""; }
.audit-event-icon-operation { width: 23rpx; height: 18rpx; border-top: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; box-sizing: border-box; }
.audit-event-icon-operation::before { position: absolute; top: 7rpx; left: 0; width: 23rpx; height: 2rpx; background: currentColor; content: ""; }
.audit-event-icon-operation::after { position: absolute; top: -4rpx; left: 5rpx; width: 5rpx; height: 5rpx; border: 2rpx solid currentColor; border-radius: 50%; background: #292318; box-shadow: 9rpx 8rpx 0 -1rpx #292318, 9rpx 8rpx 0 1rpx currentColor, 0 16rpx 0 -1rpx #292318, 0 16rpx 0 1rpx currentColor; content: ""; }
.audit-event-icon { position: relative; box-sizing: border-box; }
.audit-page.management-page .empty-reset-btn { width: 100%; height: 76rpx; margin-top: 24rpx; color: #8e9fb8; line-height: 76rpx; }
.reset-native-icon { width: 21rpx; height: 21rpx; border: 2rpx solid currentColor; border-right-color: transparent; border-radius: 50%; }
.reset-native-icon::after { position: absolute; top: -4rpx; right: -2rpx; width: 7rpx; height: 7rpx; border-top: 2rpx solid currentColor; border-right: 2rpx solid currentColor; content: ""; transform: rotate(18deg); }
