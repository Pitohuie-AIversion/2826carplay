.detail-page {
  min-height: 100vh;
  padding-bottom: 210rpx;
  background: linear-gradient(180deg, #121722 0%, #0b0d10 620rpx);
}

.hero-shell,
.hero-swiper {
  position: relative;
  height: 480rpx;
  overflow: hidden;
  background: #15181d;
}

.hero-image {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #20242c, #0e1013);
  opacity: 0;
  transition: opacity 360ms ease;
}

.hero-image-frame {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #15181d;
}

.hero-image-loaded {
  opacity: 1;
}

.hero-image-loading,
.hero-image-fallback {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.hero-image-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background:
    radial-gradient(circle at 72% 35%, rgba(66, 124, 214, 0.18), transparent 34%),
    linear-gradient(135deg, #1d2735, #0d1218);
}

.hero-image-loading::after {
  position: absolute;
  top: -100rpx;
  left: -190rpx;
  width: 150rpx;
  height: 650rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.065), transparent);
  content: "";
  transform: rotate(22deg);
  animation: heroImageSweep 1.6s ease-in-out infinite;
}

.hero-image-loading-ring {
  width: 66rpx;
  height: 66rpx;
  border: 2rpx solid rgba(115, 158, 225, 0.17);
  border-top-color: rgba(115, 158, 225, 0.64);
  border-radius: 50%;
  animation: heroImageSpin 1.15s linear infinite;
}

.hero-image-loading-text {
  margin-top: 18rpx;
  color: rgba(153, 181, 224, 0.52);
  font-size: 14rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 3rpx;
}

.hero-image-fallback {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
  padding: 46rpx 30rpx;
  background:
    radial-gradient(circle at 75% 36%, rgba(61, 119, 210, 0.27), transparent 34%),
    linear-gradient(135deg, #202b3b, #0c1118);
  box-sizing: border-box;
}

.hero-placeholder {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 46rpx 30rpx;
  background: radial-gradient(circle at 75% 36%, rgba(61, 119, 210, 0.27), transparent 34%), linear-gradient(135deg, #202b3b, #0c1118);
  box-sizing: border-box;
}

.hero-placeholder-brand {
  color: rgba(178, 199, 231, 0.66);
  font-size: 19rpx;
  line-height: 1.4;
  letter-spacing: 3rpx;
}

.hero-placeholder-name {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-placeholder-text {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 23rpx;
  line-height: 1.6;
}

.hero-shade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 220rpx;
  background: linear-gradient(180deg, transparent, rgba(8, 10, 13, 0.72));
  pointer-events: none;
  z-index: 2;
}

.hero-signature {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  display: flex;
  align-items: center;
  color: rgba(219, 228, 242, 0.7);
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 3rpx;
  z-index: 3;
}

.hero-counter {
  position: absolute;
  right: 26rpx;
  bottom: 25rpx;
  z-index: 3;
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-width: 92rpx;
  padding: 9rpx 13rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  background: rgba(7, 10, 14, 0.5);
  color: rgba(218, 225, 235, 0.66);
  font-size: 15rpx;
  line-height: 1;
  box-sizing: border-box;
}

.hero-counter-current {
  color: #f3f6fa;
  font-size: 19rpx;
  font-weight: 650;
}

.hero-counter-divider {
  margin: 0 7rpx;
  color: #6682aa;
}

.signature-line {
  width: 30rpx;
  height: 2rpx;
  margin-right: 12rpx;
  background: #5d96f6;
}

@keyframes heroImageSweep {
  0% {
    left: -220rpx;
  }

  100% {
    left: 820rpx;
  }
}

@keyframes heroImageSpin {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

.summary-card,
.notice-card,
.info-card,
.empty-page {
  margin: 22rpx 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 26rpx;
  background: #15181d;
  box-sizing: border-box;
  box-shadow: 0 20rpx 44rpx rgba(0, 0, 0, 0.2);
}

.summary-card {
  position: relative;
  z-index: 2;
  margin-top: -24rpx;
  border-color: rgba(108, 151, 221, 0.14);
  background: linear-gradient(145deg, #1a202a, #14171c 70%);
}

.summary-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-identity {
  flex: 1;
  min-width: 0;
}

.summary-kicker {
  color: #657996;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.car-name {
  margin-top: 9rpx;
  color: #f7f9fc;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-word;
}

.car-nickname {
  margin-top: 8rpx;
  color: #929ba8;
  font-size: 23rpx;
  line-height: 1.65;
}

.car-status {
  flex-shrink: 0;
  max-width: 180rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.summary-actions {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.favorite-button {
  min-width: 116rpx;
  height: 52rpx;
  margin: 14rpx 0 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.22);
  border-radius: 999rpx;
  background: rgba(84, 143, 255, 0.07);
  color: #8aabdd;
  font-size: 18rpx;
  line-height: 52rpx;
}

.favorite-button-active {
  border-color: rgba(117, 170, 255, 0.4);
  background: linear-gradient(135deg, rgba(77, 137, 234, 0.24), rgba(55, 105, 189, 0.16));
  color: #a9c9ff;
  box-shadow: 0 0 18rpx rgba(80, 140, 236, 0.12);
}

.price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.price-label {
  color: #77818f;
  font-size: 18rpx;
  line-height: 1.3;
}

.car-price {
  margin-top: 5rpx;
  color: #f7f9fc;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.price-note {
  padding-bottom: 4rpx;
  color: #5f6874;
  font-size: 18rpx;
  line-height: 1.4;
}

.tag-list {
  margin-top: 20rpx;
}

.tag-item {
  display: inline-block;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  padding: 9rpx 16rpx;
  max-width: 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 999rpx;
  color: #bec5cf;
  font-size: 19rpx;
  line-height: 1.3;
  background: rgba(255, 255, 255, 0.035);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-card {
  border-color: rgba(64, 126, 225, 0.2);
  background: linear-gradient(135deg, rgba(35, 67, 116, 0.28), rgba(19, 24, 31, 0.96));
}

.section-heading {
  display: flex;
  align-items: center;
}

.section-mark {
  width: 6rpx;
  height: 24rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #528fff;
  box-shadow: 0 0 18rpx rgba(82, 143, 255, 0.4);
}

.notice-title,
.section-title {
  color: #f5f7fa;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.45;
}

.notice-text,
.section-text {
  margin-top: 16rpx;
  color: #9ca5b2;
  font-size: 23rpx;
  line-height: 1.78;
}

.notice-text {
  color: #b9cceb;
}

.rental-tip {
  position: relative;
  padding-left: 24rpx;
}

.rental-tip::before {
  position: absolute;
  top: 17rpx;
  left: 2rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #4e87e8;
  content: "";
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 22rpx;
}

.info-item {
  width: 48.5%;
  margin-bottom: 14rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.065);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.028);
}

.info-label {
  color: #697381;
  font-size: 19rpx;
  line-height: 1.5;
}

.info-value {
  margin-top: 8rpx;
  color: #eef1f5;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.45;
  word-break: break-all;
}

.detail-bottom-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 20;
  display: flex;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 28rpx;
  background: rgba(19, 22, 27, 0.95);
  box-shadow: 0 22rpx 60rpx rgba(0, 0, 0, 0.42);
  box-sizing: border-box;
}

.action-button {
  flex: 1;
  height: 88rpx;
  padding: 0 14rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
  line-height: 88rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-button-offset {
  margin-left: 12rpx;
}

.empty-action {
  height: 88rpx;
  margin-top: 24rpx;
  font-size: 25rpx;
  line-height: 88rpx;
}

.empty-page {
  margin-top: 48rpx;
  text-align: center;
}

.empty-title {
  color: #f5f7fa;
  font-size: 30rpx;
  line-height: 1.4;
}

.empty-desc {
  margin-top: 16rpx;
  color: #929ba8;
  font-size: 24rpx;
  line-height: 1.65;
}

.detail-loading-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
  background: linear-gradient(180deg, #121722 0%, #0b0d10 620rpx);
}

.detail-loading-hero {
  height: 480rpx;
}

.detail-loading-card {
  margin: -42rpx 24rpx 0;
  padding: 34rpx 30rpx;
}

.detail-loading-info {
  margin-top: 22rpx;
}

.detail-loading-kicker,
.detail-loading-subtitle,
.detail-loading-section-title,
.detail-loading-line,
.detail-loading-price {
  border-radius: 9rpx;
}

.detail-loading-kicker {
  width: 230rpx;
  height: 18rpx;
}

.detail-loading-title {
  width: 72%;
  height: 48rpx;
  margin-top: 20rpx;
  border-radius: 12rpx;
}

.detail-loading-subtitle {
  width: 46%;
  height: 22rpx;
  margin-top: 18rpx;
}

.detail-loading-divider {
  height: 1rpx;
  margin: 30rpx 0;
  background: rgba(255, 255, 255, 0.07);
}

.detail-loading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-loading-price {
  width: 190rpx;
  height: 38rpx;
}

.detail-loading-status {
  width: 108rpx;
  height: 52rpx;
  border-radius: 999rpx;
}

.detail-loading-section-title {
  width: 150rpx;
  height: 28rpx;
}

.detail-loading-line {
  width: 100%;
  height: 20rpx;
  margin-top: 28rpx;
}

.detail-loading-line-short {
  width: 68%;
  margin-top: 16rpx;
}

.skeleton-pulse {
  background: linear-gradient(105deg, #181c22 12%, #262d37 34%, #181c22 56%);
  background-size: 220% 100%;
  animation: detailSkeletonPulse 1.6s ease-in-out infinite;
}

@keyframes detailSkeletonPulse {
  0% {
    background-position: 160% 0;
  }

  100% {
    background-position: -70% 0;
  }
}
