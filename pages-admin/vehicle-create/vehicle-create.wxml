<view wx:if="{{pageAuthorized}}" class="vehicle-create-page vehicle-form-page">
  <view class="page-glow"></view>
  <view class="hero-card">
    <view class="hero-top">
      <view>
        <view class="page-kicker">FLEET ONBOARDING</view>
        <view class="page-title">新增车辆</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    </view>
    <view class="page-desc">录入车辆档案，创建成功后可继续上传车辆图片</view>
    <view class="vehicle-form-progress {{formProgress.ready ? 'vehicle-form-progress-ready' : ''}}" aria-role="group" aria-label="车辆必填信息完成度 {{formProgress.completed}} / {{formProgress.total}}，{{formProgress.hint}}">
      <view class="vehicle-form-progress-head">
        <view class="vehicle-form-progress-title">必填信息完成度</view>
        <view class="vehicle-form-progress-value">{{formProgress.completed}} / {{formProgress.total}}</view>
      </view>
      <view class="vehicle-form-progress-track" aria-hidden="true"><view class="vehicle-form-progress-fill" style="width: {{formProgress.percent}}%;"></view></view>
      <view class="vehicle-form-progress-hint">
        <view class="vehicle-form-progress-icon" aria-hidden="true"><view class="vehicle-form-progress-check"></view></view>
        <text>{{formProgress.hint}}</text>
      </view>
    </view>
  </view>
  <view class="tip-card">
    <view class="tip-mark" aria-hidden="true">
      <view class="tip-info-icon"></view>
    </view>
    <view>
      <view class="tip-title">图片上传说明</view>
      <view class="tip-desc">提交车辆后可立即进入图片管理，设置首页封面与车辆相册。</view>
    </view>
  </view>
  <view class="form-card">
    <view class="section-heading">
      <view class="section-heading-main">
        <view class="vehicle-section-glyph vehicle-section-glyph-identity" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
        <view>
          <view class="section-kicker">IDENTITY</view>
          <view class="section-title">车辆身份</view>
        </view>
      </view>
      <view class="section-index">01</view>
    </view>
    <view class="form-divider"></view>
    <view class="form-row">
      <view class="form-item form-item-half">
        <view class="form-label field-label-row"><text>车牌号</text><text class="field-required">必填</text></view>
        <input
          class="form-input {{formProgress.plateNumberComplete ? 'vehicle-form-control-complete' : ''}}"
          placeholder="京A12345"
          placeholder-class="input-placeholder"
          value="{{form.plateNumber}}"
          maxlength="8"
          disabled="{{isSubmitting}}"
          bindinput="handlePlateInput"
          confirm-type="next"
          aria-label="填写车牌号"
          aria-required="{{true}}"
        />
      </view>
      <view class="form-item form-item-half">
        <view class="form-label field-label-row"><text>车辆类型</text><text class="field-required">必填</text></view>
        <picker mode="selector" range="{{vehicleTypeLabels}}" value="{{vehicleTypeIndex}}" disabled="{{isSubmitting}}" bindchange="handleVehicleTypeChange" aria-label="选择车辆类型" aria-required="{{true}}">
          <view class="form-picker {{form.vehicleType ? 'form-picker-filled' : ''}} {{formProgress.vehicleTypeComplete ? 'vehicle-form-control-complete' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{vehicleTypeLabel || '选择类型'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
      </view>
    </view>
    <view class="form-item">
      <view class="form-label field-label-row"><text>品牌型号</text><text class="field-required">必填</text></view>
      <input
        class="form-input {{formProgress.brandModelComplete ? 'vehicle-form-control-complete' : ''}}"
        placeholder="例如 BMW 740Li"
        placeholder-class="input-placeholder"
        value="{{form.brandModel}}"
        maxlength="50"
        data-field="brandModel"
        disabled="{{isSubmitting}}"
        bindinput="handleTextInput"
        confirm-type="done"
        aria-label="填写车辆品牌型号"
        aria-required="{{true}}"
      />
    </view>
    <view class="form-row">
      <view class="form-item form-item-half">
        <view class="form-label field-label-row"><text>注册日期</text><text class="field-required">必填</text></view>
        <picker mode="date" value="{{form.registerDate}}" end="{{today}}" disabled="{{isSubmitting}}" bindchange="handleDateChange" aria-label="选择注册日期" aria-required="{{true}}">
          <view class="form-picker {{form.registerDate ? 'form-picker-filled' : ''}} {{formProgress.registerDateComplete ? 'vehicle-form-control-complete' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{form.registerDate || '选择日期'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
      </view>
      <view class="form-item form-item-half">
        <view class="form-label field-label-row"><text>使用状态</text><text class="field-required">必填</text></view>
        <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" disabled="{{isSubmitting}}" bindchange="handleStatusChange" aria-label="选择使用状态" aria-required="{{true}}">
          <view class="form-picker {{form.status ? 'form-picker-filled' : ''}} {{formProgress.statusComplete ? 'vehicle-form-control-complete' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{statusLabel || '选择状态'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
      </view>
    </view>
  </view>
  <view class="form-card">
    <view class="section-heading">
      <view class="section-heading-main">
        <view class="vehicle-section-glyph vehicle-section-glyph-rental" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
        <view>
          <view class="section-kicker">RENTAL PROFILE</view>
          <view class="section-title">展示与租赁</view>
        </view>
      </view>
      <view class="section-index">02</view>
    </view>
    <view class="form-divider"></view>
    <view class="section-helper">选填信息 · 完善后将用于车库前台展示</view>
    <view class="form-row">
      <view class="form-item form-item-half">
        <view class="form-label">取车城市</view>
        <input class="form-input" placeholder="例如 杭州" placeholder-class="input-placeholder" value="{{form.location}}" maxlength="20" data-field="location" disabled="{{isSubmitting}}" bindinput="handleTextInput" confirm-type="done" aria-label="所在城市" />
      </view>
      <view class="form-item form-item-half">
        <view class="form-label">日租金</view>
        <input class="form-input" type="number" placeholder="例如 699" placeholder-class="input-placeholder" value="{{form.priceDay}}" maxlength="5" data-field="priceDay" disabled="{{isSubmitting}}" bindinput="handleTextInput" confirm-type="done" aria-label="日租价格" />
      </view>
    </view>
    <view class="rental-discount-form">
      <view class="rental-discount-title">连租折扣（管理员自定义）</view>
      <view class="rental-discount-help">仅对本车生效。满天数后整段租金打折，多档不叠加，按达到的最高天数档执行。全部删除则不优惠。</view>
      <view class="rental-discount-row" wx:for="{{discountRows}}" wx:key="index">
        <text>满</text>
        <input class="rental-discount-input" type="number" value="{{item.minDays}}" data-index="{{index}}" data-field="minDays" bindinput="handleDiscountTierInput" disabled="{{isSubmitting}}" maxlength="2" confirm-type="done" placeholder="天数" aria-label="连租最低天数" />
        <text>天，打</text>
        <input class="rental-discount-input" type="digit" value="{{item.discount}}" data-index="{{index}}" data-field="discount" bindinput="handleDiscountTierInput" disabled="{{isSubmitting}}" maxlength="3" confirm-type="done" placeholder="9.5" aria-label="连租折扣数" />
        <text>折</text>
        <button class="rental-discount-remove" data-index="{{index}}" bindtap="handleRemoveDiscountTier" disabled="{{isSubmitting}}" aria-label="删除本档折扣">删除</button>
      </view>
      <view class="rental-discount-help">天数 2-90，折扣 0.1-9.9（9.5 折即原价的 95%），最多 8 档。</view>
      <button class="rental-discount-add" wx:if="{{discountRows.length < 8}}" bindtap="handleAddDiscountTier" disabled="{{isSubmitting}}">添加连租折扣</button>
    </view>
    <view class="form-row">
      <view class="form-item form-item-half">
        <view class="form-label">变速箱</view>
        <picker mode="selector" range="{{transmissionLabels}}" value="{{transmissionIndex}}" disabled="{{isSubmitting}}" bindchange="handleTransmissionChange" aria-label="选择变速箱类型">
          <view class="form-picker {{form.transmission ? 'form-picker-filled' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{transmissionLabel || '选择类型'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
        <view wx:if="{{form.transmission}}" class="section-helper" data-field="transmission" bindtap="handleClearOptionalField" hover-class="control-hover" aria-role="button" aria-label="清空变速箱">清空变速箱</view>
      </view>
      <view class="form-item form-item-half">
        <view class="form-label">燃油类型</view>
        <picker mode="selector" range="{{fuelTypeLabels}}" value="{{fuelTypeIndex}}" disabled="{{isSubmitting}}" bindchange="handleFuelTypeChange" aria-label="选择燃油类型">
          <view class="form-picker {{form.fuelType ? 'form-picker-filled' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{fuelTypeLabel || '选择类型'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
        <view wx:if="{{form.fuelType}}" class="section-helper" data-field="fuelType" bindtap="handleClearOptionalField" hover-class="control-hover" aria-role="button" aria-label="清空燃油类型">清空燃油类型</view>
      </view>
    </view>
    <view class="form-item">
      <view class="form-label">座位数</view>
      <input class="form-input" type="number" placeholder="例如 5" placeholder-class="input-placeholder" value="{{form.seats}}" maxlength="1" data-field="seats" disabled="{{isSubmitting}}" bindinput="handleTextInput" confirm-type="done" aria-label="座位数" />
    </view>
    <view class="form-item">
      <view class="form-label field-label-row"><text>公开说明</text><text class="field-counter">{{publicDescriptionLength}} / 200</text></view>
      <textarea
        class="form-textarea"
        placeholder="填写车辆亮点、租赁提示等公开内容"
        placeholder-class="input-placeholder"
        value="{{form.publicDescription}}"
        maxlength="200"
        data-field="publicDescription"
        disabled="{{isSubmitting}}"
        bindinput="handleTextInput"
        aria-label="公开说明"
      />
      <view class="section-helper">此内容会显示在首页和车辆详情，请勿填写内部档案信息。</view>
    </view>
    <view class="form-item">
      <view class="form-label field-label-row"><text>人工用车提示</text><text class="field-counter">{{form.publicDrivingTips.length}} / 500</text></view>
      <textarea class="form-textarea" placeholder="填写取还车、操作或使用注意事项" placeholder-class="input-placeholder" value="{{form.publicDrivingTips}}" maxlength="500" data-field="publicDrivingTips" disabled="{{isSubmitting}}" bindinput="handleTextInput" aria-label="人工用车提示" />
      <view class="section-helper">保存后会在车辆详情展示，请填写本车实际适用的提示。</view>
    </view>

  </view>
  <view class="form-card">
    <view class="section-heading">
      <view class="section-heading-main">
        <view class="vehicle-section-glyph vehicle-section-glyph-rental" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
        <view>
          <view class="section-kicker">PERFORMANCE</view>
          <view class="section-title">性能参数与配置</view>
        </view>
      </view>
      <view class="section-index">03</view>
    </view>
    <view class="form-divider"></view>
    <view class="section-helper">选填信息 · 未填写则不展示虚构数据，100% 以人工录入为准</view>
    <view class="form-row">
      <view class="form-item form-item-half">
        <view class="form-label">百公里加速</view>
        <input class="form-input" placeholder="例如 3.4s" placeholder-class="input-placeholder" value="{{form.performance.acceleration}}" maxlength="12" data-field="performance.acceleration" disabled="{{isSubmitting}}" bindinput="handlePerformanceTextInput" confirm-type="done" aria-label="百公里加速" />
      </view>
      <view class="form-item form-item-half">
        <view class="form-label">最大马力</view>
        <input class="form-input" placeholder="例如 450Ps" placeholder-class="input-placeholder" value="{{form.performance.horsepower}}" maxlength="16" data-field="performance.horsepower" disabled="{{isSubmitting}}" bindinput="handlePerformanceTextInput" confirm-type="done" aria-label="最大马力" />
      </view>
    </view>
    <view class="form-row">
      <view class="form-item form-item-half">
        <view class="form-label">驱动方式</view>
        <picker mode="selector" range="{{drivetrainOptions}}" value="{{drivetrainIndex}}" disabled="{{isSubmitting}}" bindchange="handleDrivetrainChange" aria-label="选择驱动方式">
          <view class="form-picker {{form.performance.drivetrain ? 'form-picker-filled' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{drivetrainLabel || '选择方式'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
        <view wx:if="{{form.performance.drivetrain}}" class="section-helper" data-field="performance.drivetrain" bindtap="handleClearOptionalField" hover-class="control-hover" aria-role="button" aria-label="清空驱动方式">清空驱动方式</view>
      </view>
      <view class="form-item form-item-half">
        <view class="form-label">最大扭矩</view>
        <input class="form-input" placeholder="例如 530N·m" placeholder-class="input-placeholder" value="{{form.performance.torque}}" maxlength="18" data-field="performance.torque" disabled="{{isSubmitting}}" bindinput="handlePerformanceTextInput" confirm-type="done" aria-label="最大扭矩" />
      </view>
    </view>
    <view class="form-item">
      <view class="form-label field-label-row"><text>核心配置标签</text><text class="field-counter">{{form.performance.highlights.length}} / 8（留空不保存）</text></view>
      <view class="highlight-list" aria-role="list" aria-label="核心配置标签输入列表">
        <view class="highlight-row" wx:for="{{form.performance.highlights}}" wx:key="index" aria-role="listitem">
          <input class="form-input highlight-input" placeholder="例如 无钥匙进入、空气悬架" placeholder-class="input-placeholder" value="{{item}}" maxlength="20" data-index="{{index}}" disabled="{{isSubmitting}}" bindinput="handleHighlightInput" confirm-type="done" aria-label="核心配置标签第 {{index + 1}} 项" />
          <view class="highlight-remove" data-index="{{index}}" bindtap="handleRemoveHighlight" hover-class="highlight-remove-pressed" aria-label="删除该配置标签" aria-role="button">
            <view class="highlight-remove-icon" aria-hidden="true"></view>
          </view>
        </view>
      </view>
      <view class="highlight-actions" wx:if="{{form.performance.highlights.length < 8}}">
        <view class="highlight-add" bindtap="handleAddHighlight" hover-class="highlight-add-pressed" aria-role="button" aria-label="新增配置标签">
          <view class="highlight-add-icon" aria-hidden="true"></view>
          <text>新增配置标签</text>
        </view>
      </view>
      <view class="section-helper">建议填写车辆实际具备的卖点配置，如「Bose 音响」「全景天窗」「电尾门」等。</view>
    </view>
  </view>
  <view class="form-card">
    <view class="section-heading">
      <view class="section-heading-main">
        <view class="vehicle-section-glyph vehicle-section-glyph-archive" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
        <view>
          <view class="section-kicker">ARCHIVE</view>
          <view class="section-title">档案与备注</view>
        </view>
      </view>
      <view class="section-index">04</view>
    </view>
    <view class="form-divider"></view>
    <view class="section-helper">选填信息 · 仅用于内部档案，不会在前台展示</view>
    <view class="form-item">
      <view class="form-label">保养到期日</view>
      <picker mode="date" value="{{form.archiveDate}}" data-field="archiveDate" disabled="{{isSubmitting}}" bindchange="handleDueDateChange" aria-label="选择保养到期日">
        <view class="form-picker" hover-class="vehicle-picker-pressed"><text>{{form.archiveDate || '未填写'}}</text><view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view></view>
      </picker>
      <view wx:if="{{form.archiveDate}}" class="section-helper" data-field="archiveDate" bindtap="handleClearOptionalField" hover-class="control-hover" aria-role="button" aria-label="清空保养到期日">清空日期</view>
    </view>
    <view class="form-item">
      <view class="form-label">年检到期日</view>
      <picker mode="date" value="{{form.archiveReview}}" data-field="archiveReview" disabled="{{isSubmitting}}" bindchange="handleDueDateChange" aria-label="选择年检到期日">
        <view class="form-picker" hover-class="vehicle-picker-pressed"><text>{{form.archiveReview || '未填写'}}</text><view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view></view>
      </picker>
      <view wx:if="{{form.archiveReview}}" class="section-helper" data-field="archiveReview" bindtap="handleClearOptionalField" hover-class="control-hover" aria-role="button" aria-label="清空年检到期日">清空日期</view>
    </view>
    <view class="form-item">
      <view class="form-label">VIN</view>
      <input class="form-input" placeholder="选填，最多 32 位" placeholder-class="input-placeholder" value="{{form.vin}}" maxlength="32" data-field="vin" disabled="{{isSubmitting}}" bindinput="handleTextInput" confirm-type="done" aria-label="车辆识别码 VIN" />
    </view>
    <view class="form-item">
      <view class="form-label">发动机号</view>
      <input class="form-input" placeholder="选填，最多 32 位" placeholder-class="input-placeholder" value="{{form.engineNumber}}" maxlength="32" data-field="engineNumber" disabled="{{isSubmitting}}" bindinput="handleTextInput" confirm-type="done" aria-label="发动机号" />
    </view>
    <view class="form-item">
      <view class="form-label field-label-row"><text>内部备注</text><text class="field-counter">{{noteLength}} / 200</text></view>
      <textarea
        class="form-textarea"
        placeholder="填写维修提醒、档案说明等内部内容"
        placeholder-class="input-placeholder"
        value="{{form.note}}"
        maxlength="200"
        data-field="note"
        disabled="{{isSubmitting}}"
        bindinput="handleTextInput"
        aria-label="内部备注"
      />
    </view>
  </view>
  <view class="vehicle-submit-dock">
    <view class="vehicle-submit-state {{formProgress.ready ? 'vehicle-submit-state-ready' : ''}}">
      <view class="vehicle-submit-state-icon" aria-hidden="true"><view class="vehicle-submit-state-check"></view></view>
      <view>{{formProgress.ready ? '必填信息完整，可创建车辆' : formProgress.hint}}</view>
    </view>
    <button
      class="submit-button {{isSubmitting ? 'submit-button-disabled' : ''}}"
      bindtap="handleSubmit"
      disabled="{{isSubmitting}}"
      loading="{{isSubmitting}}"
      hover-class="vehicle-form-button-pressed"
    >
      <view class="vehicle-form-action-content">
        <view wx:if="{{!isSubmitting}}" class="vehicle-action-native-icon vehicle-create-native-icon" aria-hidden="true"></view>
        <text>{{isSubmitting ? '正在创建车辆' : '创建车辆并继续'}}</text>
      </view>
    </button>
  </view>
</view>
