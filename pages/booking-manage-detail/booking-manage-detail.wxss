@import "../../shared/management-shell.wxss";

.detail-page {
  padding: 24rpx calc(24rpx + env(safe-area-inset-right)) calc(48rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  box-sizing: border-box;
  color: #ffffff;
  background: #101010;
}

.header-card,
.info-card,
.coordination-card,
.conflict-card,
.note-card,
.action-card {
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.coordination-card {
  border-color: rgba(88, 137, 211, 0.16);
  background: linear-gradient(145deg, rgba(27, 37, 52, 0.96), rgba(19, 22, 27, 0.98));
}

.coordination-heading,
.coordination-options {
  display: flex;
  align-items: center;
}

.coordination-heading {
  justify-content: space-between;
}

.coordination-kicker {
  color: #617898;
  font-size: 15rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.coordination-title {
  margin-top: 7rpx;
  color: #eef1f5;
  font-size: 25rpx;
  font-weight: 650;
}

.coordination-time {
  color: #667487;
  font-size: 16rpx;
}

.coordination-group {
  margin-top: 24rpx;
}

.coordination-group-last {
  margin-top: 20rpx;
}

.coordination-label {
  margin-bottom: 11rpx;
  color: #7d8998;
  font-size: 18rpx;
}

.coordination-options {
  justify-content: space-between;
}

.coordination-option {
  width: calc(33.333% - 8rpx);
  height: 68rpx;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 15rpx;
  background: rgba(255, 255, 255, 0.025);
  color: #707d8e;
  font-size: 19rpx;
  line-height: 68rpx;
  transition: opacity 120ms ease, transform 120ms ease;
}

.coordination-option-pressed {
  opacity: 0.72;
  transform: scale(0.975);
}

.coordination-option::after {
  border: 0;
}

.coordination-option[disabled] {
  opacity: 0.6;
}

.coordination-option-active {
  color: #e7edf6;
  font-weight: 650;
}

.coordination-option-priority {
  border-color: rgba(235, 157, 73, 0.28);
  background: rgba(222, 139, 50, 0.1);
  color: #e8a45c;
}

.coordination-option-normal {
  border-color: rgba(91, 147, 232, 0.26);
  background: rgba(75, 130, 216, 0.1);
  color: #83acf0;
}

.coordination-option-standby {
  border-color: rgba(143, 151, 164, 0.2);
  background: rgba(124, 132, 145, 0.08);
  color: #a1a9b4;
}

.coordination-option-pending {
  border-color: rgba(226, 158, 85, 0.24);
  background: rgba(209, 137, 60, 0.08);
  color: #dca05f;
}

.coordination-option-coordinating {
  border-color: rgba(91, 147, 232, 0.26);
  background: rgba(75, 130, 216, 0.1);
  color: #83acf0;
}

.coordination-option-resolved {
  border-color: rgba(74, 199, 142, 0.25);
  background: rgba(62, 177, 125, 0.09);
  color: #65d4a1;
}

.coordination-help {
  display: flex;
  align-items: flex-start;
  margin-top: 17rpx;
  color: #687587;
  font-size: 16rpx;
  line-height: 1.55;
}

.help-native-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 29rpx;
  height: 29rpx;
  margin: 0 10rpx 0 0;
  border: 1rpx solid currentColor;
  border-radius: 50%;
  color: #607896;
  box-sizing: border-box;
}

.help-info-mark {
  position: relative;
  width: 3rpx;
  height: 9rpx;
  margin-top: 5rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.help-info-mark::before {
  position: absolute;
  top: -6rpx;
  left: 0;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.conflict-card {
  border-color: rgba(92, 137, 202, 0.13);
}

.conflict-card-warning {
  border-color: rgba(232, 157, 78, 0.22);
  background: linear-gradient(145deg, rgba(63, 45, 28, 0.52), rgba(23, 24, 27, 0.96));
}

.conflict-heading,
.conflict-item-top,
.conflict-clear,
.conflict-actions {
  display: flex;
  align-items: center;
}

.conflict-heading,
.conflict-item-top {
  justify-content: space-between;
}

.conflict-kicker {
  color: #667b99;
  font-size: 15rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.conflict-title {
  margin-top: 7rpx;
  color: #e9edf3;
  font-size: 25rpx;
  font-weight: 650;
}

.conflict-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(83, 137, 219, 0.1);
  color: #7faaf0;
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.conflict-count-warning {
  background: rgba(226, 146, 62, 0.14);
  color: #ecaa62;
}

.conflict-tip,
.conflict-state,
.conflict-more {
  margin-top: 17rpx;
  color: #7a8797;
  font-size: 18rpx;
  line-height: 1.6;
}

.conflict-message {
  display: flex;
  align-items: flex-start;
}

.conflict-message-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 31rpx;
  height: 31rpx;
  margin: 0 11rpx 0 0;
  border: 1rpx solid currentColor;
  border-radius: 50%;
  color: #6b829f;
  box-sizing: border-box;
}

.conflict-message-icon-warning {
  color: #d99a59;
}

.conflict-alert-mark {
  position: relative;
  width: 3rpx;
  height: 9rpx;
  margin-bottom: 5rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.conflict-alert-mark::after {
  position: absolute;
  bottom: -6rpx;
  left: 0;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.conflict-list {
  margin-top: 16rpx;
}

.conflict-item {
  margin-top: 12rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(238, 164, 86, 0.14);
  border-radius: 18rpx;
  background: rgba(9, 11, 14, 0.3);
}

.conflict-contact {
  color: #edf0f4;
  font-size: 22rpx;
  font-weight: 650;
}

.conflict-status {
  padding: 7rpx 12rpx;
  font-size: 15rpx;
}

.conflict-date {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  color: #dfaa70;
  font-size: 20rpx;
  font-weight: 600;
}

.conflict-date-native-icon,
.info-date-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 19rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.conflict-date-native-icon::before,
.info-date-native-icon::before {
  position: absolute;
  top: 4rpx;
  right: 0;
  left: 0;
  height: 2rpx;
  background: currentColor;
  content: "";
}

.conflict-date-route,
.info-date-route {
  display: flex;
  align-items: center;
  width: 36rpx;
  margin: 0 9rpx;
}

.conflict-date-route-line,
.info-date-route-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, currentColor, transparent);
  opacity: 0.72;
}

.conflict-date-route-chevron,
.info-date-route-chevron {
  width: 6rpx;
  height: 6rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  box-sizing: border-box;
  opacity: 0.76;
  transform: rotate(-45deg);
}

.conflict-meta {
  display: flex;
  align-items: center;
  margin-top: 7rpx;
  color: #778392;
  font-size: 17rpx;
}

.conflict-contact-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
}

.conflict-contact-native-icon::before {
  position: absolute;
  top: 0;
  left: 6rpx;
  width: 6rpx;
  height: 6rpx;
  border: 2rpx solid #667b96;
  border-radius: 50%;
  box-sizing: border-box;
  content: "";
}

.conflict-contact-native-icon::after {
  position: absolute;
  right: 1rpx;
  bottom: 0;
  left: 1rpx;
  height: 8rpx;
  border: 2rpx solid #667b96;
  border-bottom: 0;
  border-radius: 9rpx 9rpx 0 0;
  box-sizing: border-box;
  content: "";
}

.conflict-plan {
  margin-top: 10rpx;
}

.conflict-plan-pill {
  display: inline-block;
  margin-right: 9rpx;
  padding: 6rpx 11rpx;
  border-radius: 999rpx;
  background: rgba(118, 132, 151, 0.1);
  color: #929dab;
  font-size: 14rpx;
}

.priority-priority {
  background: rgba(223, 143, 57, 0.12);
  color: #e5a05a;
}

.priority-standby {
  color: #9aa3ae;
}

.coordination-coordinating {
  background: rgba(76, 135, 224, 0.12);
  color: #7faaf0;
}

.coordination-resolved {
  background: rgba(61, 181, 127, 0.1);
  color: #62d29c;
}

.conflict-actions {
  margin-top: 16rpx;
}

.conflict-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 66rpx;
  margin: 0 0 0 12rpx;
  padding: 0 12rpx;
  border: 1rpx solid rgba(110, 151, 215, 0.18);
  border-radius: 14rpx;
  background: rgba(87, 132, 201, 0.07);
  color: #87ace3;
  font-size: 19rpx;
  line-height: 1;
  transition: opacity 120ms ease, transform 120ms ease;
}

.manage-detail-button-pressed {
  opacity: 0.72;
  transform: scale(0.975);
}

.conflict-action:first-child {
  margin-left: 0;
}

.conflict-action::after {
  border: 0;
}

.conflict-action-primary {
  border-color: rgba(233, 159, 82, 0.23);
  background: rgba(220, 139, 54, 0.1);
  color: #e5a562;
}

.conflict-clear {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(69, 177, 128, 0.06);
}

.conflict-clear-mark {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: rgba(76, 202, 144, 0.12);
  color: #5bd49d;
}

.conflict-check-icon {
  width: 8rpx;
  height: 15rpx;
  margin-top: -4rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.conflict-clear-title {
  color: #70d8a9;
  font-size: 20rpx;
  font-weight: 600;
}

.conflict-clear .conflict-state {
  margin-top: 3rpx;
}

.booking-name {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-word;
}

.booking-status {
  display: inline-flex;
  align-items: center;
  margin-top: 14rpx;
  max-width: 220rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-status-dot {
  flex-shrink: 0;
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 10rpx currentColor;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 2rpx -6rpx 0;
}

.info-item {
  width: calc(50% - 12rpx);
  margin: 0 6rpx 12rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}

.info-item-full {
  width: calc(100% - 12rpx);
}

.info-label {
  font-size: 22rpx;
  color: #8f98a6;
  margin-bottom: 8rpx;
  line-height: 1.45;
}

.info-value {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-all;
}

.info-date-range {
  display: flex;
  align-items: center;
}

.info-date-native-icon {
  color: #728db3;
}

.info-date-route {
  color: #718eb7;
}

.quick-contact {
  display: flex;
  margin-top: 8rpx;
}

.quick-contact-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 74rpx;
  margin-right: 12rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  font-size: 18rpx;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-contact-btn text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-with-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.call-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 15rpx;
  height: 20rpx;
  margin-right: 8rpx;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  border-radius: 0 0 0 10rpx;
  transform: rotate(-36deg);
}

.call-native-icon::before,
.call-native-icon::after {
  position: absolute;
  left: -3rpx;
  width: 6rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: "";
}

.call-native-icon::before {
  top: -2rpx;
}

.call-native-icon::after {
  bottom: -3rpx;
}

.copy-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 15rpx;
  height: 15rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.copy-native-icon::after {
  position: absolute;
  top: -5rpx;
  left: 3rpx;
  width: 13rpx;
  height: 13rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  border-radius: 0 3rpx 0 0;
  content: "";
}

.identity-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 21rpx;
  height: 17rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.identity-native-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
}

.identity-native-icon::after {
  position: absolute;
  top: 4rpx;
  right: 3rpx;
  width: 6rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 0 5rpx 0 currentColor;
  content: "";
}

.detail-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 20rpx;
  height: 14rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.detail-native-dot {
  position: absolute;
  top: 3rpx;
  left: 6rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
}

.quick-contact-btn-last {
  margin-right: 0;
}

.action-tip {
  display: flex;
  align-items: flex-start;
  margin: -2rpx 0 16rpx;
  color: #687483;
  font-size: 20rpx;
  line-height: 1.6;
}

.note-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.note-title,
.action-title {
  font-size: 22rpx;
  color: #8f98a6;
  margin-bottom: 12rpx;
}

.note-meta {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
  max-width: 48%;
  margin-left: 16rpx;
}

.note-counter {
  color: #7697cb;
  font-size: 18rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.4;
}

.note-time {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.4;
  text-align: right;
  word-break: break-word;
}

.note-head .note-title {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
  word-break: break-word;
}

.note-title-with-icon {
  display: flex;
  align-items: center;
}

.note-native-icon,
.save-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 21rpx;
  height: 23rpx;
  margin-right: 9rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.note-native-icon {
  color: #7187a5;
}

.note-native-icon-user {
  color: #7e8da2;
}

.note-native-line,
.note-native-icon::after,
.save-native-line,
.save-native-icon::after {
  position: absolute;
  left: 4rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}

.note-native-line,
.save-native-line {
  top: 6rpx;
}

.note-native-icon::after,
.save-native-icon::after {
  top: 13rpx;
}

.note-content {
  font-size: 24rpx;
  line-height: 1.65;
  word-break: break-word;
}

.remark-input {
  width: 100%;
  min-height: 180rpx;
  margin-top: 10rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.05);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.6;
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 14rpx;
  box-sizing: border-box;
}

.save-native-icon {
  width: 20rpx;
  height: 22rpx;
  margin-right: 9rpx;
}

.status-operation-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  margin-right: 9rpx;
  border: 2rpx solid #7188aa;
  border-radius: 50%;
  box-sizing: border-box;
}

.status-operation-dot {
  position: absolute;
  top: 7rpx;
  left: 7rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #7188aa;
}

.status-operation-native-icon::before,
.status-operation-native-icon::after {
  position: absolute;
  top: 8rpx;
  width: 5rpx;
  height: 2rpx;
  background: #7188aa;
  content: "";
}

.status-operation-native-icon::before {
  left: -6rpx;
}

.status-operation-native-icon::after {
  right: -6rpx;
}

.status-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 2rpx;
}

.status-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48%;
  margin-right: 4%;
  margin-bottom: 16rpx;
  height: 72rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: #141414;
  color: #ffffff;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: opacity 120ms ease, transform 120ms ease;
}

.status-contact-native-icon {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.status-contact-native-icon::after {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 8rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}

.status-complete-native-icon {
  width: 9rpx;
  height: 16rpx;
  margin: -4rpx 9rpx 0 0;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.status-cancel-native-icon {
  position: relative;
  width: 19rpx;
  height: 19rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.status-cancel-native-icon::after {
  position: absolute;
  top: 7rpx;
  left: 3rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
  transform: rotate(-45deg);
}

.status-btn::after {
  border: 0;
}

.status-btn-alt {
  margin-right: 0;
}

.status-btn-danger {
  border-color: rgba(214, 75, 75, 0.6);
  background: rgba(214, 75, 75, 0.12);
}

