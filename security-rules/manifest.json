{
  "database": {
    "ruleFile": "database-deny-client.json",
    "indexFile": "database-indexes.json",
    "collections": [
      "analytics_events",
      "app_configs",
      "audit_logs",
      "booking_handovers",
      "booking_quotes",
      "bookings",
      "content_guides",
      "error_logs",
      "favorites",
      "pending_file_deletions",
      "privacy_requests",
      "roles",
      "vehicle_availability_blocks",
      "vehicle_calendar_days",
      "vehicle_price_rules",
      "vehicles"
    ]
  },
  "storage": {
    "ruleFile": "storage.json",
    "publicReadPrefix": "vehicle-images/",
    "privateUploadPrefix": "handover-images/",
    "maxUploadBytes": 10485760,
    "allowedImageExtensions": ["jpg", "jpeg", "png", "webp"]
  },
  "functions": {
    "ruleFile": "functions.json",
    "requiresAuthenticatedUser": true,
    "sensitiveFunctionsRequireOpenidInCode": true
  }
}
