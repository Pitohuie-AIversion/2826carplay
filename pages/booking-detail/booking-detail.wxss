.detail-skeleton-title { width: 66%; height: 40rpx; margin-top: 16rpx; border-radius: 10rpx; }
.detail-skeleton-journey { margin-top: 25rpx; padding: 25rpx 22rpx; border: 1rpx solid rgba(255, 255, 255, 0.06); border-radius: 20rpx; background: rgba(255, 255, 255, 0.02); }
.detail-skeleton-date { width: 142rpx; height: 38rpx; border-radius: 9rpx; }
.detail-skeleton-route { flex: 1; height: 4rpx; margin: 0 24rpx; border-radius: 999rpx; }
.detail-skeleton-footer { margin-top: 26rpx; }
.detail-skeleton-footer-item { width: 38%; height: 34rpx; border-radius: 9rpx; }
.detail-skeleton-info { margin-top: 20rpx; padding: 28rpx; }
.detail-skeleton-section-title { width: 166rpx; height: 31rpx; border-radius: 9rpx; }
.detail-skeleton-info-grid { margin-top: 24rpx; }
.detail-skeleton-info-item { width: calc(50% - 8rpx); height: 108rpx; border-radius: 18rpx; }
.skeleton-pulse { background: linear-gradient(105deg, #181c22 12%, #29313c 34%, #181c22 56%); background-size: 220% 100%; animation: bookingDetailSkeletonPulse 1.6s ease-in-out infinite; }
@keyframes bookingDetailSkeletonPulse { 0% { background-position: 160% 0; }
  100% { background-position: -70% 0; }
}
.customer-quote-card { margin-top: 24rpx; }
.quote-valid { border: 1rpx solid rgba(82, 143, 255, 0.4); border-radius: 999rpx; padding: 8rpx 14rpx; color: #b9ceff; font-size: 21rpx; }
.quote-rental-meta { margin-top: 20rpx; color: #8f98a7; font-size: 23rpx; }
.quote-breakdown { margin-top: 22rpx; border: 1rpx solid rgba(255, 255, 255, 0.09); border-radius: 18rpx; overflow: hidden; background: rgba(6, 8, 12, 0.58); }
.quote-row,
.quote-total { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 22rpx; color: #bac1cc; font-size: 24rpx; }
.quote-row + .quote-row { border-top: 1rpx solid rgba(255, 255, 255, 0.055); }
.quote-total { border-top: 1rpx solid rgba(82, 143, 255, 0.3); background: rgba(82, 143, 255, 0.08); color: #fff; font-size: 29rpx; font-weight: 700; }
.quote-rule,
.quote-adjustment-summary,
.quote-boundary,
.quote-response-state { margin-top: 18rpx; border-radius: 15rpx; padding: 18rpx 20rpx; background: rgba(255, 255, 255, 0.04); color: #b2bac7; font-size: 23rpx; line-height: 1.65; }
.quote-rule-label { margin-bottom: 8rpx; color: #eef2f8; font-size: 23rpx; font-weight: 600; }
.quote-adjustment-summary,
.quote-response-adjustment { color: #f0c887; background: rgba(225, 164, 72, 0.08); }
.quote-boundary { border: 1rpx solid rgba(255, 255, 255, 0.09); color: #9099a7; }
.quote-response { margin-top: 24rpx; }
.quote-confirm-btn,
.quote-adjust-btn { width: 100%; margin: 0; }
.quote-adjustment-form { margin-top: 22rpx; }
.quote-adjustment-input { box-sizing: border-box; width: 100%; min-height: 150rpx; border: 1rpx solid rgba(255, 255, 255, 0.12); border-radius: 15rpx; padding: 18rpx 20rpx 42rpx; background: rgba(6, 8, 12, 0.65); color: #fff; font-size: 24rpx; line-height: 1.6; }
.quote-adjustment-count { margin-top: -38rpx; margin-bottom: 18rpx; padding-right: 16rpx; color: #707987; font-size: 20rpx; text-align: right; }
.quote-response-confirmed { color: #8ad5b2; background: rgba(77, 184, 132, 0.08); }
.customer-handover-card { margin-top: 24rpx; }
.handover-boundary, .emergency-boundary { margin-top: 18rpx; border-radius: 14rpx; padding: 18rpx; color: #aeb7c5; background: rgba(82,143,255,.08); font-size: 22rpx; line-height: 1.6; }
.customer-handover-record { margin-top: 22rpx; border: 1rpx solid rgba(255,255,255,.09); border-radius: 18rpx; padding: 20rpx; background: rgba(255,255,255,.025); }
.handover-record-head { display: flex; align-items: center; justify-content: space-between; color: #eef2f8; font-size: 25rpx; font-weight: 600; }
.handover-status { color: #f5c87a; font-size: 21rpx; }
.handover-status-confirmed { color: #84d3ae; }
.handover-record-meta { margin-top: 12rpx; color: #9aa4b3; font-size: 22rpx; }
.handover-record-note { margin-top: 16rpx; color: #dce2ec; font-size: 23rpx; line-height: 1.6; }
.handover-record-note text { display: block; margin-bottom: 5rpx; color: #818b9a; font-size: 20rpx; }
.customer-handover-photos { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 10rpx; margin-top: 18rpx; }
.customer-handover-photos image { width: 100%; height: 128rpx; border-radius: 12rpx; background: #151a22; }
.handover-confirm-btn, .emergency-call-btn { margin-top: 20rpx; }
.handover-confirmed-time { margin-top: 16rpx; color: #84d3ae; font-size: 22rpx; }
.emergency-boundary { color: #c3a7a7; background: rgba(212,104,104,.08); }
.checklist-card { margin-top: 24rpx; border-color: rgba(91, 148, 235, 0.22); background: linear-gradient(160deg, rgba(20, 27, 39, 0.95), rgba(13, 17, 24, 0.98)); }
.checklist-heading { display: flex; align-items: center; justify-content: space-between; cursor: pointer; }
.checklist-heading-pressed { opacity: 0.85; }
.checklist-toggle-badge { display: flex; align-items: center; padding: 8rpx 16rpx; border: 1rpx solid rgba(91, 148, 235, 0.28); border-radius: 999rpx; background: rgba(78, 133, 219, 0.1); color: #8bb2f0; font-size: 18rpx; line-height: 1; }
.checklist-chevron { width: 10rpx; height: 10rpx; margin-left: 8rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg) translateY(-2rpx); transition: transform 160ms ease; }
.checklist-chevron-open { transform: rotate(225deg) translate(-2rpx, -2rpx); }
.checklist-body { margin-top: 18rpx; }
.checklist-item { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid rgba(255, 255, 255, 0.055); }
.checklist-item-last { border-bottom: 0; padding-bottom: 4rpx; }
.checklist-badge { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; margin-top: 4rpx; margin-right: 18rpx; border: 1rpx solid rgba(91, 148, 235, 0.35); border-radius: 10rpx; background: rgba(78, 133, 219, 0.12); color: #85aff1; font-size: 18rpx; font-weight: 700; }
.checklist-info { flex: 1; min-width: 0; }
.checklist-title { color: #e2e8f2; font-size: 22rpx; font-weight: 600; line-height: 1.4; }
.checklist-desc { margin-top: 6rpx; color: #8895a6; font-size: 19rpx; line-height: 1.55; }
.voucher-trigger-wrap { margin-top: 22rpx; }
.voucher-trigger-btn { width: 100%; height: 76rpx; border-radius: 16rpx; font-size: 22rpx; line-height: 1; }
.voucher-native-icon { width: 22rpx; height: 18rpx; margin-right: 12rpx; border: 2rpx solid currentColor; border-radius: 4rpx; box-sizing: border-box; }
.readiness-card { margin-bottom: 22rpx; }
.readiness-toggle-btn { padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 18rpx; line-height: 1; }
.readiness-content { margin-top: 18rpx; }
.readiness-tip-item { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid rgba(255, 255, 255, 0.055); }
.readiness-tip-item-last { border-bottom: 0; padding-bottom: 4rpx; }
.readiness-tip-badge { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 56rpx; height: 38rpx; margin-top: 4rpx; margin-right: 18rpx; border: 1rpx solid rgba(212, 175, 110, 0.35); border-radius: 10rpx; background: rgba(212, 175, 110, 0.12); color: #e6c587; font-size: 18rpx; font-weight: 700; }
.readiness-tip-info { flex: 1; min-width: 0; }
.readiness-tip-title { color: #e2e8f2; font-size: 22rpx; font-weight: 600; line-height: 1.4; }
.readiness-tip-desc { margin-top: 6rpx; color: #8895a6; font-size: 19rpx; line-height: 1.55; }
.voucher-modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 30rpx; background: rgba(0, 0, 0, 0.82); backdrop-filter: blur(10px); }
.voucher-modal-card { width: 100%; max-width: 620rpx; padding: 38rpx 32rpx; border: 1rpx solid rgba(212, 175, 110, 0.35); border-radius: 28rpx; background: linear-gradient(160deg, #1d212b, #111317); box-sizing: border-box; }
.voucher-modal-header { text-align: center; margin-bottom: 24rpx; }
.voucher-brand-emblem { width: 72rpx; height: 72rpx; margin: 0 auto 12rpx; display: block; }
.voucher-modal-kicker { color: #d4af6e; font-size: 14rpx; letter-spacing: 2rpx; }
.voucher-modal-title { margin-top: 6rpx; color: #f2f5fa; font-size: 28rpx; font-weight: 700; }
.voucher-modal-status { margin-top: 6rpx; color: #65d6a4; font-size: 18rpx; }
.voucher-modal-body { padding: 18rpx 20rpx; border-radius: 18rpx; background: rgba(255, 255, 255, 0.03); border: 1rpx solid rgba(255, 255, 255, 0.06); }
.voucher-field-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid rgba(255, 255, 255, 0.04); }
.voucher-field-row-last { border-bottom: 0; }
.voucher-field-label { color: #7f8e9f; font-size: 20rpx; }
.voucher-field-val { color: #e2e8f2; font-size: 21rpx; font-weight: 550; max-width: 65%; text-align: right; }
.voucher-field-val-gold { color: #e6c587; }
.voucher-modal-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.voucher-modal-actions .ui-btn { flex: 1; height: 76rpx; font-size: 21rpx; line-height: 1; border-radius: 16rpx; }
.voucher-close-btn { flex: 0 0 140rpx; }
