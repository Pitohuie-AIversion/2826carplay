<view wx:if="{{pageAuthorized}}" class="vehicle-create-page vehicle-form-page">
  <view class="page-glow"></view>

  <view class="hero-card">
    <view class="hero-top">
      <view>
        <view class="page-kicker">FLEET ONBOARDING</view>
        <view class="page-title">新增车辆</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    </view>
    <view class="page-desc">录入车辆档案，创建成功后可继续上传车辆图片</view>
    <view class="vehicle-form-progress {{formProgress.ready ? 'vehicle-form-progress-ready' : ''}}" aria-role="group" aria-label="车辆必填信息完成度 {{formProgress.completed}} / {{formProgress.total}}，{{formProgress.hint}}">
      <view class="vehicle-form-progress-head">
        <view class="vehicle-form-progress-title">必填信息完成度</view>
        <view class="vehicle-form-progress-value">{{formProgress.completed}} / {{formProgress.total}}</view>
      </view>
      <view class="vehicle-form-progress-track" aria-hidden="true"><view class="vehicle-form-progress-fill" style="width: {{formProgress.percent}}%;"></view></view>
      <view class="vehicle-form-progress-hint">
        <view class="vehicle-form-progress-icon" aria-hidden="true"><view class="vehicle-form-progress-check"></view></view>
        <text>{{formProgress.hint}}</text>
      </view>
    </view>
  </view>

  <view class="tip-card">
    <view class="tip-mark" aria-hidden="true">
      <view class="tip-info-icon"></view>
    </view>
    <view>
      <view class="tip-title">图片上传说明</view>
      <view class="tip-desc">提交车辆后可立即进入图片管理，设置首页封面与车辆相册。</view>
    </view>
  </view>

  <view class="form-card">
    <view class="section-heading">
      <view class="section-heading-main">
        <view class="vehicle-section-glyph vehicle-section-glyph-identity" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
        <view>
          <view class="section-kicker">IDENTITY</view>
          <view class="section-title">车辆身份</view>
        </view>
      </view>
      <view class="section-index">01</view>
    </view>
    <view class="form-divider"></view>

    <view class="form-row">
      <view class="form-item form-item-half">
        <view class="form-label field-label-row"><text>车牌号</text><text class="field-required">必填</text></view>
        <input
          class="form-input {{formProgress.plateNumberComplete ? 'vehicle-form-control-complete' : ''}}"
          placeholder="京A12345"
          placeholder-class="input-placeholder"
          value="{{form.plateNumber}}"
          maxlength="8"
          bindinput="handlePlateInput"
          confirm-type="next"
          aria-label="填写车牌号"
          aria-required="{{true}}"
        />
      </view>

      <view class="form-item form-item-half">
        <view class="form-label field-label-row"><text>车辆类型</text><text class="field-required">必填</text></view>
        <picker mode="selector" range="{{vehicleTypeLabels}}" value="{{vehicleTypeIndex}}" bindchange="handleVehicleTypeChange" aria-label="选择车辆类型" aria-required="{{true}}">
          <view class="form-picker {{form.vehicleType ? 'form-picker-filled' : ''}} {{formProgress.vehicleTypeComplete ? 'vehicle-form-control-complete' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{vehicleTypeLabel || '选择类型'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label field-label-row"><text>品牌型号</text><text class="field-required">必填</text></view>
      <input
        class="form-input {{formProgress.brandModelComplete ? 'vehicle-form-control-complete' : ''}}"
        placeholder="例如 BMW 740Li"
        placeholder-class="input-placeholder"
        value="{{form.brandModel}}"
        maxlength="50"
        data-field="brandModel"
        bindinput="handleTextInput"
        confirm-type="done"
        aria-label="填写车辆品牌型号"
        aria-required="{{true}}"
      />
    </view>

    <view class="form-row">
      <view class="form-item form-item-half">
        <view class="form-label field-label-row"><text>注册日期</text><text class="field-required">必填</text></view>
        <picker mode="date" value="{{form.registerDate}}" end="{{today}}" bindchange="handleDateChange" aria-label="选择注册日期" aria-required="{{true}}">
          <view class="form-picker {{form.registerDate ? 'form-picker-filled' : ''}} {{formProgress.registerDateComplete ? 'vehicle-form-control-complete' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{form.registerDate || '选择日期'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
      </view>

      <view class="form-item form-item-half">
        <view class="form-label field-label-row"><text>使用状态</text><text class="field-required">必填</text></view>
        <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="handleStatusChange" aria-label="选择使用状态" aria-required="{{true}}">
          <view class="form-picker {{form.status ? 'form-picker-filled' : ''}} {{formProgress.statusComplete ? 'vehicle-form-control-complete' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{statusLabel || '选择状态'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <view class="form-card">
    <view class="section-heading">
      <view class="section-heading-main">
        <view class="vehicle-section-glyph vehicle-section-glyph-rental" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
        <view>
          <view class="section-kicker">RENTAL PROFILE</view>
          <view class="section-title">展示与租赁</view>
        </view>
      </view>
      <view class="section-index">02</view>
    </view>
    <view class="form-divider"></view>
    <view class="section-helper">选填信息 · 完善后将用于车库前台展示</view>

    <view class="form-row">
      <view class="form-item form-item-half">
        <view class="form-label">取车城市</view>
        <input class="form-input" placeholder="例如 杭州" placeholder-class="input-placeholder" value="{{form.location}}" maxlength="20" data-field="location" bindinput="handleTextInput" confirm-type="done" aria-label="所在城市" />
      </view>
      <view class="form-item form-item-half">
        <view class="form-label">日租金</view>
        <input class="form-input" type="number" placeholder="例如 699" placeholder-class="input-placeholder" value="{{form.priceDay}}" maxlength="5" data-field="priceDay" bindinput="handleTextInput" confirm-type="done" aria-label="日租价格" />
      </view>
    </view>

    <view class="form-row">
      <view class="form-item form-item-half">
        <view class="form-label">变速箱</view>
        <picker mode="selector" range="{{transmissionLabels}}" value="{{transmissionIndex}}" bindchange="handleTransmissionChange" aria-label="选择变速箱类型">
          <view class="form-picker {{form.transmission ? 'form-picker-filled' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{transmissionLabel || '选择类型'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
      </view>
      <view class="form-item form-item-half">
        <view class="form-label">燃油类型</view>
        <picker mode="selector" range="{{fuelTypeLabels}}" value="{{fuelTypeIndex}}" bindchange="handleFuelTypeChange" aria-label="选择燃油类型">
          <view class="form-picker {{form.fuelType ? 'form-picker-filled' : ''}}" hover-class="vehicle-picker-pressed">
            <text>{{fuelTypeLabel || '选择类型'}}</text>
            <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">座位数</view>
      <input class="form-input" type="number" placeholder="例如 5" placeholder-class="input-placeholder" value="{{form.seats}}" maxlength="1" data-field="seats" bindinput="handleTextInput" confirm-type="done" aria-label="座位数" />
    </view>

    <view class="form-item">
      <view class="form-label field-label-row"><text>公开说明</text><text class="field-counter">{{publicDescriptionLength}} / 200</text></view>
      <textarea
        class="form-textarea"
        placeholder="填写车辆亮点、租赁提示等公开内容"
        placeholder-class="input-placeholder"
        value="{{form.publicDescription}}"
        maxlength="200"
        data-field="publicDescription"
        bindinput="handleTextInput"
        aria-label="公开说明"
      />
      <view class="section-helper">此内容会显示在首页和车辆详情，请勿填写内部档案信息。</view>
    </view>
  </view>

  <view class="form-card">
    <view class="section-heading">
      <view class="section-heading-main">
        <view class="vehicle-section-glyph vehicle-section-glyph-archive" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
        <view>
          <view class="section-kicker">ARCHIVE</view>
          <view class="section-title">档案与备注</view>
        </view>
      </view>
      <view class="section-index">03</view>
    </view>
    <view class="form-divider"></view>
    <view class="section-helper">选填信息 · 仅用于内部档案，不会在前台展示</view>

    <view class="form-item">
      <view class="form-label">VIN</view>
      <input class="form-input" placeholder="选填，最多 32 位" placeholder-class="input-placeholder" value="{{form.vin}}" maxlength="32" data-field="vin" bindinput="handleTextInput" confirm-type="done" aria-label="车辆识别码 VIN" />
    </view>

    <view class="form-item">
      <view class="form-label">发动机号</view>
      <input class="form-input" placeholder="选填，最多 32 位" placeholder-class="input-placeholder" value="{{form.engineNumber}}" maxlength="32" data-field="engineNumber" bindinput="handleTextInput" confirm-type="done" aria-label="发动机号" />
    </view>

    <view class="form-item">
      <view class="form-label field-label-row"><text>内部备注</text><text class="field-counter">{{noteLength}} / 200</text></view>
      <textarea
        class="form-textarea"
        placeholder="填写维修提醒、档案说明等内部内容"
        placeholder-class="input-placeholder"
        value="{{form.note}}"
        maxlength="200"
        data-field="note"
        bindinput="handleTextInput"
        aria-label="内部备注"
      />
    </view>
  </view>

  <view class="vehicle-submit-dock">
    <view class="vehicle-submit-state {{formProgress.ready ? 'vehicle-submit-state-ready' : ''}}">
      <view class="vehicle-submit-state-icon" aria-hidden="true"><view class="vehicle-submit-state-check"></view></view>
      <view>{{formProgress.ready ? '必填信息完整，可创建车辆' : formProgress.hint}}</view>
    </view>
    <button
      class="submit-button {{isSubmitting ? 'submit-button-disabled' : ''}}"
      bindtap="handleSubmit"
      disabled="{{isSubmitting}}"
      loading="{{isSubmitting}}"
      hover-class="vehicle-form-button-pressed"
    >
      <view class="vehicle-form-action-content">
        <view wx:if="{{!isSubmitting}}" class="vehicle-action-native-icon vehicle-create-native-icon" aria-hidden="true"></view>
        <text>{{isSubmitting ? '正在创建车辆' : '创建车辆并继续'}}</text>
      </view>
    </button>
  </view>
</view>
