<view class="analytics-page management-page">
  <view class="page-glow"></view>

  <view class="hero-card ui-card ui-card-gradient">
    <view class="hero-top">
      <view>
        <view class="page-kicker">GARAGE INSIGHTS</view>
        <view class="hero-title">数据分析</view>
        <view class="hero-desc">了解车辆关注度与预约转化趋势</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" />
    </view>
    <view class="period-row">
      <view
        wx:for="{{periodOptions}}"
        wx:key="value"
        class="period-chip {{days === item.value ? 'period-chip-active' : ''}}"
        data-days="{{item.value}}"
        bindtap="handlePeriodTap"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-card ui-card">正在汇总匿名运营数据…</view>

  <view wx:elif="{{loadError}}" class="state-card ui-card">
    <view class="state-title">暂时无法加载数据</view>
    <view class="state-desc">{{loadError}}</view>
    <button class="retry-button ui-btn ui-btn-ghost" bindtap="handleRetry">重新加载</button>
  </view>

  <block wx:else>
    <view class="metric-grid">
      <view class="metric-card metric-{{item.tone}} ui-card" wx:for="{{metricItems}}" wx:key="key">
        <view class="metric-value">{{item.value}}</view>
        <view class="metric-label">{{item.label}}</view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">CONVERSION FUNNEL</view>
          <view class="section-title">预约转化漏斗</view>
        </view>
        <view class="section-index">01</view>
      </view>
      <view class="funnel-list">
        <view class="funnel-item" wx:for="{{funnelItems}}" wx:key="key">
          <view class="funnel-head">
            <view>{{item.label}}</view>
            <view>{{item.value}}</view>
          </view>
          <view class="bar-track">
            <view class="bar-fill funnel-fill" style="width: {{item.width}}%;"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">ACTIVITY TREND</view>
          <view class="section-title">每日行为趋势</view>
        </view>
        <view class="section-index">02</view>
      </view>
      <scroll-view class="trend-scroll" scroll-x>
        <view class="trend-chart">
          <view class="trend-item" wx:for="{{trendItems}}" wx:key="key">
            <view class="trend-value">{{item.value}}</view>
            <view class="trend-column">
              <view class="trend-fill" style="height: {{item.width}}%;"></view>
            </view>
            <view class="trend-label">{{item.label}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">POPULAR VEHICLES</view>
          <view class="section-title">热门车型</view>
        </view>
        <view class="section-index">03</view>
      </view>
      <view wx:if="{{topVehicles.length}}" class="vehicle-rank-list">
        <view class="rank-item" wx:for="{{topVehicles}}" wx:key="vehicleId">
          <view class="rank-number">{{index + 1}}</view>
          <view class="rank-copy">
            <view class="rank-name">{{item.name}}</view>
            <view class="rank-meta">详情 {{item.detailViews}} · 预约 {{item.bookingStarts}} · 收藏 {{item.favorites}}</view>
          </view>
          <view class="rank-score">{{item.score}}</view>
        </view>
      </view>
      <view wx:else class="inline-empty">当前周期暂无车辆行为数据</view>
    </view>

    <view wx:if="{{truncated}}" class="scope-tip">数据量超过 5000 条，当前统计为最近记录的汇总结果。</view>
    <view class="privacy-tip">仅统计事件类型、车辆 ID 与时间，不保存用户身份和预约表单内容。</view>

    <view wx:if="{{canCleanup}}" class="section-card cleanup-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">DATA RETENTION</view>
          <view class="section-title">匿名数据保留</view>
        </view>
        <view class="section-index">04</view>
      </view>
      <view class="cleanup-desc">管理员可分批删除 90 天前的匿名行为事件。预约、车辆和用户资料不受影响。</view>
      <button
        class="cleanup-button ui-btn ui-btn-ghost"
        loading="{{cleanupLoading}}"
        disabled="{{cleanupLoading}}"
        bindtap="handleCleanup"
      >
        {{cleanupLoading ? '正在清理' : '清理 90 天前数据'}}
      </button>
    </view>
  </block>
</view>
