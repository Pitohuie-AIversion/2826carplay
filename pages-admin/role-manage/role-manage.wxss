@import "../../shared/management-shell.wxss";

.role-page {
  min-height: 100vh;
  padding: 24rpx calc(24rpx + env(safe-area-inset-right)) calc(24rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  background: #101010;
  box-sizing: border-box;
}

.hero-card,
.form-card,
.list-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero-title,
.section-title,
.role-openid,
.empty-title {
  color: #ffffff;
}

.hero-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.hero-desc,
.section-desc,
.form-tip,
.role-permission,
.loading-text,
.empty-desc {
  margin-top: 10rpx;
  color: #b7b7b7;
  font-size: 24rpx;
  line-height: 1.7;
}

.openid-input {
  margin-top: 20rpx;
}

.openid-input[disabled] {
  opacity: 0.58;
}

.permission-row {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.permission-option {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding: 20rpx 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.022);
  transition: opacity 120ms ease, transform 120ms ease, border-color 150ms ease, background 150ms ease;
}

.permission-option-active {
  border-color: rgba(82, 143, 255, 0.42);
  background: linear-gradient(145deg, rgba(55, 112, 204, 0.15), rgba(55, 112, 204, 0.055));
  box-shadow: 0 12rpx 28rpx rgba(20, 69, 145, 0.12);
}

.permission-option-pressed {
  opacity: 0.76;
  transform: scale(0.98);
}

.permission-option-disabled {
  opacity: 0.52;
}

.permission-option-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid rgba(100, 146, 215, 0.18);
  border-radius: 15rpx;
  background: rgba(70, 121, 199, 0.08);
  color: #789bce;
}

.permission-option-active .permission-option-icon {
  border-color: rgba(101, 157, 243, 0.32);
  background: rgba(64, 126, 223, 0.14);
  color: #8cb7fb;
}

.permission-icon {
  position: relative;
  width: 25rpx;
  height: 25rpx;
  box-sizing: border-box;
}

.permission-icon-car {
  width: 27rpx;
  height: 13rpx;
  margin-top: 5rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}

.permission-icon-car::before {
  position: absolute;
  top: -9rpx;
  left: 4rpx;
  width: 15rpx;
  height: 9rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
  box-sizing: border-box;
  content: "";
}

.permission-icon-car::after {
  position: absolute;
  bottom: -6rpx;
  left: 3rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 13rpx 0 0 currentColor;
  content: "";
}

.permission-icon-calendar {
  width: 25rpx;
  height: 23rpx;
  margin-top: 2rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}

.permission-icon-calendar::before {
  position: absolute;
  top: 5rpx;
  right: 0;
  left: 0;
  height: 2rpx;
  background: currentColor;
  content: "";
}

.permission-icon-calendar::after {
  position: absolute;
  top: -5rpx;
  left: 4rpx;
  width: 2rpx;
  height: 7rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 11rpx 0 0 currentColor;
  content: "";
}

.permission-option-copy {
  flex: 1;
  min-width: 0;
  margin-left: 13rpx;
}

.permission-option-title {
  color: #e9edf3;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.35;
}

.permission-option-desc {
  margin-top: 5rpx;
  color: #687587;
  font-size: 15rpx;
  line-height: 1.35;
}

.permission-option-check {
  position: relative;
  flex-shrink: 0;
  width: 25rpx;
  height: 25rpx;
  margin-left: 9rpx;
  border: 2rpx solid #4f5967;
  border-radius: 50%;
  box-sizing: border-box;
}

.permission-option-active .permission-option-check {
  border-color: #639af0;
  background: #3978d8;
  box-shadow: 0 0 13rpx rgba(73, 132, 224, 0.34);
}

.permission-option-check-mark {
  position: absolute;
  top: 4rpx;
  left: 7rpx;
  width: 5rpx;
  height: 9rpx;
  border-right: 2rpx solid #ffffff;
  border-bottom: 2rpx solid #ffffff;
  opacity: 0;
  transform: rotate(45deg);
}

.permission-option-active .permission-option-check-mark {
  opacity: 1;
}

.action-row {
  display: flex;
  margin-top: 20rpx;
}

.form-tip {
  display: flex;
  align-items: flex-start;
}

.form-tip text {
  flex: 1;
  min-width: 0;
}

.role-tip-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 22rpx;
  height: 22rpx;
  margin-top: 8rpx;
  margin-right: 10rpx;
  border: 2rpx solid #64758d;
  border-radius: 50%;
  box-sizing: border-box;
}

.role-tip-native-icon::before {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 2rpx;
  height: 2rpx;
  border-radius: 50%;
  background: #64758d;
  content: "";
}

.role-tip-native-icon::after {
  position: absolute;
  top: 9rpx;
  left: 8rpx;
  width: 2rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #64758d;
  content: "";
}

.role-action-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  line-height: 1;
}

.role-action-native-icon {
  position: relative;
  flex-shrink: 0;
  margin-right: 9rpx;
  color: currentColor;
  box-sizing: border-box;
}

.role-save-native-icon {
  width: 22rpx;
  height: 25rpx;
  border: 2rpx solid currentColor;
  border-radius: 6rpx 6rpx 10rpx 10rpx;
}

.role-save-native-icon::after {
  position: absolute;
  top: 4rpx;
  left: 7rpx;
  width: 5rpx;
  height: 9rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.role-reset-native-icon {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.role-reset-native-icon::before,
.role-reset-native-icon::after {
  position: absolute;
  top: 9rpx;
  left: 4rpx;
  width: 11rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.role-reset-native-icon::before {
  transform: rotate(45deg);
}

.role-reset-native-icon::after {
  transform: rotate(-45deg);
}

.role-edit-native-icon {
  width: 7rpx;
  height: 20rpx;
  margin-right: 11rpx;
  border-radius: 3rpx;
  background: currentColor;
  transform: rotate(42deg);
}

.role-edit-native-icon::after {
  position: absolute;
  right: 0;
  bottom: -6rpx;
  left: 0;
  width: 0;
  height: 0;
  margin: auto;
  border-right: 4rpx solid transparent;
  border-left: 4rpx solid transparent;
  border-top: 6rpx solid currentColor;
  content: "";
}

.role-more-native-icon {
  width: 13rpx;
  height: 13rpx;
  margin-top: -6rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.save-btn,
.reset-btn {
  flex: 1;
}

.reset-btn {
  margin-left: 16rpx;
}

.role-list {
  margin-top: 16rpx;
}

.role-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #262626;
}

.role-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.role-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(91, 139, 211, 0.18);
  border-radius: 17rpx;
  background: rgba(64, 110, 181, 0.07);
  color: #7294c7;
}

.role-avatar-admin {
  border-color: rgba(195, 154, 76, 0.22);
  background: rgba(170, 126, 49, 0.08);
  color: #c3a05c;
}

.role-member-icon {
  position: relative;
  width: 25rpx;
  height: 25rpx;
}

.role-member-icon::before {
  position: absolute;
  top: 0;
  left: 8rpx;
  width: 9rpx;
  height: 9rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  content: "";
}

.role-member-icon::after {
  position: absolute;
  right: 3rpx;
  bottom: 1rpx;
  left: 3rpx;
  height: 10rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 12rpx 12rpx 0 0;
  box-sizing: border-box;
  content: "";
}

.role-shield-icon {
  position: relative;
  width: 23rpx;
  height: 27rpx;
  border: 2rpx solid currentColor;
  border-radius: 7rpx 7rpx 11rpx 11rpx;
  box-sizing: border-box;
}

.role-shield-icon::after {
  position: absolute;
  top: 5rpx;
  left: 7rpx;
  width: 5rpx;
  height: 9rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.role-openid {
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.role-permission-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.role-permission-row .role-permission {
  margin-top: 0;
}

.role-permission-dot {
  flex-shrink: 0;
  width: 7rpx;
  height: 7rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: #6088bd;
  box-shadow: 0 0 10rpx rgba(96, 136, 189, 0.34);
}

.role-permission-dot-admin {
  background: #c19a50;
  box-shadow: 0 0 10rpx rgba(193, 154, 80, 0.34);
}

.edit-btn {
  min-width: 132rpx;
}

.admin-tag {
  min-width: 132rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
  box-sizing: border-box;
}

.empty-wrap {
  padding: 40rpx 0 12rpx;
  text-align: center;
}

.load-more-btn {
  margin-top: 24rpx;
}

.role-list-end {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 4rpx;
  color: #687485;
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.role-complete-native-icon {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.role-complete-native-icon::after {
  position: absolute;
  top: 3rpx;
  left: 6rpx;
  width: 4rpx;
  height: 8rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.role-page.management-page .hero-card,
.role-page.management-page .form-card,
.role-page.management-page .list-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-color: rgba(255, 255, 255, 0.075);
  border-radius: 26rpx;
}

.role-page.management-page .form-card,
.role-page.management-page .list-card {
  background: #15181d;
}

.role-page.management-page .openid-input {
  height: 82rpx;
  margin-top: 4rpx;
}

.role-page.management-page .form-tip,
.role-page.management-page .section-desc,
.role-page.management-page .role-permission,
.role-page.management-page .loading-text,
.role-page.management-page .empty-desc {
  color: #737e8c;
  font-size: 21rpx;
}

.role-page.management-page .save-btn,
.role-page.management-page .reset-btn,
.role-page.management-page .load-more-btn {
  height: 82rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 82rpx;
}

.role-page.management-page .role-item {
  margin-bottom: 12rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.065);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.025);
}

.role-page.management-page .role-openid {
  color: #e5e9ef;
  font-family: monospace;
  font-size: 21rpx;
}

.role-page.management-page .admin-tag {
  border: 1rpx solid rgba(84, 143, 255, 0.24);
  background: rgba(47, 128, 237, 0.1);
  color: #83b0fb;
}

.role-skeleton {
  margin-top: 20rpx;
}

.role-skeleton-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.02);
}

.role-skeleton-item-muted {
  opacity: 0.7;
}

.role-skeleton-copy {
  flex: 1;
  min-width: 0;
  padding-right: 22rpx;
}

.role-skeleton-avatar {
  flex: 0 0 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 17rpx;
}

.role-skeleton-openid {
  width: 78%;
  height: 23rpx;
  border-radius: 8rpx;
}

.role-skeleton-permission {
  width: 58%;
  height: 19rpx;
  margin-top: 16rpx;
  border-radius: 8rpx;
}

.role-skeleton-action {
  flex: 0 0 132rpx;
  height: 68rpx;
  border-radius: 18rpx;
}

.role-empty-emblem {
  width: 88rpx;
  height: 88rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.2);
  border-radius: 50%;
  opacity: 0.76;
}

.role-empty-kicker {
  margin-top: 17rpx;
  color: #60738f;
  font-size: 14rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.role-page.management-page .empty-title {
  margin-top: 8rpx;
}
