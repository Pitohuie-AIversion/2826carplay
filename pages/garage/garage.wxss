.garage-page {
  position: relative;
  min-height: 100vh;
  padding: 42rpx 24rpx 220rpx;
  overflow: hidden;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, rgba(18, 24, 34, 0.98) 0%, #0b0d10 540rpx),
    #0b0d10;
}

.ambient {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ambient-blue {
  top: -160rpx;
  right: -220rpx;
  width: 520rpx;
  height: 520rpx;
  background: rgba(47, 128, 237, 0.12);
  filter: blur(90rpx);
}

.ambient-silver {
  top: 280rpx;
  left: -240rpx;
  width: 420rpx;
  height: 420rpx;
  background: rgba(185, 202, 226, 0.06);
  filter: blur(80rpx);
}

.garage-header,
.category-scroll,
.summary-panel,
.car-list,
.empty-state {
  position: relative;
  z-index: 1;
}

.garage-load-more {
  margin-top: 24rpx;
}

.garage-capacity-tip {
  margin-top: 18rpx;
  color: #89919d;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.garage-header {
  padding: 12rpx 10rpx 18rpx;
}

.header-kicker {
  display: flex;
  align-items: center;
  color: #6f88ad;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 4rpx;
}

.kicker-line {
  width: 36rpx;
  height: 2rpx;
  margin-right: 14rpx;
  background: #4d8dff;
}

.header-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.page-title {
  flex: 1;
  min-width: 0;
  color: #f7f9fc;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 70rpx;
  height: 70rpx;
  margin-left: 24rpx;
  border: 1rpx solid rgba(114, 158, 230, 0.34);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.035);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.28);
  overflow: hidden;
}

.brand-mark-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.page-desc {
  max-width: 620rpx;
  margin-top: 16rpx;
  color: #8d96a4;
  font-size: 24rpx;
  line-height: 1.7;
}

.category-scroll {
  width: calc(100% + 48rpx);
  margin-top: 24rpx;
  margin-left: -24rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 0 34rpx 10rpx;
}

.category-item {
  flex-shrink: 0;
  min-height: 70rpx;
  margin-right: 14rpx;
  max-width: 320rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  overflow: hidden;
}

.category-count {
  min-width: 34rpx;
  margin-left: 12rpx;
  padding: 5rpx 10rpx;
  font-size: 18rpx;
  line-height: 1.2;
  text-align: center;
}

.ui-pill-active .category-count {
  background: rgba(255, 255, 255, 0.16);
}

.summary-panel {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 28rpx;
  overflow: hidden;
  border-color: rgba(111, 153, 220, 0.14);
  background:
    linear-gradient(135deg, rgba(29, 37, 49, 0.96), rgba(16, 20, 26, 0.98));
}

.summary-panel::after {
  position: absolute;
  top: -80rpx;
  right: 54rpx;
  width: 180rpx;
  height: 180rpx;
  border: 1rpx solid rgba(93, 143, 229, 0.11);
  border-radius: 50%;
  content: "";
}

.summary-copy {
  flex: 1;
  min-width: 0;
}

.summary-label,
.list-kicker {
  color: #63738b;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 3rpx;
}

.summary-title {
  margin-top: 6rpx;
  color: #f4f6f9;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.45;
}

.summary-stats {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.summary-stat {
  display: flex;
  align-items: baseline;
}

.summary-number {
  color: #f5f7fa;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.summary-number-active {
  color: #6aa1ff;
}

.summary-unit {
  margin-left: 8rpx;
  color: #7f8997;
  font-size: 19rpx;
  line-height: 1.4;
}

.summary-divider {
  width: 1rpx;
  height: 28rpx;
  margin: 0 18rpx;
  background: rgba(255, 255, 255, 0.1);
}

.summary-service {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 20rpx;
  padding-left: 22rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid rgba(91, 145, 238, 0.28);
  border-radius: 50%;
  background: rgba(47, 128, 237, 0.11);
  color: #75a8ff;
  font-size: 30rpx;
}

.service-copy {
  display: none;
}

.list-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 38rpx 8rpx 22rpx;
}

.list-title {
  margin-top: 4rpx;
  color: #f4f6f9;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.35;
}

.list-count {
  padding-bottom: 4rpx;
  color: #5f6875;
  font-size: 18rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.empty-state {
  margin-top: 34rpx;
  padding: 70rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  background: #14171c;
  text-align: center;
}

.empty-title {
  color: #f5f7fa;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.empty-desc {
  margin: 14rpx 0 28rpx;
  color: #89919d;
  font-size: 24rpx;
  line-height: 1.65;
}

.bottom-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 20;
  display: flex;
  padding: 12rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 30rpx;
  background: rgba(19, 22, 27, 0.95);
  box-shadow: 0 22rpx 60rpx rgba(0, 0, 0, 0.42);
  box-sizing: border-box;
}

.bottom-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  height: 90rpx;
  margin: 0;
  padding: 0;
  border-radius: 22rpx;
  background: transparent;
  color: #7d8591;
  line-height: 1;
}

.bottom-action::after {
  border: 0;
}

.bottom-icon {
  height: 36rpx;
  color: #747d8a;
  font-size: 29rpx;
  line-height: 32rpx;
}

.bottom-label {
  margin-top: 7rpx;
  color: #737c89;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1;
}

.bottom-icon-active,
.bottom-label-active {
  color: #6fa5ff;
}

.garage-skeleton {
  position: relative;
  z-index: 1;
}

.garage-skeleton-pills {
  display: flex;
  margin: 18rpx 0 24rpx;
  overflow: hidden;
}

.garage-skeleton-pill {
  flex: 0 0 124rpx;
  height: 64rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
}

.garage-skeleton-pill-wide {
  flex-basis: 166rpx;
}

.garage-skeleton-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 206rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.garage-skeleton-copy {
  flex: 1;
}

.garage-skeleton-kicker {
  width: 190rpx;
  height: 18rpx;
  border-radius: 9rpx;
}

.garage-skeleton-title {
  width: 236rpx;
  height: 38rpx;
  margin-top: 18rpx;
  border-radius: 10rpx;
}

.garage-skeleton-numbers {
  width: 176rpx;
  height: 28rpx;
  margin-top: 25rpx;
  border-radius: 10rpx;
}

.garage-skeleton-service {
  width: 190rpx;
  height: 88rpx;
  margin-left: 24rpx;
  border-radius: 20rpx;
}

.garage-skeleton-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 38rpx 8rpx 20rpx;
}

.garage-skeleton-list-title {
  width: 150rpx;
  height: 34rpx;
  margin-top: 13rpx;
  border-radius: 9rpx;
}

.garage-skeleton-count {
  width: 116rpx;
  height: 20rpx;
  border-radius: 9rpx;
}

.garage-skeleton-card {
  display: flex;
  min-height: 226rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.garage-skeleton-cover {
  flex: 0 0 238rpx;
  height: 190rpx;
  border-radius: 20rpx;
}

.garage-skeleton-card-body {
  flex: 1;
  padding: 20rpx 8rpx 12rpx 24rpx;
}

.garage-skeleton-card-title {
  width: 74%;
  height: 34rpx;
  border-radius: 9rpx;
}

.garage-skeleton-card-line {
  width: 92%;
  height: 20rpx;
  margin-top: 24rpx;
  border-radius: 8rpx;
}

.garage-skeleton-card-meta {
  width: 56%;
  height: 24rpx;
  margin-top: 38rpx;
  border-radius: 8rpx;
}

.skeleton-pulse {
  background: linear-gradient(105deg, #181c22 12%, #252b34 34%, #181c22 56%);
  background-size: 220% 100%;
  animation: garageSkeletonPulse 1.6s ease-in-out infinite;
}

@keyframes garageSkeletonPulse {
  0% {
    background-position: 160% 0;
  }

  100% {
    background-position: -70% 0;
  }
}
