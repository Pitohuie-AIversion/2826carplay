.car-card {
  position: relative;
  height: 422rpx;
  margin-bottom: 26rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  background: #171a1f;
  box-shadow: 0 22rpx 52rpx rgba(0, 0, 0, 0.28);
  transition: opacity 140ms ease, transform 140ms ease, border-color 140ms ease;
}
.car-card:active {
  opacity: 0.92;
  transform: scale(0.992);
}
.car-card-pressed {
  border-color: rgba(110, 164, 250, 0.36);
  opacity: 0.9;
  transform: scale(0.982);
}
.car-cover {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1e2229, #0e1013);
}
.car-cover-image {
  opacity: 0;
  transition: opacity 320ms ease;
}
.car-cover-image-loaded {
  opacity: 1;
}
.car-cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 30rpx;
  background:
    radial-gradient(circle at 76% 38%, rgba(75, 130, 218, 0.26), transparent 36%),
    linear-gradient(135deg, #202b3c, #0e131a);
  box-sizing: border-box;
}
.car-cover-placeholder-brand {
  display: flex;
  align-items: center;
  margin-bottom: 17rpx;
}
.car-cover-placeholder-emblem {
  flex-shrink: 0;
  width: 50rpx;
  height: 50rpx;
  margin-right: 13rpx;
  border: 1rpx solid rgba(125, 169, 236, 0.24);
  border-radius: 50%;
  opacity: 0.82;
}
.car-cover-placeholder-kicker {
  color: rgba(174, 199, 237, 0.7);
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.3;
  letter-spacing: 2.4rpx;
}
.car-cover-placeholder-title {
  color: rgba(255, 255, 255, 0.94);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}
.car-cover-placeholder-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 22rpx;
  line-height: 1.5;
}
.car-image-loading {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
  padding: 30rpx;
  background:
    radial-gradient(circle at 76% 38%, rgba(75, 130, 218, 0.16), transparent 36%),
    linear-gradient(135deg, #1c2532, #0e131a);
  box-sizing: border-box;
}
.car-image-loading::after {
  position: absolute;
  top: -80rpx;
  left: -180rpx;
  width: 160rpx;
  height: 580rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.07), transparent);
  content: "";
  transform: rotate(22deg);
  animation: carImageSweep 1.55s ease-in-out infinite;
}
.car-image-loading-mark {
  position: relative;
  width: 64rpx;
  height: 64rpx;
}
.car-image-loading-emblem {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  opacity: 0.5;
}
.car-image-loading-ring {
  position: absolute;
  top: -7rpx;
  right: -7rpx;
  bottom: -7rpx;
  left: -7rpx;
  border: 2rpx solid rgba(123, 166, 232, 0.16);
  border-top-color: rgba(123, 166, 232, 0.66);
  border-radius: 50%;
  animation: carImageSpin 1.2s linear infinite;
}
.car-image-loading-line {
  height: 20rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: rgba(124, 145, 176, 0.12);
}
.car-image-loading-line-primary {
  width: 230rpx;
}
.car-image-loading-line-secondary {
  width: 154rpx;
  margin-top: 12rpx;
}
.car-visual-sheen {
  position: absolute;
  top: -80rpx;
  right: 60rpx;
  width: 160rpx;
  height: 520rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.055), transparent);
  transform: rotate(22deg);
}
.car-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 26rpx;
  background:
    linear-gradient(180deg, rgba(4, 6, 9, 0.64) 0%, rgba(4, 6, 9, 0.02) 42%, rgba(4, 6, 9, 0.86) 100%);
  box-sizing: border-box;
}
.car-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.car-identity {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}
.car-edition {
  color: rgba(180, 202, 235, 0.68);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 3rpx;
}
.car-nickname {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.22;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.45);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.car-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 46rpx;
  margin-left: 12rpx;
  padding: 10rpx 18rpx;
  max-width: 176rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.car-status::before {
  width: 9rpx;
  height: 9rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}
.car-status.status-available,
.car-status.status-active,
.car-status.status-contacted {
  background: rgba(47, 128, 237, 0.88);
}
.car-status.status-idle,
.car-status.status-completed {
  background: rgba(31, 143, 91, 0.88);
}
.car-status.status-maintenance {
  background: rgba(221, 128, 39, 0.9);
}
.car-status.status-retired,
.car-status.status-rented {
  background: rgba(92, 101, 115, 0.9);
}
.car-status.status-reserved {
  background: rgba(124, 76, 190, 0.9);
}
.car-status.status-pending {
  background: rgba(76, 85, 99, 0.9);
}
.car-status.status-cancelled {
  background: rgba(190, 55, 65, 0.9);
}
.car-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding-right: 44rpx;
}
.car-meta {
  flex: 1;
  min-width: 0;
}
.car-name {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 550;
  line-height: 1.45;
  text-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.car-tags {
  height: 47rpx;
  margin-top: 11rpx;
  overflow: hidden;
}
.car-tag {
  display: inline-block;
  margin-right: 10rpx;
  padding: 7rpx 14rpx;
  max-width: 180rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  line-height: 1.3;
  background: rgba(7, 9, 12, 0.36);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.car-price-wrap {
  flex-shrink: 0;
  margin-left: 18rpx;
  max-width: 210rpx;
  text-align: right;
}
.car-price-label {
  color: rgba(187, 199, 217, 0.58);
  font-size: 22rpx;
  line-height: 1.3;
  letter-spacing: 2rpx;
}
.car-price {
  margin-top: 5rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.35;
  text-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-corner {
  position: absolute;
  right: 22rpx;
  bottom: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: 1rpx solid rgba(130, 173, 239, 0.28);
  border-radius: 50%;
  background: rgba(40, 82, 147, 0.2);
  color: rgba(255, 255, 255, 0.78);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
}
.card-corner-arrow {
  position: relative;
  width: 13rpx;
  height: 13rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  box-sizing: border-box;
}
.card-corner-arrow::after {
  position: absolute;
  top: -2rpx;
  right: -1rpx;
  width: 18rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
  transform: rotate(-45deg);
  transform-origin: right center;
}
@keyframes carImageSweep {
  0% {
    left: -220rpx;
  }
  100% {
    left: 780rpx;
  }
}
@keyframes carImageSpin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
