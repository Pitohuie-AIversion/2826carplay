<view wx:if="{{pageAuthorized}}" class="vehicle-edit-page vehicle-form-page">
  <view class="page-glow"></view>

  <view class="hero-card">
    <view class="hero-top">
      <view>
        <view class="page-kicker">FLEET EDITOR</view>
        <view class="hero-title">编辑车辆</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    </view>
    <view class="hero-desc">维护车辆基础资料、租赁信息与展示素材</view>
    <view wx:if="{{!loading && !loadFailed}}" class="vehicle-form-progress {{formProgress.ready ? 'vehicle-form-progress-ready' : ''}}" aria-role="group" aria-label="车辆必填信息完成度 {{formProgress.completed}} / {{formProgress.total}}，{{formProgress.hint}}">
      <view class="vehicle-form-progress-head">
        <view class="vehicle-form-progress-title">必填信息完成度</view>
        <view class="vehicle-form-progress-value">{{formProgress.completed}} / {{formProgress.total}}</view>
      </view>
      <view class="vehicle-form-progress-track" aria-hidden="true"><view class="vehicle-form-progress-fill" style="width: {{formProgress.percent}}%;"></view></view>
      <view class="vehicle-form-progress-hint">
        <view class="vehicle-form-progress-icon" aria-hidden="true"><view class="vehicle-form-progress-check"></view></view>
        <text>{{formProgress.hint}}</text>
      </view>
    </view>
  </view>

  <view class="loading-card" wx:if="{{loading}}" aria-hidden="true">
    <view class="vehicle-form-skeleton-heading">
      <view>
        <view class="vehicle-form-skeleton-kicker vehicle-form-skeleton-pulse"></view>
        <view class="vehicle-form-skeleton-title vehicle-form-skeleton-pulse"></view>
      </view>
      <view class="vehicle-form-skeleton-index vehicle-form-skeleton-pulse"></view>
    </view>
    <view class="vehicle-form-skeleton-divider"></view>
    <view class="vehicle-form-skeleton-row">
      <view class="vehicle-form-skeleton-field">
        <view class="vehicle-form-skeleton-label vehicle-form-skeleton-pulse"></view>
        <view class="vehicle-form-skeleton-input vehicle-form-skeleton-pulse"></view>
      </view>
      <view class="vehicle-form-skeleton-field">
        <view class="vehicle-form-skeleton-label vehicle-form-skeleton-pulse"></view>
        <view class="vehicle-form-skeleton-input vehicle-form-skeleton-pulse"></view>
      </view>
    </view>
    <view class="vehicle-form-skeleton-field vehicle-form-skeleton-field-full">
      <view class="vehicle-form-skeleton-label vehicle-form-skeleton-pulse"></view>
      <view class="vehicle-form-skeleton-input vehicle-form-skeleton-pulse"></view>
    </view>
  </view>

  <view class="vehicle-form-state" wx:elif="{{loadFailed}}">
    <image class="vehicle-form-state-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    <view class="vehicle-form-state-kicker">FLEET EDITOR</view>
    <view class="vehicle-form-state-title">车辆档案不可用</view>
    <view class="vehicle-form-state-desc">{{loadErrorText}}</view>
    <button wx:if="{{id}}" class="vehicle-form-state-button vehicle-form-state-button-primary" bindtap="handleRetryLoad" hover-class="vehicle-form-state-button-pressed">
      <view class="vehicle-form-action-content"><view class="vehicle-action-native-icon vehicle-retry-native-icon" aria-hidden="true"></view><text>重新加载</text></view>
    </button>
    <button class="vehicle-form-state-button vehicle-form-state-button-secondary" bindtap="handleBackList" hover-class="vehicle-form-state-button-pressed">
      <view class="vehicle-form-action-content"><view class="vehicle-action-native-icon vehicle-back-native-icon" aria-hidden="true"></view><text>返回车辆列表</text></view>
    </button>
  </view>

  <view wx:else>
    <view class="form-card">
      <view class="section-heading">
        <view class="section-heading-main">
          <view class="vehicle-section-glyph vehicle-section-glyph-identity" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
          <view>
            <view class="section-kicker">IDENTITY</view>
            <view class="section-title">车辆身份</view>
          </view>
        </view>
        <view class="section-index">01</view>
      </view>
      <view class="form-divider"></view>

      <view class="form-row">
        <view class="field-group field-group-half">
          <view class="field-label field-label-row"><text>车牌号</text><text class="field-required">必填</text></view>
          <input
            class="field-input {{formProgress.plateNumberComplete ? 'vehicle-form-control-complete' : ''}}"
            placeholder="例如 京A12345"
            placeholder-class="input-placeholder"
            value="{{form.plateNumber}}"
            maxlength="8"
            disabled="{{isSubmitting}}"
            bindinput="handlePlateInput"
            confirm-type="next"
            aria-label="填写车牌号"
            aria-required="{{true}}"
          />
        </view>

        <view class="field-group field-group-half">
          <view class="field-label field-label-row"><text>车辆类型</text><text class="field-required">必填</text></view>
          <picker range="{{vehicleTypeLabels}}" value="{{vehicleTypeIndex}}" disabled="{{isSubmitting}}" bindchange="handleVehicleTypeChange" aria-label="选择车辆类型" aria-required="{{true}}">
            <view class="picker-field {{form.vehicleType ? '' : 'picker-field-placeholder'}} {{formProgress.vehicleTypeComplete ? 'vehicle-form-control-complete' : ''}}" hover-class="vehicle-picker-pressed">
              <text>{{vehicleTypeLabel || "选择类型"}}</text>
              <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
            </view>
          </picker>
        </view>
      </view>

      <view class="field-group">
        <view class="field-label field-label-row"><text>品牌型号</text><text class="field-required">必填</text></view>
        <input
          class="field-input {{formProgress.brandModelComplete ? 'vehicle-form-control-complete' : ''}}"
          placeholder="例如 BMW 740Li"
          placeholder-class="input-placeholder"
          value="{{form.brandModel}}"
          maxlength="50"
          data-field="brandModel"
          disabled="{{isSubmitting}}"
          bindinput="handleTextInput"
          confirm-type="done"
          aria-label="填写车辆品牌型号"
          aria-required="{{true}}"
        />
      </view>

      <view class="form-row">
        <view class="field-group field-group-half">
          <view class="field-label field-label-row"><text>注册日期</text><text class="field-required">必填</text></view>
          <picker mode="date" end="{{today}}" value="{{form.registerDate}}" disabled="{{isSubmitting}}" bindchange="handleDateChange" aria-label="选择注册日期" aria-required="{{true}}">
            <view class="picker-field {{form.registerDate ? '' : 'picker-field-placeholder'}} {{formProgress.registerDateComplete ? 'vehicle-form-control-complete' : ''}}" hover-class="vehicle-picker-pressed">
              <text>{{form.registerDate || "选择日期"}}</text>
              <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
            </view>
          </picker>
        </view>

        <view class="field-group field-group-half">
          <view class="field-label field-label-row"><text>使用状态</text><text class="field-required">必填</text></view>
          <picker range="{{statusLabels}}" value="{{statusIndex}}" disabled="{{isSubmitting}}" bindchange="handleStatusChange" aria-label="选择使用状态" aria-required="{{true}}">
            <view class="picker-field {{form.status ? '' : 'picker-field-placeholder'}} {{formProgress.statusComplete ? 'vehicle-form-control-complete' : ''}}" hover-class="vehicle-picker-pressed">
              <text>{{statusLabel || "选择状态"}}</text>
              <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
            </view>
          </picker>
        </view>
      </view>
    </view>

    <view class="form-card">
      <view class="section-heading">
        <view class="section-heading-main">
          <view class="vehicle-section-glyph vehicle-section-glyph-rental" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
          <view>
            <view class="section-kicker">RENTAL PROFILE</view>
            <view class="section-title">展示与租赁</view>
          </view>
        </view>
        <view class="section-index">02</view>
      </view>
      <view class="form-divider"></view>
      <view class="section-helper">选填信息 · 完善后将用于车库前台展示</view>

      <view class="form-row">
        <view class="field-group field-group-half">
          <view class="field-label">取车城市</view>
          <input class="field-input" placeholder="例如 杭州" placeholder-class="input-placeholder" value="{{form.location}}" maxlength="20" data-field="location" disabled="{{isSubmitting}}" bindinput="handleTextInput" confirm-type="done" aria-label="所在城市" />
        </view>
        <view class="field-group field-group-half">
          <view class="field-label">日租金</view>
          <input class="field-input" type="number" placeholder="例如 699" placeholder-class="input-placeholder" value="{{form.priceDay}}" maxlength="5" data-field="priceDay" disabled="{{isSubmitting}}" bindinput="handleTextInput" confirm-type="done" aria-label="日租价格" />
        </view>
      </view>

      <view class="form-row">
        <view class="field-group field-group-half">
          <view class="field-label">变速箱</view>
          <picker range="{{transmissionLabels}}" value="{{transmissionIndex}}" disabled="{{isSubmitting}}" bindchange="handleTransmissionChange" aria-label="选择变速箱类型">
            <view class="picker-field {{form.transmission ? '' : 'picker-field-placeholder'}}" hover-class="vehicle-picker-pressed">
              <text>{{transmissionLabel || "选择类型"}}</text>
              <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
            </view>
          </picker>
        </view>
        <view class="field-group field-group-half">
          <view class="field-label">燃油类型</view>
          <picker range="{{fuelTypeLabels}}" value="{{fuelTypeIndex}}" disabled="{{isSubmitting}}" bindchange="handleFuelTypeChange" aria-label="选择燃油类型">
            <view class="picker-field {{form.fuelType ? '' : 'picker-field-placeholder'}}" hover-class="vehicle-picker-pressed">
              <text>{{fuelTypeLabel || "选择类型"}}</text>
              <view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view>
            </view>
          </picker>
        </view>
      </view>

      <view class="field-group">
        <view class="field-label">座位数</view>
        <input class="field-input" type="number" placeholder="例如 5" placeholder-class="input-placeholder" value="{{form.seats}}" maxlength="1" data-field="seats" disabled="{{isSubmitting}}" bindinput="handleTextInput" confirm-type="done" aria-label="座位数" />
      </view>

      <view class="field-group">
        <view class="field-label field-label-row"><text>公开说明</text><text class="field-counter">{{publicDescriptionLength}} / 200</text></view>
        <textarea
          class="field-textarea"
          placeholder="填写车辆亮点、租赁提示等公开内容"
          placeholder-class="input-placeholder"
          value="{{form.publicDescription}}"
          maxlength="200"
          data-field="publicDescription"
          disabled="{{isSubmitting}}"
          bindinput="handleTextInput"
          aria-label="公开说明"
        />
        <view class="section-helper">此内容会显示在首页和车辆详情，请勿填写内部档案信息。</view>
      </view>
    </view>

    <view class="form-card">
      <view class="section-heading">
        <view class="section-heading-main">
          <view class="vehicle-section-glyph vehicle-section-glyph-rental" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
          <view>
            <view class="section-kicker">TRUST PROFILE</view>
            <view class="section-title">公开可信档案</view>
          </view>
        </view>
        <view class="section-index">03</view>
      </view>
      <view class="form-divider"></view>
      <view class="section-helper">以下摘要会公开展示；有缺失、超过 180 天或未经复核时，前台会如实标记。</view>

      <view class="form-row">
        <view class="field-group field-group-half">
          <view class="field-label">实拍/资料更新</view>
          <picker mode="date" end="{{today}}" value="{{form.publicMaterialsUpdatedDate}}" data-field="publicMaterialsUpdatedDate" disabled="{{isSubmitting}}" bindchange="handleArchiveDateChange" aria-label="选择实拍或资料更新日期">
            <view class="picker-field {{form.publicMaterialsUpdatedDate ? '' : 'picker-field-placeholder'}}" hover-class="vehicle-picker-pressed"><text>{{form.publicMaterialsUpdatedDate || "选择日期"}}</text><view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view></view>
          </picker>
        </view>
        <view class="field-group field-group-half">
          <view class="field-label">最近保养/检查</view>
          <picker mode="date" end="{{today}}" value="{{form.publicInspectionDate}}" data-field="publicInspectionDate" disabled="{{isSubmitting}}" bindchange="handleArchiveDateChange" aria-label="选择最近保养或检查日期">
            <view class="picker-field {{form.publicInspectionDate ? '' : 'picker-field-placeholder'}}" hover-class="vehicle-picker-pressed"><text>{{form.publicInspectionDate || "选择日期"}}</text><view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view></view>
          </picker>
        </view>
      </view>

      <view class="field-group">
        <view class="field-label">公开档案状态</view>
        <picker range="{{archiveReviewLabels}}" value="{{archiveReviewIndex}}" disabled="{{isSubmitting}}" bindchange="handleArchiveReviewChange" aria-label="选择公开档案复核状态">
          <view class="picker-field" hover-class="vehicle-picker-pressed"><text>{{archiveReviewLabel}}</text><view class="picker-arrow" aria-hidden="true"><view class="picker-chevron"></view></view></view>
        </picker>
        <view class="section-helper">“已复核”只表示运营人员核对过公开摘要，不代表平台或第三方认证。</view>
      </view>

      <view class="field-group">
        <view class="field-label field-label-row"><text>保养/检查摘要</text><text class="field-counter">{{form.publicInspectionSummary.length}} / 200</text></view>
        <textarea class="field-textarea" placeholder="公开说明最近保养或检查项目" placeholder-class="input-placeholder" value="{{form.publicInspectionSummary}}" maxlength="200" data-field="publicInspectionSummary" disabled="{{isSubmitting}}" bindinput="handleTextInput" aria-label="保养或检查摘要" />
      </view>
      <view class="field-group">
        <view class="field-label field-label-row"><text>已知外观情况</text><text class="field-counter">{{form.publicExteriorSummary.length}} / 200</text></view>
        <textarea class="field-textarea" placeholder="如实说明当前已知划痕、修复或无明显异常" placeholder-class="input-placeholder" value="{{form.publicExteriorSummary}}" maxlength="200" data-field="publicExteriorSummary" disabled="{{isSubmitting}}" bindinput="handleTextInput" aria-label="已知外观情况" />
      </view>
      <view class="field-group">
        <view class="field-label field-label-row"><text>商业保险摘要</text><text class="field-counter">{{form.publicInsuranceSummary.length}} / 200</text></view>
        <textarea class="field-textarea" placeholder="仅填写保障范围摘要，不上传或公开完整保单" placeholder-class="input-placeholder" value="{{form.publicInsuranceSummary}}" maxlength="200" data-field="publicInsuranceSummary" disabled="{{isSubmitting}}" bindinput="handleTextInput" aria-label="商业保险摘要" />
      </view>
      <view class="field-group">
        <view class="field-label field-label-row"><text>救援能力摘要</text><text class="field-counter">{{form.publicAssistanceSummary.length}} / 200</text></view>
        <textarea class="field-textarea" placeholder="说明可提供的道路救援或人工协助边界" placeholder-class="input-placeholder" value="{{form.publicAssistanceSummary}}" maxlength="200" data-field="publicAssistanceSummary" disabled="{{isSubmitting}}" bindinput="handleTextInput" aria-label="救援能力摘要" />
      </view>
    </view>

    <view class="form-card">
      <view class="section-heading">
        <view class="section-heading-main">
          <view class="vehicle-section-glyph vehicle-section-glyph-archive" aria-hidden="true"><view class="vehicle-section-glyph-icon"></view></view>
          <view>
            <view class="section-kicker">ARCHIVE</view>
            <view class="section-title">档案与备注</view>
          </view>
        </view>
        <view class="section-index">04</view>
      </view>
      <view class="form-divider"></view>
      <view class="section-helper">选填信息 · 仅用于内部档案，不会在前台展示</view>

      <view class="field-group">
        <view class="field-label">VIN</view>
        <input class="field-input" placeholder="选填，最多 32 位" placeholder-class="input-placeholder" value="{{form.vin}}" maxlength="32" data-field="vin" disabled="{{isSubmitting}}" bindinput="handleTextInput" confirm-type="done" aria-label="车辆识别码 VIN" />
      </view>

      <view class="field-group">
        <view class="field-label field-label-row"><text>内部保养记录</text><text class="field-counter">{{form.internalMaintenanceRecord.length}} / 500</text></view>
        <textarea class="field-textarea" placeholder="仅后台可见，最多 500 字" placeholder-class="input-placeholder" value="{{form.internalMaintenanceRecord}}" maxlength="500" data-field="internalMaintenanceRecord" disabled="{{isSubmitting}}" bindinput="handleTextInput" aria-label="内部保养记录" />
      </view>
      <view class="field-group">
        <view class="field-label field-label-row"><text>内部检查记录</text><text class="field-counter">{{form.internalInspectionRecord.length}} / 500</text></view>
        <textarea class="field-textarea" placeholder="仅后台可见，最多 500 字" placeholder-class="input-placeholder" value="{{form.internalInspectionRecord}}" maxlength="500" data-field="internalInspectionRecord" disabled="{{isSubmitting}}" bindinput="handleTextInput" aria-label="内部检查记录" />
      </view>
      <view class="field-group">
        <view class="field-label field-label-row"><text>内部保险记录</text><text class="field-counter">{{form.internalInsuranceRecord.length}} / 500</text></view>
        <textarea class="field-textarea" placeholder="仅后台可见，最多 500 字" placeholder-class="input-placeholder" value="{{form.internalInsuranceRecord}}" maxlength="500" data-field="internalInsuranceRecord" disabled="{{isSubmitting}}" bindinput="handleTextInput" aria-label="内部保险记录" />
      </view>
      <view class="field-group">
        <view class="field-label field-label-row"><text>内部档案说明</text><text class="field-counter">{{form.internalArchiveNote.length}} / 500</text></view>
        <textarea class="field-textarea" placeholder="仅后台可见，最多 500 字" placeholder-class="input-placeholder" value="{{form.internalArchiveNote}}" maxlength="500" data-field="internalArchiveNote" disabled="{{isSubmitting}}" bindinput="handleTextInput" aria-label="内部档案说明" />
      </view>

      <view class="field-group">
        <view class="field-label">发动机号</view>
        <input class="field-input" placeholder="选填，最多 32 位" placeholder-class="input-placeholder" value="{{form.engineNumber}}" maxlength="32" data-field="engineNumber" disabled="{{isSubmitting}}" bindinput="handleTextInput" confirm-type="done" aria-label="发动机号" />
      </view>

      <view class="field-group">
        <view class="field-label field-label-row"><text>内部备注</text><text class="field-counter">{{noteLength}} / 200</text></view>
        <textarea
          class="field-textarea"
          placeholder="填写维修提醒、档案说明等内部内容"
          placeholder-class="input-placeholder"
          value="{{form.note}}"
          maxlength="200"
          data-field="note"
          disabled="{{isSubmitting}}"
          bindinput="handleTextInput"
          aria-label="内部备注"
        />
      </view>
    </view>

    <view class="vehicle-submit-dock">
      <view class="vehicle-submit-state {{formProgress.ready ? 'vehicle-submit-state-ready' : ''}}">
        <view class="vehicle-submit-state-icon" aria-hidden="true"><view class="vehicle-submit-state-check"></view></view>
        <view>{{formProgress.ready ? '必填信息完整，可保存车辆资料' : formProgress.hint}}</view>
      </view>
      <view class="action-row">
        <button class="secondary-button" bindtap="handleManageImages" disabled="{{loading || isSubmitting}}" hover-class="vehicle-form-button-pressed">
          <view class="vehicle-form-action-content"><view class="vehicle-action-native-icon vehicle-image-native-icon" aria-hidden="true"><view class="vehicle-image-native-sun"></view></view><text>管理车辆图片</text></view>
        </button>
        <button class="submit-button" bindtap="handleSubmit" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" hover-class="vehicle-form-button-pressed">
          <view class="vehicle-form-action-content"><view wx:if="{{!isSubmitting}}" class="vehicle-action-native-icon vehicle-save-native-icon" aria-hidden="true"></view><text>{{isSubmitting ? "正在保存" : "保存车辆资料"}}</text></view>
        </button>
      </view>
    </view>
  </view>
</view>
