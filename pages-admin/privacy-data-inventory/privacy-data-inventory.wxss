@import "../../shared/management-shell.wxss";
.inventory-page {
  min-height: 100vh;
  padding: 24rpx calc(24rpx + env(safe-area-inset-right)) calc(70rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  box-sizing: border-box;
  color: #f4f7fb;
  background: linear-gradient(180deg, #151c27 0%, #0b0d10 520rpx);
}
.hero-card,
.error-card,
.warning-card,
.request-card,
.export-card,
.section-card,
.privacy-note {
  position: relative;
  z-index: 1;
  margin-bottom: 22rpx;
  padding: 28rpx;
  box-sizing: border-box;
}
.hero-card {
  overflow: hidden;
  border-color: rgba(84, 143, 255, 0.2);
}
.hero-top,
.hero-foot,
.section-heading,
.error-card,
.record-head,
.identity-row {
  display: flex;
  align-items: center;
}
.hero-top,
.section-heading,
.record-head {
  justify-content: space-between;
}
.hero-copy,
.error-copy {
  flex: 1;
  min-width: 0;
}
.page-kicker,
.section-eyebrow {
  color: #7185a2;
  font-size: 15rpx;
  font-weight: 650;
  line-height: 1.4;
  letter-spacing: 2.5rpx;
}
.hero-title {
  margin-top: 7rpx;
  color: #f7f9fc;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}
.hero-desc {
  margin-top: 10rpx;
  color: #8d98a7;
  font-size: 21rpx;
  line-height: 1.6;
}
.hero-emblem {
  flex-shrink: 0;
  width: 82rpx;
  height: 82rpx;
  margin-left: 20rpx;
  border: 1rpx solid rgba(113, 163, 246, 0.28);
  border-radius: 50%;
}
.hero-foot {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}
.live-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #53d59a;
  box-shadow: 0 0 16rpx rgba(83, 213, 154, 0.5);
}
.hero-foot-text {
  flex: 1;
  color: #758193;
  font-size: 18rpx;
}
.refresh-link {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 8rpx;
  color: #84b1fb;
  font-size: 19rpx;
  font-weight: 600;
  box-sizing: border-box;
  transition: opacity 120ms ease, transform 120ms ease;
}
.refresh-link-disabled {
  color: #5f6b7b;
}
.refresh-link-pressed {
  opacity: 0.7;
  transform: scale(0.96);
}
.error-card {
  min-height: 130rpx;
}
.error-title,
.warning-title {
  color: #e9edf3;
  font-size: 22rpx;
  font-weight: 600;
}
.error-desc,
.warning-desc {
  margin-top: 7rpx;
  color: #7b8796;
  font-size: 18rpx;
  line-height: 1.55;
}
.inventory-skeleton {
  position: relative;
  z-index: 1;
}
.inventory-skeleton-request,
.inventory-skeleton-progress,
.inventory-skeleton-section {
  margin-bottom: 22rpx;
  padding: 28rpx;
  box-sizing: border-box;
}
.inventory-skeleton-heading,
.inventory-skeleton-request-heading,
.inventory-skeleton-identity,
.inventory-skeleton-progress-foot {
  display: flex;
  align-items: center;
}
.inventory-skeleton-heading,
.inventory-skeleton-progress-foot {
  justify-content: space-between;
}
.inventory-skeleton-type {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
}
.inventory-skeleton-kicker {
  width: 112rpx;
  height: 13rpx;
  border-radius: 5rpx;
}
.inventory-skeleton-title {
  width: 132rpx;
  height: 23rpx;
  margin-top: 8rpx;
  border-radius: 7rpx;
}
.inventory-skeleton-status {
  width: 78rpx;
  height: 29rpx;
  border-radius: 999rpx;
}
.inventory-skeleton-identity {
  margin-top: 23rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 17rpx;
}
.inventory-skeleton-identity-icon {
  flex-shrink: 0;
  width: 38rpx;
  height: 38rpx;
  margin-right: 13rpx;
  border-radius: 12rpx;
}
.inventory-skeleton-copy {
  flex: 1;
  min-width: 0;
}
.inventory-skeleton-label {
  width: 66rpx;
  height: 13rpx;
  margin-bottom: 8rpx;
  border-radius: 5rpx;
}
.inventory-skeleton-line {
  width: 72%;
  height: 15rpx;
  border-radius: 6rpx;
}
.inventory-skeleton-button {
  flex-shrink: 0;
  width: 72rpx;
  height: 34rpx;
  margin-left: 14rpx;
  border-radius: 10rpx;
}
.inventory-skeleton-detail {
  width: 100%;
  height: 66rpx;
  margin-top: 16rpx;
  border-radius: 14rpx;
}
.inventory-skeleton-track {
  width: 100%;
  height: 12rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
}
.inventory-skeleton-progress-foot {
  margin-top: 15rpx;
}
.inventory-skeleton-progress-meta {
  width: 110rpx;
  height: 14rpx;
  border-radius: 5rpx;
}
.inventory-skeleton-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.inventory-skeleton-metric {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
  padding: 22rpx 12rpx;
  box-sizing: border-box;
}
.inventory-skeleton-metric-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 11rpx;
}
.inventory-skeleton-metric-value {
  width: 46rpx;
  height: 28rpx;
  margin-top: 12rpx;
  border-radius: 7rpx;
}
.inventory-skeleton-metric-label {
  width: 66rpx;
  height: 14rpx;
  margin-top: 8rpx;
  border-radius: 5rpx;
}
.inventory-skeleton-metric-state {
  width: 72rpx;
  height: 25rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
}
.inventory-skeleton-index {
  width: 40rpx;
  height: 28rpx;
  border-radius: 8rpx;
}
.inventory-skeleton-record {
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 17rpx;
}
.inventory-skeleton-record-title {
  width: 42%;
  height: 20rpx;
  margin-bottom: 11rpx;
  border-radius: 6rpx;
}
.inventory-skeleton-line-short {
  width: 54%;
  margin-top: 9rpx;
}
.retry-button {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 62rpx;
  margin-left: 18rpx;
  border-radius: 16rpx;
  font-size: 19rpx;
  line-height: 62rpx;
}
.warning-card {
  align-items: flex-start;
  border-color: rgba(241, 173, 91, 0.2);
  background: rgba(241, 173, 91, 0.06);
}
.export-card {
  border-color: rgba(102, 153, 238, 0.18);
}
.export-security {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(240, 170, 88, 0.1);
  color: #e9ae69;
  font-size: 16rpx;
}
.export-desc,
.export-blocked {
  margin-top: 18rpx;
  color: #8591a1;
  font-size: 19rpx;
  line-height: 1.65;
}
.export-blocked {
  padding: 18rpx;
  border: 1rpx solid rgba(241, 173, 91, 0.16);
  border-radius: 14rpx;
  background: rgba(241, 173, 91, 0.055);
  color: #dca66a;
}
.export-primary {
  width: 100%;
  height: 76rpx;
  margin-top: 22rpx;
  border-radius: 18rpx;
  font-size: 21rpx;
  line-height: 76rpx;
}
.export-result {
  margin-top: 20rpx;
}
.export-file-name {
  overflow: hidden;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.025);
  color: #91a4bf;
  font-family: monospace;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.export-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.export-action {
  flex: 1 1 180rpx;
  height: 66rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 18rpx;
  line-height: 66rpx;
}
.delete-action {
  color: #d99595;
}
.section-title {
  margin-top: 4rpx;
  color: #ecf0f6;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.45;
}
.section-index {
  color: #53637a;
  font-size: 16rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}
.status-pill,
.record-status {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(105, 153, 230, 0.1);
  color: #81aef5;
  font-size: 16rpx;
}
.identity-row {
  margin-top: 22rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.025);
}
.identity-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #8290a3;
  font-family: monospace;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.copy-button {
  width: 110rpx;
  min-width: 110rpx;
  height: 58rpx;
  margin-left: 12rpx;
  padding: 0;
  border-radius: 14rpx;
  font-size: 20rpx;
  line-height: 58rpx;
}
.request-meta {
  margin-top: 16rpx;
  color: #748091;
  font-size: 19rpx;
}
.request-description {
  margin-top: 12rpx;
  color: #aeb8c5;
  font-size: 22rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}
.metric-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.metric-card {
  padding: 22rpx 10rpx;
  text-align: center;
}
.metric-value {
  color: #76aaff;
  font-size: 34rpx;
  font-weight: 700;
}
.metric-label {
  margin-top: 8rpx;
  color: #778392;
  font-size: 17rpx;
}
.record-list {
  margin-top: 20rpx;
}
.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.record-link {
  position: relative;
  transition: opacity 120ms ease, transform 120ms ease;
}
.record-link-pressed {
  opacity: 0.72;
  transform: scale(0.975);
}
.record-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}
.record-link .record-head {
  padding-right: 26rpx;
}
.record-title {
  min-width: 0;
  color: #e8edf4;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-word;
}
.record-meta,
.record-detail {
  margin-top: 8rpx;
  color: #778392;
  font-size: 18rpx;
  line-height: 1.55;
}
.record-note,
.record-resolution {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.025);
  color: #9ea9b7;
  font-size: 19rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}
.record-resolution {
  background: rgba(82, 143, 255, 0.055);
}
.empty-text {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx 0 8rpx;
  color: #748091;
  font-size: 20rpx;
  text-align: center;
}
.inventory-empty-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-right: 9rpx;
  border: 2rpx solid #668a80;
  border-radius: 50%;
  box-sizing: border-box;
}
.inventory-empty-native-icon::after {
  position: absolute;
  top: 6rpx;
  left: 5rpx;
  width: 11rpx;
  height: 6rpx;
  border-bottom: 2rpx solid #74a096;
  border-left: 2rpx solid #74a096;
  content: "";
  transform: rotate(-45deg);
}
.privacy-note {
  border-color: rgba(113, 148, 202, 0.12);
  color: #7f8b9a;
  font-size: 18rpx;
  line-height: 1.7;
}
.refresh-link,
.retry-button,
.export-primary,
.export-action,
.export-security,
.status-pill,
.record-status,
.warning-card,
.export-desc,
.export-blocked,
.privacy-note,
.request-heading-wrap,
.section-heading-icon-wrap,
.request-meta,
.request-description,
.inventory-status-pill,
.metric-state {
  display: flex;
  align-items: center;
}
.refresh-native-icon,
.retry-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 20rpx;
  height: 20rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}
.refresh-native-icon::after,
.retry-native-icon::after {
  position: absolute;
  top: -4rpx;
  right: -2rpx;
  width: 6rpx;
  height: 6rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  content: "";
  transform: rotate(18deg);
}
.refresh-native-icon-spinning {
  animation: inventory-spin 0.9s linear infinite;
}
.error-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  border: 2rpx solid #c86873;
  border-radius: 50%;
  box-sizing: border-box;
}
.error-native-icon::before,
.error-native-icon::after {
  position: absolute;
  top: 18rpx;
  left: 10rpx;
  width: 18rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #c86873;
  content: "";
}
.error-native-icon::before {
  transform: rotate(45deg);
}
.error-native-icon::after {
  transform: rotate(-45deg);
}
.inventory-page .retry-button {
  justify-content: center;
}
.warning-native-icon,
.blocked-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 30rpx;
  height: 26rpx;
  margin: 2rpx 15rpx 0 0;
  border-right: 15rpx solid transparent;
  border-bottom: 26rpx solid #c89456;
  border-left: 15rpx solid transparent;
  box-sizing: content-box;
}
.warning-native-icon::before,
.warning-native-icon::after,
.blocked-native-icon::before,
.blocked-native-icon::after {
  position: absolute;
  left: -1rpx;
  z-index: 1;
  width: 2rpx;
  border-radius: 2rpx;
  background: #1f1b17;
  content: "";
}
.warning-native-icon::before,
.blocked-native-icon::before {
  top: 10rpx;
  height: 7rpx;
}
.warning-native-icon::after,
.blocked-native-icon::after {
  top: 20rpx;
  height: 2rpx;
}
.warning-copy {
  flex: 1;
  min-width: 0;
}
.request-type-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  margin-right: 15rpx;
  border: 1rpx solid rgba(82, 143, 255, 0.2);
  border-radius: 16rpx;
  background: rgba(82, 143, 255, 0.07);
  color: #75a4ed;
  box-sizing: border-box;
}
.request-type-correction {
  border-color: rgba(190, 145, 69, 0.2);
  background: rgba(190, 145, 69, 0.07);
  color: #c6a063;
}
.request-type-deletion {
  border-color: rgba(201, 86, 99, 0.2);
  background: rgba(201, 86, 99, 0.07);
  color: #d27580;
}
.request-type-default {
  border-color: rgba(132, 143, 158, 0.2);
  background: rgba(132, 143, 158, 0.07);
  color: #8f9baa;
}
.request-type-icon {
  position: relative;
  width: 24rpx;
  height: 27rpx;
  box-sizing: border-box;
}
.request-type-icon-access,
.request-type-icon-default {
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
}
.request-type-icon-access::after,
.request-type-icon-default::after {
  position: absolute;
  top: 7rpx;
  left: 5rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 0 6rpx 0 currentColor;
  content: "";
}
.request-type-icon-correction {
  width: 23rpx;
  height: 23rpx;
  border-bottom: 2rpx solid currentColor;
}
.request-type-icon-correction::before {
  position: absolute;
  top: 0;
  left: 10rpx;
  width: 6rpx;
  height: 23rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx 5rpx 2rpx 2rpx;
  content: "";
  transform: rotate(43deg);
}
.request-type-icon-deletion::before {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 16rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 5rpx 5rpx;
  content: "";
}
.request-type-icon-deletion::after {
  position: absolute;
  top: 3rpx;
  left: 2rpx;
  width: 20rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 7rpx -4rpx 0 -1rpx currentColor;
  content: "";
}
.inventory-page .status-pill,
.inventory-page .record-status {
  align-items: center;
}
.status-dot,
.record-status-dot,
.inventory-status-dot,
.metric-state-dot {
  flex-shrink: 0;
  width: 7rpx;
  height: 7rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 9rpx currentColor;
}
.request-status-pending {
  background: rgba(218, 164, 76, 0.1);
  color: #d8aa5e;
}
.request-status-processing {
  background: rgba(82, 143, 255, 0.1);
  color: #81aef5;
}
.request-status-completed {
  background: rgba(74, 185, 133, 0.1);
  color: #64c795;
}
.request-status-rejected {
  background: rgba(201, 86, 99, 0.1);
  color: #d77a84;
}
.request-status-cancelled,
.request-status-unknown {
  background: rgba(132, 143, 158, 0.1);
  color: #929daa;
}
.inventory-page .identity-row {
  padding: 14rpx 15rpx;
}
.identity-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-right: 13rpx;
  border: 1rpx solid rgba(112, 154, 222, 0.22);
  border-radius: 50%;
  background: rgba(82, 143, 255, 0.07);
  box-sizing: border-box;
}
.identity-native-icon::before {
  position: absolute;
  top: 6rpx;
  left: 11rpx;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #718fbb;
  border-radius: 50%;
  box-sizing: border-box;
  content: "";
}
.identity-native-icon::after {
  position: absolute;
  bottom: 5rpx;
  left: 7rpx;
  width: 18rpx;
  height: 9rpx;
  border: 2rpx solid #718fbb;
  border-bottom: 0;
  border-radius: 12rpx 12rpx 0 0;
  box-sizing: border-box;
  content: "";
}
.identity-copy,
.request-description-copy,
.export-file-copy {
  flex: 1;
  min-width: 0;
}
.identity-label,
.request-meta-label,
.export-file-label {
  color: #5f6c80;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 1rpx;
}
.inventory-page .identity-text {
  margin-top: 3rpx;
}
.inventory-page .copy-button {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8296b3;
}
.copy-native-icon {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  margin-right: 7rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}
.copy-native-icon::before {
  position: absolute;
  top: -6rpx;
  left: 4rpx;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  content: "";
  opacity: 0.55;
}
.inventory-page .request-meta,
.inventory-page .request-description {
  align-items: flex-start;
  padding: 15rpx 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.045);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.018);
  color: #8c98a8;
}
.inventory-page .request-description {
  margin-top: 11rpx;
}
.time-native-icon,
.description-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 23rpx;
  height: 23rpx;
  margin: 2rpx 11rpx 0 0;
  color: #6f829e;
  box-sizing: border-box;
}
