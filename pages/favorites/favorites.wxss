.favorites-page {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 24rpx 70rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #151d29 0%, #0b0d10 560rpx);
  box-sizing: border-box;
}

.page-glow {
  position: absolute;
  top: -220rpx;
  right: -170rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: rgba(57, 115, 209, 0.12);
  filter: blur(90rpx);
}

.hero-card,
.favorite-list,
.empty-card,
.loading-list {
  position: relative;
  z-index: 1;
}

.hero-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-color: rgba(96, 148, 232, 0.18);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-kicker,
.empty-kicker {
  color: #6b809e;
  font-size: 15rpx;
  font-weight: 650;
  line-height: 1.4;
  letter-spacing: 2.5rpx;
}

.hero-title {
  margin-top: 7rpx;
  color: #f7f9fc;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-desc {
  margin-top: 10rpx;
  padding-right: 18rpx;
  color: #8995a5;
  font-size: 21rpx;
  line-height: 1.6;
}

.hero-emblem,
.empty-emblem {
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
  border: 1rpx solid rgba(105, 155, 236, 0.25);
  border-radius: 50%;
}

.favorite-item {
  position: relative;
  margin-bottom: 22rpx;
}

.favorite-action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: -12rpx;
}

.remove-button {
  min-width: 116rpx;
  height: 48rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  background: rgba(10, 13, 18, 0.72);
  color: #aeb8c6;
  font-size: 17rpx;
  line-height: 48rpx;
  backdrop-filter: blur(12rpx);
}

.loading-card {
  height: 390rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.055);
}

.empty-card {
  padding: 70rpx 34rpx;
  text-align: center;
}

.empty-emblem {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 22rpx;
}

.empty-title {
  margin-top: 8rpx;
  color: #eef2f7;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.45;
}

.empty-desc {
  max-width: 540rpx;
  margin: 12rpx auto 0;
  color: #818c9b;
  font-size: 20rpx;
  line-height: 1.7;
}

.empty-button,
.load-more-button {
  height: 76rpx;
  margin-top: 26rpx;
  border-radius: 18rpx;
  font-size: 21rpx;
  line-height: 76rpx;
}

.empty-button {
  width: 250rpx;
}

.load-more-button {
  width: 100%;
}

.list-end {
  padding: 12rpx 0 0;
  color: #586373;
  font-size: 17rpx;
  line-height: 1.5;
  text-align: center;
  letter-spacing: 1rpx;
}
