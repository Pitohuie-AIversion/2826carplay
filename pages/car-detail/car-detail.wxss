.detail-loading-section-title,
.detail-loading-line,
.detail-loading-price { border-radius: 9rpx; }
.detail-loading-kicker { width: 230rpx; height: 18rpx; }
.detail-loading-title { width: 72%; height: 48rpx; margin-top: 20rpx; border-radius: 12rpx; }
.detail-loading-subtitle { width: 46%; height: 22rpx; margin-top: 18rpx; }
.detail-loading-divider { height: 1rpx; margin: 30rpx 0; background: rgba(255, 255, 255, 0.07); }
.detail-loading-row { display: flex; align-items: center; justify-content: space-between; }
.detail-loading-price { width: 190rpx; height: 38rpx; }
.detail-loading-status { width: 108rpx; height: 52rpx; border-radius: 999rpx; }
.detail-loading-section-title { width: 150rpx; height: 28rpx; }
.detail-loading-line { width: 100%; height: 20rpx; margin-top: 28rpx; }
.detail-loading-line-short { width: 68%; margin-top: 16rpx; }
.skeleton-pulse { background: linear-gradient(105deg, #181c22 12%, #262d37 34%, #181c22 56%); background-size: 220% 100%; animation: detailSkeletonPulse 1.6s ease-in-out infinite; }
@keyframes detailSkeletonPulse { 0% { background-position: 160% 0; }
  100% { background-position: -70% 0; }
}
.trust-profile-heading { align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.trust-status { flex: 0 0 auto; padding: 8rpx 14rpx; border: 1rpx solid rgba(255, 255, 255, 0.16); border-radius: 999rpx; color: #dce4ef; font-size: 20rpx; }
.trust-status-current { border-color: rgba(68, 211, 146, 0.45); color: #72dda9; }
.trust-status-pending { border-color: rgba(82, 143, 255, 0.5); color: #8ab3ff; }
.trust-status-stale,
.trust-status-missing { border-color: rgba(242, 153, 74, 0.5); color: #f5b46e; }
.trust-profile-summary { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 24rpx; padding: 20rpx; border: 1rpx solid rgba(255, 255, 255, 0.08); border-radius: 18rpx; background: rgba(255, 255, 255, 0.025); }
.trust-profile-date { color: #edf2f8; font-size: 25rpx; }
.trust-profile-meta,
.trust-boundary,
.trust-channel-note { margin-top: 8rpx; color: #929eae; font-size: 21rpx; line-height: 1.6; }
.trust-profile-year { color: #ffffff; font-size: 34rpx; font-weight: 700; }
.trust-profile-year text { margin-left: 4rpx; color: #8f9bad; font-size: 19rpx; font-weight: 400; }
.trust-profile-list { margin-top: 18rpx; }
.trust-profile-item { padding: 18rpx 0; border-top: 1rpx solid rgba(255, 255, 255, 0.07); }
.trust-profile-item-label,
.trust-channel-title { color: #8faeff; font-size: 21rpx; }
.trust-profile-item-value,
.trust-profile-item-summary { margin-top: 8rpx; color: #dce3ec; font-size: 23rpx; line-height: 1.65; }
.trust-channel-card { margin-top: 16rpx; padding: 20rpx; border: 1rpx solid rgba(82, 143, 255, 0.24); border-radius: 18rpx; background: rgba(82, 143, 255, 0.06); }
.trust-channel-row { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 14rpx; color: #cfd7e2; font-size: 22rpx; }
.trust-channel-call { width: 100%; margin-top: 18rpx; }
/* 车型专属海报与位置导航增强 */
.poster-button { display: inline-flex; align-items: center; justify-content: center; min-width: 116rpx; height: 52rpx; margin: 14rpx 0 0 12rpx; padding: 0 18rpx; border: 1rpx solid rgba(208, 158, 90, 0.32); border-radius: 999rpx; background: rgba(208, 158, 90, 0.08); color: #e8c88b; font-size: 18rpx; line-height: 1; transition: opacity 120ms ease, transform 120ms ease; }
.poster-button::after { border: 0; }
.poster-button-pressed { opacity: 0.72; transform: scale(0.94); }
.poster-button-icon { position: relative; width: 20rpx; height: 20rpx; margin-right: 6rpx; color: currentColor; }
.poster-button-native-mark { position: absolute; top: 3rpx; left: 2rpx; width: 15rpx; height: 14rpx; border: 2rpx solid currentColor; border-radius: 3rpx; opacity: 0.85; }
.poster-button-native-mark::after { position: absolute; top: -4rpx; right: -4rpx; width: 5rpx; height: 5rpx; border-radius: 50%; background: currentColor; content: ""; }
.poster-button-text { line-height: 1; }
.info-item-clickable { cursor: pointer; transition: background-color 150ms ease; }
.info-item-clickable:active,
.info-item-pressed { opacity: 0.8; background: rgba(82, 143, 255, 0.08); }
.location-nav-arrow { margin-left: 8rpx; color: #528fff; font-size: 18rpx; font-weight: 600; }
.location-clickable-value { color: #dce3ec; }
.copy-hint-tag { margin-left: 8rpx; padding: 2rpx 10rpx; border-radius: 6rpx; background: rgba(82, 143, 255, 0.12); color: #528fff; font-size: 16rpx; font-weight: 600; vertical-align: middle; }
.info-value-clickable { color: #b8d0f8; }
.wechat-action-native-icon { position: relative; width: 22rpx; height: 22rpx; margin-right: 8rpx; }
.wechat-action-native-icon::before { position: absolute; top: 3rpx; left: 1rpx; width: 14rpx; height: 11rpx; border: 2rpx solid currentColor; border-radius: 6rpx 6rpx 2rpx 6rpx; content: ""; }
.wechat-action-native-icon::after { position: absolute; right: 1rpx; bottom: 3rpx; width: 10rpx; height: 8rpx; border: 2rpx solid currentColor; border-radius: 4rpx 4rpx 4rpx 2rpx; background: #15181d; content: ""; }
.poster-modal-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); background: rgba(0, 0, 0, 0.78); }
.poster-modal-dialog { width: 100%; max-width: 620rpx; max-height: 88vh; padding: 28rpx; border: 1rpx solid rgba(208, 158, 90, 0.3); border-radius: 28rpx; background: #111419; box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.6); display: flex; flex-direction: column; }
.poster-modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.poster-modal-title { color: #e8c88b; font-size: 28rpx; font-weight: 700; letter-spacing: 1rpx; }
.poster-modal-close { padding: 6rpx 14rpx; color: #8fa0b5; font-size: 26rpx; cursor: pointer; }
.poster-modal-close-hover { opacity: 0.6; }
.poster-canvas-wrap { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; height: 720rpx; max-height: 64vh; border-radius: 16rpx; background: #0b0d10; overflow: hidden; }
.poster-preview-image { width: 100%; height: 100%; border-radius: 12rpx; display: block; }
.poster-canvas, .poster-canvas-offscreen { position: fixed; left: -9999px; top: 0; width: 600px; height: 960px; pointer-events: none; opacity: 0; z-index: -1; }
.poster-loading-box { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; }
.poster-spinner { width: 36rpx; height: 36rpx; border: 3rpx solid rgba(208, 158, 90, 0.2); border-top-color: #e8c88b; border-radius: 50%; animation: poster-spin 800ms linear infinite; }
@keyframes poster-spin { to { transform: rotate(360deg); }
}
.poster-loading-text { color: #9ca5b2; font-size: 22rpx; }
.poster-retry-box { display: flex; align-items: center; justify-content: center; padding: 24rpx; }
.poster-retry-text { color: #d09e5a; font-size: 24rpx; }
.poster-modal-footer { margin-top: 24rpx; }
.poster-save-action { width: 100%; height: 76rpx; background: linear-gradient(135deg, #d09e5a, #b3823d); color: #0b0d10; font-weight: 700; font-size: 26rpx; border-radius: 16rpx; }
.poster-modal-subtip { margin-top: 14rpx; text-align: center; color: #7b889b; font-size: 19rpx; }

