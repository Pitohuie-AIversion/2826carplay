<view class="vehicle-detail-page management-page">
  <view class="page-glow"></view>
  <view class="hero-card ui-card ui-card-gradient">
    <view class="hero-top">
      <view class="hero-copy">
        <view class="page-kicker">FLEET PROFILE</view>
        <view class="hero-title">车辆详情管理</view>
        <view class="hero-desc">查看车辆档案、状态与图片素材</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" />
    </view>
  </view>

  <view class="loading-card ui-card" wx:if="{{loading}}">
    <view class="vehicle-detail-skeleton-head">
      <view>
        <view class="vehicle-detail-skeleton-plate manage-skeleton-pulse"></view>
        <view class="vehicle-detail-skeleton-model manage-skeleton-pulse"></view>
      </view>
      <view class="vehicle-detail-skeleton-status manage-skeleton-pulse"></view>
    </view>
    <view class="vehicle-detail-skeleton-divider"></view>
    <view class="vehicle-detail-skeleton-grid">
      <view class="vehicle-detail-skeleton-item manage-skeleton-pulse"></view>
      <view class="vehicle-detail-skeleton-item manage-skeleton-pulse"></view>
      <view class="vehicle-detail-skeleton-item manage-skeleton-pulse"></view>
      <view class="vehicle-detail-skeleton-item manage-skeleton-pulse"></view>
    </view>
    <view class="vehicle-detail-skeleton-actions">
      <view class="vehicle-detail-skeleton-button manage-skeleton-pulse"></view>
      <view class="vehicle-detail-skeleton-button manage-skeleton-pulse"></view>
    </view>
  </view>

  <view wx:elif="{{detail}}" class="detail-wrap">
    <view class="summary-card ui-card">
      <view>
        <view class="plate-number">{{detail.plateNumber}}</view>
        <view class="brand-model">{{detail.brandModel}}</view>
      </view>
      <view class="vehicle-status ui-status {{detail.statusClass}}">{{detail.statusText}}</view>
    </view>

    <view class="section-card ui-card">
      <view class="section-title">状态操作</view>
      <view wx:if="{{detail.status !== 'retired'}}">
        <view class="status-op-row">
          <button
            wx:for="{{statusOpOptions}}"
            wx:key="value"
            wx:for-item="op"
            class="status-op-btn {{detail.status === op.value ? 'status-op-btn-active' : ''}}"
            data-status="{{op.value}}"
            bindtap="handleUpdateStatus"
            disabled="{{updatingStatus}}"
          >
            {{op.label}}
          </button>
        </view>
        <button class="retire-inline-btn ui-btn ui-btn-danger" bindtap="handleRetire" disabled="{{updatingStatus}}">停用车辆</button>
      </view>
      <view wx:else>
        <button class="restore-inline-btn ui-btn ui-btn-primary" bindtap="handleRestore" disabled="{{updatingStatus}}">恢复启用</button>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-title">基础信息</view>
      <view class="info-grid">
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">车辆类型</view>
            <view class="info-value">{{detail.vehicleTypeText}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">注册日期</view>
            <view class="info-value">{{detail.registerDate || "--"}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">取车城市</view>
            <view class="info-value">{{detail.locationText}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">日租金</view>
            <view class="info-value">{{detail.priceDayText}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">变速箱</view>
            <view class="info-value">{{detail.transmissionText}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">燃油类型</view>
            <view class="info-value">{{detail.fuelTypeText}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">座位数</view>
            <view class="info-value">{{detail.seatsText}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">VIN</view>
            <view class="info-value">{{detail.vinText}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">发动机号</view>
            <view class="info-value">{{detail.engineNumberText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-title">管理信息</view>
      <view class="info-grid">
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">车辆ID</view>
            <view class="info-value info-value-ellipsis">{{detail.id}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">创建人</view>
            <view class="info-value info-value-ellipsis">{{detail.createdByOpenidText}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">创建时间</view>
            <view class="info-value">{{detail.createdAtText}}</view>
          </view>
        </view>
        <view class="info-item">
          <view class="info-item-inner">
            <view class="info-label">更新时间</view>
            <view class="info-value">{{detail.updatedAtText}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-title">公开说明</view>
      <view class="note-box">{{detail.publicDescriptionText}}</view>
    </view>

    <view class="section-card ui-card">
      <view class="section-title">内部备注</view>
      <view class="note-box">{{detail.noteText}}</view>
    </view>

    <view class="section-card ui-card">
      <view class="image-header">
        <view>
          <view class="section-title">车辆图片</view>
          <view class="image-desc">已上传 {{detail.imageCount}} / 9 张，可设置封面。</view>
        </view>
        <button class="upload-button ui-btn ui-btn-primary" bindtap="handleUploadImages" loading="{{uploading}}" disabled="{{uploading}}">
          {{uploading ? "上传中" : "上传图片"}}
        </button>
      </view>

      <view wx:if="{{detail.imageItems.length}}" class="image-list">
        <view wx:for="{{detail.imageItems}}" wx:key="fileId" class="image-card">
          <image class="vehicle-image" src="{{item.fileId}}" mode="aspectFill" lazy-load="{{true}}" fade-in="{{true}}" bindtap="handlePreviewImage" data-file-id="{{item.fileId}}" />
          <view class="image-badge" wx:if="{{item.isCover}}">封面</view>
          <view class="image-action-row">
            <button
              class="mini-button secondary-mini-button"
              wx:if="{{!item.isCover}}"
              data-file-id="{{item.fileId}}"
              bindtap="handleSetCover"
            >
              设为封面
            </button>
            <view wx:else class="mini-placeholder">当前封面</view>
            <button class="mini-button danger-mini-button" data-file-id="{{item.fileId}}" bindtap="handleRemoveImage">
              移除图片
            </button>
          </view>
        </view>
      </view>

      <view wx:else class="empty-image-box">
        <view class="loading-text">当前还没有上传车辆图片</view>
      </view>
    </view>

    <view class="action-row">
      <button class="secondary-button ui-btn ui-btn-ghost" bindtap="handleBackList">返回列表</button>
      <button class="primary-button ui-btn ui-btn-primary" bindtap="handleEdit">编辑车辆</button>
    </view>
  </view>

  <view class="loading-card vehicle-detail-empty-card ui-card" wx:else>
    <image class="vehicle-detail-empty-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" />
    <view class="vehicle-detail-empty-kicker">FLEET PROFILE</view>
    <view class="vehicle-detail-empty-title">暂无车辆详情</view>
    <view class="vehicle-detail-empty-desc">车辆可能已删除，或当前账号无法读取该车辆档案</view>
    <button class="vehicle-detail-empty-button ui-btn ui-btn-primary" bindtap="handleBackList">返回车辆列表</button>
  </view>
</view>
