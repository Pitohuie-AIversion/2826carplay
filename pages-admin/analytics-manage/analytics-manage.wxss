@import "../../shared/management-shell.wxss";
.analytics-page {
  min-height: 100vh;
  padding: 24rpx calc(24rpx + env(safe-area-inset-right)) calc(70rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  background: linear-gradient(180deg, #151d29 0%, #0b0d10 540rpx);
  box-sizing: border-box;
  color: #eef2f7;
}
.hero-card,
.section-card,
.state-card {
  position: relative;
  z-index: 1;
  margin-bottom: 22rpx;
  padding: 28rpx;
}
.analytics-skeleton {
  position: relative;
  z-index: 1;
}
.hero-top,
.section-heading,
.funnel-head,
.rank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page-kicker,
.section-eyebrow {
  color: #6f84a2;
  font-size: 15rpx;
  font-weight: 650;
  letter-spacing: 2.5rpx;
}
.hero-title {
  margin-top: 7rpx;
  font-size: 38rpx;
  font-weight: 700;
}
.hero-desc {
  margin-top: 10rpx;
  color: #8996a6;
  font-size: 21rpx;
}
.hero-emblem {
  width: 80rpx;
  height: 80rpx;
  border: 1rpx solid rgba(105, 155, 236, 0.25);
  border-radius: 50%;
}
.period-row {
  display: flex;
  margin-top: 24rpx;
}
.period-chip {
  margin-right: 12rpx;
  padding: 12rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  color: #7e8998;
  font-size: 19rpx;
  transition: opacity 120ms ease, transform 120ms ease;
}
.period-chip-pressed {
  opacity: 0.72;
  transform: scale(0.975);
}
.period-chip-disabled {
  opacity: 0.48;
}
.period-chip-active {
  border-color: rgba(95, 151, 242, 0.35);
  background: rgba(84, 143, 255, 0.12);
  color: #9fc2fa;
}
.metric-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.content-rank-group {
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}
.metric-card {
  width: calc(50% - 7rpx);
  margin-bottom: 14rpx;
  padding: 24rpx;
  box-sizing: border-box;
}
.metric-top,
.metric-icon-wrap,
.funnel-stage,
.funnel-metric,
.analytics-skeleton-heading,
.metric-skeleton-top {
  display: flex;
  align-items: center;
}
.metric-top,
.analytics-skeleton-heading,
.metric-skeleton-top {
  justify-content: space-between;
}
.metric-value {
  margin-top: 16rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.15;
}
.metric-label {
  color: #7f8a98;
  font-size: 18rpx;
}
.metric-icon-wrap {
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-left: 16rpx;
  border: 1rpx solid currentColor;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.025);
  opacity: 0.72;
}
.metric-icon {
  position: relative;
  width: 23rpx;
  height: 23rpx;
  color: currentColor;
  box-sizing: border-box;
}
.metric-icon-eye {
  width: 25rpx;
  height: 16rpx;
  border: 2rpx solid currentColor;
  border-radius: 50% 50% 48% 48%;
}
.metric-icon-eye::after {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}
.metric-icon-calendar {
  width: 23rpx;
  height: 21rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}
.metric-icon-calendar::before {
  position: absolute;
  top: 5rpx;
  right: 0;
  left: 0;
  height: 2rpx;
  background: currentColor;
  content: "";
}
.metric-icon-calendar::after {
  position: absolute;
  top: -5rpx;
  left: 4rpx;
  width: 2rpx;
  height: 7rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 10rpx 0 0 currentColor;
  content: "";
}
.metric-icon-check {
  border: 2rpx solid currentColor;
  border-radius: 50%;
}
.metric-icon-check::after {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 5rpx;
  height: 9rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}
.metric-icon-chart::before {
  position: absolute;
  bottom: 2rpx;
  left: 2rpx;
  width: 4rpx;
  height: 8rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: currentColor;
  content: "";
  box-shadow: 8rpx -5rpx 0 currentColor, 16rpx -11rpx 0 currentColor;
}
.metric-primary .metric-value { color: #83b1fb; }
.metric-warning .metric-value { color: #efb168; }
.metric-success .metric-value { color: #58d69e; }
.metric-accent .metric-value { color: #b39bff; }
.metric-primary .metric-icon-wrap { color: #83b1fb; }
.metric-warning .metric-icon-wrap { color: #efb168; }
.metric-success .metric-icon-wrap { color: #58d69e; }
.metric-accent .metric-icon-wrap { color: #b39bff; }
.section-title {
  margin-top: 5rpx;
  font-size: 27rpx;
  font-weight: 650;
}
.section-index {
  color: #58687f;
  font-size: 16rpx;
}
.funnel-list {
  margin-top: 24rpx;
}
.funnel-item {
  margin-bottom: 20rpx;
}
.funnel-head {
  color: #9da7b4;
  font-size: 19rpx;
}
.funnel-stage-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  border: 1rpx solid rgba(99, 154, 239, 0.18);
  border-radius: 9rpx;
  background: rgba(70, 124, 207, 0.07);
  color: #6e94cd;
  font-size: 14rpx;
  font-weight: 650;
}
.funnel-value {
  color: #c3ccd8;
  font-weight: 650;
}
.funnel-rate {
  min-width: 58rpx;
  margin-left: 12rpx;
  color: #7298d0;
  font-size: 15rpx;
  text-align: right;
}
.bar-track {
  height: 14rpx;
  margin-top: 9rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.055);
}
.bar-fill {
  height: 100%;
  border-radius: inherit;
}
.funnel-fill {
  background: linear-gradient(90deg, #4f8be9, #72afff);
}
.decision-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 23rpx;
}
.decision-item {
  min-height: 126rpx;
  padding: 19rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 19rpx;
  background: rgba(255, 255, 255, 0.025);
  box-sizing: border-box;
}
.decision-label {
  color: #7d8998;
  font-size: 18rpx;
  line-height: 1.5;
}
.decision-value {
  margin-top: 6rpx;
  color: #eef3fa;
  font-size: 34rpx;
  font-weight: 680;
  line-height: 1.25;
}
.decision-meta {
  margin-top: 7rpx;
  color: #647185;
  font-size: 15rpx;
  line-height: 1.55;
}
.trend-scroll-shell {
  margin-top: 22rpx;
}
.trend-scroll {
  white-space: nowrap;
}
.trend-chart {
  position: relative;
  display: inline-flex;
  align-items: flex-end;
  min-width: 100%;
  height: 260rpx;
  padding: 0 68rpx 0 4rpx;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 63rpx,
    rgba(255, 255, 255, 0.035) 64rpx,
    transparent 65rpx
  );
  box-sizing: border-box;
}
.trend-item {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  flex-direction: column;
  justify-content: flex-end;
  width: 64rpx;
  height: 100%;
}
.trend-value,
.trend-label {
  color: #738092;
  font-size: 14rpx;
}
.trend-column {
  display: flex;
  align-items: flex-end;
  width: 18rpx;
  height: 170rpx;
  margin: 8rpx 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
}
.trend-fill {
  width: 100%;
  min-height: 2rpx;
  border-radius: inherit;
  background: linear-gradient(180deg, #78afff, #426fbd);
}
.trend-item-peak .trend-value {
  color: #c7dcff;
  font-weight: 700;
}
.trend-item-peak .trend-label {
  color: #8fb6ef;
}
.trend-fill-peak {
  background: linear-gradient(180deg, #a7cbff, #5790ea 58%, #3765ad);
}
.trend-scroll-cue {
  width: 68rpx;
}
.vehicle-rank-list {
  margin-top: 18rpx;
}
.rank-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.rank-item:last-child {
  border-bottom: 0;
}
.rank-number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 38rpx;
  height: 38rpx;
  margin-right: 12rpx;
  border: 1rpx solid rgba(117, 168, 248, 0.18);
  border-radius: 12rpx;
  background: rgba(70, 123, 205, 0.07);
  color: #75a8f8;
  font-size: 18rpx;
  font-weight: 700;
}
.rank-item:nth-child(1) .rank-number {
  border-color: rgba(218, 178, 94, 0.26);
  background: rgba(187, 139, 52, 0.1);
  color: #d9b367;
}
.rank-item:nth-child(2) .rank-number {
  border-color: rgba(166, 182, 204, 0.23);
  background: rgba(139, 158, 184, 0.08);
  color: #aebdce;
}
.rank-item:nth-child(3) .rank-number {
  border-color: rgba(190, 129, 86, 0.23);
  background: rgba(170, 104, 62, 0.08);
  color: #c99775;
}
.analytics-skeleton-section {
  margin-top: 8rpx;
}
.analytics-skeleton-section-muted {
  opacity: 0.68;
}
.metric-skeleton-label {
  width: 104rpx;
  height: 18rpx;
  border-radius: 7rpx;
}
.metric-skeleton-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
}
.metric-skeleton-value {
  width: 112rpx;
  height: 38rpx;
  margin-top: 16rpx;
  border-radius: 10rpx;
}
.analytics-skeleton-kicker {
  width: 172rpx;
  height: 15rpx;
  border-radius: 7rpx;
}
.analytics-skeleton-title {
  width: 154rpx;
  height: 27rpx;
  margin-top: 10rpx;
  border-radius: 8rpx;
}
.analytics-skeleton-index {
  width: 36rpx;
  height: 20rpx;
  border-radius: 7rpx;
}
.analytics-skeleton-funnel-row {
  margin-top: 22rpx;
}
.analytics-skeleton-funnel-label {
  width: 38%;
  height: 18rpx;
  border-radius: 7rpx;
}
.analytics-skeleton-funnel-bar {
  width: 100%;
  height: 14rpx;
  margin-top: 11rpx;
  border-radius: 999rpx;
}
.analytics-skeleton-columns {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 210rpx;
  margin-top: 24rpx;
}
.analytics-skeleton-column {
  width: 18rpx;
  height: 58%;
  border-radius: 999rpx;
}
.analytics-skeleton-column:nth-child(2),
.analytics-skeleton-column:nth-child(6) {
  height: 82%;
}
.analytics-skeleton-column:nth-child(3),
.analytics-skeleton-column:nth-child(7) {
  height: 42%;
}
.analytics-skeleton-column:nth-child(4) {
  height: 100%;
}
.rank-copy {
  flex: 1;
  min-width: 0;
}
.rank-name {
  display: -webkit-box;
  overflow: hidden;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.rank-meta {
  margin-top: 6rpx;
  color: #788493;
  font-size: 16rpx;
}
.rank-score {
  margin-left: 16rpx;
  color: #93baf7;
  font-size: 24rpx;
  font-weight: 700;
}
.state-card,
.inline-empty,
.scope-tip,
.privacy-tip {
  color: #7f8b9a;
  font-size: 19rpx;
  line-height: 1.65;
  text-align: center;
}
.analytics-state-icon {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  margin: 0 auto 18rpx;
  border: 2rpx solid #d69a69;
  border-radius: 50%;
  color: #d69a69;
  box-sizing: border-box;
}
.analytics-state-mark {
  position: absolute;
  top: 10rpx;
  left: 20rpx;
  width: 3rpx;
  height: 15rpx;
  border-radius: 999rpx;
  background: currentColor;
}
.analytics-state-mark::after {
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}
.state-title {
  color: #e8ecf2;
  font-size: 23rpx;
  font-weight: 600;
}
.state-desc {
  margin-top: 8rpx;
}
.retry-button {
  width: 220rpx;
  height: 70rpx;
  margin-top: 22rpx;
  border-radius: 17rpx;
  font-size: 20rpx;
  line-height: 70rpx;
}
.analytics-action-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  line-height: 1;
}
.analytics-action-native-icon {
  position: relative;
  flex-shrink: 0;
  margin-right: 10rpx;
  color: currentColor;
  box-sizing: border-box;
}
.analytics-retry-native-icon {
  width: 23rpx;
  height: 23rpx;
  border: 2rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
}
.analytics-retry-native-icon::after {
  position: absolute;
  top: -4rpx;
  right: -1rpx;
  width: 7rpx;
  height: 7rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  content: "";
  transform: rotate(20deg);
}
.inline-empty {
  padding: 34rpx 0 10rpx;
}
.analytics-empty-native-icon {
  position: relative;
  width: 46rpx;
  height: 40rpx;
  margin: 0 auto 14rpx;
  border-bottom: 2rpx solid #667891;
  border-left: 2rpx solid #667891;
  border-radius: 0 0 0 4rpx;
  box-sizing: border-box;
}
.analytics-empty-native-icon::before {
  position: absolute;
  bottom: 5rpx;
  left: 8rpx;
  width: 6rpx;
  height: 11rpx;
  border-radius: 2rpx 2rpx 0 0;
  background: #7287a6;
  box-shadow: 10rpx -6rpx 0 #7287a6, 20rpx -14rpx 0 #7287a6;
  content: "";
}
.analytics-empty-title {
  color: #9aa7b7;
  font-size: 20rpx;
  font-weight: 600;
}
.analytics-empty-desc {
  max-width: 500rpx;
  margin: 5rpx auto 0;
  color: #697688;
  font-size: 17rpx;
  line-height: 1.6;
}
.scope-tip,
.privacy-tip {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  padding: 18rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.025);
  font-size: 17rpx;
  text-align: left;
}
.scope-tip text,
.privacy-tip text {
  flex: 1;
  min-width: 0;
}
.analytics-tip-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 23rpx;
  height: 23rpx;
  margin-top: 2rpx;
  margin-right: 10rpx;
  color: currentColor;
  box-sizing: border-box;
}
.analytics-warning-native-icon {
  border: 2rpx solid #d69a69;
  border-radius: 50%;
  color: #d69a69;
}
.analytics-warning-native-mark {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 2rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: currentColor;
}
.analytics-warning-native-mark::after {
  position: absolute;
  bottom: -5rpx;
  left: 0;
  width: 2rpx;
  height: 2rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}
.analytics-lock-native-icon {
  width: 21rpx;
  height: 17rpx;
  margin-top: 6rpx;
  border: 2rpx solid #6d91c6;
  border-radius: 4rpx;
  color: #6d91c6;
}
.analytics-lock-native-shackle {
  position: absolute;
  bottom: 13rpx;
  left: 4rpx;
  width: 9rpx;
  height: 9rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
  box-sizing: border-box;
}
.cleanup-card {
  margin-top: 20rpx;
}
.cleanup-desc {
  margin-top: 18rpx;
  color: #7f8b9a;
  font-size: 18rpx;
  line-height: 1.7;
}
.cleanup-button {
  height: 72rpx;
  margin-top: 22rpx;
  border-color: rgba(239, 177, 104, 0.28);
  color: #efb168;
  font-size: 20rpx;
  line-height: 72rpx;
}
.analytics-cleanup-native-icon {
  width: 19rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
}
.analytics-cleanup-native-icon::before {
  position: absolute;
  top: -5rpx;
  left: -3rpx;
  width: 21rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 5rpx -4rpx 0 -1rpx currentColor;
  content: "";
}
.analytics-cleanup-native-icon::after {
  position: absolute;
  top: 4rpx;
  left: 5rpx;
  width: 2rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 5rpx 0 0 currentColor;
  content: "";
}
.rank-tag {
  display: inline;
  color: #85a2c9;
  font-weight: 500;
}
.content-trend-legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 18rpx 26rpx;
  margin-top: 10rpx;
  margin-bottom: 20rpx;
  padding: 12rpx 6rpx 0;
  color: #7a8aa1;
  font-size: 15rpx;
}
.legend-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}
.legend-swatch {
  width: 16rpx;
  height: 16rpx;
  border-radius: 5rpx;
  flex-shrink: 0;
}
.legend-swatch-views {
  background: linear-gradient(180deg, #78afff, #426fbd);
}
.legend-swatch-vehicles {
  background: linear-gradient(180deg, #6fd3b0, #37a480);
}
.legend-swatch-submits {
  background: linear-gradient(180deg, #efb168, #d28940);
}
.legend-swatch-confirmed {
  background: linear-gradient(180deg, #d98fa8, #b35a7c);
}
.content-trend-item {
  width: 86rpx;
}
.content-trend-value {
  font-size: 15rpx;
  font-weight: 600;
}
.content-trend-column {
  width: 34rpx;
  height: 170rpx;
  margin: 8rpx 0;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.05);
}
.content-stacked-column {
  display: flex;
  flex-direction: column-reverse;
  align-items: stretch;
  justify-content: flex-start;
  width: 100%;
  height: 100%;
  min-height: 2rpx;
}
.content-fill {
  width: 100%;
  min-height: 2rpx;
  flex: 1;
}
.content-fill-views {
  background: linear-gradient(180deg, #78afff, #426fbd);
}
.content-fill-vehicles {
  background: linear-gradient(180deg, #6fd3b0, #37a480);
}
.content-fill-submits {
  background: linear-gradient(180deg, #efb168, #d28940);
}
.content-fill-confirmed {
  background: linear-gradient(180deg, #d98fa8, #b35a7c);
}
.content-trend-breakdown {
  margin-top: 6rpx;
  padding: 0 4rpx;
  color: #6c7c92;
  font-size: 20rpx;
  line-height: 1.5;
  letter-spacing: 0.2rpx;
}
.content-trend-breakdown text {
  display: inline-block;
  min-width: 22rpx;
  padding: 0 2rpx;
  text-align: center;
  color: #8898b0;
}
.scene-funnel-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 8rpx;
}
.scene-funnel-card {
  padding: 18rpx 18rpx 14rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx solid rgba(130, 150, 180, 0.14);
  border-radius: 14rpx;
}
.scene-funnel-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.scene-funnel-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #dbe6f5;
}
