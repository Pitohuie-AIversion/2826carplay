<view class="detail-loading-page" wx:if="{{loading}}" aria-hidden="true">
  <view class="detail-loading-hero skeleton-pulse"></view>
  <view class="detail-loading-card ui-card">
    <view class="detail-loading-kicker skeleton-pulse"></view>
    <view class="detail-loading-title skeleton-pulse"></view>
    <view class="detail-loading-subtitle skeleton-pulse"></view>
    <view class="detail-loading-divider"></view>
    <view class="detail-loading-row">
      <view class="detail-loading-price skeleton-pulse"></view>
      <view class="detail-loading-status skeleton-pulse"></view>
    </view>
  </view>
  <view class="detail-loading-card detail-loading-info ui-card">
    <view class="detail-loading-section-title skeleton-pulse"></view>
    <view class="detail-loading-line skeleton-pulse"></view>
    <view class="detail-loading-line detail-loading-line-short skeleton-pulse"></view>
  </view>
</view>

<view class="detail-page" wx:elif="{{car}}">
  <view class="hero-shell">
    <swiper wx:if="{{car.hasImages}}" class="hero-swiper" indicator-dots="{{false}}" autoplay="{{false}}" circular="{{car.imageItems.length > 1}}" bindchange="handleHeroSwiperChange">
      <swiper-item wx:for="{{car.imageItems}}" wx:key="key">
        <view class="hero-image-frame">
          <view wx:if="{{!item.loaded && !item.failed}}" class="hero-image-loading">
            <view class="hero-image-loading-mark" aria-hidden="true">
              <image class="hero-image-loading-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
              <view class="hero-image-loading-ring"></view>
            </view>
            <view class="hero-image-loading-text">LOADING VEHICLE</view>
          </view>
          <view wx:if="{{item.failed}}" class="hero-image-fallback">
            <view class="hero-placeholder-brand-row">
              <image class="hero-placeholder-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
              <view class="hero-placeholder-brand">{{car.brand}}</view>
            </view>
            <view class="hero-placeholder-name">{{car.name}}</view>
            <view class="hero-placeholder-text">该图片暂时无法显示</view>
          </view>
          <image
            wx:if="{{!item.failed && item.displaySrc}}"
            class="hero-image {{item.loaded ? 'hero-image-loaded' : ''}}"
            src="{{item.displaySrc}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            fade-in="{{false}}"
            data-index="{{index}}"
            bindload="handleHeroImageLoad"
            binderror="handleHeroImageError"
            bindtap="handleHeroImageTap"
            hover-class="hero-image-pressed"
            aria-role="button"
            aria-label="预览第 {{index + 1}} 张车辆图片，共 {{car.imageItems.length}} 张"
          />
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="hero-swiper hero-placeholder">
      <view class="hero-placeholder-brand-row">
        <image class="hero-placeholder-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
        <view class="hero-placeholder-brand">{{car.brand}}</view>
      </view>
      <view class="hero-placeholder-name">{{car.name}}</view>
      <view class="hero-placeholder-text">该车辆暂未上传展示图片</view>
    </view>
    <view class="hero-shade"></view>
    <view class="hero-signature">
      <view class="signature-line"></view>
      <text>EXTREME GARAGE</text>
    </view>
    <view wx:if="{{car.imageItems.length > 1}}" class="hero-pagination" aria-hidden="true">
      <view
        wx:for="{{car.imageItems}}"
        wx:key="key"
        class="hero-pagination-segment {{index === currentImageIndex ? 'hero-pagination-segment-active' : ''}}"
      ></view>
    </view>
    <view wx:if="{{car.hasImages}}" class="hero-counter">
      <text class="hero-counter-current">{{currentImageIndex + 1}}</text>
      <text class="hero-counter-divider">/</text>
      <text>{{car.imageItems.length}}</text>
    </view>
    <view wx:if="{{car.hasImages}}" class="hero-preview-hint">
      <view class="hero-preview-icon" aria-hidden="true">
        <view class="hero-preview-corner hero-preview-corner-top-left"></view>
        <view class="hero-preview-corner hero-preview-corner-top-right"></view>
        <view class="hero-preview-corner hero-preview-corner-bottom-left"></view>
        <view class="hero-preview-corner hero-preview-corner-bottom-right"></view>
      </view>
      <text>点击查看大图</text>
    </view>
  </view>

  <view class="summary-card ui-card">
    <view class="summary-top">
      <view class="summary-identity">
        <view class="summary-kicker">{{car.brand}} · PRIVATE COLLECTION</view>
        <view class="car-name">{{car.name}}</view>
        <view class="car-nickname">{{car.nickname}}</view>
      </view>
      <view class="summary-actions">
        <view class="car-status ui-status {{car.statusClass}}">{{car.statusText}}</view>
        <button
          class="favorite-button {{favorited ? 'favorite-button-active' : ''}}"
          loading="{{favoriteLoading}}"
          disabled="{{favoriteLoading}}"
          bindtap="handleFavoriteTap"
          hover-class="favorite-button-pressed"
          aria-label="{{favoriteLoading ? '正在更新收藏状态' : favorited ? '取消收藏车辆' : '收藏车辆'}}"
        >
          <view wx:if="{{!favoriteLoading}}" class="favorite-button-icon" aria-hidden="true">
            <view class="favorite-heart-shape"></view>
          </view>
          <text class="favorite-button-text">{{favoriteLoading ? '处理中…' : favorited ? '已收藏' : '收藏'}}</text>
        </button>
        <button
          class="poster-button"
          bindtap="handleOpenPosterModal"
          hover-class="poster-button-pressed"
          aria-label="生成车型分享海报"
        >
          <view class="poster-button-icon" aria-hidden="true">
            <view class="poster-button-native-mark"></view>
          </view>
          <text class="poster-button-text">海报</text>
        </button>
      </view>
    </view>

    <view class="price-row">
      <view>
        <view class="price-label">基础日租参考</view>
        <view class="car-price">{{car.priceText}}</view>
      </view>
      <view class="price-note">不含未列明项目</view>
    </view>

    <view class="tag-list">
      <text wx:for="{{car.tags}}" wx:key="*this" class="tag-item">{{item}}</text>
    </view>
  </view>

  <view class="pricing-card ui-card">
    <view class="section-heading pricing-heading">
      <view class="section-heading-copy">
        <view class="section-mark"></view>
        <view>
          <view class="section-title">费用怎么计算</view>
          <view class="section-kicker">PRICE ESTIMATE</view>
        </view>
      </view>
      <view class="pricing-badge">预估</view>
    </view>
    <view class="pricing-base-row">
      <view>
        <view class="pricing-base-label">{{pricingOverview.estimateLabel}}</view>
        <view class="pricing-base-value">{{pricingOverview.baseDailyRateText}}<text wx:if="{{pricingOverview.hasBasePrice}}" class="pricing-base-unit"> / {{pricingOverview.billingUnit}}</text></view>
      </view>
      <view class="pricing-base-state">仅基础日租</view>
    </view>
    <view class="pricing-included">{{pricingOverview.includedText}}</view>
    <button class="disclosure-button" bindtap="handleTogglePricing" hover-class="disclosure-button-pressed" aria-expanded="{{pricingExpanded}}">
      <text>{{pricingExpanded ? '收起费用说明' : '查看保障与其他费用'}}</text>
      <view class="disclosure-chevron {{pricingExpanded ? 'disclosure-chevron-open' : ''}}" aria-hidden="true"></view>
    </button>
    <view wx:if="{{pricingExpanded}}" class="disclosure-list">
      <view class="disclosure-item" wx:for="{{pricingOverview.feeItems}}" wx:key="key">
        <view class="disclosure-label">{{item.label}}</view>
        <view class="disclosure-text">{{item.text}}</view>
      </view>
    </view>
    <view class="estimate-disclaimer"><view class="estimate-disclaimer-mark" aria-hidden="true">i</view><text>{{pricingOverview.disclaimer}}</text></view>
  </view>

  <view class="notice-card ui-card" wx:if="{{car.statusNoticeText}}">
    <view class="section-heading">
      <view class="section-mark"></view>
      <view class="notice-title">当前状态说明</view>
    </view>
    <view class="notice-text">{{car.statusNoticeText}}</view>
  </view>

  <view wx:if="{{relatedGuides.length}}" class="info-card related-guide-card ui-card">
    <view class="section-heading"><view class="section-mark"></view><view><view class="section-title">相关路线与指南</view><view class="section-kicker">SCENARIO GUIDES</view></view></view>
    <view class="related-guide-item" wx:for="{{relatedGuides}}" wx:key="id" data-id="{{item.id}}" data-scene="{{item.scenario}}" bindtap="handleRelatedGuideTap" hover-class="related-guide-item-pressed" aria-role="button">
      <view class="related-guide-copy"><view class="related-guide-title">{{item.title}}</view><view class="related-guide-summary">{{item.summary}}</view></view>
      <view class="related-guide-arrow">→</view>
    </view>
  </view>

  <view class="info-card ui-card">
    <view class="section-heading">
      <view class="section-mark"></view>
      <view class="section-title">车辆简介</view>
    </view>
    <view class="section-text">{{car.description}}</view>
  </view>

  <view class="info-card ui-card">
    <view class="section-heading">
      <view class="section-mark"></view>
      <view class="section-title">基础信息</view>
    </view>
    <view class="info-grid">
      <view class="info-item">
        <view class="info-label">品牌</view>
        <view class="info-value">{{car.brand}}</view>
      </view>
      <view class="info-item info-item-clickable" bindtap="handleOpenLocation" hover-class="info-item-pressed" aria-role="button" aria-label="查看{{car.location}}位置并导航">
        <view class="info-label">城市 / 门店 <text class="location-nav-arrow">导航 →</text></view>
        <view class="info-value location-clickable-value">{{car.location}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">变速箱</view>
        <view class="info-value">{{car.transmissionText}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">燃油类型</view>
        <view class="info-value">{{car.fuelTypeText}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">座位数</view>
        <view class="info-value">{{car.seatsText}}</view>
      </view>
      <view class="info-item">
        <view class="info-label">车辆编号</view>
        <view class="info-value">{{car.id}}</view>
      </view>
    </view>
  </view>

  <view class="info-card trust-profile-card ui-card">
    <view class="section-heading trust-profile-heading">
      <view class="section-heading-copy"><view class="section-mark"></view><view><view class="section-title">车辆可信档案</view><view class="section-kicker">TRUST PROFILE</view></view></view>
      <view class="trust-status {{car.trustArchive.statusClass}}">{{car.trustArchive.statusText}}</view>
    </view>
    <view class="trust-profile-summary">
      <view><view class="trust-profile-date">{{car.trustArchive.lastUpdatedText}}</view><view class="trust-profile-meta">{{car.trustArchive.freshnessText}} · 缺失 {{car.trustArchive.missingCount}} 项</view></view>
      <view class="trust-profile-year">{{car.vehicleYear}}<text>年</text></view>
    </view>
    <view class="trust-boundary">档案状态来自运营人员维护的公开摘要；“已复核”不代表平台或第三方认证。</view>
    <button class="disclosure-button" bindtap="handleToggleTrustArchive" hover-class="disclosure-button-pressed" aria-expanded="{{trustExpanded}}">
      <text>{{trustExpanded ? '收起可信档案' : '查看车况与保障摘要'}}</text>
      <view class="disclosure-chevron {{trustExpanded ? 'disclosure-chevron-open' : ''}}" aria-hidden="true"></view>
    </button>
    <view wx:if="{{trustExpanded}}" class="trust-profile-list">
      <view class="trust-profile-item" wx:for="{{car.trustArchive.items}}" wx:key="key">
        <view class="trust-profile-item-label">{{item.label}}</view>
        <view class="trust-profile-item-value">{{item.value}}</view>
        <view wx:if="{{item.summary}}" class="trust-profile-item-summary">{{item.summary}}</view>
      </view>
      <view class="trust-channel-card">
        <view class="trust-channel-title">经营与客诉渠道</view>
        <view class="trust-channel-row"><text>服务品牌</text><text>{{brandName}}</text></view>
        <view class="trust-channel-row"><text>客服、监督与投诉</text><text>{{servicePhone}}</text></view>
        <view class="trust-channel-note">经营主体材料可通过该渠道进一步核验；来电由人工登记处理，不承诺实时道路救援调度。</view>
        <button class="trust-channel-call ui-btn ui-btn-ghost" bindtap="handlePhoneCall">电话咨询 / 投诉</button>
      </view>
    </view>
  </view>

  <view class="info-card ui-card">
    <view class="section-heading">
      <view class="section-mark"></view>
      <view class="section-title">预约流程</view>
    </view>
    <view class="service-flow">
      <view class="service-step" wx:for="{{serviceSteps}}" wx:key="key">
        <view class="service-step-index">{{item.index}}</view>
        <view class="service-step-title">{{item.title}}</view>
        <view class="service-step-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="info-card ui-card rental-rules-card">
    <view class="section-heading">
      <view class="section-mark"></view>
      <view class="section-title">租赁规则</view>
    </view>
    <view class="rental-rules-summary">押金、取消改期、超时和油电标准会在确认前明确说明。</view>
    <button class="disclosure-button rental-disclosure-button" bindtap="handleToggleRentalRules" hover-class="disclosure-button-pressed" aria-expanded="{{rulesExpanded}}">
      <text>{{rulesExpanded ? '收起租赁规则' : '查看完整租赁规则'}}</text>
      <view class="disclosure-chevron {{rulesExpanded ? 'disclosure-chevron-open' : ''}}" aria-hidden="true"></view>
    </button>
    <view wx:if="{{rulesExpanded}}" class="disclosure-list rental-rule-list">
      <view class="disclosure-item" wx:for="{{pricingOverview.ruleItems}}" wx:key="key">
        <view class="disclosure-label">{{item.label}}</view>
        <view class="disclosure-text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <view class="detail-bottom-bar">
    <view class="bottom-action-meta">
      <view class="bottom-action-status {{car.statusClass}}">
        <view class="bottom-action-dot"></view>
        <text>{{car.statusText}}</text>
      </view>
      <view class="bottom-action-hint">{{car.actionHintText}}</view>
    </view>
    <view class="bottom-action-buttons">
      <button class="action-button ui-btn ui-btn-primary" bindtap="handleBookingTap" aria-label="{{car.primaryActionText}}，{{car.actionHintText}}">
        <view class="detail-action-content"><view class="detail-action-native-icon booking-action-native-icon" aria-hidden="true"></view><text>{{car.primaryActionText}}</text></view>
      </button>
      <button class="action-button ui-btn ui-btn-ghost action-button-offset" bindtap="handlePhoneCall" aria-label="电话咨询极境车库顾问">
        <view class="detail-action-content"><view class="detail-action-native-icon phone-action-native-icon" aria-hidden="true"></view><text>电话咨询</text></view>
      </button>
      <button class="action-button ui-btn ui-btn-ghost action-button-offset" bindtap="handleWechatConsult" aria-label="复制微信咨询极境车库顾问">
        <view class="detail-action-content"><view class="detail-action-native-icon wechat-action-native-icon" aria-hidden="true"></view><text>微信咨询</text></view>
      </button>
    </view>
  </view>

  <view wx:if="{{posterModalVisible}}" class="poster-modal-overlay" bindtap="handleClosePosterModal" hover-class="none" aria-role="button" aria-modal="true">
    <view class="poster-modal-dialog ui-card" catchtap="true">
      <view class="poster-modal-header">
        <view class="poster-modal-title">车型专属海报</view>
        <view class="poster-modal-close" bindtap="handleClosePosterModal" hover-class="poster-modal-close-hover" aria-role="button" aria-label="关闭海报弹窗">✕</view>
      </view>

      <view class="poster-canvas-wrap">
        <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>
        <view wx:if="{{posterGenerating}}" class="poster-loading-box">
          <view class="poster-spinner"></view>
          <text class="poster-loading-text">正在生成高清海报…</text>
        </view>
      </view>

      <view class="poster-modal-footer">
        <button class="ui-btn ui-btn-primary poster-save-action" bindtap="handleSavePoster" disabled="{{posterGenerating}}">
          保存海报到相册
        </button>
        <view class="poster-modal-subtip">保存后可分享到微信朋友圈或车友群</view>
      </view>
    </view>
  </view>
</view>

<view class="empty-page ui-card" wx:else>
  <image class="empty-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
  <view class="empty-kicker">VEHICLE PROFILE</view>
  <view class="empty-title">车辆详情</view>
  <view class="empty-desc">{{loadError ? loadErrorText : notFoundText}}</view>
  <button wx:if="{{loadError}}" class="empty-action ui-btn ui-btn-primary" bindtap="handleRetryLoad">
    <view class="detail-action-content"><view class="detail-action-native-icon retry-action-native-icon" aria-hidden="true"></view><text>重新加载</text></view>
  </button>
  <button wx:else class="empty-action ui-btn ui-btn-primary" bindtap="handleBackGarage">
    <view class="detail-action-content"><view class="detail-action-native-icon back-action-native-icon" aria-hidden="true"></view><text>返回车库首页</text></view>
  </button>
</view>
