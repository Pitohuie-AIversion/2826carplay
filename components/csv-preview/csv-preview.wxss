.csv-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 10000; background: rgba(0,0,0,.78); display: flex; align-items: center; padding: 24rpx; box-sizing: border-box; }
.csv-panel { width: 100%; max-height: 88vh; background: #171b24; color: #f5f7ff; border: 1rpx solid #394156; border-radius: 24rpx; overflow: hidden; }
.csv-heading { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; border-bottom: 1rpx solid #394156; }
.csv-title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600; word-break: break-all; }
.csv-close { flex-shrink: 0; margin: 0; padding: 0 24rpx; color: #e9efff; background: #303b55; font-size: 26rpx; line-height: 64rpx; }
.csv-close::after { border: 0; }
.csv-scroll { width: 100%; height: 60vh; }
.csv-table { display: inline-block; min-width: 100%; }
.csv-row { display: flex; }
.csv-cell { flex: 0 0 260rpx; box-sizing: border-box; padding: 18rpx; border-right: 1rpx solid #394156; border-bottom: 1rpx solid #394156; font-size: 25rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
.csv-first-row { background: #26314a; font-weight: 600; }
.csv-status { display: block; padding: 64rpx 24rpx; font-size: 28rpx; }
.csv-note { display: block; padding: 20rpx 24rpx; color: #b9c4da; font-size: 23rpx; line-height: 1.6; }
