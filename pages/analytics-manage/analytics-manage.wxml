<view wx:if="{{pageAuthorized}}" class="analytics-page management-page">
  <view class="page-glow"></view>

  <view class="hero-card ui-card ui-card-gradient">
    <view class="hero-top">
      <view>
        <view class="page-kicker">GARAGE INSIGHTS</view>
        <view class="hero-title">数据分析</view>
        <view class="hero-desc">了解车辆关注度与预约转化趋势</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    </view>
    <view class="period-row">
      <view
        wx:for="{{periodOptions}}"
        wx:key="value"
        class="period-chip {{days === item.value ? 'period-chip-active' : ''}} {{cleanupLoading ? 'period-chip-disabled' : ''}}"
        data-days="{{item.value}}"
        bindtap="handlePeriodTap"
        hover-class="period-chip-pressed"
        aria-role="button"
        aria-pressed="{{days === item.value}}"
        aria-disabled="{{cleanupLoading}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="analytics-skeleton" aria-hidden="true">
    <view class="metric-grid">
      <view class="metric-card metric-skeleton-card ui-card" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this">
        <view class="metric-skeleton-top">
          <view class="metric-skeleton-label manage-skeleton-pulse"></view>
          <view class="metric-skeleton-icon manage-skeleton-pulse"></view>
        </view>
        <view class="metric-skeleton-value manage-skeleton-pulse"></view>
      </view>
    </view>
    <view class="section-card analytics-skeleton-section ui-card">
      <view class="analytics-skeleton-heading">
        <view>
          <view class="analytics-skeleton-kicker manage-skeleton-pulse"></view>
          <view class="analytics-skeleton-title manage-skeleton-pulse"></view>
        </view>
        <view class="analytics-skeleton-index manage-skeleton-pulse"></view>
      </view>
      <view class="analytics-skeleton-funnel-row" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this">
        <view class="analytics-skeleton-funnel-label manage-skeleton-pulse"></view>
        <view class="analytics-skeleton-funnel-bar manage-skeleton-pulse"></view>
      </view>
    </view>
    <view class="section-card analytics-skeleton-section analytics-skeleton-section-muted ui-card">
      <view class="analytics-skeleton-heading">
        <view>
          <view class="analytics-skeleton-kicker manage-skeleton-pulse"></view>
          <view class="analytics-skeleton-title manage-skeleton-pulse"></view>
        </view>
        <view class="analytics-skeleton-index manage-skeleton-pulse"></view>
      </view>
      <view class="analytics-skeleton-columns">
        <view class="analytics-skeleton-column manage-skeleton-pulse" wx:for="{{[1, 2, 3, 4, 5, 6, 7]}}" wx:key="*this"></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{loadError}}" class="state-card ui-card">
    <view class="analytics-state-icon" aria-hidden="true"><view class="analytics-state-mark"></view></view>
    <view class="state-title">暂时无法加载数据</view>
    <view class="state-desc">{{loadError}}</view>
    <button class="retry-button ui-btn ui-btn-ghost" bindtap="handleRetry"><view class="analytics-action-content"><view class="analytics-action-native-icon analytics-retry-native-icon" aria-hidden="true"></view><text>重新加载</text></view></button>
  </view>

  <block wx:else>
    <view class="metric-grid">
      <view class="metric-card metric-{{item.tone}} ui-card" wx:for="{{metricItems}}" wx:key="key">
        <view class="metric-top">
          <view class="metric-label">{{item.label}}</view>
          <view class="metric-icon-wrap" aria-hidden="true">
            <view class="metric-icon metric-icon-{{item.icon}}"></view>
          </view>
        </view>
        <view class="metric-value">{{item.value}}</view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">DECISION SIGNALS</view>
          <view class="section-title">用户决策行为</view>
        </view>
        <view class="section-index">02</view>
      </view>
      <view class="decision-grid">
        <view class="decision-item" wx:for="{{decisionItems}}" wx:key="key">
          <view class="decision-label">{{item.label}}</view>
          <view class="decision-value">{{item.value}}</view>
          <view wx:if="{{item.meta}}" class="decision-meta">{{item.meta}}</view>
        </view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">QUOTE LOOP</view>
          <view class="section-title">报价确认闭环</view>
        </view>
        <view class="section-index">03</view>
      </view>
      <view class="decision-grid">
        <view class="decision-item" wx:for="{{quoteMetricItems}}" wx:key="key">
          <view class="decision-label">{{item.label}}</view>
          <view class="decision-value">{{item.value}}</view>
          <view class="decision-meta">{{item.meta}}</view>
        </view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">CONVERSION FUNNEL</view>
          <view class="section-title">预约转化漏斗</view>
        </view>
        <view class="section-index">01</view>
      </view>
      <view class="funnel-list">
        <view class="funnel-item" wx:for="{{funnelItems}}" wx:key="key">
          <view class="funnel-head">
            <view class="funnel-stage">
              <view class="funnel-stage-index">{{index + 1}}</view>
              <view>{{item.label}}</view>
            </view>
            <view class="funnel-metric">
              <text class="funnel-value">{{item.value}}</text>
              <text class="funnel-rate">{{item.rate}}%</text>
            </view>
          </view>
          <view class="bar-track">
            <view class="bar-fill funnel-fill" style="width: {{item.width}}%;"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">TRUST PROFILE</view>
          <view class="section-title">可信档案转化</view>
        </view>
        <view class="section-index">04</view>
      </view>
      <view class="decision-grid">
        <view class="decision-item" wx:for="{{trustProfileMetricItems}}" wx:key="key">
          <view class="decision-label">{{item.label}}</view>
          <view class="decision-value">{{item.value}}</view>
          <view class="decision-meta">{{item.meta}}</view>
        </view>
      </view>
      <view class="decision-note">比率为同周期匿名事件汇总，不用于识别或追踪单个用户。</view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">ACTIVITY TREND</view>
          <view class="section-title">每日行为趋势</view>
        </view>
        <view class="section-index">03</view>
      </view>
      <view class="trend-scroll-shell ui-scroll-shell">
        <scroll-view class="trend-scroll" scroll-x enhanced show-scrollbar="{{false}}" aria-label="近 {{days}} 天每日行为趋势，可横向滑动查看">
          <view class="trend-chart">
            <view class="trend-item {{item.isPeak ? 'trend-item-peak' : ''}}" wx:for="{{trendItems}}" wx:key="key" aria-label="{{item.label}}，共 {{item.value}} 次行为{{item.isPeak ? '，本周期峰值' : ''}}">
              <view class="trend-value">{{item.value}}</view>
              <view class="trend-column">
                <view class="trend-fill {{item.isPeak ? 'trend-fill-peak' : ''}}" style="height: {{item.width}}%;"></view>
              </view>
              <view class="trend-label">{{item.label}}</view>
            </view>
          </view>
        </scroll-view>
        <view wx:if="{{trendItems.length > 10}}" class="ui-scroll-cue trend-scroll-cue" aria-hidden="true"></view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">POPULAR VEHICLES</view>
          <view class="section-title">热门车型</view>
        </view>
        <view class="section-index">04</view>
      </view>
      <view wx:if="{{topVehicles.length}}" class="vehicle-rank-list">
        <view class="rank-item" wx:for="{{topVehicles}}" wx:key="vehicleId">
          <view class="rank-number">{{index + 1}}</view>
          <view class="rank-copy">
            <view class="rank-name">{{item.name}}</view>
            <view class="rank-meta">详情 {{item.detailViews}} · 档案 {{item.trustProfileViews}} · 费用 {{item.pricingViews}} · 预约 {{item.bookingStarts}} · 收藏 {{item.favorites}}</view>
          </view>
          <view class="rank-score">{{item.score}}</view>
        </view>
      </view>
      <view wx:else class="inline-empty">
        <view class="analytics-empty-native-icon" aria-hidden="true"></view>
        <view class="analytics-empty-title">当前周期暂无车辆行为数据</view>
        <view class="analytics-empty-desc">产生浏览、收藏或预约行为后，这里会生成车辆热度排行。</view>
      </view>
    </view>

    <view wx:if="{{truncated}}" class="scope-tip"><view class="analytics-tip-native-icon analytics-warning-native-icon" aria-hidden="true"><view class="analytics-warning-native-mark"></view></view><text>数据量超过 5000 条，当前统计为最近记录的汇总结果。</text></view>
    <view class="privacy-tip"><view class="analytics-tip-native-icon analytics-lock-native-icon" aria-hidden="true"><view class="analytics-lock-native-shackle"></view></view><text>仅统计事件类型、车辆 ID 与时间，不保存用户身份和预约表单内容。</text></view>

    <view wx:if="{{canCleanup}}" class="section-card cleanup-card ui-card">
      <view class="section-heading">
        <view>
          <view class="section-eyebrow">DATA RETENTION</view>
          <view class="section-title">匿名数据保留</view>
        </view>
        <view class="section-index">05</view>
      </view>
      <view class="cleanup-desc">管理员可分批删除 90 天前的匿名行为事件。预约、车辆和用户资料不受影响。</view>
      <button
        class="cleanup-button ui-btn ui-btn-ghost"
        loading="{{cleanupLoading}}"
        disabled="{{loading || cleanupLoading}}"
        bindtap="handleCleanup"
        aria-label="清理九十天前的匿名行为数据"
      >
        <view class="analytics-action-content"><view wx:if="{{!cleanupLoading}}" class="analytics-action-native-icon analytics-cleanup-native-icon" aria-hidden="true"></view><text>{{cleanupLoading ? '正在清理' : '清理 90 天前数据'}}</text></view>
      </button>
    </view>
  </block>
</view>
