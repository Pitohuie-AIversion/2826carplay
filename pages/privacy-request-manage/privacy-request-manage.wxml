<view class="privacy-manage-page management-page">
  <view class="page-glow"></view>
  <view class="hero-card ui-card ui-card-gradient">
    <view class="hero-top">
      <view class="hero-copy">
        <view class="page-kicker">PRIVACY OPERATIONS</view>
        <view class="hero-title">隐私申请处理</view>
        <view class="hero-desc">处理用户个人信息查询、更正与删除申请</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" />
    </view>
  </view>

  <view class="filter-card ui-card">
    <view class="section-heading">
      <view>
        <view class="section-eyebrow">REQUEST FILTER</view>
        <view class="section-heading-title">筛选申请</view>
      </view>
      <view class="section-index">01</view>
    </view>
    <input
      class="keyword-input ui-input"
      placeholder="搜索 OpenID 或申请 ID"
      value="{{keyword}}"
      bindinput="handleKeywordInput"
      confirm-type="search"
      bindconfirm="handleSearch"
    />
    <scroll-view class="filter-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="chip-list">
        <view
          wx:for="{{statusOptions}}"
          wx:key="value"
          class="filter-chip ui-pill {{currentStatus === item.value ? 'ui-pill-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleStatusTap"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>
    <scroll-view class="filter-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="chip-list">
        <view
          wx:for="{{typeOptions}}"
          wx:key="value"
          class="filter-chip ui-pill {{currentType === item.value ? 'ui-pill-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleTypeTap"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>
    <button class="search-btn ui-btn ui-btn-primary" bindtap="handleSearch">查询</button>
    <view class="result-count">当前筛选结果 {{total}}{{truncated ? '+' : ''}} 条</view>
  </view>

  <view wx:if="{{(initialLoading || loading) && !list.length}}" class="loading-card ui-card">正在加载申请…</view>

  <view wx:elif="{{list.length}}" class="request-list">
    <view class="list-heading">
      <view>
        <view class="list-kicker">PRIVACY REQUESTS</view>
        <view class="list-title">申请记录</view>
      </view>
      <view class="list-count">{{total}}{{truncated ? '+' : ''}} 条</view>
    </view>

    <view class="request-card ui-card" wx:for="{{list}}" wx:key="id">
      <view class="request-head">
        <view>
          <view class="request-type">{{item.typeLabel}}</view>
          <view class="request-time">{{item.createdAtText || '--'}}</view>
        </view>
        <view class="status-pill {{item.statusClass}}">{{item.statusLabel}}</view>
      </view>
      <view class="identity-row">
        <view class="identity-text">{{item.openid || '--'}}</view>
        <button class="copy-btn ui-btn ui-btn-ghost" data-openid="{{item.openid}}" bindtap="handleCopyOpenid">复制</button>
      </view>
      <view class="field-label">申请说明</view>
      <view class="field-content">{{item.description || '--'}}</view>
      <view wx:if="{{item.resolutionNote}}" class="resolution-box">
        <view class="field-label">处理反馈</view>
        <view class="field-content">{{item.resolutionNote}}</view>
      </view>
      <view class="request-actions">
        <button
          class="inventory-btn ui-btn ui-btn-ghost"
          data-id="{{item.id}}"
          bindtap="handleInventoryTap"
        >
          核验相关数据
        </button>
        <button
          wx:if="{{item.canHandle}}"
          class="handle-btn ui-btn ui-btn-primary"
          loading="{{updatingId === item.id}}"
          disabled="{{updatingId}}"
          data-id="{{item.id}}"
          bindtap="handleRequestAction"
        >
          处理申请
        </button>
      </view>
    </view>

    <button
      wx:if="{{hasMore}}"
      class="load-more-btn ui-btn ui-btn-ghost"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="handleLoadMore"
    >
      加载更多
    </button>
    <view wx:else class="list-end">已加载全部申请</view>
  </view>

  <view wx:else class="empty-card ui-card">
    <image class="manage-empty-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" />
    <view class="manage-empty-kicker">NO PRIVACY REQUESTS</view>
    <view class="empty-title">暂无匹配申请</view>
    <view class="empty-desc">调整状态、类型或关键词后重试。</view>
  </view>
</view>
