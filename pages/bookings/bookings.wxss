.vehicle-native-wheel-right { right: 5rpx; }
.booking-name { min-width: 0; color: #f7f9fc; font-size: 31rpx; font-weight: 650; line-height: 1.4; word-break: break-word; }
.booking-vehicle-copy { min-width: 0; }
.booking-vehicle-reference { margin-top: 2rpx; color: #7f8da0; font-size: 19rpx; line-height: 1.4; }
.journey-panel { display: flex; align-items: center; margin-top: 24rpx; padding: 22rpx; border: 1rpx solid rgba(255, 255, 255, 0.065); border-radius: 20rpx; background: rgba(255, 255, 255, 0.025); }
.journey-date { flex-shrink: 0; }
.journey-date-end { text-align: right; }
.journey-label { color: #66717f; font-size: 18rpx; line-height: 1.4; }
.journey-value { margin-top: 6rpx; color: #dce1e8; font-size: 22rpx; font-weight: 600; line-height: 1.4; }
.journey-route { display: flex; align-items: center; flex: 1; margin: 20rpx 18rpx 0; }
.route-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #548fff; }
.route-line { flex: 1; height: 1rpx; background: linear-gradient(90deg, #548fff, rgba(84, 143, 255, 0.15)); }
.route-arrow { display: flex; align-items: center; justify-content: center; width: 18rpx; height: 18rpx; color: #667c9f; }
.route-chevron { width: 8rpx; height: 8rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; box-sizing: border-box; transform: rotate(-45deg); }
.booking-city { display: flex; align-items: center; margin-top: 16rpx; color: #8d97a4; font-size: 21rpx; line-height: 1.5; }
.city-pin { position: relative; width: 9rpx; height: 9rpx; margin-right: 10rpx; border: 2rpx solid #5e8edc; border-radius: 50%; }
.city-pin::after { position: absolute; right: -3rpx; bottom: -5rpx; width: 6rpx; height: 6rpx; border-right: 2rpx solid #5e8edc; border-bottom: 2rpx solid #5e8edc; transform: rotate(45deg); content: ""; }
.booking-progress { margin-top: 18rpx; padding: 19rpx 20rpx 17rpx; border: 1rpx solid rgba(84, 143, 255, 0.12); border-radius: 17rpx; background: rgba(84, 143, 255, 0.035); }
.booking-progress-heading { display: flex; align-items: center; justify-content: space-between; }
.booking-progress-kicker { color: #71839d; font-size: 15rpx; font-weight: 650; line-height: 1.4; letter-spacing: 2rpx; }
.booking-progress-stage { color: #8fb5ed; font-size: 17rpx; font-weight: 600; line-height: 1.4; }
.booking-progress-track { position: relative; height: 2rpx; margin: 25rpx 9rpx 0; background: rgba(255, 255, 255, 0.09); }
.booking-progress-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #4c87e3, #6da6fb); transition: width 0.25s ease; }
.booking-progress-node { position: absolute; top: -8rpx; display: flex; align-items: center; justify-content: center; width: 18rpx; height: 18rpx; border: 2rpx solid #394657; border-radius: 50%; background: #171d25; box-sizing: border-box; transform: translateX(-50%); }
.booking-progress-node-one { left: 0; }
.booking-progress-node-two { left: 50%; }
.booking-progress-node-three { left: 100%; }
.progress-node-mark { width: 5rpx; height: 5rpx; border-radius: 50%; background: #465366; }
.journey-step-complete,
.journey-step-current { border-color: #659cf1; box-shadow: 0 0 13rpx rgba(101, 156, 241, 0.28); }
.journey-step-complete .progress-node-mark,
.journey-step-current .progress-node-mark { background: #79adfa; }
.journey-step-current { width: 22rpx; height: 22rpx; top: -10rpx; border-color: #92bbf8; }
.journey-step-cancelled { border-color: #727d8c; }
.journey-step-cancelled .progress-node-mark { position: relative; width: 8rpx; height: 2rpx; border-radius: 2rpx; background: #87919d; transform: rotate(-45deg); }
.booking-progress-labels { display: flex; justify-content: space-between; margin-top: 14rpx; color: #657184; font-size: 15rpx; line-height: 1.4; }
.booking-progress-contacted { border-color: rgba(74, 184, 134, 0.14); background: rgba(74, 184, 134, 0.035); }
.booking-progress-contacted .booking-progress-stage { color: #77c79f; }
.booking-progress-contacted .booking-progress-fill { background: linear-gradient(90deg, #438e6b, #60c392); }
.booking-progress-completed,
.booking-progress-cancelled { border-color: rgba(139, 148, 161, 0.11); background: rgba(139, 148, 161, 0.025); }
.booking-progress-completed .booking-progress-stage,
.booking-progress-cancelled .booking-progress-stage { color: #8d98a6; }
.booking-progress-cancelled .booking-progress-fill { background: #626d7b; }
.booking-guidance { display: flex; align-items: flex-start; margin-top: 18rpx; padding: 18rpx 20rpx; border: 1rpx solid rgba(84, 143, 255, 0.12); border-radius: 17rpx; background: rgba(84, 143, 255, 0.045); }
.booking-guidance-mark { flex-shrink: 0; width: 8rpx; height: 42rpx; margin: 4rpx 15rpx 0 0; border-radius: 999rpx; background: #5d96f4; }
.booking-guidance-native-icon { position: relative; display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 34rpx; height: 34rpx; margin: 2rpx 15rpx 0 0; border: 2rpx solid #5d96f4; border-radius: 50%; color: #5d96f4; box-sizing: border-box; }
.booking-guidance-icon-mark { width: 4rpx; height: 9rpx; border-radius: 2rpx; background: currentColor; box-shadow: 0 12rpx 0 -1rpx currentColor; }
.booking-guidance-title { color: #c8d8ef; font-size: 20rpx; font-weight: 600; line-height: 1.45; }
.booking-guidance-desc { margin-top: 5rpx; color: #758397; font-size: 17rpx; line-height: 1.58; }
.booking-guidance-contacted { border-color: rgba(74, 184, 134, 0.14); background: rgba(74, 184, 134, 0.045); }
.booking-guidance-contacted .booking-guidance-mark { background: #59c894; }
.booking-guidance-contacted .booking-guidance-native-icon { border-color: #59c894; color: #59c894; }
.booking-guidance-completed,
.booking-guidance-cancelled { border-color: rgba(139, 148, 161, 0.11); background: rgba(139, 148, 161, 0.035); }
.booking-guidance-completed .booking-guidance-mark,
.booking-guidance-cancelled .booking-guidance-mark { background: #788493; }
.booking-guidance-completed .booking-guidance-native-icon,
.booking-guidance-cancelled .booking-guidance-native-icon { border-color: #788493; color: #788493; }
.booking-note-box { margin-top: 18rpx; padding: 18rpx 20rpx; border-left: 3rpx solid rgba(84, 143, 255, 0.55); border-radius: 0 16rpx 16rpx 0; background: rgba(65, 104, 164, 0.07); }
.booking-note-label { color: #71809a; font-size: 18rpx; line-height: 1.4; }
.booking-note-heading { display: flex; align-items: center; }
.note-native-icon { position: relative; width: 22rpx; height: 24rpx; margin-right: 9rpx; border: 2rpx solid #6683ae; border-radius: 4rpx; box-sizing: border-box; }
.note-native-line { width: 8rpx; height: 2rpx; margin: 5rpx 0 0 4rpx; border-radius: 2rpx; background: #6683ae; }
.note-native-line-long { width: 11rpx; }
.booking-note { margin-top: 8rpx; color: #949daa; font-size: 21rpx; line-height: 1.65; word-break: break-word; }
.booking-actions { display: flex; margin-top: 22rpx; }
.booking-btn { display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; height: 80rpx; margin-right: 12rpx; border-radius: 18rpx; font-size: 23rpx; line-height: 1; }
.booking-btn-last { margin-right: 0; }
.load-more { width: 100%; height: 84rpx; margin-top: 6rpx; border-radius: 20rpx; font-size: 23rpx; line-height: 1; }
.action-with-icon { display: flex; align-items: center; justify-content: center; line-height: 1; }
.native-action-icon { position: relative; flex-shrink: 0; width: 25rpx; height: 25rpx; margin-right: 10rpx; color: currentColor; box-sizing: border-box; }
.native-action-icon-document { border: 2rpx solid currentColor; border-radius: 4rpx; }
.document-line,
.native-action-icon-document::after { position: absolute; left: 5rpx; width: 11rpx; height: 2rpx; border-radius: 2rpx; background: currentColor; content: ""; }
.document-line { top: 6rpx; }
.native-action-icon-document::after { top: 13rpx; }
.native-action-icon-cancel { border: 2rpx solid currentColor; border-radius: 50%; }
.native-action-icon-cancel::after { position: absolute; top: 10rpx; left: 4rpx; width: 13rpx; height: 2rpx; border-radius: 2rpx; background: currentColor; transform: rotate(-45deg); content: ""; }
.native-action-icon-refresh { border: 2rpx solid currentColor; border-right-color: transparent; border-radius: 50%; }
.native-action-icon-refresh::after { position: absolute; top: -4rpx; right: -1rpx; width: 7rpx; height: 7rpx; border-top: 2rpx solid currentColor; border-right: 2rpx solid currentColor; transform: rotate(20deg); content: ""; }
.native-action-icon-filter { border-top: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; }
.native-action-icon-filter::before,
.native-action-icon-filter::after { position: absolute; width: 7rpx; height: 7rpx; border: 2rpx solid currentColor; border-radius: 50%; background: #111720; content: ""; }
.native-action-icon-filter::before { top: -5rpx; left: 4rpx; }
.native-action-icon-filter::after { right: 4rpx; bottom: -5rpx; }
.native-action-icon-more { border-bottom: 2rpx solid currentColor; }
.native-action-icon-more::before,
.native-action-icon-more::after { position: absolute; bottom: -1rpx; width: 10rpx; height: 2rpx; background: currentColor; content: ""; }
.native-action-icon-more::before { left: 4rpx; transform: rotate(40deg); transform-origin: left center; }
.native-action-icon-more::after { right: 4rpx; transform: rotate(-40deg); transform-origin: right center; }
.native-action-icon-garage { border: 2rpx solid currentColor; border-radius: 4rpx 4rpx 0 0; }
.garage-door { position: absolute; right: 3rpx; bottom: 0; left: 3rpx; height: 12rpx; border-top: 2rpx solid currentColor; border-right: 2rpx solid currentColor; border-left: 2rpx solid currentColor; }
.filter-empty { margin-bottom: 20rpx; padding: 52rpx 30rpx; border-color: rgba(84, 143, 255, 0.11); text-align: center; }
.filter-empty-icon { position: relative; width: 42rpx; height: 42rpx; margin: 0 auto; color: #587aa8; }
.filter-empty-line { position: absolute; left: 5rpx; width: 32rpx; height: 2rpx; border-radius: 2rpx; background: currentColor; }
.filter-empty-line::after { position: absolute; top: -5rpx; width: 10rpx; height: 10rpx; border: 2rpx solid currentColor; border-radius: 50%; background: #111720; box-sizing: border-box; content: ""; }
.filter-empty-line-top { top: 12rpx; }
.filter-empty-line-top::after { left: 6rpx; }
.filter-empty-line-bottom { top: 29rpx; }
.filter-empty-line-bottom::after { right: 6rpx; }
.filter-empty-title { margin-top: 15rpx; color: #e8edf4; font-size: 25rpx; font-weight: 650; line-height: 1.45; }
.filter-empty-desc { max-width: 520rpx; margin: 9rpx auto 0; color: #758192; font-size: 19rpx; line-height: 1.65; }
.filter-empty-action { width: 240rpx; height: 68rpx; margin-top: 22rpx; border-radius: 16rpx; font-size: 19rpx; line-height: 1; }
.list-end { padding: 8rpx 0 0; color: #586474; font-size: 17rpx; line-height: 1.5; text-align: center; }
.loading-card { display: flex; align-items: center; padding: 34rpx; }
.loading-mark { width: 42rpx; height: 42rpx; margin-right: 20rpx; border: 3rpx solid rgba(84, 143, 255, 0.18); border-top-color: #548fff; border-radius: 50%; }
.loading-title { color: #e9edf2; font-size: 25rpx; font-weight: 600; }
.loading-desc { margin-top: 5rpx; color: #707a87; font-size: 20rpx; }
.empty { margin-top: 8rpx; padding: 64rpx 34rpx; text-align: center; }
.empty-emblem { width: 108rpx; height: 108rpx; border-radius: 50%; opacity: 0.82; }
.empty-kicker { margin-top: 20rpx; }
.empty-title { margin-top: 10rpx; color: #f3f5f8; font-size: 29rpx; font-weight: 650; line-height: 1.4; }
.empty-desc { margin-top: 12rpx; color: #838d9b; font-size: 23rpx; line-height: 1.65; }
.empty-action { width: 100%; height: 84rpx; margin-top: 26rpx; border-radius: 19rpx; font-size: 24rpx; line-height: 1; }
.bookings-skeleton { position: relative; z-index: 1; }
.skeleton-heading,
.skeleton-booking-top,
.skeleton-journey { display: flex; align-items: center; justify-content: space-between; }
.skeleton-heading { align-items: flex-end; margin: 2rpx 8rpx 20rpx; }
.skeleton-kicker { width: 176rpx; height: 17rpx; border-radius: 9rpx; }
.skeleton-title { width: 154rpx; height: 34rpx; margin-top: 14rpx; border-radius: 10rpx; }
.skeleton-count { width: 100rpx; height: 18rpx; margin-bottom: 5rpx; border-radius: 9rpx; }
.skeleton-booking-card { margin-bottom: 20rpx; padding: 28rpx; border-color: rgba(255, 255, 255, 0.075); background: linear-gradient(145deg, #181d25, #14171c 72%); }
.skeleton-booking-card-muted { opacity: 0.72; }
.skeleton-index { width: 166rpx; height: 17rpx; border-radius: 8rpx; }
.skeleton-status { width: 112rpx; height: 52rpx; border-radius: 999rpx; }
.skeleton-car-name { width: 64%; height: 38rpx; margin-top: 22rpx; border-radius: 10rpx; }
.skeleton-journey { margin-top: 24rpx; padding: 25rpx 22rpx; border: 1rpx solid rgba(255, 255, 255, 0.055); border-radius: 20rpx; background: rgba(255, 255, 255, 0.02); }
.skeleton-date { width: 142rpx; height: 38rpx; border-radius: 9rpx; }
.skeleton-route { flex: 1; height: 4rpx; margin: 0 24rpx; border-radius: 999rpx; }
.skeleton-city { width: 158rpx; height: 20rpx; margin-top: 20rpx; border-radius: 9rpx; }
.skeleton-action { width: 100%; height: 80rpx; margin-top: 24rpx; border-radius: 18rpx; }
.skeleton-pulse { background: linear-gradient(105deg, #181c22 12%, #29313c 34%, #181c22 56%); background-size: 220% 100%; animation: bookingsSkeletonPulse 1.6s ease-in-out infinite; }
@keyframes bookingsSkeletonPulse { 0% { background-position: 160% 0; }
  100% { background-position: -70% 0; }
}
