.retry-native-icon {
  position: relative;
  width: 23rpx;
  height: 23rpx;
  margin-right: 9rpx;
  border: 2rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.retry-native-icon::after {
  position: absolute;
  top: -4rpx;
  right: -1rpx;
  width: 7rpx;
  height: 7rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  content: "";
  transform: rotate(20deg);
}

.back-native-icon {
  width: 12rpx;
  height: 12rpx;
  margin-right: 9rpx;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.manage-detail-state-desc + .manage-detail-state-btn {
  margin-top: 26rpx;
}
