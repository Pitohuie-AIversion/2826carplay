<view class="content-page">
  <view class="page-glow"></view>

  <view class="hero-card ui-card ui-card-gradient">
    <view class="hero-top">
      <view>
        <view class="hero-kicker">{{type === 'privacy' ? 'PRIVACY & DATA' : type === 'rules' ? 'SERVICE RULES' : 'HELP CENTER'}}</view>
        <view class="hero-title">{{pageTitle}}</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    </view>
    <view class="hero-desc">{{heroDesc}}</view>
  </view>

  <view class="content-switcher ui-card">
    <view class="switcher-heading">
      <view>
        <view class="switcher-kicker">SERVICE GUIDE</view>
        <view class="switcher-title">服务指南</view>
      </view>
      <view class="switcher-note">选择内容</view>
    </view>
    <view class="content-tabs" aria-role="tablist" aria-label="服务指南内容类型">
      <button
        class="content-tab {{type === item.type ? 'content-tab-active' : ''}}"
        wx:for="{{contentTabs}}"
        wx:key="type"
        data-type="{{item.type}}"
        bindtap="handleContentTabTap"
        hover-class="content-control-pressed"
        aria-role="tab"
        aria-selected="{{type === item.type}}"
        aria-label="{{item.title}}"
      >
        <text class="content-tab-kicker">{{item.kicker}}</text>
        <text class="content-tab-title">{{item.title}}</text>
      </button>
    </view>
  </view>

  <view class="content-card ui-card">
    <view class="document-head">
      <view class="document-mark"></view>
      <view>
        <view class="document-label">OFFICIAL DOCUMENT</view>
        <view class="document-title">{{documentTitle}}</view>
      </view>
      <view class="document-count"><block wx:if="{{sections.length}}"><text class="document-count-value">{{sections.length}}</text><text>节内容</text></block><block wx:else>官方内容</block></view>
    </view>
    <view class="document-divider"></view>
    <view wx:if="{{sections.length > 1}}" class="section-index-shell">
      <scroll-view
        class="section-index"
        scroll-x="{{true}}"
        scroll-with-animation="{{true}}"
        scroll-into-view="content-index-{{activeSectionKey}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        aria-label="章节目录，可横向滑动"
      >
        <view class="section-index-track">
          <button
            id="content-index-{{item.key}}"
            class="section-index-item {{activeSectionKey === item.key ? 'section-index-item-active' : ''}}"
            wx:for="{{sections}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="handleSectionTap"
            hover-class="content-control-pressed"
            aria-pressed="{{activeSectionKey === item.key}}"
          >
            <text class="section-index-number">{{item.number}}</text>
            <text class="section-index-title">{{item.title}}</text>
          </button>
        </view>
      </scroll-view>
      <view wx:if="{{sections.length > 3}}" class="section-scroll-cue" aria-hidden="true">
        <view class="section-scroll-cue-arrow"></view>
      </view>
    </view>
    <view wx:if="{{intro}}" class="document-intro">{{intro}}</view>
    <view wx:if="{{sections.length}}" class="document-sections">
      <view id="{{item.key}}" class="document-section" wx:for="{{sections}}" wx:key="key">
        <view class="section-number">{{item.number}}</view>
        <view class="section-copy">
          <view class="section-title">{{item.title}}</view>
          <view wx:if="{{item.body}}" class="section-body">{{item.body}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="content-text">{{content}}</view>
  </view>

  <view wx:if="{{type === 'privacy'}}" class="rights-card ui-card">
    <view class="rights-icon" aria-hidden="true">
      <view class="rights-document-icon">
        <view class="rights-document-check"></view>
      </view>
    </view>
    <view class="rights-copy">
      <view class="rights-kicker">PRIVACY RIGHTS</view>
      <view class="rights-title">行使您的个人信息权利</view>
      <view class="rights-desc">在线提交查询、更正或删除申请，并随时查看处理进度与反馈。</view>
    </view>
    <button class="rights-button ui-btn ui-btn-primary" bindtap="handlePrivacyRequest" hover-class="content-control-pressed" aria-label="提交个人信息查询、更正或删除申请">
      <view class="content-action-content"><view class="content-action-native-icon rights-action-native-icon" aria-hidden="true"></view><text>提交个人信息申请</text></view>
    </button>
  </view>

  <view class="support-card ui-card">
    <view class="support-heading">
      <view>
        <view class="support-kicker">NEED ASSISTANCE</view>
        <view class="support-title">仍有疑问？</view>
        <view class="support-desc">专属顾问将为您解答服务与信息相关问题</view>
      </view>
      <view class="support-mark" aria-hidden="true">
        <view class="support-headset-icon">
          <view class="support-headset-mic"></view>
        </view>
      </view>
    </view>
    <view class="support-actions">
      <button class="support-button ui-btn ui-btn-primary" open-type="contact" hover-class="content-control-pressed" aria-label="联系极境车库在线客服">
        <view class="content-action-content"><view class="content-action-native-icon support-chat-native-icon" aria-hidden="true"></view><text>在线客服</text></view>
      </button>
      <button class="support-button support-button-last ui-btn ui-btn-ghost" bindtap="handlePhoneCall" hover-class="content-control-pressed" aria-label="拨打极境车库咨询电话">
        <view class="content-action-content"><view class="content-action-native-icon support-phone-native-icon" aria-hidden="true"></view><text>电话咨询</text></view>
      </button>
    </view>
  </view>

  <view class="document-footer">
    <view class="footer-line"></view>
    <view class="footer-text">EXTREME GARAGE · OFFICIAL</view>
    <view class="footer-line"></view>
  </view>
</view>
