.csv-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 10000; background: rgba(0, 0, 0, 0.78); backdrop-filter: blur(16rpx); display: flex; align-items: center; padding: 24rpx; box-sizing: border-box; }
.csv-panel { width: 100%; max-height: 88vh; background: #171b24; color: #f5f7ff; border: 1rpx solid rgba(255, 255, 255, 0.1); border-radius: 24rpx; overflow: hidden; box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.08); }
.csv-heading { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; border-bottom: 1rpx solid rgba(255, 255, 255, 0.08); background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent); }
.csv-title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600; word-break: break-all; }
.csv-close { flex-shrink: 0; margin: 0; padding: 0 24rpx; color: #e9efff; background: rgba(255, 255, 255, 0.08); border: 1rpx solid rgba(255, 255, 255, 0.12); border-radius: 14rpx; font-size: 26rpx; line-height: 64rpx; transition: opacity 120ms ease; }
.csv-close::after { border: 0; }
.csv-scroll { width: 100%; height: 60vh; }
.csv-table { display: inline-block; min-width: 100%; }
.csv-row { display: flex; }
.csv-cell { flex: 0 0 260rpx; box-sizing: border-box; padding: 18rpx; border-right: 1rpx solid rgba(255, 255, 255, 0.07); border-bottom: 1rpx solid rgba(255, 255, 255, 0.07); font-size: 25rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
.csv-first-row { background: rgba(56, 114, 212, 0.14); font-weight: 600; color: #adc9ff; }
.csv-status { display: block; padding: 64rpx 24rpx; font-size: 28rpx; }
.csv-note { display: block; padding: 20rpx 24rpx; color: #8e9db3; font-size: 23rpx; line-height: 1.6; border-top: 1rpx solid rgba(255, 255, 255, 0.06); }

