<view class="privacy-request-page">
  <view class="hero ui-card ui-card-gradient">
    <view class="hero-top">
      <view class="hero-copy">
        <view class="page-kicker">PRIVACY RIGHTS</view>
        <view class="hero-title">个人信息申请</view>
        <view class="hero-desc">提交查询、更正或删除申请，并在此查看处理进度。</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    </view>
    <view class="hero-assurance">
      <view class="hero-lock-icon" aria-hidden="true"><view class="hero-lock-shackle"></view></view>
      <text>申请与处理进度仅对当前微信账号展示</text>
    </view>
  </view>

  <view class="form-card ui-card">
    <view class="privacy-field-heading">
      <view><view class="section-kicker">REQUEST TYPE</view><view class="section-title">选择申请类型</view></view>
      <view class="privacy-required-mark">必选</view>
    </view>
    <view class="type-list" aria-role="radiogroup" aria-label="个人信息申请类型，必选">
      <view
        wx:for="{{typeOptions}}"
        wx:key="value"
        class="type-item {{item.active ? 'type-item-active' : ''}}"
        data-value="{{item.value}}"
        bindtap="handleTypeTap"
        hover-class="type-item-pressed"
        aria-role="radio"
        aria-checked="{{item.active}}"
        aria-label="{{item.label}}：{{item.desc}}"
      >
        <view class="type-head">
          <view class="type-glyph type-glyph-{{item.value}}" aria-hidden="true">
            <view class="type-glyph-icon"></view>
          </view>
          <view class="type-copy">
            <view class="type-label">{{item.label}}</view>
            <view class="type-desc">{{item.desc}}</view>
          </view>
          <view class="type-radio" aria-hidden="true"><view class="type-radio-check"></view></view>
        </view>
      </view>
    </view>

    <view class="field-label-row"><view class="field-label">申请说明</view><view class="privacy-required-mark">必填</view></view>
    <textarea
      class="description-input {{formReady ? 'description-input-ready' : ''}}"
      maxlength="500"
      value="{{description}}"
      placeholder="请说明希望查询、更正或删除的具体内容，避免填写与申请无关的敏感信息"
      bindinput="handleDescriptionInput"
      aria-label="填写个人信息申请说明"
      aria-required="{{true}}"
    />
    <view class="field-feedback">
      <view class="description-hint {{formReady ? 'description-hint-ready' : ''}}">
        <view class="description-hint-dot"></view>
        <text>{{descriptionHint}}</text>
      </view>
      <view class="word-count">{{descriptionLength}} / 500</view>
    </view>
    <button
      class="submit-btn ui-btn ui-btn-primary"
      loading="{{submitting}}"
      disabled="{{submitting || !formReady}}"
      bindtap="handleSubmit"
      hover-class="privacy-submit-pressed"
      aria-label="{{submitting ? '正在提交个人信息申请' : formReady ? '提交个人信息申请' : '申请说明尚未填写完整'}}"
    >
      <view class="privacy-action-content"><view wx:if="{{!submitting}}" class="privacy-action-native-icon privacy-submit-native-icon" aria-hidden="true"></view><text>{{submitting ? '正在提交' : formReady ? '提交申请' : '填写说明后提交'}}</text></view>
    </button>
    <view class="form-tip"><view class="form-tip-native-icon" aria-hidden="true"></view><text>申请不会自动删除业务记录；工作人员核验身份与保留义务后处理，并在下方反馈结果。</text></view>
  </view>

  <view class="record-section">
    <view class="section-kicker">REQUEST HISTORY</view>
    <view class="section-title">我的申请记录</view>

    <view wx:if="{{list.length}}" class="request-overview ui-card">
      <view class="request-summary">
        <view>
          <view class="summary-kicker">CURRENTLY LOADED</view>
          <view class="summary-title">{{hasMore ? '当前已加载' : '共'}} {{requestSummary.total}} 条申请</view>
        </view>
        <view class="summary-metrics">
          <view class="summary-metric">
            <view class="summary-value summary-value-active">{{requestSummary.active}}</view>
            <view class="summary-label">处理中</view>
          </view>
          <view class="summary-metric">
            <view class="summary-value">{{requestSummary.completed}}</view>
            <view class="summary-label">已结束</view>
          </view>
        </view>
      </view>
      <view class="record-filters" aria-role="group" aria-label="个人信息申请记录状态筛选">
        <button
          class="record-filter {{currentFilter === 'all' ? 'record-filter-active' : ''}}"
          data-filter="all"
          bindtap="handleRecordFilterTap"
          hover-class="record-filter-pressed"
          aria-pressed="{{currentFilter === 'all'}}"
          aria-label="查看当前已加载的 {{requestSummary.total}} 条申请"
        >全部</button>
        <button
          class="record-filter {{currentFilter === 'active' ? 'record-filter-active' : ''}}"
          data-filter="active"
          bindtap="handleRecordFilterTap"
          hover-class="record-filter-pressed"
          aria-pressed="{{currentFilter === 'active'}}"
          aria-label="查看处理中的 {{requestSummary.active}} 条申请"
        >处理中</button>
        <button
          class="record-filter {{currentFilter === 'completed' ? 'record-filter-active' : ''}}"
          data-filter="completed"
          bindtap="handleRecordFilterTap"
          hover-class="record-filter-pressed"
          aria-pressed="{{currentFilter === 'completed'}}"
          aria-label="查看已结束的 {{requestSummary.completed}} 条申请"
        >已结束</button>
      </view>
    </view>

    <view
      wx:if="{{initialLoading && !list.length}}"
      class="request-skeleton"
      aria-hidden="true"
    >
      <view
        class="request-skeleton-card ui-card {{index ? 'request-skeleton-card-muted' : ''}}"
        wx:for="{{[1, 2]}}"
        wx:key="*this"
      >
        <view class="request-skeleton-head">
          <view>
            <view class="request-skeleton-type privacy-skeleton-pulse"></view>
            <view class="request-skeleton-time privacy-skeleton-pulse"></view>
          </view>
          <view class="request-skeleton-status privacy-skeleton-pulse"></view>
        </view>
        <view class="request-skeleton-stage privacy-skeleton-pulse"></view>
        <view class="request-skeleton-label privacy-skeleton-pulse"></view>
        <view class="request-skeleton-line privacy-skeleton-pulse"></view>
        <view class="request-skeleton-line request-skeleton-line-short privacy-skeleton-pulse"></view>
      </view>
    </view>

    <view wx:elif="{{loadError && !list.length}}" class="empty-card ui-card">
      <view class="empty-visual empty-visual-error" aria-hidden="true">
        <view class="empty-alert-icon"><view class="empty-alert-dot"></view></view>
      </view>
      <view class="empty-kicker">CONNECTION NOTICE</view>
      <view class="empty-title">暂时无法加载</view>
      <view class="empty-desc">{{loadError}}</view>
      <button class="retry-btn ui-btn ui-btn-ghost" bindtap="handleRetry"><view class="privacy-action-content"><view class="privacy-action-native-icon privacy-retry-native-icon" aria-hidden="true"></view><text>重新加载</text></view></button>
    </view>

    <view wx:elif="{{list.length}}" class="record-list">
      <view wx:if="{{visibleList.length}}">
      <view class="record-card ui-card" wx:for="{{visibleList}}" wx:key="id">
        <view class="record-head">
          <view>
            <view class="record-type">{{item.typeLabel}}</view>
            <view class="record-time">{{item.createdAtText || '—'}}</view>
          </view>
          <view class="status-pill {{item.statusClass}}">{{item.statusLabel}}</view>
        </view>
        <view class="record-stage">
          <view class="record-stage-dot {{item.statusClass}}"></view>
          <view>{{item.stageHint}}</view>
        </view>
        <view class="record-label">申请说明</view>
        <view class="record-content">{{item.description || '—'}}</view>
        <view wx:if="{{item.resolutionNote}}" class="resolution-box">
          <view class="record-label">处理反馈</view>
          <view class="record-content">{{item.resolutionNote}}</view>
        </view>
        <button
          wx:if="{{item.canCancel}}"
          class="cancel-request-btn ui-btn ui-btn-danger-ghost"
          loading="{{cancellingId === item.id}}"
          disabled="{{cancellingId}}"
          data-id="{{item.id}}"
          bindtap="handleCancelRequest"
          aria-label="{{cancellingId === item.id ? '正在撤回' + item.typeLabel + '申请' : '撤回' + item.typeLabel + '申请'}}"
        >
          <view class="privacy-action-content"><view wx:if="{{cancellingId !== item.id}}" class="privacy-action-native-icon privacy-cancel-native-icon" aria-hidden="true"></view><text>{{cancellingId === item.id ? '正在撤回' : '撤回申请'}}</text></view>
        </button>
      </view>
      </view>
      <view wx:else class="filter-empty ui-card">
        <view class="empty-visual empty-visual-filter" aria-hidden="true">
          <view class="empty-filter-icon">
            <view class="empty-filter-line empty-filter-line-top"><view class="empty-filter-knob"></view></view>
            <view class="empty-filter-line empty-filter-line-bottom"><view class="empty-filter-knob"></view></view>
          </view>
        </view>
        <view class="empty-kicker">FILTER RESULT</view>
        <view class="filter-empty-title">{{currentFilter === 'active' ? '当前没有处理中的申请' : '当前没有已结束的申请'}}</view>
        <view class="filter-empty-desc">其他状态的申请记录仍会保留。</view>
        <button class="filter-empty-btn ui-btn ui-btn-ghost" bindtap="handleShowAllRecords"><view class="privacy-action-content"><view class="privacy-action-native-icon privacy-list-native-icon" aria-hidden="true"></view><text>查看全部申请</text></view></button>
      </view>
      <button
        wx:if="{{hasMore}}"
        class="load-more-btn ui-btn ui-btn-ghost"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindtap="handleLoadMore"
      >
        <view class="privacy-action-content"><view wx:if="{{!loading}}" class="privacy-action-native-icon privacy-more-native-icon" aria-hidden="true"></view><text>{{loading ? '正在加载' : '加载更多'}}</text></view>
      </button>
      <view wx:else class="list-end"><view class="privacy-complete-native-icon" aria-hidden="true"></view><text>已加载全部申请</text></view>
    </view>

    <view wx:else class="empty-card ui-card">
      <view class="empty-visual empty-visual-record" aria-hidden="true">
        <view class="empty-record-icon">
          <view class="empty-record-fold"></view>
          <view class="empty-record-line empty-record-line-long"></view>
          <view class="empty-record-line empty-record-line-short"></view>
        </view>
      </view>
      <view class="empty-kicker">REQUEST HISTORY</view>
      <view class="empty-title">暂无申请记录</view>
      <view class="empty-desc">提交后可在这里查看处理进度和反馈。</view>
    </view>
  </view>
</view>
