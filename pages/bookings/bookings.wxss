.bookings-page {
  position: relative;
  min-height: 100vh;
  padding: 38rpx 24rpx 70rpx;
  overflow: hidden;
  color: #f7f8fa;
  background: linear-gradient(180deg, #141a25 0%, #0b0d10 560rpx);
  box-sizing: border-box;
}

.page-glow {
  position: absolute;
  top: -230rpx;
  right: -190rpx;
  width: 540rpx;
  height: 540rpx;
  border-radius: 50%;
  background: rgba(47, 104, 198, 0.12);
  filter: blur(90rpx);
}

.page-header,
.loading-card,
.booking-list,
.empty {
  position: relative;
  z-index: 1;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 10rpx 30rpx;
}

.page-kicker,
.list-kicker,
.empty-kicker {
  color: #657997;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 3rpx;
}

.page-title {
  margin-top: 8rpx;
  color: #f7f9fc;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.page-desc {
  margin-top: 8rpx;
  color: #838d9b;
  font-size: 22rpx;
  line-height: 1.55;
}

.header-emblem {
  flex-shrink: 0;
  width: 82rpx;
  height: 82rpx;
  margin-left: 22rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.25);
  border-radius: 50%;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.28);
}

.list-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 2rpx 8rpx 20rpx;
}

.list-title {
  margin-top: 4rpx;
  color: #f4f6f9;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
}

.list-count {
  padding-bottom: 4rpx;
  color: #66717f;
  font-size: 19rpx;
  line-height: 1.4;
}

.booking-item {
  position: relative;
  margin-bottom: 20rpx;
  padding: 28rpx;
  overflow: hidden;
  border-color: rgba(255, 255, 255, 0.075);
  background: linear-gradient(145deg, #181d25, #14171c 72%);
  box-sizing: border-box;
}

.booking-accent {
  position: absolute;
  top: 30rpx;
  left: 0;
  width: 5rpx;
  height: 56rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #528fff;
  box-shadow: 0 0 20rpx rgba(82, 143, 255, 0.35);
}

.booking-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.booking-index {
  color: #60728d;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.booking-status {
  flex-shrink: 0;
  max-width: 200rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-name {
  margin-top: 20rpx;
  color: #f7f9fc;
  font-size: 31rpx;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-word;
}

.journey-panel {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.065);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.025);
}

.journey-date {
  flex-shrink: 0;
}

.journey-date-end {
  text-align: right;
}

.journey-label {
  color: #66717f;
  font-size: 18rpx;
  line-height: 1.4;
}

.journey-value {
  margin-top: 6rpx;
  color: #dce1e8;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.journey-route {
  display: flex;
  align-items: center;
  flex: 1;
  margin: 20rpx 18rpx 0;
}

.route-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #548fff;
}

.route-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, #548fff, rgba(84, 143, 255, 0.15));
}

.route-arrow {
  color: #667c9f;
  font-size: 22rpx;
  line-height: 1;
}

.booking-city {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: #8d97a4;
  font-size: 21rpx;
  line-height: 1.5;
}

.city-pin {
  width: 9rpx;
  height: 9rpx;
  margin-right: 10rpx;
  border: 2rpx solid #5e8edc;
  border-radius: 50%;
}

.booking-note-box {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-left: 3rpx solid rgba(84, 143, 255, 0.55);
  border-radius: 0 16rpx 16rpx 0;
  background: rgba(65, 104, 164, 0.07);
}

.booking-note-label {
  color: #71809a;
  font-size: 18rpx;
  line-height: 1.4;
}

.booking-note {
  margin-top: 8rpx;
  color: #949daa;
  font-size: 21rpx;
  line-height: 1.65;
  word-break: break-word;
}

.booking-actions {
  display: flex;
  margin-top: 22rpx;
}

.booking-btn {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  margin-right: 12rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 80rpx;
}

.booking-btn-last {
  margin-right: 0;
}

.load-more {
  width: 100%;
  height: 84rpx;
  margin-top: 6rpx;
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 84rpx;
}

.loading-card {
  display: flex;
  align-items: center;
  padding: 34rpx;
}

.loading-mark {
  width: 42rpx;
  height: 42rpx;
  margin-right: 20rpx;
  border: 3rpx solid rgba(84, 143, 255, 0.18);
  border-top-color: #548fff;
  border-radius: 50%;
}

.loading-title {
  color: #e9edf2;
  font-size: 25rpx;
  font-weight: 600;
}

.loading-desc {
  margin-top: 5rpx;
  color: #707a87;
  font-size: 20rpx;
}

.empty {
  margin-top: 8rpx;
  padding: 64rpx 34rpx;
  text-align: center;
}

.empty-emblem {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  opacity: 0.82;
}

.empty-kicker {
  margin-top: 20rpx;
}

.empty-title {
  margin-top: 10rpx;
  color: #f3f5f8;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.4;
}

.empty-desc {
  margin-top: 12rpx;
  color: #838d9b;
  font-size: 23rpx;
  line-height: 1.65;
}

.empty-action {
  width: 100%;
  height: 84rpx;
  margin-top: 26rpx;
  border-radius: 19rpx;
  font-size: 24rpx;
  line-height: 84rpx;
}

.bookings-skeleton {
  position: relative;
  z-index: 1;
}

.skeleton-heading,
.skeleton-booking-top,
.skeleton-journey {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.skeleton-heading {
  align-items: flex-end;
  margin: 2rpx 8rpx 20rpx;
}

.skeleton-kicker {
  width: 176rpx;
  height: 17rpx;
  border-radius: 9rpx;
}

.skeleton-title {
  width: 154rpx;
  height: 34rpx;
  margin-top: 14rpx;
  border-radius: 10rpx;
}

.skeleton-count {
  width: 100rpx;
  height: 18rpx;
  margin-bottom: 5rpx;
  border-radius: 9rpx;
}

.skeleton-booking-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-color: rgba(255, 255, 255, 0.075);
  background: linear-gradient(145deg, #181d25, #14171c 72%);
}

.skeleton-booking-card-muted {
  opacity: 0.72;
}

.skeleton-index {
  width: 166rpx;
  height: 17rpx;
  border-radius: 8rpx;
}

.skeleton-status {
  width: 112rpx;
  height: 52rpx;
  border-radius: 999rpx;
}

.skeleton-car-name {
  width: 64%;
  height: 38rpx;
  margin-top: 22rpx;
  border-radius: 10rpx;
}

.skeleton-journey {
  margin-top: 24rpx;
  padding: 25rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.055);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.02);
}

.skeleton-date {
  width: 142rpx;
  height: 38rpx;
  border-radius: 9rpx;
}

.skeleton-route {
  flex: 1;
  height: 4rpx;
  margin: 0 24rpx;
  border-radius: 999rpx;
}

.skeleton-city {
  width: 158rpx;
  height: 20rpx;
  margin-top: 20rpx;
  border-radius: 9rpx;
}

.skeleton-action {
  width: 100%;
  height: 80rpx;
  margin-top: 24rpx;
  border-radius: 18rpx;
}

.skeleton-pulse {
  background: linear-gradient(105deg, #181c22 12%, #29313c 34%, #181c22 56%);
  background-size: 220% 100%;
  animation: bookingsSkeletonPulse 1.6s ease-in-out infinite;
}

@keyframes bookingsSkeletonPulse {
  0% {
    background-position: 160% 0;
  }

  100% {
    background-position: -70% 0;
  }
}
