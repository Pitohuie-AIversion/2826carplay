@import "../../shared/management-shell.wxss";

.config-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #101010;
  box-sizing: border-box;
}

.hero-card,
.form-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero-title,
.section-title,
.form-label {
  color: #ffffff;
}

.hero-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.hero-desc {
  margin-top: 10rpx;
  color: #b7b7b7;
  font-size: 24rpx;
  line-height: 1.7;
}

.form-tip {
  margin-top: 10rpx;
  color: #8f8f8f;
  font-size: 22rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.form-item {
  margin-top: 20rpx;
}

.form-label {
  font-size: 24rpx;
  line-height: 1.6;
}

.form-input,
.form-textarea {
  width: 100%;
  margin-top: 12rpx;
  box-sizing: border-box;
}

.form-textarea {
  min-height: 140rpx;
}

.form-textarea-lg {
  min-height: 220rpx;
}

.action-row {
  display: flex;
}

.action-btn {
  flex: 1;
}

.action-btn-offset {
  margin-left: 16rpx;
}

.config-page.management-page .hero-card,
.config-page.management-page .form-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-color: rgba(255, 255, 255, 0.075);
  border-radius: 26rpx;
}

.config-page.management-page .form-card {
  background: #15181d;
}

.config-page.management-page .form-item {
  margin-top: 24rpx;
}

.config-page.management-page .form-label {
  margin-bottom: 10rpx;
  color: #c8cdd5;
  font-size: 22rpx;
  font-weight: 500;
}

.config-page.management-page .form-input,
.config-page.management-page .form-textarea {
  margin-top: 0;
  border-color: rgba(255, 255, 255, 0.09);
  border-radius: 18rpx;
  background: #101318;
  color: #edf0f4;
  font-size: 23rpx;
}

.config-page.management-page .form-input {
  height: 82rpx;
}

.config-page.management-page .form-textarea {
  min-height: 156rpx;
  padding: 20rpx;
}

.config-page.management-page .form-textarea-lg {
  min-height: 230rpx;
}

.config-page.management-page .form-tip {
  color: #6f7a88;
  font-size: 20rpx;
}

.config-page.management-page .action-row {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
}

.config-page.management-page .action-btn {
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 88rpx;
}

.config-skeleton,
.config-state {
  position: relative;
  z-index: 1;
}

.config-skeleton-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-color: rgba(255, 255, 255, 0.075);
  border-radius: 26rpx;
  background: #15181d;
  box-sizing: border-box;
}

.config-skeleton-card-muted {
  opacity: 0.72;
}

.config-skeleton-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.config-skeleton-kicker {
  width: 178rpx;
  height: 16rpx;
  border-radius: 8rpx;
}

.config-skeleton-title {
  width: 140rpx;
  height: 31rpx;
  margin-top: 13rpx;
  border-radius: 9rpx;
}

.config-skeleton-index {
  width: 32rpx;
  height: 20rpx;
  margin-bottom: 4rpx;
  border-radius: 8rpx;
}

.config-skeleton-field {
  margin-top: 26rpx;
}

.config-skeleton-label {
  width: 112rpx;
  height: 20rpx;
  margin-bottom: 12rpx;
  border-radius: 8rpx;
}

.config-skeleton-label-short {
  width: 88rpx;
}

.config-skeleton-input,
.config-skeleton-textarea {
  width: 100%;
  height: 82rpx;
  border-radius: 18rpx;
}

.config-skeleton-textarea {
  height: 156rpx;
}

.config-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 58rpx 30rpx;
  border-color: rgba(255, 255, 255, 0.075);
  border-radius: 26rpx;
  background: linear-gradient(145deg, #1a2029, #14171c 72%);
  text-align: center;
}

.config-state-emblem {
  width: 98rpx;
  height: 98rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.22);
  border-radius: 50%;
  opacity: 0.8;
}

.config-state-kicker {
  margin-top: 20rpx;
  color: #60738f;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.config-state-title {
  margin-top: 9rpx;
  color: #f3f5f8;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.4;
}

.config-state-desc {
  margin-top: 12rpx;
  color: #a2abb7;
  font-size: 22rpx;
  line-height: 1.65;
}

.config-state-note {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-left: 3rpx solid rgba(84, 143, 255, 0.45);
  border-radius: 0 14rpx 14rpx 0;
  background: rgba(84, 143, 255, 0.05);
  color: #747f8e;
  font-size: 20rpx;
  line-height: 1.65;
  text-align: left;
}

.config-state-button {
  width: 100%;
  height: 84rpx;
  margin-top: 26rpx;
  font-size: 23rpx;
  line-height: 84rpx;
}
