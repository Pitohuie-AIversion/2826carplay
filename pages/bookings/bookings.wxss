.bookings-page { position: relative; min-height: 100vh; padding: 38rpx calc(24rpx + env(safe-area-inset-right)) calc(220rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left)); overflow: hidden; color: #f7f8fa; background: linear-gradient(180deg, #141a25 0%, #0b0d10 560rpx); box-sizing: border-box; }
.page-glow { position: absolute; top: -230rpx; right: -190rpx; width: 540rpx; height: 540rpx; border-radius: 50%; background: rgba(47, 104, 198, 0.12); filter: blur(90rpx); }
.page-header,
.loading-card,
.booking-list,
.empty { position: relative; z-index: 1; }
.page-header { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 10rpx 30rpx; }
.page-kicker,
.list-kicker,
.empty-kicker { color: #657997; font-size: 16rpx; font-weight: 600; line-height: 1.4; letter-spacing: 3rpx; }
.page-title { margin-top: 8rpx; color: #f7f9fc; font-size: 42rpx; font-weight: 700; line-height: 1.3; }
.page-desc { margin-top: 8rpx; color: #838d9b; font-size: 22rpx; line-height: 1.55; }
.header-emblem { flex-shrink: 0; width: 82rpx; height: 82rpx; margin-left: 22rpx; border: 1rpx solid rgba(105, 154, 235, 0.25); border-radius: 50%; box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.28); }
.list-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 2rpx 8rpx 20rpx; }
.journey-summary { margin-bottom: 20rpx; padding: 18rpx 16rpx 16rpx; border-color: rgba(95, 147, 231, 0.13); background: rgba(20, 27, 37, 0.94); }
.journey-summary-caption { margin-bottom: 16rpx; color: #5d6c82; font-size: 14rpx; font-weight: 600; line-height: 1.4; text-align: center; letter-spacing: 2rpx; }
.journey-summary-grid { display: flex; align-items: center; }
.journey-summary-item { flex: 1; min-width: 0; text-align: center; }
.summary-native-icon { position: relative; width: 28rpx; height: 28rpx; margin: 0 auto 8rpx; border: 2rpx solid currentColor; border-radius: 50%; color: #628fcf; box-sizing: border-box; }
.summary-native-icon-ongoing { color: #72a8f8; }
.summary-clock-hand { position: absolute; top: 6rpx; left: 12rpx; width: 6rpx; height: 7rpx; border-bottom: 2rpx solid currentColor; border-left: 2rpx solid currentColor; transform: rotate(-8deg); transform-origin: left bottom; }
.summary-native-icon-completed { color: #63bb91; }
.summary-check { position: absolute; top: 6rpx; left: 7rpx; width: 10rpx; height: 6rpx; border-bottom: 2rpx solid currentColor; border-left: 2rpx solid currentColor; transform: rotate(-45deg); }
.summary-native-icon-cancelled { color: #727d8c; }
.summary-cancel-line { position: absolute; top: 11rpx; left: 5rpx; width: 14rpx; height: 2rpx; border-radius: 2rpx; background: currentColor; transform: rotate(-45deg); }
.journey-summary-value { color: #c8d0db; font-size: 30rpx; font-weight: 700; line-height: 1.2; }
.journey-summary-value-primary { color: #82b1fb; }
.journey-summary-value-muted { color: #7d8795; }
.journey-summary-label { margin-top: 7rpx; color: #707c8c; font-size: 17rpx; line-height: 1.4; }
.journey-summary-divider { width: 1rpx; height: 44rpx; background: rgba(255, 255, 255, 0.08); }
.booking-filters { display: flex; margin-top: 18rpx; margin-bottom: 0; padding: 5rpx; border: 1rpx solid rgba(255, 255, 255, 0.065); border-radius: 16rpx; background: rgba(8, 11, 15, 0.5); }
.booking-filter { flex: 1; min-width: 0; height: 58rpx; margin: 0; padding: 0 5rpx; border: 0; border-radius: 12rpx; background: transparent; color: #697586; font-size: 16rpx; line-height: 58rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: opacity 120ms ease, transform 120ms ease; }
.booking-filter-pressed { opacity: 0.72; transform: scale(0.975); }
.booking-filter::after { border: 0; }
.booking-filter-active { background: linear-gradient(135deg, rgba(58, 118, 214, 0.22), rgba(47, 88, 153, 0.14)); color: #a6c7fb; box-shadow: 0 8rpx 18rpx rgba(27, 68, 133, 0.12); }
.list-title { margin-top: 4rpx; color: #f4f6f9; font-size: 30rpx; font-weight: 650; line-height: 1.4; }
.list-count { padding-bottom: 4rpx; color: #66717f; font-size: 19rpx; line-height: 1.4; }
.booking-item { position: relative; margin-bottom: 20rpx; padding: 28rpx; overflow: hidden; border-color: rgba(255, 255, 255, 0.075); background: linear-gradient(145deg, #181d25, #14171c 72%); box-sizing: border-box; }
.booking-accent { position: absolute; top: 30rpx; left: 0; width: 5rpx; height: 56rpx; border-radius: 0 999rpx 999rpx 0; background: #528fff; box-shadow: 0 0 20rpx rgba(82, 143, 255, 0.35); }
.booking-accent-contacted { background: #57ba89; box-shadow: 0 0 20rpx rgba(87, 186, 137, 0.3); }
.booking-accent-completed { background: #4f9f72; box-shadow: 0 0 18rpx rgba(79, 159, 114, 0.22); }
