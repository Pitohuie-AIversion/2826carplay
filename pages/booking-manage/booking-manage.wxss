@import "../../shared/management-shell.wxss";

.manage-page {
  padding: 24rpx calc(24rpx + env(safe-area-inset-right)) calc(60rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  box-sizing: border-box;
  color: #ffffff;
  background: #101010;
}

.header {
  margin-bottom: 18rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
  line-height: 1.6;
  word-break: break-word;
}

.filter-card {
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.dashboard-card {
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.keyword-input {
  width: 100%;
  box-sizing: border-box;
}

.status-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.status-chip {
  max-width: 220rpx;
  font-size: 22rpx;
  line-height: 1.3;
  padding: 10rpx 16rpx;
  margin-right: 14rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workflow-filter {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
}

.workflow-filter-last {
  margin-top: 4rpx;
}

.workflow-filter-label {
  margin-bottom: 11rpx;
  color: #778496;
  font-size: 17rpx;
}

.workflow-filter-row {
  display: flex;
  flex-wrap: wrap;
}

.workflow-chip {
  margin: 0 11rpx 10rpx 0;
  padding: 9rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.025);
  color: #778394;
  font-size: 17rpx;
  transition: opacity 120ms ease, transform 120ms ease;
}

.workflow-chip-pressed {
  opacity: 0.72;
  transform: scale(0.975);
}

.workflow-chip-active {
  color: #dce6f4;
}

.workflow-chip-priority {
  border-color: rgba(225, 151, 74, 0.24);
  background: rgba(211, 132, 51, 0.09);
  color: #dfa15f;
}

.workflow-chip-coordination {
  border-color: rgba(86, 143, 232, 0.24);
  background: rgba(71, 127, 214, 0.09);
  color: #82acf0;
}

.workflow-chip-city {
  border-color: rgba(56, 189, 248, 0.24);
  background: rgba(14, 165, 233, 0.09);
  color: #38bdf8;
}

.actions {
  display: flex;
  margin-top: 10rpx;
}

.result-count {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.72);
}

.action-btn {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  box-sizing: border-box;
}

.action-btn-last {
  margin-right: 0;
}

.export-btn {
  margin-top: 16rpx;
  box-sizing: border-box;
}

.export-actions {
  margin-top: 16rpx;
}

.export-tip {
  display: flex;
  align-items: center;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(83, 143, 239, 0.14);
  border-radius: 16rpx;
  background: rgba(83, 143, 239, 0.045);
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.72);
  margin-bottom: 12rpx;
  word-break: break-word;
}

.export-tip-title {
  color: #a8b9d2;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.4;
}

.export-tip-name {
  margin-top: 4rpx;
  color: #697a91;
  font-size: 16rpx;
  line-height: 1.45;
  word-break: break-all;
}

.dashboard-head,
.ratio-head,
.recent-head {
  margin-bottom: 16rpx;
}

.dashboard-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.dashboard-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.7);
  word-break: break-word;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx 4rpx;
}

.summary-item {
  width: calc(50% - 12rpx);
  margin: 0 6rpx 12rpx;
  padding: 24rpx 20rpx 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}

.summary-value {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.06;
  color: #ffffff;
}

.summary-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9fa5b0;
}

.ratio-card,
.recent-block {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
}

.ratio-bar {
  display: flex;
  width: 100%;
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
}

.ratio-seg {
  height: 100%;
}

.ratio-pending {
  background: rgba(255, 255, 255, 0.5);
}

.ratio-contacted {
  background: rgba(47, 128, 237, 0.9);
}

.ratio-completed {
  background: rgba(39, 174, 96, 0.9);
}

.ratio-legend {
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.legend-text {
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.76);
  word-break: break-word;
}

.recent-list {
  margin-top: 4rpx;
}

.recent-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: opacity 120ms ease, transform 120ms ease;
}

.recent-item-pressed {
  opacity: 0.7;
  transform: translateX(3rpx);
}

.recent-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.recent-entry-side {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding-top: 2rpx;
}

.recent-entry-chevron {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  color: #66758a;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.recent-booking-title {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-word;
}

.recent-booking-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.72);
  word-break: break-word;
}

.recent-empty {
  display: flex;
  align-items: center;
  margin-top: 15rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid rgba(111, 143, 190, 0.11);
  border-radius: 16rpx;
  background: rgba(80, 112, 160, 0.04);
}

.recent-empty-native-icon {
  position: relative;
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-right: 13rpx;
  border: 1rpx solid rgba(105, 151, 220, 0.16);
  border-radius: 12rpx;
  background: rgba(78, 131, 210, 0.06);
  color: #718fb9;
  box-sizing: border-box;
}

.booking-recent-empty-native-icon::before {
  position: absolute;
  top: 9rpx;
  left: 9rpx;
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  content: "";
  box-sizing: border-box;
}

.booking-recent-empty-native-icon::after {
  position: absolute;
  top: 15rpx;
  left: 10rpx;
  width: 18rpx;
  height: 2rpx;
  background: currentColor;
  content: "";
}

.recent-empty-copy {
  flex: 1;
  min-width: 0;
}

.recent-empty-title {
  color: rgba(255, 255, 255, 0.67);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.45;
}

.recent-empty-desc {
  margin-top: 3rpx;
  color: rgba(255, 255, 255, 0.38);
  font-size: 17rpx;
  line-height: 1.5;
}

.loading {
  padding: 40rpx 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.72);
}

.booking-item {
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.booking-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.booking-name {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-word;
}

.booking-status {
  max-width: 200rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-plan {
  margin-top: 13rpx;
}

.booking-plan-pill {
  display: inline-block;
  margin-right: 10rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(118, 132, 151, 0.1);
  color: #929dab;
  font-size: 15rpx;
}

.priority-priority {
  background: rgba(223, 143, 57, 0.12);
  color: #e5a05a;
}

.priority-standby {
  color: #a1a9b4;
}

.coordination-coordinating {
  background: rgba(76, 135, 224, 0.12);
  color: #7faaf0;
}

.coordination-resolved {
  background: rgba(61, 181, 127, 0.1);
  color: #62d29c;
}

.booking-meta {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.7;
  word-break: break-word;
}

.quick-action-row {
  display: flex;
  margin-top: 16rpx;
}

.quick-action-btn {
  flex: 1;
  height: 76rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 76rpx;
}

.quick-action-btn-last {
  margin-right: 0;
}

.booking-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
  word-break: break-word;
}

.remark-card {
  margin-top: 16rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.remark-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.remark-title {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.78);
  word-break: break-word;
}

.remark-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 16rpx;
  max-width: 45%;
  line-height: 1.4;
  text-align: right;
  word-break: break-word;
}

.remark-input {
  width: 100%;
  min-height: 132rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.6;
}

.remark-save-btn {
  margin-top: 14rpx;
  box-sizing: border-box;
}

.op-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.op-btn {
  width: calc(50% - 7rpx);
  height: 72rpx;
  font-size: 24rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: #141414;
  color: #ffffff;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.op-btn::after {
  border: 0;
}

.op-btn-last {
  margin-right: 0;
}

.op-btn-alt {
  margin-right: 0;
}

.op-danger {
  border-color: rgba(214, 75, 75, 0.6);
  background: rgba(214, 75, 75, 0.12);
}

.empty {
  padding: 70rpx 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.72);
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #ffffff;
  line-height: 1.35;
}

.empty-desc {
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-word;
}

.load-more {
  padding: 10rpx 0 0;
  text-align: center;
}

.load-more-btn {
  width: 100%;
  margin: 0;
}

.load-more-end {
  padding: 20rpx 0 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.6);
}

.manage-page.management-page .header,
.manage-page.management-page .filter-card,
.manage-page.management-page .dashboard-card,
.manage-page.management-page .booking-item,
.manage-page.management-page .empty {
  margin-bottom: 22rpx;
  border-color: rgba(255, 255, 255, 0.075);
  border-radius: 26rpx;
}

.manage-page.management-page .filter-card {
  padding: 28rpx;
  background: #15181d;
}

.manage-page.management-page .dashboard-card {
  padding: 28rpx;
  border-color: rgba(84, 136, 220, 0.14);
  background: linear-gradient(145deg, #19202a, #14171c 75%);
}

.manage-page.management-page .dashboard-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.manage-page.management-page .keyword-input {
  height: 82rpx;
}

.manage-page.management-page .status-chip {
  min-height: 60rpx;
  padding: 13rpx 20rpx;
}

.manage-page.management-page .summary-item,
.manage-page.management-page .ratio-card,
.manage-page.management-page .recent-block {
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 19rpx;
  background: rgba(255, 255, 255, 0.025);
}

.manage-page.management-page .summary-value {
  color: #f5f7fa;
}

.manage-page.management-page .booking-item {
  position: relative;
  padding: 28rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #181d24, #14171c 72%);
  box-shadow: 0 20rpx 46rpx rgba(0, 0, 0, 0.2);
}

.manage-page.management-page .booking-item::before {
  position: absolute;
  top: 30rpx;
  left: 0;
  width: 5rpx;
  height: 54rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #528fff;
  content: "";
}

.manage-page.management-page .booking-name {
  color: #f5f7fa;
  font-size: 29rpx;
}

.manage-page.management-page .booking-meta {
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.025);
  color: #929ca9;
}

.manage-page.management-page .quick-action-btn {
  height: 76rpx;
  border-radius: 17rpx;
  line-height: 76rpx;
}

.manage-page.management-page .remark-card {
  border-color: rgba(255, 255, 255, 0.065);
  border-radius: 19rpx;
  background: rgba(255, 255, 255, 0.025);
}

.manage-page.management-page .remark-input {
  border: 1rpx solid rgba(255, 255, 255, 0.075);
  background: #101318;
}

.manage-page.management-page .op-btn {
  border-radius: 16rpx;
  background: #111419;
}

.booking-title-copy {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.booking-title-copy .booking-name {
  padding-right: 0;
}

.booking-plan {
  display: flex;
  flex-wrap: wrap;
}

.booking-plan-pill {
  display: inline-flex;
  align-items: center;
}

.booking-plan-dot {
  width: 6rpx;
  height: 6rpx;
  margin-right: 6rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 8rpx currentColor;
}

.booking-journey {
  margin-top: 20rpx;
  padding: 19rpx;
  border: 1rpx solid rgba(103, 135, 181, 0.14);
  border-radius: 18rpx;
  background: rgba(59, 85, 122, 0.07);
  color: #7896be;
}

.booking-journey-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.booking-journey-kicker {
  color: #71839d;
  font-size: 15rpx;
  font-weight: 650;
  line-height: 1.35;
  letter-spacing: 1.8rpx;
}

.booking-journey-title {
  margin-top: 4rpx;
  color: #c6d0dd;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1.4;
}

.booking-journey-stage {
  flex-shrink: 0;
  margin-left: 14rpx;
  color: currentColor;
  font-size: 18rpx;
  font-weight: 700;
}

.booking-journey-track {
  height: 6rpx;
  margin-top: 15rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
}

.booking-journey-fill {
  height: 100%;
  border-radius: inherit;
  background: currentColor;
  box-shadow: 0 0 12rpx currentColor;
  transition: width 0.2s ease;
}

.booking-journey-steps {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.booking-journey-step {
  display: flex;
  align-items: center;
  color: #586577;
  font-size: 15rpx;
  line-height: 1.4;
}

.booking-journey-step-dot {
  width: 7rpx;
  height: 7rpx;
  margin-right: 6rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.booking-journey-step-active {
  color: currentColor;
}

.booking-journey-step-active .booking-journey-step-dot {
  background: currentColor;
  box-shadow: 0 0 8rpx currentColor;
}

.booking-journey-hint {
  margin-top: 12rpx;
  color: #7a8799;
  font-size: 16rpx;
  line-height: 1.5;
}

.booking-journey-contacted {
  border-color: rgba(81, 143, 231, 0.18);
  background: rgba(58, 108, 179, 0.08);
  color: #75a4eb;
}

.booking-journey-completed {
  border-color: rgba(72, 185, 131, 0.18);
  background: rgba(50, 139, 96, 0.08);
  color: #65c792;
}

.booking-journey-cancelled {
  border-color: rgba(139, 150, 165, 0.13);
  background: rgba(96, 104, 116, 0.06);
  color: #8b96a5;
}

.booking-meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  padding: 4rpx 12rpx 17rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.022);
}

.booking-meta-item {
  display: flex;
  align-items: center;
  width: 50%;
  margin-top: 16rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.booking-meta-item-wide {
  width: 100%;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.booking-meta-icon {
  position: relative;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  margin-right: 11rpx;
  color: #63738a;
  box-sizing: border-box;
}

.booking-meta-icon-user::before {
  position: absolute;
  top: 1rpx;
  left: 9rpx;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  content: "";
}

.booking-meta-icon-user::after {
  position: absolute;
  right: 3rpx;
  bottom: 1rpx;
  left: 3rpx;
  height: 11rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 14rpx 14rpx 0 0;
  box-sizing: border-box;
  content: "";
}

.booking-meta-icon-phone {
  width: 19rpx;
  height: 24rpx;
  margin-left: 4rpx;
  margin-right: 16rpx;
  border-bottom: 3rpx solid currentColor;
  border-left: 3rpx solid currentColor;
  border-radius: 0 0 0 12rpx;
  transform: rotate(-36deg);
}

.booking-meta-icon-phone::before,
.booking-meta-icon-phone::after {
  position: absolute;
  left: -4rpx;
  width: 8rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: "";
}

.booking-meta-icon-phone::before {
  top: -2rpx;
}

.booking-meta-icon-phone::after {
  bottom: -4rpx;
}

.booking-meta-icon-route {
  width: 32rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border-top: 2rpx dashed currentColor;
  transform: translateY(5rpx);
}

.booking-meta-icon-route::before,
.booking-meta-icon-route::after,
.booking-meta-route-dot {
  position: absolute;
  top: -6rpx;
  width: 10rpx;
