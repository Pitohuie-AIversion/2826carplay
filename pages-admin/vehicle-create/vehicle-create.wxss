@import "../../shared/vehicle-form.wxss";
@import "../rentalDiscountForm.wxss";
.vehicle-create-page .submit-button{width:100%;}
.vehicle-create-page .highlight-list{display:flex;flex-direction:column;gap:14rpx;margin-top:14rpx;}
.vehicle-create-page .highlight-row{display:flex;align-items:center;gap:14rpx;}
.vehicle-create-page .highlight-input{flex:1;min-width:0;}
.vehicle-create-page .highlight-remove{flex-shrink:0;width:56rpx;height:56rpx;border-radius:999rpx;background:rgba(255,80,80,0.08);display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(255,80,80,0.18);}
.vehicle-create-page .highlight-remove-pressed{background:rgba(255,80,80,0.16);}
.vehicle-create-page .highlight-remove-icon{width:22rpx;height:22rpx;background-image:linear-gradient(135deg,transparent 46%,#ff5a5a 46%,#ff5a5a 54%,transparent 54%),linear-gradient(45deg,transparent 46%,#ff5a5a 46%,#ff5a5a 54%,transparent 54%);background-size:22rpx 22rpx;background-repeat:no-repeat;background-position:center;}
.vehicle-create-page .highlight-actions{margin-top:18rpx;}
.vehicle-create-page .highlight-add{display:inline-flex;align-items:center;gap:10rpx;padding:14rpx 22rpx;border-radius:16rpx;background:rgba(82,143,255,0.08);border:1rpx dashed rgba(82,143,255,0.42);color:#4f7dff;font-size:26rpx;line-height:1.3;}
.vehicle-create-page .highlight-add-pressed{background:rgba(82,143,255,0.14);}
.vehicle-create-page .highlight-add-icon{width:24rpx;height:24rpx;position:relative;}
.vehicle-create-page .highlight-add-icon::before,.vehicle-create-page .highlight-add-icon::after{content:"";position:absolute;background:#4f7dff;border-radius:2rpx;}
.vehicle-create-page .highlight-add-icon::before{left:10rpx;top:0;width:4rpx;height:24rpx;}
.vehicle-create-page .highlight-add-icon::after{left:0;top:10rpx;width:24rpx;height:4rpx;}
