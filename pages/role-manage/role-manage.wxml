<view wx:if="{{pageAuthorized}}" class="role-page management-page">
  <view class="page-glow"></view>
  <view class="hero-card ui-card ui-card-gradient">
    <view class="hero-top">
      <view class="hero-copy">
        <view class="page-kicker">ACCESS CONTROL</view>
        <view class="hero-title">权限管理</view>
        <view class="hero-desc">分配车辆、预约与运营管理权限</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    </view>
  </view>

  <view class="form-card ui-card">
    <view class="section-heading">
      <view>
        <view class="section-eyebrow">MEMBER ACCESS</view>
        <view class="section-heading-title">{{editingOpenid ? "编辑权限" : "新增权限"}}</view>
      </view>
      <view class="section-index">01</view>
    </view>
    <input
      class="openid-input ui-input"
      placeholder="请输入目标用户 OpenID"
      aria-label="目标用户 OpenID"
      value="{{formOpenid}}"
      maxlength="128"
      confirm-type="done"
      disabled="{{initialLoading || loading || saving || !!editingOpenid}}"
      bindinput="handleOpenidInput"
    />

    <view class="permission-row" aria-role="group" aria-label="选择成员管理权限">
      <view
        wx:for="{{permissionOptions}}"
        wx:key="value"
        class="permission-option {{item.active ? 'permission-option-active' : ''}} {{initialLoading || loading || saving ? 'permission-option-disabled' : ''}}"
        data-value="{{item.value}}"
        bindtap="handleTogglePermission"
        hover-class="permission-option-pressed"
        aria-role="checkbox"
        aria-checked="{{item.active}}"
        aria-disabled="{{initialLoading || loading || saving}}"
        aria-label="{{item.label}}，{{item.desc}}"
      >
        <view class="permission-option-icon" aria-hidden="true">
          <view class="permission-icon permission-icon-{{item.icon}}"></view>
        </view>
        <view class="permission-option-copy">
          <view class="permission-option-title">{{item.label}}</view>
          <view class="permission-option-desc">{{item.desc}}</view>
        </view>
        <view class="permission-option-check" aria-hidden="true">
          <view class="permission-option-check-mark"></view>
        </view>
      </view>
    </view>

    <view class="form-tip"><view class="role-tip-native-icon" aria-hidden="true"></view><text>{{editingOpenid ? "编辑时不可更换 OpenID；如需新增成员，请先清空表单。" : "不选任何权限时，将保存为普通成员记录。"}}</text></view>

    <view class="action-row">
      <button class="save-btn ui-btn ui-btn-primary" loading="{{saving}}" disabled="{{initialLoading || loading || saving}}" bindtap="handleSubmit" aria-label="保存当前成员权限"><view class="role-action-content"><view wx:if="{{!saving}}" class="role-action-native-icon role-save-native-icon" aria-hidden="true"></view><text>{{saving ? '正在保存' : '保存权限'}}</text></view></button>
      <button class="reset-btn ui-btn ui-btn-ghost" disabled="{{initialLoading || loading || saving}}" bindtap="handleResetForm" aria-label="清空权限表单"><view class="role-action-content"><view class="role-action-native-icon role-reset-native-icon" aria-hidden="true"></view><text>清空表单</text></view></button>
    </view>
  </view>

  <view class="list-card ui-card">
    <view class="section-heading">
      <view>
        <view class="section-eyebrow">TEAM MEMBERS</view>
        <view class="section-heading-title">当前角色列表</view>
      </view>
      <view class="section-index">02</view>
    </view>
    <view class="section-desc">优先显示管理员，其余按 OpenID 排序。</view>

  <view wx:if="{{(initialLoading || loading) && !list.length}}" class="role-skeleton" aria-hidden="true">
      <view class="role-skeleton-item">
        <view class="role-skeleton-avatar manage-skeleton-pulse"></view>
        <view class="role-skeleton-copy">
          <view class="role-skeleton-openid manage-skeleton-pulse"></view>
          <view class="role-skeleton-permission manage-skeleton-pulse"></view>
        </view>
        <view class="role-skeleton-action manage-skeleton-pulse"></view>
      </view>
      <view class="role-skeleton-item role-skeleton-item-muted">
        <view class="role-skeleton-avatar manage-skeleton-pulse"></view>
        <view class="role-skeleton-copy">
          <view class="role-skeleton-openid manage-skeleton-pulse"></view>
          <view class="role-skeleton-permission manage-skeleton-pulse"></view>
        </view>
        <view class="role-skeleton-action manage-skeleton-pulse"></view>
      </view>
    </view>

    <view wx:elif="{{list.length}}" class="role-list">
      <view wx:for="{{list}}" wx:key="id" class="role-item">
        <view class="role-avatar {{item.isAdmin ? 'role-avatar-admin' : ''}}" aria-hidden="true">
          <view class="{{item.isAdmin ? 'role-shield-icon' : 'role-member-icon'}}"></view>
        </view>
        <view class="role-main">
          <view class="role-openid">{{item.openid}}</view>
          <view class="role-permission-row">
            <view class="role-permission-dot {{item.isAdmin ? 'role-permission-dot-admin' : ''}}"></view>
            <view class="role-permission">{{item.permissionText}}</view>
          </view>
        </view>
        <button
          wx:if="{{!item.isAdmin}}"
          class="edit-btn ui-btn ui-btn-ghost"
          data-openid="{{item.openid}}"
          data-permissions="{{item.permissions}}"
          disabled="{{initialLoading || loading || saving}}"
          bindtap="handleEditRole"
          aria-label="编辑 {{item.openid}} 的权限"
        >
          <view class="role-action-content"><view class="role-action-native-icon role-edit-native-icon" aria-hidden="true"></view><text>编辑权限</text></view>
        </button>
        <view wx:else class="admin-tag">全权访问</view>
      </view>
      <button
        wx:if="{{hasMore}}"
        class="load-more-btn ui-btn ui-btn-ghost"
        loading="{{loading}}"
        disabled="{{loading || saving}}"
        bindtap="handleLoadMore"
      >
        <view class="role-action-content"><view wx:if="{{!loading}}" class="role-action-native-icon role-more-native-icon" aria-hidden="true"></view><text>{{loading ? '正在加载' : '加载更多'}}</text></view>
      </button>
      <view wx:else class="role-list-end"><view class="role-complete-native-icon" aria-hidden="true"></view><text>已加载全部成员</text></view>
    </view>

    <view wx:else class="empty-wrap">
      <image class="role-empty-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
      <view class="role-empty-kicker">NO ACCESS RECORDS</view>
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-desc">{{emptyDesc}}</view>
    </view>
  </view>
</view>
