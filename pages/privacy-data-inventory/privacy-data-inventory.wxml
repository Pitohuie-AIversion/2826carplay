<view wx:if="{{pageAuthorized}}" class="inventory-page management-page">
  <view class="page-glow"></view>

  <view class="hero-card ui-card ui-card-gradient">
    <view class="hero-top">
      <view class="hero-copy">
        <view class="page-kicker">PRIVACY DATA INVENTORY</view>
        <view class="hero-title">相关数据清单</view>
        <view class="hero-desc">只读核验本次申请关联的用户数据</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    </view>
    <view class="hero-foot">
      <view class="live-dot"></view>
      <view class="hero-foot-text">每次核验均写入审计日志</view>
      <view class="refresh-link {{refreshing ? 'refresh-link-disabled' : ''}}" bindtap="handleRefresh" hover-class="{{refreshing ? 'none' : 'refresh-link-pressed'}}" aria-role="button" aria-disabled="{{refreshing}}" aria-label="{{refreshing ? '正在重新核验相关数据' : '重新核验相关数据'}}"><view class="refresh-native-icon {{refreshing ? 'refresh-native-icon-spinning' : ''}}" aria-hidden="true"></view>{{refreshing ? '核验中…' : '重新核验'}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="inventory-skeleton" aria-hidden="true">
    <view class="inventory-skeleton-request ui-card">
      <view class="inventory-skeleton-heading"><view class="inventory-skeleton-request-heading"><view class="inventory-skeleton-type manage-skeleton-pulse"></view><view><view class="inventory-skeleton-kicker manage-skeleton-pulse"></view><view class="inventory-skeleton-title manage-skeleton-pulse"></view></view></view><view class="inventory-skeleton-status manage-skeleton-pulse"></view></view>
      <view class="inventory-skeleton-identity"><view class="inventory-skeleton-identity-icon manage-skeleton-pulse"></view><view class="inventory-skeleton-copy"><view class="inventory-skeleton-label manage-skeleton-pulse"></view><view class="inventory-skeleton-line manage-skeleton-pulse"></view></view><view class="inventory-skeleton-button manage-skeleton-pulse"></view></view>
      <view class="inventory-skeleton-detail manage-skeleton-pulse"></view>
    </view>
    <view class="inventory-skeleton-progress ui-card">
      <view class="inventory-skeleton-heading"><view><view class="inventory-skeleton-kicker manage-skeleton-pulse"></view><view class="inventory-skeleton-title manage-skeleton-pulse"></view></view><view class="inventory-skeleton-status manage-skeleton-pulse"></view></view>
      <view class="inventory-skeleton-track manage-skeleton-pulse"></view>
      <view class="inventory-skeleton-progress-foot"><view class="inventory-skeleton-progress-meta manage-skeleton-pulse"></view><view class="inventory-skeleton-progress-meta manage-skeleton-pulse"></view></view>
    </view>
    <view class="inventory-skeleton-metrics"><view class="inventory-skeleton-metric ui-card" wx:for="{{[1, 2, 3]}}" wx:key="*this"><view class="inventory-skeleton-metric-icon manage-skeleton-pulse"></view><view class="inventory-skeleton-metric-value manage-skeleton-pulse"></view><view class="inventory-skeleton-metric-label manage-skeleton-pulse"></view><view class="inventory-skeleton-metric-state manage-skeleton-pulse"></view></view></view>
    <view class="inventory-skeleton-section ui-card">
      <view class="inventory-skeleton-heading"><view><view class="inventory-skeleton-kicker manage-skeleton-pulse"></view><view class="inventory-skeleton-title manage-skeleton-pulse"></view></view><view class="inventory-skeleton-index manage-skeleton-pulse"></view></view>
      <view class="inventory-skeleton-record"><view class="inventory-skeleton-record-title manage-skeleton-pulse"></view><view class="inventory-skeleton-line manage-skeleton-pulse"></view><view class="inventory-skeleton-line inventory-skeleton-line-short manage-skeleton-pulse"></view></view>
    </view>
  </view>

  <view wx:elif="{{loadError}}" class="error-card ui-card">
    <view class="error-native-icon" aria-hidden="true"></view>
    <view class="error-copy">
      <view class="error-title">数据核验未完成</view>
      <view class="error-desc">{{loadError}}</view>
    </view>
    <button class="retry-button ui-btn ui-btn-ghost" bindtap="handleRefresh"><view class="retry-native-icon" aria-hidden="true"></view>重试</button>
  </view>

  <block wx:else>
    <view wx:if="{{partial}}" class="warning-card ui-card">
      <view class="warning-native-icon" aria-hidden="true"></view>
      <view class="warning-copy"><view class="warning-title">清单未完全展示</view><view class="warning-desc">{{issueText}}。请缩小人工核验范围或修复对应集合，暂勿直接完成申请。</view></view>
    </view>

    <view class="request-card ui-card">
      <view class="section-heading">
        <view class="request-heading-wrap">
          <view class="request-type-icon-wrap {{request.typeClass}}"><view class="request-type-icon {{request.typeIconClass}}" aria-hidden="true"></view></view>
          <view>
            <view class="section-eyebrow">REQUEST CONTEXT</view>
            <view class="section-title">{{request.typeLabel}}</view>
          </view>
        </view>
        <view class="status-pill {{request.statusClass}}"><view class="status-dot"></view>{{request.statusLabel}}</view>
      </view>
      <view class="identity-row">
        <view class="identity-native-icon" aria-hidden="true"></view>
        <view class="identity-copy"><view class="identity-label">申请账号</view><view class="identity-text">{{request.openid || '—'}}</view></view>
        <button class="copy-button ui-btn ui-btn-ghost" disabled="{{loading || refreshing || exporting}}" bindtap="handleCopyOpenid"><view class="copy-native-icon" aria-hidden="true"></view>复制</button>
      </view>
      <view class="request-meta"><view class="time-native-icon" aria-hidden="true"></view><view><view class="request-meta-label">申请时间</view><view>{{request.createdAtText}}</view></view></view>
      <view class="request-description"><view class="description-native-icon" aria-hidden="true"></view><view class="request-description-copy"><view class="request-meta-label">申请说明</view><view class="request-description-value">{{request.description || '未填写申请说明'}}</view></view></view>
    </view>

    <view wx:if="{{request.type === 'access'}}" class="export-card ui-card">
      <view class="section-heading">
        <view class="section-heading-icon-wrap">
          <view class="section-native-icon delivery-section-native-icon" aria-hidden="true"></view>
          <view><view class="section-eyebrow">DATA DELIVERY</view><view class="section-title">个人数据交付</view></view>
        </view>
        <view class="export-security"><view class="lock-native-icon" aria-hidden="true"></view>敏感文件</view>
      </view>
      <view class="export-desc"><view class="shield-native-icon" aria-hidden="true"></view><view>生成包含预约、收藏和隐私申请的 CSV。匿名分析数据不保存身份信息，不包含在导出文件中。</view></view>
      <view wx:if="{{partial}}" class="export-blocked"><view class="blocked-native-icon" aria-hidden="true"></view><view>当前清单不完整，已禁止导出残缺文件。</view></view>
      <button
        wx:elif="{{!exportFilePath}}"
        class="export-primary ui-btn ui-btn-primary"
        loading="{{exporting}}"
        disabled="{{exporting}}"
        bindtap="handleExport"
      >
        <view wx:if="{{!exporting}}" class="export-native-icon" aria-hidden="true"></view>{{exporting ? '正在生成…' : '导出个人数据 CSV'}}
      </button>
      <view wx:else class="export-result">
        <view class="export-file-state"><view class="file-native-icon" aria-hidden="true"></view><view class="export-file-copy"><view class="export-file-label">个人数据文件已就绪</view><view class="export-file-name">{{exportFileName}}</view></view></view>
        <view class="export-actions">
          <button
            wx:if="{{canShareExport}}"
            class="export-action ui-btn ui-btn-primary"
            disabled="{{exporting}}"
            bindtap="handleShareExportedFile"
          >
            <view class="export-action-icon share-native-icon" aria-hidden="true"></view>分享文件
          </button>
          <button class="export-action ui-btn ui-btn-ghost" disabled="{{exporting}}" bindtap="handleOpenExportedFile">
            <view class="export-action-icon open-native-icon" aria-hidden="true"></view>打开文件
          </button>
          <button class="export-action delete-action ui-btn ui-btn-ghost" disabled="{{exporting}}" bindtap="handleDeleteExportedFile">
            <view class="export-action-icon delete-native-icon" aria-hidden="true"></view>删除本地文件
          </button>
        </view>
      </view>
    </view>

    <view class="inventory-progress-card ui-card {{inventoryStatusClass}}" aria-role="group" aria-label="数据核验覆盖 {{inventoryProgress}}%，{{verifiedCategoryCount}} / 3 类完整，{{inventoryStatusLabel}}">
      <view class="inventory-progress-head"><view><view class="section-eyebrow">VERIFICATION COVERAGE</view><view class="inventory-progress-title">核验覆盖</view></view><view class="inventory-status-pill"><view class="inventory-status-dot"></view>{{inventoryStatusLabel}}</view></view>
      <view class="inventory-progress-track" aria-hidden="true"><view class="inventory-progress-value" style="width: {{inventoryProgress}}%;"></view></view>
      <view class="inventory-progress-foot"><view>{{verifiedCategoryCount}} / 3 类完整</view><view>共关联 {{totalRecordCount}} 条记录</view></view>
    </view>

    <view class="metric-grid">
      <view class="metric-card ui-card {{bookings.stateClass}}">
        <view class="metric-native-icon {{bookings.iconClass}}" aria-hidden="true"></view>
        <view class="metric-value">{{bookings.count}}{{bookings.truncated ? '+' : ''}}</view>
        <view class="metric-label">预约记录</view>
        <view class="metric-state"><view class="metric-state-dot"></view>{{bookings.stateLabel}}</view>
      </view>
      <view class="metric-card ui-card {{favorites.stateClass}}">
        <view class="metric-native-icon {{favorites.iconClass}}" aria-hidden="true"></view>
        <view class="metric-value">{{favorites.count}}{{favorites.truncated ? '+' : ''}}</view>
        <view class="metric-label">收藏记录</view>
        <view class="metric-state"><view class="metric-state-dot"></view>{{favorites.stateLabel}}</view>
      </view>
      <view class="metric-card ui-card {{privacyRequests.stateClass}}">
        <view class="metric-native-icon {{privacyRequests.iconClass}}" aria-hidden="true"></view>
        <view class="metric-value">{{privacyRequests.count}}{{privacyRequests.truncated ? '+' : ''}}</view>
        <view class="metric-label">隐私申请</view>
        <view class="metric-state"><view class="metric-state-dot"></view>{{privacyRequests.stateLabel}}</view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view class="section-heading-icon-wrap">
          <view class="section-native-icon booking-section-native-icon" aria-hidden="true"></view>
          <view><view class="section-eyebrow">RESERVATIONS</view><view class="section-title">预约数据</view></view>
        </view>
        <view class="section-index">{{bookings.count}}{{bookings.truncated ? '+' : ''}}</view>
      </view>
      <view wx:if="{{bookings.list.length}}" class="record-list">
        <view
          class="record-item record-link"
          wx:for="{{bookings.list}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="handleBookingTap"
          hover-class="record-link-pressed"
          aria-role="button"
          aria-label="查看预约 {{item.vehicleName || item.vehicleId || '未命名车辆'}}，{{item.dateText}}，{{item.statusLabel}}"
        >
          <view class="record-head">
            <view class="record-title">{{item.vehicleName || item.vehicleId || '未命名车辆'}}</view>
            <view class="record-status"><view class="record-status-dot"></view>{{item.statusLabel}}</view>
          </view>
          <view class="record-meta">{{item.dateText}} · {{item.createdAtText}}</view>
          <view class="record-detail">姓名：{{item.userName || '—'}}　电话：{{item.phone || '—'}}</view>
          <view class="record-detail">城市：{{item.city || '—'}}</view>
          <view wx:if="{{item.note}}" class="record-note">{{item.note}}</view>
          <view class="record-native-chevron" aria-hidden="true"></view>
        </view>
      </view>
      <view wx:else class="empty-text"><view class="inventory-empty-native-icon" aria-hidden="true"></view><text>未发现预约记录</text></view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view class="section-heading-icon-wrap">
          <view class="section-native-icon favorite-section-native-icon" aria-hidden="true"></view>
          <view><view class="section-eyebrow">FAVORITES</view><view class="section-title">收藏数据</view></view>
        </view>
        <view class="section-index">{{favorites.count}}{{favorites.truncated ? '+' : ''}}</view>
      </view>
      <view wx:if="{{favorites.list.length}}" class="record-list">
        <view class="record-item" wx:for="{{favorites.list}}" wx:key="id">
          <view class="record-title">车辆 ID：{{item.vehicleId || '—'}}</view>
          <view class="record-meta">收藏时间：{{item.createdAtText}}</view>
        </view>
      </view>
      <view wx:else class="empty-text"><view class="inventory-empty-native-icon" aria-hidden="true"></view><text>未发现收藏记录</text></view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view class="section-heading-icon-wrap">
          <view class="section-native-icon privacy-section-native-icon" aria-hidden="true"></view>
          <view><view class="section-eyebrow">PRIVACY REQUESTS</view><view class="section-title">隐私申请记录</view></view>
        </view>
        <view class="section-index">{{privacyRequests.count}}{{privacyRequests.truncated ? '+' : ''}}</view>
      </view>
      <view wx:if="{{privacyRequests.list.length}}" class="record-list">
        <view class="record-item" wx:for="{{privacyRequests.list}}" wx:key="id">
          <view class="record-head">
            <view class="record-title">{{item.typeLabel}}</view>
            <view class="record-status"><view class="record-status-dot"></view>{{item.statusLabel}}</view>
          </view>
          <view class="record-meta">{{item.createdAtText}} · {{item.id}}</view>
          <view wx:if="{{item.description}}" class="record-note">{{item.description}}</view>
          <view wx:if="{{item.resolutionNote}}" class="record-resolution">处理反馈：{{item.resolutionNote}}</view>
        </view>
      </view>
      <view wx:else class="empty-text"><view class="inventory-empty-native-icon" aria-hidden="true"></view><text>未发现其他隐私申请</text></view>
    </view>

    <view class="privacy-note ui-card">
      <view class="privacy-note-native-icon" aria-hidden="true"></view><view>匿名分析事件不保存 OpenID、姓名、手机号、城市或备注，无法也无需关联到具体用户。该清单仅用于人工核验，不会自动更正或删除记录。</view>
    </view>
  </block>
</view>
