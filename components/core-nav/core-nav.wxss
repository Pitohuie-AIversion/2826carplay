.core-nav {
  position: fixed;
  right: calc(24rpx + env(safe-area-inset-right));
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: calc(24rpx + env(safe-area-inset-left));
  z-index: 30;
  display: flex;
  padding: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 30rpx;
  background: rgba(17, 21, 27, 0.96);
  box-shadow: 0 22rpx 60rpx rgba(0, 0, 0, 0.44);
  backdrop-filter: blur(18rpx);
  box-sizing: border-box;
}

.core-nav-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  height: 90rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 22rpx;
  background: transparent;
  color: #717b89;
  line-height: 1;
  overflow: hidden;
  transition: color 150ms ease, background 150ms ease, opacity 120ms ease, transform 120ms ease;
}

.core-nav-item::after {
  border: 0;
}

.core-nav-item-active {
  background: linear-gradient(145deg, rgba(73, 135, 234, 0.15), rgba(55, 96, 162, 0.08));
  color: #83aff5;
  box-shadow: inset 0 0 0 1rpx rgba(91, 148, 240, 0.11);
}

.core-nav-item-active::before {
  position: absolute;
  top: 0;
  left: 50%;
  width: 28rpx;
  height: 3rpx;
  border-radius: 0 0 4rpx 4rpx;
  background: #78aaf5;
  box-shadow: 0 0 14rpx rgba(100, 160, 249, 0.66);
  content: "";
  transform: translateX(-50%);
}

.core-nav-item-pressed {
  opacity: 0.84;
  transform: scale(0.94);
}

.core-nav-icon,
.core-nav-emblem {
  width: 34rpx;
  height: 34rpx;
}

.core-nav-icon {
  position: relative;
  display: block;
  color: currentColor;
  box-sizing: border-box;
}

.core-nav-heart-shape {
  position: absolute;
  top: 9rpx;
  left: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: currentColor;
  transform: rotate(-45deg) scale(0.78);
  transform-origin: center;
}

.core-nav-heart-shape::before,
.core-nav-heart-shape::after {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.core-nav-heart-shape::before {
  top: -9rpx;
  left: 0;
}

.core-nav-heart-shape::after {
  top: 0;
  left: 9rpx;
}

.core-nav-icon-calendar {
  width: 30rpx;
  height: 28rpx;
  margin-top: 2rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
}

.core-nav-icon-calendar::before {
  position: absolute;
  top: 6rpx;
  right: 0;
  left: 0;
  height: 3rpx;
  background: currentColor;
  content: "";
}

.core-nav-icon-calendar::after {
  position: absolute;
  top: -6rpx;
  left: 5rpx;
  width: 3rpx;
  height: 8rpx;
  border-radius: 3rpx;
  background: currentColor;
  box-shadow: 13rpx 0 0 currentColor;
  content: "";
}

.core-nav-icon-profile::before {
  position: absolute;
  top: 1rpx;
  left: 11rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  content: "";
}

.core-nav-icon-profile::after {
  position: absolute;
  right: 4rpx;
  bottom: 1rpx;
  left: 4rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 5rpx 5rpx;
  box-sizing: border-box;
  content: "";
}

.core-nav-emblem {
  border: 1rpx solid rgba(109, 158, 236, 0.18);
  border-radius: 50%;
  opacity: 0.68;
}

.core-nav-item-active .core-nav-emblem {
  border-color: rgba(109, 158, 236, 0.42);
  opacity: 1;
  box-shadow: 0 0 16rpx rgba(73, 135, 234, 0.22);
}

.core-nav-label {
  margin-top: 7rpx;
  color: currentColor;
  font-size: 18rpx;
  font-weight: 550;
  line-height: 1;
  transition: font-weight 150ms ease, letter-spacing 150ms ease;
}

.core-nav-item-active .core-nav-label {
  font-weight: 650;
  letter-spacing: 0.6rpx;
}
