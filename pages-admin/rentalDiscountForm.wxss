.rental-discount-form { margin: 24rpx 0; padding: 24rpx; border: 1rpx solid rgba(255, 255, 255, 0.08); border-radius: 18rpx; background: rgba(255, 255, 255, 0.025); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.05); }
.rental-discount-title { font-size: 26rpx; font-weight: 650; color: #edf1f7; }
.rental-discount-help { margin: 12rpx 0; font-size: 21rpx; line-height: 1.6; color: #78869b; }
.rental-discount-row { display: flex; align-items: center; gap: 12rpx; margin: 16rpx 0; font-size: 23rpx; color: #b7c3d4; }
.rental-discount-input { width: 104rpx; min-width: 0; height: 72rpx; text-align: center; border: 1rpx solid rgba(255, 255, 255, 0.1); border-radius: 14rpx; background: #101318; color: #f0f3f8; font-size: 23rpx; box-sizing: border-box; transition: border-color 150ms ease, box-shadow 150ms ease; }
.rental-discount-input:focus { border-color: rgba(84, 143, 255, 0.55); background: #121720; box-shadow: 0 0 0 4rpx rgba(84, 143, 255, 0.12); }
.rental-discount-remove { margin: 0 0 0 auto; padding: 0 16rpx; height: 56rpx; line-height: 56rpx; border-radius: 12rpx; border: 1rpx solid rgba(255, 80, 80, 0.2); background: rgba(255, 80, 80, 0.08); font-size: 21rpx; color: #ff7a7a; }
.rental-discount-remove::after { border: 0; }
.rental-discount-add { display: inline-flex; align-items: center; justify-content: center; width: 100%; height: 76rpx; margin-top: 10rpx; border-radius: 16rpx; border: 1rpx dashed rgba(84, 143, 255, 0.35); background: rgba(84, 143, 255, 0.06); font-size: 23rpx; color: #6fa0ef; line-height: 76rpx; }
.rental-discount-add::after { border: 0; }

