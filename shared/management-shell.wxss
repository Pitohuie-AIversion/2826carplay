.management-page {
  position: relative;
  min-height: 100vh;
  padding: 38rpx calc(24rpx + env(safe-area-inset-right)) calc(70rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  overflow: hidden;
  color: #f7f8fa;
  background: linear-gradient(180deg, #141a25 0%, #0b0d10 620rpx);
  box-sizing: border-box;
}

.management-page.vehicle-manage-page,
.management-page.manage-page,
.management-page.vehicle-detail-page,
.management-page.detail-page,
.management-page.config-page,
.management-page.role-page,
.management-page.audit-page,
.management-page.error-page {
  padding: 38rpx calc(24rpx + env(safe-area-inset-right)) calc(70rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  background: linear-gradient(180deg, #141a25 0%, #0b0d10 620rpx);
}

.management-page .page-glow {
  position: absolute;
  top: -230rpx;
  right: -190rpx;
  width: 540rpx;
  height: 540rpx;
  border-radius: 50%;
  background: rgba(47, 104, 198, 0.12);
  filter: blur(90rpx);
  pointer-events: none;
}

.management-page .hero-card,
.management-page .filter-card,
.management-page .section-card,
.management-page .dashboard-card,
.management-page .summary-card,
.management-page .info-card,
.management-page .note-card,
.management-page .action-card,
.management-page .loading-card,
.management-page .vehicle-list,
.management-page .detail-wrap,
.management-page .booking-list,
.management-page .empty,
.management-page .empty-card {
  position: relative;
  z-index: 1;
}

.management-page .hero-card {
  padding: 30rpx;
  overflow: hidden;
  border-color: rgba(94, 145, 226, 0.18);
  background: linear-gradient(145deg, #1b2330, #14181e 70%);
}

.management-page .hero-card::after {
  position: absolute;
  right: -70rpx;
  bottom: -125rpx;
  width: 270rpx;
  height: 270rpx;
  border: 1rpx solid rgba(98, 148, 227, 0.08);
  border-radius: 50%;
  content: "";
}

.management-page .hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.management-page .hero-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.management-page .page-kicker,
.management-page .section-eyebrow,
.management-page .list-kicker {
  color: #657997;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 3rpx;
}

.management-page .hero-title,
.management-page .title {
  margin-top: 8rpx;
  color: #f7f9fc;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.management-page .hero-desc,
.management-page .desc {
  position: relative;
  z-index: 1;
  margin-top: 9rpx;
  color: #8993a1;
  font-size: 22rpx;
  line-height: 1.65;
}

.management-page .hero-emblem {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
  margin-left: 20rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.25);
  border-radius: 50%;
}

.management-page .section-heading,
.management-page .list-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.management-page .section-heading {
  align-items: center;
  margin-bottom: 20rpx;
}

.management-page .section-heading-title,
.management-page .list-title {
  margin-top: 4rpx;
  color: #f1f4f8;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.4;
}

.management-page .section-index,
.management-page .list-count {
  color: #56667e;
  font-size: 17rpx;
  font-weight: 600;
  line-height: 1.4;
}

.management-page .list-heading {
  margin: 10rpx 8rpx 20rpx;
}

.management-page .ui-input,
.management-page .remark-input {
  border-color: rgba(255, 255, 255, 0.09);
  border-radius: 18rpx;
  background: #101318;
}

.management-page .management-search {
  position: relative;
  flex: 1;
  min-width: 0;
  width: 100%;
}

.management-page .management-search-input {
  width: 100%;
  padding-right: 70rpx;
  padding-left: 70rpx;
}

.management-page .management-search-icon {
  position: absolute;
  top: 50%;
  left: 25rpx;
  z-index: 1;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #65758b;
  border-radius: 50%;
  box-sizing: border-box;
  pointer-events: none;
  transform: translateY(-58%);
}

.management-page .management-search-icon::after {
  position: absolute;
  right: -7rpx;
  bottom: -5rpx;
  width: 9rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #65758b;
  content: "";
  transform: rotate(45deg);
  transform-origin: left center;
}

.management-page .management-search-clear {
  position: absolute;
  top: 50%;
  right: 13rpx;
  z-index: 2;
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.055);
  color: #758399;
  line-height: 56rpx;
  transform: translateY(-50%);
}

.management-page .management-search-clear::after {
  border: 0;
}

.management-page .management-search-clear-icon::before,
.management-page .management-search-clear-icon::after {
  position: absolute;
  top: 23rpx;
  left: 15rpx;
  width: 18rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}

.management-page .management-search-clear-icon::before {
  transform: rotate(45deg);
}

.management-page .management-search-clear-icon::after {
  transform: rotate(-45deg);
}

.management-page .management-search-clear-pressed {
  opacity: 0.7;
  transform: translateY(-50%) scale(0.9);
}

.management-page .ui-btn {
  border-radius: 18rpx;
}

.management-page .loading-wrap,
.management-page .manage-list-skeleton {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  flex-direction: column;
  width: 100%;
  min-height: 0;
  padding: 10rpx 0 24rpx;
  text-align: left;
  box-sizing: border-box;
}

.management-page .manage-loading-head,
.management-page .manage-loading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.management-page .manage-loading-head {
  align-items: flex-end;
  margin: 0 8rpx 20rpx;
}

.management-page .manage-loading-kicker {
  width: 196rpx;
  height: 17rpx;
  border-radius: 9rpx;
}

.management-page .manage-loading-title {
  width: 142rpx;
  height: 32rpx;
  margin-top: 13rpx;
  border-radius: 9rpx;
}

.management-page .manage-loading-count {
  width: 92rpx;
  height: 18rpx;
  margin-bottom: 4rpx;
  border-radius: 9rpx;
}

.management-page .manage-loading-card {
  display: flex;
  width: 100%;
  min-height: 220rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.management-page .manage-loading-card-booking {
  flex-direction: column;
}

.management-page .manage-loading-cover {
  flex: 0 0 220rpx;
  height: 164rpx;
  border-radius: 16rpx;
}

.management-page .manage-loading-copy {
  flex: 1;
  min-width: 0;
  padding: 8rpx 4rpx 0 22rpx;
}

.management-page .manage-loading-line {
  width: 88%;
  height: 20rpx;
  margin-top: 19rpx;
  border-radius: 9rpx;
}

.management-page .manage-loading-line-title {
  width: 66%;
  height: 32rpx;
  margin-top: 0;
}

.management-page .manage-loading-line-short {
  width: 54%;
}

.management-page .manage-loading-line-mid {
  width: 72%;
}

.management-page .manage-loading-grid {
  display: flex;
  margin-top: 25rpx;
}

.management-page .manage-loading-grid-item {
  width: 42%;
  height: 42rpx;
  margin-right: 14rpx;
  border-radius: 9rpx;
}

.management-page .manage-loading-name {
  width: 56%;
  height: 32rpx;
  border-radius: 9rpx;
}

.management-page .manage-loading-status {
  width: 108rpx;
  height: 50rpx;
  border-radius: 999rpx;
}

.management-page .manage-loading-action {
  width: 100%;
  height: 74rpx;
  margin-top: 26rpx;
  border-radius: 18rpx;
}

.management-page .manage-empty-emblem {
  width: 94rpx;
  height: 94rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.2);
  border-radius: 50%;
  opacity: 0.78;
}

.management-page .manage-empty-kicker {
  margin-bottom: 9rpx;
  color: #60738f;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.management-page .empty,
.management-page .empty-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 56rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(24, 29, 37, 0.96), rgba(18, 21, 26, 0.96));
  box-sizing: border-box;
}

.management-page .manage-skeleton-pulse {
  background: linear-gradient(105deg, #181c22 12%, #29313c 34%, #181c22 56%);
  background-size: 220% 100%;
  animation: managementSkeletonPulse 1.6s ease-in-out infinite;
}

@keyframes managementSkeletonPulse {
  0% {
    background-position: 160% 0;
  }

  100% {
    background-position: -70% 0;
  }
}

.management-page .log-list-skeleton {
  position: relative;
  z-index: 1;
}

.management-page .log-skeleton-heading,
.management-page .log-skeleton-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.management-page .log-skeleton-heading {
  align-items: flex-end;
  margin: 10rpx 8rpx 20rpx;
}

.management-page .log-skeleton-kicker {
  width: 188rpx;
  height: 16rpx;
  border-radius: 8rpx;
}

.management-page .log-skeleton-title {
  width: 150rpx;
  height: 32rpx;
  margin-top: 13rpx;
  border-radius: 9rpx;
}

.management-page .log-skeleton-count {
  width: 88rpx;
  height: 18rpx;
  margin-bottom: 4rpx;
  border-radius: 8rpx;
}

.management-page .log-skeleton-card {
  margin-bottom: 16rpx;
  padding: 26rpx;
  border-color: rgba(255, 255, 255, 0.07);
  border-radius: 26rpx;
  background: linear-gradient(145deg, #181d24, #14171c 74%);
  box-sizing: border-box;
}

.management-page .log-skeleton-card-muted {
  opacity: 0.7;
}

.management-page .log-skeleton-name {
  width: 214rpx;
  height: 27rpx;
  border-radius: 9rpx;
}

.management-page .log-skeleton-time {
  width: 170rpx;
  height: 18rpx;
  margin-left: 20rpx;
  border-radius: 8rpx;
}

.management-page .log-skeleton-identity {
  width: 82%;
  height: 52rpx;
  margin-top: 20rpx;
  border-radius: 14rpx;
}

.management-page .log-skeleton-line {
  width: 100%;
  height: 20rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
}

.management-page .log-skeleton-line-short {
  width: 62%;
  margin-top: 13rpx;
}

.management-page .log-skeleton-message {
  width: 100%;
  height: 82rpx;
  margin-top: 22rpx;
  border-radius: 0 14rpx 14rpx 0;
}

.management-page .log-skeleton-action {
  width: 100%;
  height: 76rpx;
  margin-top: 20rpx;
  border-radius: 17rpx;
}

.management-page .log-title-group {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.management-page .log-kind {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 7rpx 10rpx;
  border: 1rpx solid rgba(84, 143, 255, 0.22);
  border-radius: 999rpx;
  background: rgba(84, 143, 255, 0.08);
  color: #7eaaf1;
  font-size: 15rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 1rpx;
}

.management-page .log-kind-error {
  border-color: rgba(198, 79, 93, 0.25);
  background: rgba(198, 79, 93, 0.08);
  color: #e18b95;
}

.management-page .log-kind-dot {
  width: 7rpx;
  height: 7rpx;
  margin-right: 6rpx;
  border-radius: 50%;
  background: #d55d6b;
  box-shadow: 0 0 10rpx rgba(213, 93, 107, 0.45);
}
