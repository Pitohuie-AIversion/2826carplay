@import "../../shared/management-shell.wxss";

.vehicle-detail-page {
  min-height: 100vh;
  padding: 24rpx calc(24rpx + env(safe-area-inset-right)) calc(56rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  background: #101010;
  box-sizing: border-box;
}

.hero-card,
.summary-card,
.section-card,
.loading-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.hero-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.hero-desc,
.loading-text,
.info-label {
  margin-top: 10rpx;
  color: #b8b8b8;
  font-size: 24rpx;
  line-height: 1.7;
}

.summary-card,
.action-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.plate-number {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-all;
}

.brand-model {
  margin-top: 8rpx;
  color: #d0d0d0;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-word;
}

.vehicle-status {
  flex-shrink: 0;
  margin-left: 16rpx;
  max-width: 176rpx;
}

.section-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.status-op-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.status-op-btn {
  min-width: 180rpx;
  height: 72rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: #141414;
  color: #ffffff;
  padding: 0 16rpx;
  font-size: 24rpx;
  line-height: 72rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
  transition: opacity 120ms ease, transform 120ms ease;
}

.status-op-btn-pressed {
  opacity: 0.72;
  transform: scale(0.975);
}

.status-op-btn-active {
  background: rgba(47, 128, 237, 0.22);
  border-color: rgba(47, 128, 237, 0.8);
}

.status-op-btn::after {
  border: 0;
}

.retire-inline-btn,
.restore-inline-btn {
  width: 100%;
  margin-top: 16rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  margin-left: -8rpx;
  margin-right: -8rpx;
}

.info-item {
  width: 50%;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.info-item-inner {
  min-height: 100%;
  padding: 22rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}

.info-value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
  word-break: break-all;
}

.info-value-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-box {
  margin-top: 18rpx;
  min-height: 120rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.7;
  box-sizing: border-box;
  word-break: break-word;
}

.image-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.image-desc {
  margin-top: 10rpx;
  color: #b8b8b8;
  font-size: 24rpx;
  line-height: 1.7;
}

.upload-button {
  min-width: 180rpx;
  margin: 0 0 0 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.image-card {
  width: calc(50% - 12rpx);
  margin-right: 24rpx;
  margin-bottom: 24rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}

.image-card:nth-child(2n) {
  margin-right: 0;
}

.vehicle-image {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  background: #2a2a2a;
  transition: filter 120ms ease, transform 120ms ease;
}

.vehicle-image-pressed {
  filter: brightness(0.82);
  transform: scale(0.985);
}

.vehicle-image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1rpx dashed rgba(216, 137, 92, 0.3);
  background:
    radial-gradient(circle at 50% 20%, rgba(191, 112, 72, 0.12), transparent 55%),
    #171416;
  color: #a87562;
}

.vehicle-image-fallback-mark {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(216, 137, 92, 0.18), 0 8rpx 24rpx rgba(108, 54, 37, 0.24);
}

.vehicle-image-fallback-emblem {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  opacity: 0.72;
}

.vehicle-image-fallback-ring {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  left: -6rpx;
  border: 1rpx solid rgba(216, 137, 92, 0.42);
  border-radius: 50%;
  box-shadow: inset 0 0 12rpx rgba(191, 112, 72, 0.12);
}

.vehicle-image-fallback-text {
  margin-top: 12rpx;
  color: #b78771;
  font-size: 18rpx;
  line-height: 1.4;
}

.mini-placeholder-warning {
  color: #c98e70;
}

.mini-placeholder-warning-mark {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.mini-placeholder-warning-mark::before,
.mini-placeholder-warning-mark::after {
  position: absolute;
  left: 7rpx;
  width: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}

.mini-placeholder-warning-mark::before {
  top: 3rpx;
  height: 6rpx;
}

.mini-placeholder-warning-mark::after {
  bottom: 2rpx;
  height: 2rpx;
}

.image-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  max-width: 100%;
  border-radius: 999rpx;
  background: #27ae60;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.image-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.mini-button {
  width: calc(50% - 8rpx);
  height: 64rpx;
  margin: 0;
  border-radius: 12rpx;
  padding: 0 10rpx;
  font-size: 22rpx;
  line-height: 64rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: opacity 120ms ease, transform 120ms ease;
}

.vehicle-detail-button-pressed {
  opacity: 0.72;
  transform: scale(0.975);
}

.secondary-mini-button {
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: #141414;
  color: #ffffff;
}

.danger-mini-button {
  border: 1rpx solid rgba(214, 75, 75, 0.6);
  background: rgba(214, 75, 75, 0.12);
  color: #ffffff;
}

.mini-button::after {
  border: 0;
}

.mini-placeholder {
  width: calc(50% - 8rpx);
  color: #9f9f9f;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-image-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  margin-top: 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  text-align: center;
}

.action-row {
  align-items: center;
  margin-top: 8rpx;
}

.primary-button,
.secondary-button {
  width: calc(50% - 8rpx);
  height: 88rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  line-height: 88rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vehicle-detail-page.management-page .hero-card,
.vehicle-detail-page.management-page .summary-card,
.vehicle-detail-page.management-page .section-card,
.vehicle-detail-page.management-page .loading-card {
  margin-bottom: 22rpx;
  border-color: rgba(255, 255, 255, 0.075);
  border-radius: 26rpx;
}

.vehicle-detail-page.management-page .summary-card {
  border-color: rgba(84, 136, 220, 0.14);
  background: linear-gradient(145deg, #19202a, #14171c 75%);
}

.vehicle-detail-page.management-page .section-card {
  background: #15181d;
}

.vehicle-detail-page.management-page .info-item-inner,
.vehicle-detail-page.management-page .note-box,
.vehicle-detail-page.management-page .image-card,
.vehicle-detail-page.management-page .empty-image-box {
  border-color: rgba(255, 255, 255, 0.065);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.025);
}

.vehicle-detail-page.management-page .vehicle-image {
  border-radius: 16rpx;
}

.vehicle-detail-page.management-page .status-op-btn,
.vehicle-detail-page.management-page .mini-button {
  border-radius: 16rpx;
  background: #101318;
}

.vehicle-detail-page.management-page .primary-button,
.vehicle-detail-page.management-page .secondary-button {
  border-radius: 20rpx;
}

.vehicle-detail-page .loading-card {
  position: relative;
  z-index: 1;
}

.vehicle-detail-skeleton-head,
.vehicle-detail-skeleton-grid,
.vehicle-detail-skeleton-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vehicle-detail-skeleton-plate {
  width: 210rpx;
  height: 38rpx;
  border-radius: 10rpx;
}

.vehicle-detail-skeleton-model {
  width: 280rpx;
  height: 22rpx;
  margin-top: 16rpx;
  border-radius: 9rpx;
}

.vehicle-detail-skeleton-status {
  width: 110rpx;
  height: 52rpx;
  margin-left: 22rpx;
  border-radius: 999rpx;
}

.vehicle-detail-skeleton-divider {
  height: 1rpx;
  margin: 30rpx 0;
  background: rgba(255, 255, 255, 0.07);
}

.vehicle-detail-skeleton-grid {
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.vehicle-detail-skeleton-item {
  width: calc(50% - 12rpx);
  height: 104rpx;
  margin: 0 6rpx 12rpx;
  border-radius: 18rpx;
}

.vehicle-detail-skeleton-actions {
  margin-top: 18rpx;
}

.vehicle-detail-skeleton-button {
  width: calc(50% - 8rpx);
  height: 84rpx;
  border-radius: 20rpx;
}

.vehicle-detail-page .vehicle-detail-empty-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 58rpx 30rpx;
  text-align: center;
  background: linear-gradient(145deg, #1a2029, #14171c 72%);
}

.vehicle-detail-empty-emblem {
  width: 98rpx;
  height: 98rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.22);
  border-radius: 50%;
  opacity: 0.8;
}

.vehicle-detail-empty-kicker {
  margin-top: 20rpx;
  color: #60738f;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.vehicle-detail-empty-title {
  margin-top: 9rpx;
  color: #f3f5f8;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.4;
}

.vehicle-detail-empty-desc {
  margin-top: 12rpx;
  color: #818b99;
  font-size: 22rpx;
  line-height: 1.65;
}

.vehicle-detail-empty-button {
  width: 100%;
  height: 84rpx;
  margin-top: 26rpx;
  font-size: 23rpx;
  line-height: 84rpx;
}

.summary-copy {
  flex: 1;
  min-width: 0;
}

.summary-meta-row,
.summary-meta-item {
  display: flex;
  align-items: center;
}

.summary-meta-row {
  margin-top: 16rpx;
  color: #68778a;
  font-size: 17rpx;
  line-height: 1.45;
}

.summary-meta-divider {
  width: 1rpx;
  height: 18rpx;
  margin: 0 14rpx;
  background: rgba(255, 255, 255, 0.09);
}

.summary-image-icon {
  position: relative;
  width: 20rpx;
  height: 17rpx;
  margin-right: 7rpx;
  overflow: hidden;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.summary-image-icon::before {
  position: absolute;
  right: -1rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.detail-section-heading,
.detail-section-heading-main,
.note-heading {
  display: flex;
  align-items: center;
}

.detail-section-heading,
.note-heading {
  justify-content: space-between;
}

.detail-section-heading-main {
  min-width: 0;
}

.detail-section-kicker {
  color: #60738f;
  font-size: 14rpx;
  font-weight: 650;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.detail-section-kicker + .section-title {
  margin-top: 3rpx;
}

.detail-section-index {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #4e6079;
  font-size: 16rpx;
  font-weight: 650;
}

.detail-section-desc {
  margin-top: 18rpx;
  color: #687587;
  font-size: 19rpx;
  line-height: 1.6;
}

.detail-section-glyph {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(102, 153, 232, 0.19);
  border-radius: 18rpx;
  background: rgba(70, 119, 194, 0.1);
  color: #7caaf0;
}

.detail-section-glyph-icon {
  position: relative;
  box-sizing: border-box;
}

.detail-section-glyph-status .detail-section-glyph-icon {
  width: 31rpx;
  height: 22rpx;
}

.detail-section-glyph-status .detail-section-glyph-icon::before,
.detail-section-glyph-status .detail-section-glyph-icon::after {
  position: absolute;
  left: 0;
  width: 31rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.detail-section-glyph-status .detail-section-glyph-icon::before {
  top: 3rpx;
  box-shadow: 0 14rpx currentColor;
}

.detail-section-glyph-status .detail-section-glyph-icon::after {
  top: -1rpx;
  left: 6rpx;
  width: 10rpx;
  height: 10rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  background: #1b2737;
  box-sizing: border-box;
  box-shadow: 11rpx 14rpx 0 -3rpx #1b2737, 11rpx 14rpx 0 0 currentColor;
}

.detail-section-glyph-profile .detail-section-glyph-icon {
  width: 32rpx;
  height: 17rpx;
  margin-top: 7rpx;
  border: 3rpx solid currentColor;
  border-radius: 7rpx 7rpx 5rpx 5rpx;
}

.detail-section-glyph-profile .detail-section-glyph-icon::before {
  position: absolute;
  top: -10rpx;
  left: 5rpx;
  width: 16rpx;
  height: 11rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 7rpx 7rpx 0 0;
  box-sizing: border-box;
  content: "";
}

.detail-section-glyph-profile .detail-section-glyph-icon::after {
  position: absolute;
  bottom: -7rpx;
  left: 3rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 16rpx 0 currentColor;
  content: "";
}

.detail-section-glyph-admin .detail-section-glyph-icon {
  width: 28rpx;
  height: 30rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
}

.detail-section-glyph-admin .detail-section-glyph-icon::before {
  position: absolute;
  top: 6rpx;
  left: 5rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 9rpx 0 currentColor;
  content: "";
}

.detail-section-glyph-admin .detail-section-glyph-icon::after {
  position: absolute;
  bottom: 5rpx;
  left: 5rpx;
  width: 12rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.detail-section-glyph-images .detail-section-glyph-icon {
  width: 31rpx;
  height: 27rpx;
  overflow: hidden;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
}

.detail-section-glyph-images .detail-section-glyph-icon::before {
  position: absolute;
  right: 4rpx;
  bottom: -7rpx;
  width: 18rpx;
  height: 18rpx;
  border-top: 3rpx solid currentColor;
  border-left: 3rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.detail-section-glyph-images .detail-section-glyph-icon::after {
  position: absolute;
  top: 4rpx;
  left: 5rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.status-op-content,
.danger-button-content,
.upload-button-content,
.mini-button-content,
.detail-action-content,
.mini-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-op-content {
  height: 100%;
}

.status-op-dot {
  flex-shrink: 0;
  width: 8rpx;
  height: 8rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: #758196;
}

.status-op-dot-idle {
  background: #64c891;
}

.status-op-dot-active {
  background: #6fa5f2;
}

.status-op-dot-maintenance {
  background: #d9a957;
}

.status-op-check {
  width: 6rpx;
  height: 11rpx;
  margin: -4rpx 0 0 10rpx;
  border-right: 2rpx solid #9fc2fa;
  border-bottom: 2rpx solid #9fc2fa;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.danger-zone {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(221, 92, 92, 0.14);
  border-radius: 18rpx;
  background: rgba(153, 55, 55, 0.06);
}

.danger-zone-copy {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.danger-zone-title {
  color: #dc8a8a;
  font-size: 20rpx;
  font-weight: 650;
}

.danger-zone-desc {
  margin-top: 5rpx;
  color: #79686c;
  font-size: 16rpx;
  line-height: 1.5;
}

.vehicle-detail-page .danger-zone .retire-inline-btn {
  flex-shrink: 0;
  width: 184rpx;
  height: 68rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 19rpx;
  line-height: 68rpx;
}

.retire-native-icon {
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.retire-native-icon::after {
  display: block;
  width: 8rpx;
  height: 2rpx;
  margin: 6rpx auto 0;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
}

.restore-native-icon {
  position: relative;
  width: 17rpx;
  height: 17rpx;
  margin-right: 9rpx;
  border: 2rpx solid currentColor;
  border-left-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
  transform: rotate(-34deg);
}

.restore-native-icon::before {
  position: absolute;
  top: -3rpx;
  left: -2rpx;
  width: 0;
  height: 0;
  border-top: 4rpx solid transparent;
  border-right: 6rpx solid currentColor;
  border-bottom: 4rpx solid transparent;
  content: "";
}

.visibility-chip {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 8rpx 13rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  color: #778598;
  font-size: 16rpx;
  line-height: 1.3;
}

.visibility-chip-public {
  border-color: rgba(87, 158, 233, 0.18);
  background: rgba(67, 126, 191, 0.08);
  color: #77a9e3;
}

.visibility-chip-private {
  border-color: rgba(214, 166, 84, 0.16);
  background: rgba(157, 111, 35, 0.07);
  color: #c79e5c;
}

.visibility-eye-icon {
  position: relative;
  width: 18rpx;
  height: 12rpx;
  margin-right: 7rpx;
  border: 2rpx solid currentColor;
  border-radius: 50% 50% 48% 48%;
  box-sizing: border-box;
}

.visibility-eye-icon::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
  transform: translate(-50%, -50%);
}

.visibility-lock-icon {
  position: relative;
  width: 15rpx;
  height: 13rpx;
  margin-right: 7rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.visibility-lock-shackle {
  position: absolute;
  bottom: 9rpx;
  left: 50%;
  width: 9rpx;
  height: 8rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 7rpx 7rpx 0 0;
  box-sizing: border-box;
  transform: translateX(-50%);
}

.upload-button-content {
  white-space: nowrap;
}

.upload-native-icon {
  position: relative;
  width: 19rpx;
  height: 16rpx;
  margin-right: 9rpx;
  border: 2rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 3rpx 3rpx;
  box-sizing: border-box;
}

.upload-native-icon::before {
  position: absolute;
  bottom: 5rpx;
  left: 50%;
  width: 2rpx;
  height: 13rpx;
  border-radius: 999rpx;
  background: currentColor;
  content: "";
  transform: translateX(-50%);
}

.upload-native-icon::after {
  position: absolute;
  bottom: 13rpx;
  left: 50%;
  width: 7rpx;
  height: 7rpx;
  border-top: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  content: "";
  transform: translateX(-50%) rotate(45deg);
}

.vehicle-detail-page .image-card {
  position: relative;
}

.vehicle-detail-page .image-badge {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  display: flex;
  align-items: center;
  margin: 0;
  padding: 7rpx 12rpx;
  background: rgba(32, 152, 91, 0.92);
  box-shadow: 0 7rpx 18rpx rgba(0, 0, 0, 0.24);
}

.image-badge-check,
.mini-placeholder-check {
  width: 5rpx;
  height: 10rpx;
  margin: -3rpx 8rpx 0 2rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  box-sizing: border-box;
  transform: rotate(45deg);
}

.mini-button-content {
  height: 100%;
}

.cover-native-icon {
  position: relative;
  width: 18rpx;
  height: 15rpx;
  margin-right: 7rpx;
  overflow: hidden;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.cover-native-icon::after {
  position: absolute;
  right: -1rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 10rpx;
  border-top: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.trash-native-icon {
  position: relative;
  width: 14rpx;
  height: 16rpx;
  margin: 3rpx 8rpx 0 0;
  border: 2rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 3rpx 3rpx;
  box-sizing: border-box;
}

.trash-native-icon::before {
  position: absolute;
  top: -5rpx;
  left: -3rpx;
  width: 16rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 5rpx -3rpx 0 -1rpx currentColor;
  content: "";
}

.vehicle-detail-page .mini-placeholder {
  color: #67bf91;
  line-height: 64rpx;
}

.empty-image-box {
  flex-direction: column;
  min-height: 250rpx;
  padding: 34rpx 24rpx;
  box-sizing: border-box;
}

.empty-image-icon {
  position: relative;
  width: 58rpx;
  height: 50rpx;
  overflow: hidden;
  border: 3rpx solid #6888b5;
  border-radius: 9rpx;
  box-sizing: border-box;
}

.empty-image-sun {
  position: absolute;
  top: 8rpx;
  left: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid #6888b5;
  border-radius: 50%;
  box-sizing: border-box;
}

.empty-image-mountain {
  position: absolute;
  right: 5rpx;
  bottom: -13rpx;
  width: 35rpx;
  height: 35rpx;
  border-top: 3rpx solid #6888b5;
  border-left: 3rpx solid #6888b5;
  transform: rotate(45deg);
}

.empty-image-title {
  margin-top: 19rpx;
  color: #dfe6ef;
  font-size: 23rpx;
  font-weight: 650;
}

.empty-image-desc {
  max-width: 480rpx;
  margin-top: 8rpx;
  color: #667386;
  font-size: 18rpx;
  line-height: 1.6;
  text-align: center;
}

.detail-action-dock {
  position: sticky;
  z-index: 8;
  bottom: calc(env(safe-area-inset-bottom) + 12rpx);
  margin-top: 8rpx;
  padding: 18rpx;
  border-color: rgba(91, 143, 224, 0.2);
  border-radius: 25rpx;
  background: rgba(20, 25, 33, 0.97);
  box-shadow: 0 22rpx 54rpx rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}

.detail-action-content {
  height: 100%;
}

.back-native-icon {
  width: 9rpx;
  height: 9rpx;
  margin-right: 10rpx;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.edit-native-icon {
  position: relative;
  width: 7rpx;
  height: 21rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: currentColor;
  transform: rotate(42deg);
}

.edit-native-icon::after {
  position: absolute;
  right: 0;
  bottom: -6rpx;
  left: 0;
  width: 0;
  height: 0;
  margin: auto;
  border-right: 4rpx solid transparent;
  border-left: 4rpx solid transparent;
  border-top: 6rpx solid currentColor;
  content: "";
}
