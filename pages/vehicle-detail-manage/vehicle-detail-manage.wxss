@import "../../shared/management-shell.wxss";

.vehicle-detail-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background: #101010;
  box-sizing: border-box;
}

.hero-card,
.summary-card,
.section-card,
.loading-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.hero-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.hero-desc,
.loading-text,
.info-label {
  margin-top: 10rpx;
  color: #b8b8b8;
  font-size: 24rpx;
  line-height: 1.7;
}

.summary-card,
.action-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.plate-number {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-all;
}

.brand-model {
  margin-top: 8rpx;
  color: #d0d0d0;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-word;
}

.vehicle-status {
  flex-shrink: 0;
  margin-left: 16rpx;
  max-width: 176rpx;
}

.section-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.status-op-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.status-op-btn {
  min-width: 180rpx;
  height: 72rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  background: #141414;
  color: #ffffff;
  padding: 0 16rpx;
  font-size: 24rpx;
  line-height: 72rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.status-op-btn-active {
  background: rgba(47, 128, 237, 0.22);
  border-color: rgba(47, 128, 237, 0.8);
}

.status-op-btn::after {
  border: 0;
}

.retire-inline-btn,
.restore-inline-btn {
  width: 100%;
  margin-top: 16rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
  margin-left: -8rpx;
  margin-right: -8rpx;
}

.info-item {
  width: 50%;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.info-item-inner {
  min-height: 100%;
  padding: 22rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}

.info-value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
  word-break: break-all;
}

.info-value-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-box {
  margin-top: 18rpx;
  min-height: 120rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.7;
  box-sizing: border-box;
  word-break: break-word;
}

.image-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.image-desc {
  margin-top: 10rpx;
  color: #b8b8b8;
  font-size: 24rpx;
  line-height: 1.7;
}

.upload-button {
  min-width: 180rpx;
  margin: 0 0 0 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.image-card {
  width: calc(50% - 12rpx);
  margin-right: 24rpx;
  margin-bottom: 24rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  box-sizing: border-box;
}

.image-card:nth-child(2n) {
  margin-right: 0;
}

.vehicle-image {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  background: #2a2a2a;
}

.image-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  max-width: 100%;
  border-radius: 999rpx;
  background: #27ae60;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.image-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.mini-button {
  width: calc(50% - 8rpx);
  height: 64rpx;
  margin: 0;
  border-radius: 12rpx;
  padding: 0 10rpx;
  font-size: 22rpx;
  line-height: 64rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.secondary-mini-button {
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: #141414;
  color: #ffffff;
}

.danger-mini-button {
  border: 1rpx solid rgba(214, 75, 75, 0.6);
  background: rgba(214, 75, 75, 0.12);
  color: #ffffff;
}

.mini-button::after {
  border: 0;
}

.mini-placeholder {
  width: calc(50% - 8rpx);
  color: #9f9f9f;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-image-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  margin-top: 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  text-align: center;
}

.action-row {
  align-items: center;
  margin-top: 8rpx;
}

.primary-button,
.secondary-button {
  width: calc(50% - 8rpx);
  height: 88rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  line-height: 88rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vehicle-detail-page.management-page .hero-card,
.vehicle-detail-page.management-page .summary-card,
.vehicle-detail-page.management-page .section-card,
.vehicle-detail-page.management-page .loading-card {
  margin-bottom: 22rpx;
  border-color: rgba(255, 255, 255, 0.075);
  border-radius: 26rpx;
}

.vehicle-detail-page.management-page .summary-card {
  border-color: rgba(84, 136, 220, 0.14);
  background: linear-gradient(145deg, #19202a, #14171c 75%);
}

.vehicle-detail-page.management-page .section-card {
  background: #15181d;
}

.vehicle-detail-page.management-page .info-item-inner,
.vehicle-detail-page.management-page .note-box,
.vehicle-detail-page.management-page .image-card,
.vehicle-detail-page.management-page .empty-image-box {
  border-color: rgba(255, 255, 255, 0.065);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.025);
}

.vehicle-detail-page.management-page .vehicle-image {
  border-radius: 16rpx;
}

.vehicle-detail-page.management-page .status-op-btn,
.vehicle-detail-page.management-page .mini-button {
  border-radius: 16rpx;
  background: #101318;
}

.vehicle-detail-page.management-page .primary-button,
.vehicle-detail-page.management-page .secondary-button {
  border-radius: 20rpx;
}

.vehicle-detail-page .loading-card {
  position: relative;
  z-index: 1;
}

.vehicle-detail-skeleton-head,
.vehicle-detail-skeleton-grid,
.vehicle-detail-skeleton-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vehicle-detail-skeleton-plate {
  width: 210rpx;
  height: 38rpx;
  border-radius: 10rpx;
}

.vehicle-detail-skeleton-model {
  width: 280rpx;
  height: 22rpx;
  margin-top: 16rpx;
  border-radius: 9rpx;
}

.vehicle-detail-skeleton-status {
  width: 110rpx;
  height: 52rpx;
  margin-left: 22rpx;
  border-radius: 999rpx;
}

.vehicle-detail-skeleton-divider {
  height: 1rpx;
  margin: 30rpx 0;
  background: rgba(255, 255, 255, 0.07);
}

.vehicle-detail-skeleton-grid {
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.vehicle-detail-skeleton-item {
  width: calc(50% - 12rpx);
  height: 104rpx;
  margin: 0 6rpx 12rpx;
  border-radius: 18rpx;
}

.vehicle-detail-skeleton-actions {
  margin-top: 18rpx;
}

.vehicle-detail-skeleton-button {
  width: calc(50% - 8rpx);
  height: 84rpx;
  border-radius: 20rpx;
}

.vehicle-detail-page .vehicle-detail-empty-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 58rpx 30rpx;
  text-align: center;
  background: linear-gradient(145deg, #1a2029, #14171c 72%);
}

.vehicle-detail-empty-emblem {
  width: 98rpx;
  height: 98rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.22);
  border-radius: 50%;
  opacity: 0.8;
}

.vehicle-detail-empty-kicker {
  margin-top: 20rpx;
  color: #60738f;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.vehicle-detail-empty-title {
  margin-top: 9rpx;
  color: #f3f5f8;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.4;
}

.vehicle-detail-empty-desc {
  margin-top: 12rpx;
  color: #818b99;
  font-size: 22rpx;
  line-height: 1.65;
}

.vehicle-detail-empty-button {
  width: 100%;
  height: 84rpx;
  margin-top: 26rpx;
  font-size: 23rpx;
  line-height: 84rpx;
}
