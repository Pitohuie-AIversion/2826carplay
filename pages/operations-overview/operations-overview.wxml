<view wx:if="{{pageAuthorized}}" class="overview-page management-page">
  <view class="page-glow"></view>

  <view class="hero-card ui-card ui-card-gradient">
    <view class="hero-top">
      <view class="hero-copy">
        <view class="page-kicker">OPERATIONS PULSE</view>
        <view class="hero-title">运营概览</view>
        <view class="hero-desc">集中查看预约跟进、车辆状态与待办提醒</view>
      </view>
      <image class="hero-emblem" src="/assets/icons/jijing-garage-emblem.png" mode="aspectFill" aria-hidden="true" />
    </view>
    <view class="hero-foot">
      <view class="live-dot {{loadedSourceCount && loadedSourceCount === requestedSourceCount ? '' : 'live-dot-warning'}}"></view>
      <view class="hero-foot-text">
        {{lastSyncedText ? '最近同步 ' + lastSyncedText + ' · ' + loadedSourceCount + '/' + requestedSourceCount + ' 数据源' : '等待同步当前云环境'}}
      </view>
      <view class="refresh-link {{loading || refreshing ? 'refresh-link-disabled' : ''}}" bindtap="handleRefresh" hover-class="{{loading || refreshing ? 'none' : 'refresh-link-pressed'}}" aria-role="button" aria-disabled="{{loading || refreshing}}" aria-label="{{loading || refreshing ? '正在刷新运营数据' : '刷新运营数据'}}">
        <view class="refresh-native-icon {{loading || refreshing ? 'refresh-native-icon-spinning' : ''}}" aria-hidden="true"></view>{{loading || refreshing ? '同步中…' : '刷新数据'}}
      </view>
    </view>
    <view class="hero-sync {{syncStateClass}}" aria-role="group" aria-label="运营数据同步进度 {{syncProgress}}%，{{syncStateLabel}}"><view class="hero-sync-track" aria-hidden="true"><view class="hero-sync-progress" style="width: {{syncProgress}}%;"></view></view><view class="hero-sync-meta"><view>{{syncStateLabel}}</view><view>{{syncProgress}}%</view></view></view>
  </view>

  <view wx:if="{{loading}}" class="overview-skeleton" aria-hidden="true">
    <view class="overview-skeleton-pulse ui-card">
      <view class="overview-skeleton-stat" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="overview-skeleton-stat-icon manage-skeleton-pulse"></view>
        <view class="overview-skeleton-stat-value manage-skeleton-pulse"></view>
        <view class="overview-skeleton-stat-label manage-skeleton-pulse"></view>
      </view>
    </view>
    <view class="overview-skeleton-section ui-card">
      <view class="overview-skeleton-heading">
        <view><view class="overview-skeleton-kicker manage-skeleton-pulse"></view><view class="overview-skeleton-title manage-skeleton-pulse"></view></view>
        <view class="overview-skeleton-status manage-skeleton-pulse"></view>
      </view>
      <view class="overview-skeleton-alert" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="overview-skeleton-alert-icon manage-skeleton-pulse"></view>
        <view class="overview-skeleton-alert-copy"><view class="overview-skeleton-line overview-skeleton-line-title manage-skeleton-pulse"></view><view class="overview-skeleton-line manage-skeleton-pulse"></view></view>
      </view>
    </view>
    <view class="overview-skeleton-section overview-skeleton-section-muted ui-card">
      <view class="overview-skeleton-heading">
        <view><view class="overview-skeleton-kicker manage-skeleton-pulse"></view><view class="overview-skeleton-title manage-skeleton-pulse"></view></view>
        <view class="overview-skeleton-link manage-skeleton-pulse"></view>
      </view>
      <view class="overview-skeleton-metrics">
        <view class="overview-skeleton-metric" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this"><view class="overview-skeleton-metric-icon manage-skeleton-pulse"></view><view class="overview-skeleton-metric-value manage-skeleton-pulse"></view><view class="overview-skeleton-metric-label manage-skeleton-pulse"></view></view>
      </view>
    </view>
  </view>

  <view wx:else>
    <view wx:if="{{loadError}}" class="error-card ui-card">
      <view class="error-native-icon" aria-hidden="true"></view>
      <view class="error-copy">
        <view class="error-title">部分数据暂未加载</view>
        <view class="error-desc">{{loadError}}</view>
      </view>
      <button class="retry-button ui-btn ui-btn-ghost" bindtap="handleRefresh"><view class="retry-native-icon" aria-hidden="true"></view>重试</button>
    </view>

    <view wx:if="{{vehicleLoaded || bookingLoaded || summaryLoaded}}" class="pulse-strip ui-card">
      <view class="pulse-item">
        <view class="pulse-native-icon pulse-native-icon-action" aria-hidden="true"></view>
        <view class="pulse-value pulse-value-primary">{{pendingActionCount}}</view>
        <view class="pulse-label">当前行动项</view>
      </view>
      <view class="pulse-divider"></view>
      <view class="pulse-item">
        <view class="pulse-native-icon pulse-native-icon-attention" aria-hidden="true"></view>
        <view class="pulse-value">{{attentionAreaCount}}</view>
        <view class="pulse-label">需关注模块</view>
      </view>
      <view class="pulse-divider"></view>
      <view class="pulse-item">
        <view class="pulse-native-icon pulse-native-icon-source" aria-hidden="true"></view>
        <view class="pulse-value">{{loadedSourceCount}}/{{requestedSourceCount}}</view>
        <view class="pulse-label">数据完整度</view>
      </view>
    </view>

    <view class="section-card ui-card">
      <view class="section-heading">
        <view class="section-heading-icon-wrap">
          <view class="section-native-icon action-section-native-icon" aria-hidden="true"></view>
          <view><view class="section-eyebrow">ACTION CENTER</view><view class="section-title">当前待办</view></view>
        </view>
        <view class="operation-state {{operationStateClass}}"><view class="operation-state-dot"></view>{{operationStateLabel}}</view>
      </view>
      <view class="alert-list">
        <view
          class="alert-item"
          wx:for="{{alerts}}"
          wx:key="key"
          data-url="{{item.url}}"
          bindtap="handleRouteTap"
          hover-class="alert-item-pressed"
          aria-role="button"
          aria-label="{{item.title}}，{{item.desc}}"
        >
          <view class="alert-icon-wrap alert-{{item.tone}}"><view class="alert-native-icon {{item.iconClass}}" aria-hidden="true"></view></view>
          <view class="alert-copy">
            <view class="alert-title">{{item.title}}</view>
            <view class="alert-desc">{{item.desc}}</view>
          </view>
          <view class="alert-action" aria-hidden="true">
            <view class="alert-action-label">{{item.actionLabel}}</view><view class="alert-chevron"></view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{canManageBookings}}" class="section-card ui-card">
      <view class="section-heading">
        <view class="section-heading-icon-wrap">
          <view class="section-native-icon booking-section-native-icon" aria-hidden="true"></view>
          <view><view class="section-eyebrow">RESERVATION DESK</view><view class="section-title">预约概况</view></view>
        </view>
        <view class="section-link" data-url="/pages/booking-manage/booking-manage" bindtap="handleRouteTap" hover-class="section-link-pressed" aria-role="button" aria-label="查看全部预约">查看全部<view class="section-link-chevron" aria-hidden="true"></view></view>
      </view>
      <view wx:if="{{bookingLoaded}}" class="metric-grid">
        <view class="metric-item metric-{{item.tone}}" wx:for="{{bookingMetrics}}" wx:key="key">
          <view class="metric-native-icon {{item.iconClass}}" aria-hidden="true"></view>
          <view class="metric-value">{{item.value}}</view>
          <view class="metric-label">{{item.label}}</view>
        </view>
      </view>
      <view wx:else class="inline-empty">
        <view class="section-native-icon booking-section-native-icon inline-empty-native-icon" aria-hidden="true"></view>
        <view class="inline-empty-copy"><view class="inline-empty-title">预约统计暂时不可用</view><view class="inline-empty-desc">已同步的其他模块不受影响，可稍后刷新重试</view></view>
      </view>
    </view>

    <view wx:if="{{canManageVehicles}}" class="section-card ui-card">
      <view class="section-heading">
        <view class="section-heading-icon-wrap">
          <view class="section-native-icon vehicle-section-native-icon" aria-hidden="true"></view>
          <view><view class="section-eyebrow">FLEET STATUS</view><view class="section-title">车辆概况</view></view>
        </view>
        <view class="section-link" data-url="/pages/vehicle-manage/vehicle-manage" bindtap="handleRouteTap" hover-class="section-link-pressed" aria-role="button" aria-label="查看车辆管理">查看车库<view class="section-link-chevron" aria-hidden="true"></view></view>
      </view>
      <view wx:if="{{vehicleLoaded}}" class="metric-grid">
        <view class="metric-item metric-{{item.tone}}" wx:for="{{vehicleMetrics}}" wx:key="key">
          <view class="metric-native-icon {{item.iconClass}}" aria-hidden="true"></view>
          <view class="metric-value">{{item.value}}</view>
          <view class="metric-label">{{item.label}}</view>
        </view>
      </view>
      <view wx:else class="inline-empty">
        <view class="section-native-icon vehicle-section-native-icon inline-empty-native-icon" aria-hidden="true"></view>
        <view class="inline-empty-copy"><view class="inline-empty-title">车辆统计暂时不可用</view><view class="inline-empty-desc">已同步的其他模块不受影响，可稍后刷新重试</view></view>
      </view>
    </view>

    <view wx:if="{{canManageBookings && recentBookings.length}}" class="section-card ui-card">
      <view class="section-heading">
        <view class="section-heading-icon-wrap">
          <view class="section-native-icon recent-booking-section-native-icon" aria-hidden="true"></view>
          <view><view class="section-eyebrow">RECENT LEADS</view><view class="section-title">近期预约</view></view>
        </view>
        <view class="section-index">04</view>
      </view>
      <view
        class="recent-item {{item.itemClass}}"
        wx:for="{{recentBookings}}"
        wx:key="id"
        data-url="/pages/booking-manage-detail/booking-manage-detail?id={{item.id}}"
        bindtap="handleRouteTap"
        hover-class="recent-item-pressed"
        aria-role="button"
        aria-label="查看 {{item.title}}，{{item.meta}}，{{item.statusLabel}}"
      >
        <view class="recent-native-icon-wrap"><view class="recent-native-icon {{item.iconClass}}" aria-hidden="true"></view></view><view class="recent-main">
          <view class="recent-title">{{item.title}}</view>
          <view class="recent-meta">{{item.meta}}</view>
        </view>
        <view class="recent-side">
          <view class="status-pill {{item.statusClass}}"><view class="status-dot"></view>{{item.statusLabel}}</view>
          <view class="recent-time"><view class="time-native-icon" aria-hidden="true"></view>{{item.timeText}}</view>
        </view>
        <view class="recent-chevron" aria-hidden="true"></view>
      </view>
    </view>

    <view wx:if="{{canManageVehicles && recentVehicles.length}}" class="section-card ui-card">
      <view class="section-heading">
        <view class="section-heading-icon-wrap">
          <view class="section-native-icon recent-vehicle-section-native-icon" aria-hidden="true"></view>
          <view><view class="section-eyebrow">RECENT FLEET</view><view class="section-title">近期入库</view></view>
        </view>
        <view class="section-index">05</view>
      </view>
      <view
        class="recent-item {{item.itemClass}}"
        wx:for="{{recentVehicles}}"
        wx:key="id"
        data-url="/pages/vehicle-detail-manage/vehicle-detail-manage?id={{item.id}}"
        bindtap="handleRouteTap"
        hover-class="recent-item-pressed"
        aria-role="button"
        aria-label="查看 {{item.title}}，{{item.meta}}，{{item.statusLabel}}"
      >
        <view class="recent-native-icon-wrap"><view class="recent-native-icon {{item.iconClass}}" aria-hidden="true"></view></view><view class="recent-main">
          <view class="recent-title">{{item.title}}</view>
          <view class="recent-meta">{{item.meta}}</view>
        </view>
        <view class="recent-side">
          <view class="status-pill {{item.statusClass}}"><view class="status-dot"></view>{{item.statusLabel}}</view>
          <view class="recent-time"><view class="time-native-icon" aria-hidden="true"></view>{{item.timeText}}</view>
        </view>
        <view class="recent-chevron" aria-hidden="true"></view>
      </view>
    </view>
  </view>
</view>
