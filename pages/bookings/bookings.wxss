.booking-top { display: flex; align-items: center; justify-content: space-between; }
.booking-index { color: #60728d; font-size: 16rpx; font-weight: 600; line-height: 1.4; letter-spacing: 2rpx; }
.booking-status { display: flex; align-items: center; flex-shrink: 0; max-width: 200rpx; border: 1rpx solid rgba(255, 255, 255, 0.12); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.booking-status-dot { flex-shrink: 0; width: 8rpx; height: 8rpx; margin-right: 8rpx; border-radius: 50%; background: currentColor; box-shadow: 0 0 12rpx currentColor; }
.booking-name-row { display: flex; align-items: center; margin-top: 20rpx; }
