root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{wxml,wxss,json}]
indent_style = space
indent_size = 2

[*.{png,jpg,jpeg,gif,webp,ico,zip,pdf}]
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
