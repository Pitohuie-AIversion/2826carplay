.detail-page {
  min-height: 100vh;
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #121722 0%, #0b0d10 620rpx);
}

.hero-shell,
.hero-swiper {
  position: relative;
  height: 480rpx;
  overflow: hidden;
  background: #15181d;
}

.hero-image {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #20242c, #0e1013);
  opacity: 0;
  transition: opacity 360ms ease, filter 120ms ease, transform 120ms ease;
}

.hero-image-pressed {
  filter: brightness(0.82);
  transform: scale(0.99);
}

.hero-image-frame {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #15181d;
}

.hero-image-loaded {
  opacity: 1;
}

.hero-image-loading,
.hero-image-fallback {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.hero-image-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background:
    radial-gradient(circle at 72% 35%, rgba(66, 124, 214, 0.18), transparent 34%),
    linear-gradient(135deg, #1d2735, #0d1218);
}

.hero-image-loading::after {
  position: absolute;
  top: -100rpx;
  left: -190rpx;
  width: 150rpx;
  height: 650rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.065), transparent);
  content: "";
  transform: rotate(22deg);
  animation: heroImageSweep 1.6s ease-in-out infinite;
}

.hero-image-loading-mark {
  position: relative;
  width: 66rpx;
  height: 66rpx;
}

.hero-image-loading-emblem {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  opacity: 0.5;
}

.hero-image-loading-ring {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  left: -8rpx;
  border: 2rpx solid rgba(115, 158, 225, 0.17);
  border-top-color: rgba(115, 158, 225, 0.64);
  border-radius: 50%;
  animation: heroImageSpin 1.15s linear infinite;
}

.hero-image-loading-text {
  margin-top: 18rpx;
  color: rgba(153, 181, 224, 0.52);
  font-size: 14rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 3rpx;
}

.hero-image-fallback {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
  padding: 46rpx 30rpx;
  background:
    radial-gradient(circle at 75% 36%, rgba(61, 119, 210, 0.27), transparent 34%),
    linear-gradient(135deg, #202b3b, #0c1118);
  box-sizing: border-box;
}

.hero-placeholder {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 46rpx 30rpx;
  background: radial-gradient(circle at 75% 36%, rgba(61, 119, 210, 0.27), transparent 34%), linear-gradient(135deg, #202b3b, #0c1118);
  box-sizing: border-box;
}

.hero-placeholder-brand-row {
  display: flex;
  align-items: center;
}

.hero-placeholder-emblem {
  flex-shrink: 0;
  width: 50rpx;
  height: 50rpx;
  margin-right: 14rpx;
  border: 1rpx solid rgba(125, 169, 236, 0.24);
  border-radius: 50%;
  opacity: 0.82;
}

.hero-placeholder-brand {
  color: rgba(178, 199, 231, 0.66);
  font-size: 19rpx;
  line-height: 1.4;
  letter-spacing: 3rpx;
}

.hero-placeholder-name {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-placeholder-text {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 23rpx;
  line-height: 1.6;
}

.hero-shade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 220rpx;
  background: linear-gradient(180deg, transparent, rgba(8, 10, 13, 0.72));
  pointer-events: none;
  z-index: 2;
}

.hero-signature {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  display: flex;
  align-items: center;
  color: rgba(219, 228, 242, 0.7);
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 3rpx;
  z-index: 3;
}

.hero-counter {
  position: absolute;
  right: 26rpx;
  bottom: 25rpx;
  z-index: 3;
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-width: 92rpx;
  padding: 9rpx 13rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  background: rgba(7, 10, 14, 0.5);
  color: rgba(218, 225, 235, 0.66);
  font-size: 15rpx;
  line-height: 1;
  box-sizing: border-box;
}

.hero-pagination {
  position: absolute;
  bottom: 31rpx;
  left: 50%;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  transform: translateX(-50%);
  pointer-events: none;
}

.hero-pagination-segment {
  flex: 1;
  min-width: 8rpx;
  max-width: 34rpx;
  height: 4rpx;
  margin: 0 3rpx;
  border-radius: 999rpx;
  background: rgba(218, 228, 242, 0.28);
  transition: background-color 180ms ease, transform 180ms ease;
}

.hero-pagination-segment-active {
  background: #78aaf7;
  box-shadow: 0 0 12rpx rgba(93, 150, 246, 0.42);
  transform: scaleY(1.5);
}

.hero-preview-hint {
  position: absolute;
  top: 24rpx;
  right: calc(24rpx + env(safe-area-inset-right));
  z-index: 3;
  display: flex;
  align-items: center;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 999rpx;
  background: rgba(7, 10, 14, 0.46);
  color: rgba(226, 233, 243, 0.76);
  font-size: 15rpx;
  line-height: 1.2;
  backdrop-filter: blur(10rpx);
  pointer-events: none;
}

.hero-preview-icon {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  margin-right: 7rpx;
  color: #7daaf0;
  box-sizing: border-box;
}

.hero-preview-corner {
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  box-sizing: border-box;
}

.hero-preview-corner-top-left {
  top: 0;
  left: 0;
  border-top: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
}

.hero-preview-corner-top-right {
  top: 0;
  right: 0;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
}

.hero-preview-corner-bottom-left {
  bottom: 0;
  left: 0;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
}

.hero-preview-corner-bottom-right {
  right: 0;
  bottom: 0;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
}

.hero-counter-current {
  color: #f3f6fa;
  font-size: 19rpx;
  font-weight: 650;
}

.hero-counter-divider {
  margin: 0 7rpx;
  color: #6682aa;
}

.signature-line {
  width: 30rpx;
  height: 2rpx;
  margin-right: 12rpx;
  background: #5d96f6;
}

@keyframes heroImageSweep {
  0% {
    left: -220rpx;
  }

  100% {
    left: 820rpx;
  }
}

@keyframes heroImageSpin {
  0% {
    transform: rotate(0deg);
  }

  100% {
    transform: rotate(360deg);
  }
}

.summary-card,
.notice-card,
.info-card,
.empty-page {
  margin: 22rpx 24rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 26rpx;
  background: #15181d;
  box-sizing: border-box;
  box-shadow: 0 20rpx 44rpx rgba(0, 0, 0, 0.2);
}

.summary-card {
  position: relative;
  z-index: 2;
  margin-top: -24rpx;
  border-color: rgba(108, 151, 221, 0.14);
  background: linear-gradient(145deg, #1a202a, #14171c 70%);
}

.summary-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-identity {
  flex: 1;
  min-width: 0;
}

.summary-kicker {
  color: #657996;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.car-name {
  margin-top: 9rpx;
  color: #f7f9fc;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-word;
}

.car-nickname {
  margin-top: 8rpx;
  color: #929ba8;
  font-size: 23rpx;
  line-height: 1.65;
}

.car-status {
  flex-shrink: 0;
  max-width: 180rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.summary-actions {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.favorite-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  height: 52rpx;
  margin: 14rpx 0 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.22);
  border-radius: 999rpx;
  background: rgba(84, 143, 255, 0.07);
  color: #8aabdd;
  font-size: 18rpx;
  line-height: 1;
  transition: opacity 120ms ease, transform 120ms ease;
}

.favorite-button::after {
  border: 0;
}

.favorite-button-active {
  border-color: rgba(117, 170, 255, 0.4);
  background: linear-gradient(135deg, rgba(77, 137, 234, 0.24), rgba(55, 105, 189, 0.16));
  color: #a9c9ff;
  box-shadow: 0 0 18rpx rgba(80, 140, 236, 0.12);
}

.favorite-button-pressed {
  opacity: 0.72;
  transform: scale(0.94);
}

.favorite-button-icon {
  position: relative;
  width: 23rpx;
  height: 23rpx;
  color: currentColor;
}

.favorite-heart-shape {
  position: absolute;
  top: 7rpx;
  left: 6rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 3rpx;
  background: currentColor;
  opacity: 0.72;
  transform: rotate(-45deg) scale(0.8);
  transform-origin: center;
}

.favorite-heart-shape::before,
.favorite-heart-shape::after {
  position: absolute;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}

.favorite-heart-shape::before {
  top: -6.5rpx;
  left: 0;
}

.favorite-heart-shape::after {
  top: 0;
  left: 6.5rpx;
}

.favorite-button-active .favorite-heart-shape {
  opacity: 1;
}

.favorite-button-text {
  margin-left: 6rpx;
  line-height: 1;
}

.price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.price-label {
  color: #77818f;
  font-size: 18rpx;
  line-height: 1.3;
}

.car-price {
  margin-top: 5rpx;
  color: #f7f9fc;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.price-note {
  padding-bottom: 4rpx;
  color: #5f6874;
  font-size: 18rpx;
  line-height: 1.4;
}

.tag-list {
  margin-top: 20rpx;
}

.tag-item {
  display: inline-block;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  padding: 9rpx 16rpx;
  max-width: 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 999rpx;
  color: #bec5cf;
  font-size: 19rpx;
  line-height: 1.3;
  background: rgba(255, 255, 255, 0.035);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-card {
  border-color: rgba(64, 126, 225, 0.2);
  background: linear-gradient(135deg, rgba(35, 67, 116, 0.28), rgba(19, 24, 31, 0.96));
}

.section-heading {
  display: flex;
  align-items: center;
}

.section-mark {
  width: 6rpx;
  height: 24rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #528fff;
  box-shadow: 0 0 18rpx rgba(82, 143, 255, 0.4);
}

.notice-title,
.section-title {
  color: #f5f7fa;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.45;
}

.notice-text,
.section-text {
  margin-top: 16rpx;
  color: #9ca5b2;
  font-size: 23rpx;
  line-height: 1.78;
}

.notice-text {
  color: #b9cceb;
}

.rental-tip {
  position: relative;
  padding-left: 24rpx;
}

.rental-tip::before {
  position: absolute;
  top: 17rpx;
  left: 2rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #4e87e8;
  content: "";
}

.pricing-card {
  margin-top: 22rpx;
  padding: 27rpx;
  border-color: rgba(86, 143, 232, 0.22);
  background: linear-gradient(145deg, rgba(31, 43, 61, 0.98), rgba(20, 24, 31, 0.98) 68%);
}

.pricing-heading,
.section-heading-copy,
.pricing-base-row,
.disclosure-button,
.estimate-disclaimer {
  display: flex;
  align-items: center;
}

.pricing-heading,
.pricing-base-row,
.disclosure-button {
  justify-content: space-between;
}

.section-heading-copy {
  min-width: 0;
}

.section-kicker {
  margin-top: 3rpx;
  color: #5d6f89;
  font-size: 14rpx;
  font-weight: 600;
  letter-spacing: 1.6rpx;
}

.pricing-badge,
.pricing-base-state {
  flex-shrink: 0;
  border: 1rpx solid rgba(91, 148, 235, 0.26);
  border-radius: 999rpx;
  background: rgba(78, 133, 219, 0.11);
  color: #85aff1;
  font-size: 17rpx;
}

.pricing-badge {
  padding: 7rpx 14rpx;
}

.pricing-base-row {
  margin-top: 23rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
}

.pricing-base-label {
  color: #7f8a98;
  font-size: 18rpx;
}

.pricing-base-value {
  margin-top: 5rpx;
  color: #f1f5fb;
  font-size: 34rpx;
  font-weight: 680;
  line-height: 1.3;
}

.pricing-base-unit {
  color: #8a96a6;
  font-size: 18rpx;
  font-weight: 450;
}

.pricing-base-state {
  padding: 8rpx 13rpx;
}

.pricing-included,
.rental-rules-summary {
  margin-top: 17rpx;
  color: #9aa5b3;
  font-size: 21rpx;
  line-height: 1.65;
}

.disclosure-button {
  width: 100%;
  height: 76rpx;
  margin-top: 18rpx;
  padding: 0 19rpx;
  border: 1rpx solid rgba(100, 151, 230, 0.2);
  border-radius: 18rpx;
  background: rgba(73, 125, 205, 0.08);
  color: #8eb6f3;
  font-size: 20rpx;
  line-height: 76rpx;
  box-sizing: border-box;
}

.disclosure-button::after {
  border: 0;
}

.disclosure-button-pressed {
  background: rgba(73, 125, 205, 0.16);
}

.disclosure-chevron {
  width: 12rpx;
  height: 12rpx;
  margin-right: 4rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg) translateY(-3rpx);
  transition: transform 160ms ease;
}

.disclosure-chevron-open {
  transform: rotate(225deg) translate(-2rpx, -2rpx);
}

.disclosure-list {
  margin-top: 12rpx;
}

.disclosure-item {
  padding: 19rpx 4rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.065);
}

.disclosure-item:last-child {
  border-bottom: 0;
}

.disclosure-label {
  color: #d7dee8;
  font-size: 21rpx;
  font-weight: 600;
}

.disclosure-text {
  margin-top: 7rpx;
  color: #8995a4;
  font-size: 20rpx;
  line-height: 1.65;
}

.estimate-disclaimer {
  align-items: flex-start;
  margin-top: 16rpx;
  padding: 15rpx 17rpx;
  border-radius: 15rpx;
  background: rgba(236, 170, 93, 0.075);
  color: #a99579;
  font-size: 18rpx;
  line-height: 1.6;
}

.estimate-disclaimer-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 25rpx;
  height: 25rpx;
  margin-top: 2rpx;
  margin-right: 10rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  font-size: 15rpx;
  font-weight: 700;
  line-height: 1;
  box-sizing: border-box;
}

.rental-rules-card {
  border-color: rgba(255, 255, 255, 0.085);
}

.rental-disclosure-button {
  color: #a7b4c5;
}

.rental-rule-list {
  margin-bottom: -5rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 22rpx;
}

.service-flow {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.service-step {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 20rpx 16rpx 18rpx;
  border: 1rpx solid rgba(94, 145, 226, 0.11);
  border-radius: 18rpx;
  background: rgba(62, 101, 162, 0.045);
  box-sizing: border-box;
}

.service-step-index {
  color: #5e8dd7;
  font-size: 14rpx;
  font-weight: 650;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.service-step-title {
  margin-top: 8rpx;
  color: #e7ebf1;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.4;
}

.service-step-desc {
  margin-top: 7rpx;
  color: #737f8e;
  font-size: 16rpx;
  line-height: 1.55;
}

.info-item {
  width: 48.5%;
  margin-bottom: 14rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.065);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.028);
}

.info-label {
  color: #697381;
  font-size: 19rpx;
  line-height: 1.5;
}

.info-value {
  margin-top: 8rpx;
  color: #eef1f5;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.45;
  word-break: break-all;
}

.detail-bottom-bar {
  position: fixed;
  right: calc(24rpx + env(safe-area-inset-right));
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: calc(24rpx + env(safe-area-inset-left));
  z-index: 20;
  display: flex;
  flex-direction: column;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 28rpx;
  background: rgba(19, 22, 27, 0.95);
  box-shadow: 0 22rpx 60rpx rgba(0, 0, 0, 0.42);
  box-sizing: border-box;
}

.bottom-action-meta,
.bottom-action-buttons,
.bottom-action-status {
  display: flex;
  align-items: center;
}

.bottom-action-meta {
  min-height: 50rpx;
  padding: 2rpx 8rpx 10rpx;
}

.bottom-action-status {
  flex-shrink: 0;
  margin-right: 12rpx;
  color: #82aef3;
  font-size: 17rpx;
  font-weight: 600;
  line-height: 1.4;
}

.bottom-action-status.status-rented {
  color: #8e99a8;
}

.bottom-action-status.status-maintenance {
  color: #e2a05d;
}

.bottom-action-status.status-reserved {
  color: #aa8bdc;
}

.bottom-action-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 10rpx currentColor;
}

.bottom-action-hint {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #6e7988;
  font-size: 16rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-action-buttons {
  width: 100%;
}

.action-button {
  flex: 1;
  height: 88rpx;
  padding: 0 14rpx;
  border-radius: 20rpx;
  font-size: 25rpx;
  line-height: 88rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-button-offset {
  margin-left: 12rpx;
}

.detail-action-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  line-height: 1;
}

.detail-action-native-icon {
  position: relative;
  flex-shrink: 0;
  margin-right: 11rpx;
  color: currentColor;
  box-sizing: border-box;
}

.booking-action-native-icon {
  width: 27rpx;
  height: 25rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}

.booking-action-native-icon::before {
  position: absolute;
  top: 6rpx;
  right: 0;
  left: 0;
  height: 2rpx;
  background: currentColor;
  content: "";
}

.booking-action-native-icon::after {
  position: absolute;
  top: 12rpx;
  left: 5rpx;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 7rpx 0 0 currentColor, 14rpx 0 0 currentColor, 0 6rpx 0 currentColor, 7rpx 6rpx 0 currentColor;
  content: "";
}

.phone-action-native-icon {
  width: 16rpx;
  height: 22rpx;
  margin-right: 13rpx;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  border-radius: 0 0 0 11rpx;
  transform: rotate(-36deg);
}

.phone-action-native-icon::before,
.phone-action-native-icon::after {
  position: absolute;
  left: -3rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: "";
}

.phone-action-native-icon::before {
  top: -2rpx;
}

.phone-action-native-icon::after {
  bottom: -3rpx;
}

.retry-action-native-icon {
  width: 25rpx;
  height: 25rpx;
  border: 2rpx solid currentColor;
  border-right-color: transparent;
  border-radius: 50%;
}

.retry-action-native-icon::after {
  position: absolute;
  top: -4rpx;
  right: -1rpx;
  width: 7rpx;
  height: 7rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  content: "";
  transform: rotate(20deg);
}

.back-action-native-icon {
  width: 12rpx;
  height: 12rpx;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  transform: rotate(45deg);
}

