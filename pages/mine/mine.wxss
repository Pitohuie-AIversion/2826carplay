.mine-page {
  position: relative;
  min-height: 100vh;
  padding: 36rpx calc(24rpx + env(safe-area-inset-right)) calc(220rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  overflow: hidden;
  background: linear-gradient(180deg, #141a25 0%, #0b0d10 520rpx);
  box-sizing: border-box;
}
.mine-glow {
  position: absolute;
  top: -220rpx;
  right: -180rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: rgba(50, 111, 210, 0.12);
  filter: blur(90rpx);
}
.mine-intro,
.profile-card,
.operation-pulse,
.section-card {
  position: relative;
  z-index: 1;
}
.mine-intro {
  padding: 10rpx 10rpx 26rpx;
}
.intro-kicker,
.section-kicker {
  color: #647794;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 3rpx;
}
.intro-title {
  margin-top: 8rpx;
  color: #f7f9fc;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}
.intro-desc {
  margin-top: 8rpx;
  color: #818b99;
  font-size: 23rpx;
  line-height: 1.5;
}
.profile-card,
.member-services,
.operation-pulse,
.section-card {
  margin-bottom: 22rpx;
  padding: 30rpx;
  box-sizing: border-box;
}
.profile-card {
  position: relative;
  display: flex;
  align-items: center;
  overflow: hidden;
  min-height: 190rpx;
}
.member-services {
  overflow: hidden;
  border-color: rgba(90, 145, 230, 0.15);
  background:
    radial-gradient(circle at 8% 0%, rgba(78, 132, 216, 0.1), transparent 38%),
    rgba(18, 23, 31, 0.94);
}
.member-services-heading {
  padding-bottom: 20rpx;
}
.member-services-note {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #68768a;
  font-size: 16rpx;
  line-height: 1.4;
}
.member-shortcuts {
  display: flex;
  gap: 12rpx;
}
.member-shortcut {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 18rpx 15rpx 17rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.075);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.026);
  transition: opacity 120ms ease, transform 120ms ease;
  box-sizing: border-box;
}
.member-shortcut::after {
  position: absolute;
  right: -28rpx;
  bottom: -42rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(92, 149, 239, 0.06);
  content: "";
}
.member-shortcut-green::after {
  background: rgba(94, 191, 142, 0.055);
}
.member-shortcut-violet::after {
  background: rgba(151, 115, 222, 0.06);
}
.member-shortcut-pressed {
  opacity: 0.74;
  transform: scale(0.975);
}
.member-shortcut-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.member-shortcut-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid rgba(89, 151, 248, 0.24);
  border-radius: 15rpx;
  background: rgba(59, 125, 230, 0.1);
  color: #7daaf0;
}
.member-shortcut-icon {
  position: relative;
  display: block;
  width: 25rpx;
  height: 25rpx;
  color: currentColor;
  box-sizing: border-box;
}
.member-shortcut-icon-calendar {
  width: 25rpx;
  height: 23rpx;
  margin-top: 2rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}
.member-shortcut-icon-calendar::before {
  position: absolute;
  top: 5rpx;
  right: 0;
  left: 0;
  height: 2rpx;
  background: currentColor;
  content: "";
}
.member-shortcut-icon-calendar::after {
  position: absolute;
  top: -5rpx;
  left: 4rpx;
  width: 2rpx;
  height: 7rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 11rpx 0 0 currentColor;
  content: "";
}
.member-shortcut-heart-shape {
  position: absolute;
  top: 7rpx;
  left: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 3rpx;
  background: currentColor;
  transform: rotate(-45deg) scale(0.82);
  transform-origin: center;
}
.member-shortcut-heart-shape::before,
.member-shortcut-heart-shape::after {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}
.member-shortcut-heart-shape::before {
  top: -7rpx;
  left: 0;
}
.member-shortcut-heart-shape::after {
  top: 0;
  left: 7rpx;
}
.member-shortcut-icon-lock {
  width: 23rpx;
  height: 17rpx;
  margin-top: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}
.member-shortcut-icon-lock::before {
  position: absolute;
  top: -10rpx;
  left: 4rpx;
  width: 11rpx;
  height: 10rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
  box-sizing: border-box;
  content: "";
}
.member-shortcut-icon-lock::after {
  position: absolute;
  top: 5rpx;
  left: 9rpx;
  width: 3rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: "";
}
.member-shortcut-green .member-shortcut-symbol {
  border-color: rgba(84, 181, 131, 0.22);
  background: rgba(64, 151, 106, 0.09);
  color: #78c89f;
}
.member-shortcut-violet .member-shortcut-symbol {
  border-color: rgba(145, 107, 218, 0.22);
  background: rgba(124, 82, 203, 0.09);
  color: #aa8de0;
}
.member-shortcut-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  color: #526073;
}
.direction-arrow-icon {
  position: relative;
  width: 11rpx;
  height: 11rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  box-sizing: border-box;
}
.direction-arrow-icon::after {
  position: absolute;
  top: -2rpx;
  right: -1rpx;
  width: 15rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
  transform: rotate(-45deg);
  transform-origin: right center;
}
.member-shortcut-kicker {
  margin-top: 18rpx;
  overflow: hidden;
  color: #74839a;
  font-size: 15rpx;
  font-weight: 650;
  line-height: 1.3;
  letter-spacing: 0.8rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-shortcut-title {
  position: relative;
  z-index: 1;
  margin-top: 5rpx;
  overflow: hidden;
  color: #edf2f8;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-shortcut-desc {
  position: relative;
  z-index: 1;
  margin-top: 3rpx;
  overflow: hidden;
  color: #697689;
  font-size: 16rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile-card::after {
  position: absolute;
  right: -60rpx;
  bottom: -100rpx;
  width: 240rpx;
  height: 240rpx;
  border: 1rpx solid rgba(102, 148, 221, 0.1);
  border-radius: 50%;
  content: "";
}
.avatar-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 126rpx;
  height: 126rpx;
  margin-right: 24rpx;
  border: 1rpx solid rgba(100, 154, 240, 0.32);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.025);
}
.avatar-image {
  width: 102rpx;
  height: 102rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 30rpx rgba(24, 71, 148, 0.28);
}
.profile-info {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}
.profile-name {
  color: #f7f9fc;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.45;
  word-break: break-word;
}
.profile-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 9rpx;
}
.profile-brand-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 13rpx;
  border: 1rpx solid rgba(87, 144, 239, 0.3);
  border-radius: 999rpx;
  background: rgba(47, 128, 237, 0.11);
  color: #86b0f8;
  font-size: 15rpx;
  line-height: 1.3;
  letter-spacing: 1rpx;
}
.profile-brand-chip.profile-role-admin {
  border-color: rgba(187, 148, 75, 0.3);
  background: rgba(187, 148, 75, 0.1);
  color: #d9b76f;
}
.profile-brand-chip.profile-role-operations {
  border-color: rgba(103, 173, 137, 0.28);
  background: rgba(72, 145, 106, 0.1);
  color: #8ac9a7;
}
.profile-brand-chip.profile-role-loading {
  border-color: rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  color: #7d8794;
}
.profile-brand-note {
  margin-left: 10rpx;
  color: #737e8c;
  font-size: 20rpx;
  line-height: 1.5;
}
.profile-desc,
.section-desc,
.menu-desc {
  margin-top: 9rpx;
  color: #8d96a3;
  font-size: 22rpx;
  line-height: 1.65;
}
.profile-access {
  display: flex;
  align-items: center;
  margin-top: 13rpx;
  color: #7f8996;
  font-size: 19rpx;
  line-height: 1.4;
}
.profile-access-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: #568fff;
  box-shadow: 0 0 12rpx rgba(86, 143, 255, 0.52);
}
.profile-access.profile-role-admin {
  color: #ba9e66;
}
.profile-access.profile-role-admin .profile-access-dot {
  background: #d1a94f;
  box-shadow: 0 0 12rpx rgba(209, 169, 79, 0.46);
}
.profile-access.profile-role-operations {
  color: #79aa8e;
}
.profile-access.profile-role-operations .profile-access-dot {
  background: #65b187;
  box-shadow: 0 0 12rpx rgba(101, 177, 135, 0.42);
}
.profile-access.profile-role-loading .profile-access-dot {
  background: #77818e;
  animation: profileAccessPulse 1.2s ease-in-out infinite;
}
.profile-watermark {
  position: absolute;
  right: -28rpx;
  bottom: -48rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  opacity: 0.07;
}
.operation-pulse {
  overflow: hidden;
  border-color: rgba(84, 143, 255, 0.18);
  background:
    radial-gradient(circle at 88% 0%, rgba(70, 129, 224, 0.14), transparent 42%),
    rgba(20, 27, 37, 0.94);
  transition: opacity 120ms ease, transform 120ms ease;
}
.operation-pulse-priority::before {
  position: absolute;
  top: 28rpx;
  bottom: 28rpx;
  left: 0;
  width: 4rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #528fff;
  box-shadow: 0 0 18rpx rgba(82, 143, 255, 0.42);
  content: "";
}
.operation-pulse-pressed {
  opacity: 0.78;
  transform: scale(0.992);
}
.operation-pulse-top,
.operation-pulse-side,
.operation-pulse-items {
  display: flex;
  align-items: center;
}
.operation-pulse-top {
  justify-content: space-between;
}
.operation-pulse-title {
  margin-top: 6rpx;
  color: #eef3f9;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.4;
}
.operation-pulse-side {
  flex-shrink: 0;
  margin-left: 18rpx;
}
.operation-pulse-state {
  display: flex;
  align-items: center;
  color: #6fc99b;
  font-size: 16rpx;
  line-height: 1.4;
}
.operation-pulse-state-warning {
  color: #e5a95f;
}
.operation-pulse-state-icon {
  position: relative;
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-right: 6rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}
.operation-pulse-state-icon-loading {
  border-right-color: transparent;
  animation: mine-pulse-spin 0.8s linear infinite;
}
.operation-pulse-state-icon-ready .operation-pulse-state-mark {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 7rpx;
  height: 4rpx;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  transform: rotate(-45deg);
}
.operation-pulse-state-icon-warning .operation-pulse-state-mark::before {
  position: absolute;
  top: 3rpx;
  left: 6rpx;
  width: 2rpx;
  height: 6rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}
.operation-pulse-state-icon-warning .operation-pulse-state-mark::after {
  position: absolute;
  bottom: 2rpx;
  left: 6rpx;
  width: 2rpx;
  height: 2rpx;
  border-radius: 50%;
  background: currentColor;
  content: "";
}
.operation-pulse-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-left: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 50%;
  color: #8490a0;
}
.operation-pulse-arrow .direction-arrow-icon {
  width: 12rpx;
  height: 12rpx;
}
.operation-pulse-items {
  gap: 12rpx;
  margin-top: 22rpx;
}
.operation-pulse-item {
  flex: 1;
  min-width: 0;
  padding: 18rpx 10rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.025);
  text-align: center;
}
.operation-pulse-item-unavailable {
  opacity: 0.52;
}
.operation-pulse-native-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin: 0 auto 10rpx;
  border: 1rpx solid rgba(118, 162, 230, 0.18);
  border-radius: 11rpx;
  background: rgba(76, 130, 211, 0.06);
  color: #779bd0;
  box-sizing: border-box;
}
.operation-pulse-icon-booking::before {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 15rpx;
  height: 15rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  content: "";
  box-sizing: border-box;
}
.operation-pulse-icon-booking::after {
  position: absolute;
  top: 13rpx;
  left: 9rpx;
  width: 15rpx;
  height: 2rpx;
  background: currentColor;
  content: "";
}
.operation-pulse-icon-privacy::before {
  position: absolute;
  top: 14rpx;
  left: 9rpx;
  width: 14rpx;
  height: 11rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  content: "";
  box-sizing: border-box;
}
.operation-pulse-icon-privacy::after {
  position: absolute;
  top: 7rpx;
  left: 12rpx;
  width: 8rpx;
  height: 10rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 6rpx 6rpx 0 0;
  content: "";
  box-sizing: border-box;
}
.operation-pulse-icon-storage::before {
  position: absolute;
  top: 11rpx;
  left: 8rpx;
  width: 16rpx;
  height: 13rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  content: "";
  box-sizing: border-box;
}
.operation-pulse-icon-storage::after {
  position: absolute;
  top: 8rpx;
  left: 11rpx;
  width: 10rpx;
  height: 2rpx;
  border-top: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
}
.operation-pulse-value {
  color: #84b1fb;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.2;
}
.operation-pulse-label {
  margin-top: 7rpx;
  overflow: hidden;
  color: #778496;
  font-size: 16rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.operation-pulse-foot {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  color: #748194;
  font-size: 17rpx;
  line-height: 1.5;
}
@keyframes mine-pulse-spin {
  to {
    transform: rotate(360deg);
  }
}
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 10rpx;
}
.section-title {
  margin-top: 4rpx;
  color: #f3f5f8;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.45;
}
.section-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #568fff;
  box-shadow: 0 0 16rpx rgba(86, 143, 255, 0.8);
}
.section-count {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(84, 143, 255, 0.13);
  border-radius: 999rpx;
  background: rgba(84, 143, 255, 0.045);
  color: #7185a3;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 1rpx;
}
.section-count-loading {
  color: #70819a;
  letter-spacing: 0;
}
.section-count-error {
  border-color: rgba(220, 142, 105, 0.28);
  color: #d89a79;
  letter-spacing: 0;
}
.section-count-pressed {
  opacity: 0.78;
  transform: scale(0.98);
}
.section-count-value {
  margin-right: 5rpx;
  color: #8caee0;
  font-size: 16rpx;
  font-weight: 700;
}
.section-count-dot {
  width: 7rpx;
  height: 7rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: #6a9ce9;
  box-shadow: 0 0 11rpx rgba(106, 156, 233, 0.5);
  animation: mine-permission-dot 1.15s ease-in-out infinite;
}
.menu-skeleton-group {
  display: flex;
  align-items: center;
  margin: 14rpx 0 4rpx;
  padding-top: 10rpx;
}
.menu-skeleton-group-line {
  width: 4rpx;
  height: 34rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: rgba(82, 143, 255, 0.42);
}
.menu-skeleton-kicker {
  width: 84rpx;
  height: 13rpx;
  border-radius: 6rpx;
}
.menu-skeleton-group-title {
  width: 104rpx;
  height: 20rpx;
  margin-top: 6rpx;
  border-radius: 7rpx;
}
.menu-skeleton-row {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}
.menu-skeleton-row:last-child {
  padding-bottom: 4rpx;
  border-bottom: 0;
}
.menu-skeleton-icon {
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
}
.menu-skeleton-copy {
  flex: 1;
  min-width: 0;
}
.menu-skeleton-title {
  width: 158rpx;
  height: 25rpx;
  border-radius: 8rpx;
}
.menu-skeleton-desc {
  width: 76%;
  height: 19rpx;
  margin-top: 11rpx;
  border-radius: 7rpx;
}
.menu-skeleton-arrow {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  margin-left: 14rpx;
  border-radius: 50%;
}
.menu-skeleton-pulse {
  background: linear-gradient(105deg, rgba(91, 111, 141, 0.08) 12%, rgba(107, 146, 204, 0.18) 34%, rgba(91, 111, 141, 0.08) 56%);
  background-size: 220% 100%;
  animation: mine-menu-skeleton 1.55s ease-in-out infinite;
}
.menu-group-heading {
  display: flex;
  align-items: center;
  margin: 26rpx 0 4rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.065);
}
.menu-group-heading-first {
  margin-top: 14rpx;
  padding-top: 10rpx;
  border-top: 0;
}
.menu-group-line {
  width: 4rpx;
  height: 34rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #528fff;
}
.menu-group-kicker {
  color: #7487a2;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 2rpx;
}
.menu-group-title {
  margin-top: 3rpx;
  color: #aab2bd;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.065);
  transition: opacity 120ms ease, transform 120ms ease;
}
.menu-item:active {
  opacity: 0.78;
}
.menu-item-pressed {
  opacity: 0.72;
  transform: translateX(4rpx);
}
.menu-item-last {
  padding-bottom: 4rpx;
  border-bottom: 0;
}
.menu-glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  margin-right: 16rpx;
  border: 1rpx solid rgba(84, 143, 255, 0.16);
