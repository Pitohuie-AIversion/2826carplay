@import "../../shared/management-shell.wxss";

.inventory-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 70rpx;
  box-sizing: border-box;
  color: #f4f7fb;
  background: linear-gradient(180deg, #151c27 0%, #0b0d10 520rpx);
}

.hero-card,
.state-card,
.error-card,
.warning-card,
.request-card,
.section-card,
.privacy-note {
  position: relative;
  z-index: 1;
  margin-bottom: 22rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero-card {
  overflow: hidden;
  border-color: rgba(84, 143, 255, 0.2);
}

.hero-top,
.hero-foot,
.section-heading,
.state-card,
.error-card,
.record-head,
.identity-row {
  display: flex;
  align-items: center;
}

.hero-top,
.section-heading,
.record-head {
  justify-content: space-between;
}

.hero-copy,
.error-copy {
  flex: 1;
  min-width: 0;
}

.page-kicker,
.section-eyebrow {
  color: #7185a2;
  font-size: 15rpx;
  font-weight: 650;
  line-height: 1.4;
  letter-spacing: 2.5rpx;
}

.hero-title {
  margin-top: 7rpx;
  color: #f7f9fc;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-desc {
  margin-top: 10rpx;
  color: #8d98a7;
  font-size: 21rpx;
  line-height: 1.6;
}

.hero-emblem {
  flex-shrink: 0;
  width: 82rpx;
  height: 82rpx;
  margin-left: 20rpx;
  border: 1rpx solid rgba(113, 163, 246, 0.28);
  border-radius: 50%;
}

.hero-foot {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #53d59a;
  box-shadow: 0 0 16rpx rgba(83, 213, 154, 0.5);
}

.hero-foot-text {
  flex: 1;
  color: #758193;
  font-size: 18rpx;
}

.refresh-link {
  color: #84b1fb;
  font-size: 19rpx;
  font-weight: 600;
}

.state-card,
.error-card {
  min-height: 130rpx;
}

.state-loader {
  flex-shrink: 0;
  width: 38rpx;
  height: 38rpx;
  margin-right: 20rpx;
  border: 4rpx solid rgba(105, 158, 246, 0.15);
  border-top-color: #69a0f8;
  border-radius: 50%;
  animation: inventory-spin 0.9s linear infinite;
}

.state-title,
.error-title,
.warning-title {
  color: #e9edf3;
  font-size: 22rpx;
  font-weight: 600;
}

.state-desc,
.error-desc,
.warning-desc {
  margin-top: 7rpx;
  color: #7b8796;
  font-size: 18rpx;
  line-height: 1.55;
}

.retry-button {
  flex-shrink: 0;
  min-width: 112rpx;
  height: 62rpx;
  margin-left: 18rpx;
  border-radius: 16rpx;
  font-size: 19rpx;
  line-height: 62rpx;
}

.warning-card {
  border-color: rgba(241, 173, 91, 0.2);
  background: rgba(241, 173, 91, 0.06);
}

.section-title {
  margin-top: 4rpx;
  color: #ecf0f6;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.45;
}

.section-index {
  color: #53637a;
  font-size: 16rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.status-pill,
.record-status {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(105, 153, 230, 0.1);
  color: #81aef5;
  font-size: 16rpx;
}

.identity-row {
  margin-top: 22rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.025);
}

.identity-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #8290a3;
  font-family: monospace;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy-button {
  width: 110rpx;
  min-width: 110rpx;
  height: 58rpx;
  margin-left: 12rpx;
  padding: 0;
  border-radius: 14rpx;
  font-size: 20rpx;
  line-height: 58rpx;
}

.request-meta {
  margin-top: 16rpx;
  color: #748091;
  font-size: 19rpx;
}

.request-description {
  margin-top: 12rpx;
  color: #aeb8c5;
  font-size: 22rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.metric-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.metric-card {
  padding: 22rpx 10rpx;
  text-align: center;
}

.metric-value {
  color: #76aaff;
  font-size: 34rpx;
  font-weight: 700;
}

.metric-label {
  margin-top: 8rpx;
  color: #778392;
  font-size: 17rpx;
}

.record-list {
  margin-top: 20rpx;
}

.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.record-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.record-link {
  position: relative;
}

.record-link::after {
  position: absolute;
  top: 20rpx;
  right: 0;
  color: #5f7393;
  font-size: 28rpx;
  content: "›";
}

.record-link .record-head {
  padding-right: 26rpx;
}

.record-title {
  min-width: 0;
  color: #e8edf4;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
  word-break: break-word;
}

.record-meta,
.record-detail {
  margin-top: 8rpx;
  color: #778392;
  font-size: 18rpx;
  line-height: 1.55;
}

.record-note,
.record-resolution {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.025);
  color: #9ea9b7;
  font-size: 19rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.record-resolution {
  background: rgba(82, 143, 255, 0.055);
}

.empty-text {
  padding: 34rpx 0 8rpx;
  color: #748091;
  font-size: 20rpx;
  text-align: center;
}

.privacy-note {
  border-color: rgba(113, 148, 202, 0.12);
  color: #7f8b9a;
  font-size: 18rpx;
  line-height: 1.7;
}

@keyframes inventory-spin {
  to {
    transform: rotate(360deg);
  }
}
