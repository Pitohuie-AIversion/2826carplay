.content-page {
  position: relative;
  min-height: 100vh;
  padding: 38rpx calc(24rpx + env(safe-area-inset-right)) calc(70rpx + env(safe-area-inset-bottom)) calc(24rpx + env(safe-area-inset-left));
  overflow: hidden;
  background: linear-gradient(180deg, #141a25 0%, #0b0d10 560rpx);
  box-sizing: border-box;
}
.guide-state {
  color: #aeb9c8;
  text-align: center;
}
.guide-retry {
  margin-top: 22rpx;
}
.guide-vehicle {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}
.guide-vehicle-cover {
  width: 112rpx;
  height: 84rpx;
  margin-right: 18rpx;
  border-radius: 12rpx;
}
.guide-vehicle-copy {
  min-width: 0;
  flex: 1;
}
.guide-vehicle-name {
  color: #eef2f7;
  font-size: 24rpx;
  font-weight: 650;
}
.guide-vehicle-status {
  margin-top: 6rpx;
  color: #7f8b9b;
  font-size: 18rpx;
}
.guide-vehicle-actions {
  display: flex;
  gap: 10rpx;
}
.guide-vehicle-actions .ui-btn {
  min-width: 116rpx;
  padding: 14rpx 18rpx;
  font-size: 19rpx;
}
.page-glow {
  position: absolute;
  top: -230rpx;
  right: -190rpx;
  width: 540rpx;
  height: 540rpx;
  border-radius: 50%;
  background: rgba(47, 104, 198, 0.12);
  filter: blur(90rpx);
}
.hero-card,
.content-switcher,
.content-card,
.rights-card,
.support-card,
.document-footer {
  position: relative;
  z-index: 1;
}
.hero-card,
.content-switcher,
.content-card,
.rights-card,
.support-card {
  margin-bottom: 22rpx;
  padding: 30rpx;
  box-sizing: border-box;
}
.content-switcher {
  border-color: rgba(84, 143, 255, 0.13);
  background: rgba(17, 22, 29, 0.94);
}
.switcher-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.switcher-kicker {
  color: #5e7290;
  font-size: 14rpx;
  font-weight: 650;
  line-height: 1.4;
  letter-spacing: 2.3rpx;
}
.switcher-title {
  margin-top: 4rpx;
  color: #e8edf4;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.4;
}
.switcher-note {
  color: #687587;
  font-size: 16rpx;
  line-height: 1.4;
}
.content-tabs {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
}
.content-tab {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  height: 78rpx;
  margin: 0;
  padding: 0 15rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 15rpx;
  background: rgba(255, 255, 255, 0.025);
  line-height: 1;
  box-sizing: border-box;
  transition: opacity 120ms ease, transform 120ms ease;
}
.content-tab::after,
.section-index-item::after {
  border: 0;
}
.content-tab-active {
  border-color: rgba(84, 143, 255, 0.25);
  background: linear-gradient(135deg, rgba(57, 115, 209, 0.2), rgba(47, 87, 151, 0.13));
}
.content-tab-kicker,
.content-tab-title {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.content-tab-kicker {
  color: #74839a;
  font-size: 15rpx;
  font-weight: 650;
  line-height: 1.2;
  letter-spacing: 0.7rpx;
}
.content-tab-title {
  margin-top: 7rpx;
  color: #919baa;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.2;
}
.content-tab-active .content-tab-kicker {
  color: #729bdd;
}
.content-tab-active .content-tab-title {
  color: #edf4ff;
}
.rights-card {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  border-color: rgba(84, 143, 255, 0.2);
  background: linear-gradient(145deg, rgba(31, 49, 75, 0.98), rgba(20, 25, 33, 0.98));
}
.rights-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 62rpx;
  height: 62rpx;
  margin-right: 18rpx;
  border: 1rpx solid rgba(112, 162, 246, 0.28);
  border-radius: 18rpx;
  background: rgba(84, 143, 255, 0.1);
  color: #8ab4fb;
}
.rights-document-icon {
  position: relative;
  width: 25rpx;
  height: 31rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}
.rights-document-icon::before {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 0 6rpx 0 currentColor;
  content: "";
}
.rights-document-check {
  position: absolute;
  right: -5rpx;
  bottom: -4rpx;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  background: #1d304b;
  box-sizing: border-box;
}
.rights-document-check::after {
  position: absolute;
  top: 2rpx;
  left: 4rpx;
  width: 3rpx;
  height: 6rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}
.rights-copy {
  flex: 1;
  min-width: 0;
}
.rights-kicker {
  color: #6f86a8;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}
.rights-title {
  margin-top: 5rpx;
  color: #f0f4fa;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.45;
}
.rights-desc {
  width: 100%;
  margin-top: 16rpx;
  color: #8d9aac;
  font-size: 21rpx;
  line-height: 1.7;
}
.rights-button {
  width: 100%;
  height: 82rpx;
  margin-top: 22rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 82rpx;
}
.content-action-content {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  line-height: 1;
}
.content-action-native-icon {
  position: relative;
  flex-shrink: 0;
  margin-right: 10rpx;
  color: currentColor;
  box-sizing: border-box;
}
.rights-action-native-icon {
  width: 23rpx;
  height: 27rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
}
.rights-action-native-icon::before {
  position: absolute;
  top: 6rpx;
  left: 4rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 0 6rpx 0 currentColor;
  content: "";
}
.rights-action-native-icon::after {
  position: absolute;
  right: -5rpx;
  bottom: 2rpx;
  width: 8rpx;
  height: 8rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}
.support-chat-native-icon {
  width: 25rpx;
  height: 20rpx;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}
.support-chat-native-icon::before {
  position: absolute;
  top: 7rpx;
  left: 5rpx;
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 6rpx 0 0 currentColor, 12rpx 0 0 currentColor;
  content: "";
}
.support-chat-native-icon::after {
  position: absolute;
  bottom: -6rpx;
  left: 4rpx;
  width: 7rpx;
  height: 7rpx;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  content: "";
  transform: skewY(-30deg);
}
.support-phone-native-icon {
  width: 16rpx;
  height: 22rpx;
  margin-right: 13rpx;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  border-radius: 0 0 0 11rpx;
  transform: rotate(-36deg);
}
.support-phone-native-icon::before,
.support-phone-native-icon::after {
  position: absolute;
  left: -3rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: "";
}
.support-phone-native-icon::before {
  top: -2rpx;
}
.support-phone-native-icon::after {
  bottom: -3rpx;
}
.hero-card {
  overflow: hidden;
  border-color: rgba(94, 145, 226, 0.18);
}
.hero-card::after {
  position: absolute;
  right: -70rpx;
  bottom: -125rpx;
  width: 270rpx;
  height: 270rpx;
  border: 1rpx solid rgba(98, 148, 227, 0.08);
  border-radius: 50%;
  content: "";
}
.hero-top,
.document-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-kicker,
.document-label {
  color: #657997;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 3rpx;
}
.hero-title {
  margin-top: 8rpx;
  color: #f7f9fc;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}
.hero-desc {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  color: #8993a1;
  font-size: 22rpx;
  line-height: 1.6;
}
.hero-emblem {
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
  margin-left: 20rpx;
  border: 1rpx solid rgba(105, 154, 235, 0.25);
  border-radius: 50%;
}
.document-head {
  justify-content: flex-start;
}
.document-count {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: auto;
  padding: 7rpx 11rpx;
  border: 1rpx solid rgba(84, 143, 255, 0.12);
  border-radius: 999rpx;
  background: rgba(84, 143, 255, 0.045);
  color: #66758b;
  font-size: 14rpx;
  font-weight: 600;
  line-height: 1;
}
.document-count-value {
  margin-right: 5rpx;
  color: #87aae0;
  font-size: 16rpx;
  font-weight: 700;
}
.document-mark {
  width: 6rpx;
  height: 50rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #528fff;
  box-shadow: 0 0 18rpx rgba(82, 143, 255, 0.35);
}
.document-title {
  margin-top: 3rpx;
  color: #e9edf2;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.4;
}
.document-divider {
  margin: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
}
.section-index-shell {
  position: relative;
  width: 100%;
  margin: -4rpx 0 24rpx;
}
.section-index {
  width: 100%;
  white-space: nowrap;
}
.section-index-track {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 62rpx;
}
.section-scroll-cue {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 58rpx;
  padding-right: 12rpx;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(21, 24, 29, 0), rgba(21, 24, 29, 0.96) 74%);
  box-sizing: border-box;
}
.section-scroll-cue-arrow {
  width: 11rpx;
  height: 11rpx;
  border-top: 2rpx solid rgba(142, 178, 232, 0.7);
  border-right: 2rpx solid rgba(142, 178, 232, 0.7);
  transform: rotate(45deg);
}
.section-index-item {
  display: inline-flex;
  align-items: center;
  width: auto;
  max-width: 280rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.075);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.025);
  color: #778394;
  line-height: 58rpx;
  box-sizing: border-box;
  transition: opacity 120ms ease, transform 120ms ease;
}
.content-control-pressed {
  opacity: 0.72;
  transform: scale(0.975);
}
.section-index-item-active {
  border-color: rgba(84, 143, 255, 0.24);
  background: rgba(70, 127, 218, 0.1);
  color: #9abeef;
}
.section-index-number {
  flex-shrink: 0;
  margin-right: 8rpx;
  color: #668ac1;
  font-size: 14rpx;
  font-weight: 650;
}
.section-index-title {
  overflow: hidden;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.content-text {
  color: #b1b8c2;
  font-size: 23rpx;
  line-height: 1.95;
  white-space: pre-wrap;
  word-break: break-word;
}
.document-intro {
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  border-left: 3rpx solid rgba(84, 143, 255, 0.5);
  border-radius: 0 16rpx 16rpx 0;
  background: rgba(84, 143, 255, 0.055);
  color: #9ca8b8;
  font-size: 21rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}
.document-section {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.document-section:first-child {
  padding-top: 2rpx;
}
.document-section:last-child {
  padding-bottom: 2rpx;
  border-bottom: 0;
}
.section-number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-right: 18rpx;
  border: 1rpx solid rgba(84, 143, 255, 0.2);
  border-radius: 14rpx;
  background: rgba(84, 143, 255, 0.07);
  color: #7faaf1;
  font-size: 16rpx;
  font-weight: 650;
  line-height: 1;
}
.section-copy {
  flex: 1;
  min-width: 0;
}
.section-title {
  color: #dfe4eb;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.65;
  word-break: break-word;
}
.section-body {
  margin-top: 10rpx;
  color: #959fac;
  font-size: 21rpx;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
}
.support-card {
  border-color: rgba(84, 136, 220, 0.13);
  background: linear-gradient(145deg, #19212c, #14171c 74%);
}
.support-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.support-kicker {
  color: #657997;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}
.support-title {
  margin-top: 6rpx;
  color: #f0f3f7;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.4;
}
.support-desc {
  margin-top: 7rpx;
  padding-right: 20rpx;
  color: #7e8997;
  font-size: 20rpx;
  line-height: 1.6;
}
.support-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid rgba(84, 143, 255, 0.24);
  border-radius: 50%;
  background: rgba(84, 143, 255, 0.08);
  color: #82adf3;
}
.support-headset-icon {
  position: relative;
  width: 30rpx;
  height: 26rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
  box-sizing: border-box;
}
.support-headset-icon::before,
.support-headset-icon::after {
  position: absolute;
  top: 11rpx;
  width: 6rpx;
  height: 12rpx;
  border-radius: 5rpx;
  background: currentColor;
  content: "";
}
.support-headset-icon::before {
  left: -5rpx;
}
.support-headset-icon::after {
  right: -5rpx;
}
.support-headset-mic {
  position: absolute;
  right: -2rpx;
  bottom: -5rpx;
  width: 12rpx;
  height: 7rpx;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  border-radius: 0 0 0 6rpx;
  box-sizing: border-box;
}
.support-actions {
  display: flex;
  margin-top: 24rpx;
}
.support-button {
  flex: 1;
  height: 82rpx;
  margin-right: 12rpx;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 82rpx;
}
.support-button-last {
  margin-right: 0;
}
.document-footer {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx 0;
}
.footer-line {
  flex: 1;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.06);
}
.footer-text {
  margin: 0 16rpx;
  color: #515c6b;
  font-size: 14rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
}
